@model IEnumerable<Vehicle_Service_Management_System.Application.ViewModels.JobCard.JobCardListViewModel>

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Deleted Job Cards | Vehicle Service Management</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
            :root {
                --primary-gradient: linear-gradient(135deg, #0d6efd, #0a58ca);
                --shadow-sm: 0 2px 8px rgba(0, 0, 0, 0.06);
                --shadow-md: 0 8px 30px rgba(0, 0, 0, 0.10);
                --shadow-lg: 0 16px 48px rgba(0, 0, 0, 0.14);
                --radius: 16px;
                --radius-sm: 10px;
                --transition: 0.25s ease;
            }

            body {
                background: #f4f6fa;
                font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
                padding: 2rem 1.5rem;
                min-height: 100vh;
                display: flex;
                align-items: flex-start;
                justify-content: center;
            }

            .deleted-wrapper {
                max-width: 1200px;
                width: 100%;
                background: #ffffff;
                border-radius: var(--radius);
                box-shadow: var(--shadow-lg);
                padding: 2rem 2rem 2.5rem;
                transition: var(--transition);
            }

            @@media (max-width: 576px) {
                body {
                    padding: 1rem 0.75rem;
                }

                .deleted-wrapper {
                    padding: 1.25rem 1rem 1.75rem;
                    border-radius: var(--radius-sm);
                }
            }

            /* ── Header ── */
            .page-header {
                display: flex;
                flex-wrap: wrap;
                align-items: center;
                justify-content: space-between;
                gap: 1rem;
                margin-bottom: 1.75rem;
            }

                .page-header h1 {
                    font-weight: 700;
                    font-size: 1.85rem;
                    letter-spacing: -0.02em;
                    color: #1a2634;
                    margin: 0;
                    display: flex;
                    align-items: center;
                    gap: 0.5rem;
                }

                    .page-header h1 i {
                        color: #ef4444;
                        font-size: 2rem;
                    }

                .page-header .btn-primary {
                    background: var(--primary-gradient);
                    border: none;
                    padding: 0.6rem 1.4rem;
                    font-weight: 600;
                    border-radius: 50px;
                    box-shadow: 0 4px 14px rgba(13, 110, 253, 0.30);
                    transition: var(--transition);
                    display: inline-flex;
                    align-items: center;
                    gap: 0.5rem;
                }

                    .page-header .btn-primary:hover {
                        transform: translateY(-2px);
                        box-shadow: 0 8px 24px rgba(13, 110, 253, 0.40);
                    }

            /* ── Alerts ── */
            .alert {
                border-radius: var(--radius-sm);
                border: none;
                box-shadow: var(--shadow-sm);
            }

            .alert-success {
                background: #dcfce7;
                color: #166534;
            }

            .alert-danger {
                background: #fee2e2;
                color: #991b1b;
            }

            .alert i {
                margin-right: 0.5rem;
            }

            /* ── Table Card ── */
            .table-card {
                background: #ffffff;
                border-radius: var(--radius-sm);
                box-shadow: var(--shadow-sm);
                overflow: hidden;
                border: 1px solid #eef2f7;
                margin-top: 0.5rem;
            }

            .table-responsive-custom {
                overflow-x: auto;
                -webkit-overflow-scrolling: touch;
                padding: 0 0.25rem;
            }

            .table {
                margin: 0;
                font-size: 0.92rem;
                vertical-align: middle;
                border-collapse: separate;
                border-spacing: 0;
                min-width: 700px;
            }

                .table thead th {
                    background: #f8fafc;
                    color: #2d3748;
                    font-weight: 600;
                    font-size: 0.8rem;
                    text-transform: uppercase;
                    letter-spacing: 0.04em;
                    padding: 0.9rem 1rem;
                    border-bottom: 2px solid #e2e8f0;
                    white-space: nowrap;
                }

                .table tbody td {
                    padding: 0.85rem 1rem;
                    border-bottom: 1px solid #edf2f7;
                    background: #fff;
                    transition: background var(--transition);
                }

                .table tbody tr:hover td {
                    background: #fafcff;
                }

                .table tbody tr:last-child td {
                    border-bottom: none;
                }

            /* ── Badges ── */
            .badge-status {
                font-weight: 500;
                padding: 0.4rem 0.9rem;
                border-radius: 50px;
                font-size: 0.75rem;
                display: inline-flex;
                align-items: center;
                gap: 0.4rem;
                letter-spacing: 0.02em;
            }

                .badge-status.bg-success {
                    background: #dcfce7 !important;
                    color: #166534;
                }

                .badge-status.bg-danger {
                    background: #fee2e2 !important;
                    color: #991b1b;
                }

                .badge-status.bg-warning {
                    background: #fef3c7 !important;
                    color: #b45309;
                }

                .badge-status.bg-info {
                    background: #e0f2fe !important;
                    color: #0369a1;
                }

                .badge-status i {
                    font-size: 0.7rem;
                }

            /* ── Action Buttons ── */
            .action-group {
                display: flex;
                flex-wrap: wrap;
                gap: 0.3rem;
                align-items: center;
            }

                .action-group .btn {
                    border-radius: 30px;
                    padding: 0.25rem 0.75rem;
                    font-size: 0.75rem;
                    font-weight: 500;
                    border: 1px solid transparent;
                    transition: var(--transition);
                    display: inline-flex;
                    align-items: center;
                    gap: 0.3rem;
                }

                .action-group .btn-success {
                    background: #22c55e;
                    border: none;
                    color: #fff;
                    box-shadow: 0 2px 8px rgba(34, 197, 94, 0.25);
                }

                    .action-group .btn-success:hover {
                        transform: translateY(-1px);
                        box-shadow: 0 4px 14px rgba(34, 197, 94, 0.35);
                    }

            /* ── Empty State ── */
            .empty-state {
                padding: 3.5rem 1rem !important;
                text-align: center;
                color: #94a3b8;
                font-size: 1rem;
            }

                .empty-state i {
                    font-size: 2.8rem;
                    display: block;
                    margin-bottom: 0.75rem;
                    color: #cbd5e1;
                }

            /* ── Footer ── */
            .table-footer {
                padding: 0.75rem 1.25rem;
                background: #f8fafc;
                border-top: 1px solid #eef2f7;
                font-size: 0.9rem;
                color: #4a5568;
            }

                .table-footer strong {
                    color: #1a2634;
                }

            @@media (max-width: 480px) {
                .page-header h1 {
                    font-size: 1.4rem;
                }

                    .page-header h1 i {
                        font-size: 1.5rem;
                    }

                .table tbody td {
                    padding: 0.6rem 0.5rem;
                    font-size: 0.82rem;
                }

                .table thead th {
                    padding: 0.6rem 0.5rem;
                    font-size: 0.7rem;
                }

                .action-group .btn {
                    font-size: 0.65rem;
                    padding: 0.15rem 0.5rem;
                }
            }
    </style>
</head>
<body>

    <div class="deleted-wrapper">

        <!-- ─── HEADER ─── -->
        <div class="page-header">
            <h1>
                <i class="bi bi-archive"></i>
                Deleted Job Cards
            </h1>
            <a asp-action="Index" class="btn btn-primary">
                <i class="bi bi-arrow-left"></i> Back to List
            </a>
        </div>

        <!-- ─── ALERTS ─── -->
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle-fill"></i> @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-circle-fill"></i> @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <!-- ─── TABLE ─── -->
        <div class="table-card">
            <div class="table-responsive-custom">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Job Card No.</th>
                            <th>Customer</th>
                            <th>Vehicle</th>
                            <th>Status</th>
                            <th>Estimated Cost</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <span class="fw-500">@item.JobCardNumber</span>
                                    </td>
                                    <td>@item.CustomerName</td>
                                    <td>@item.VehicleNumber</td>
                                    <td>
                                        <span class="badge-status @item.StatusBadge">
                                            @if (item.Status == "Completed")
                                            {
                                                <i class="bi bi-check-circle-fill"></i>
                                            }
                                            else if (item.Status == "InProgress")
                                            {
                                                <i class="bi bi-arrow-repeat"></i>
                                            }
                                            else if (item.Status == "Pending")
                                            {
                                                <i class="bi bi-clock-fill"></i>
                                            }
                                            @item.Status
                                        </span>
                                    </td>
                                    <td>@item.EstimatedCost.ToString("C")</td>
                                    <td class="text-end">
                                        <div class="action-group justify-content-end">
                                            <form asp-action="Restore" asp-route-id="@item.Id" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-success" title="Restore"
                                                        onclick="return confirm('Restore this job card?');">
                                                    <i class="bi bi-arrow-counterclockwise"></i> Restore
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6">
                                    <div class="empty-state">
                                        <i class="bi bi-archive"></i>
                                        No deleted job cards found.
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- ─── TABLE FOOTER ─── -->
        <div class="table-footer">
            Total Records: <strong>@Model.Count()</strong>
        </div>

    </div> <!-- /.deleted-wrapper -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Auto‑dismiss alerts after 4 seconds
        setTimeout(function () {
        let alerts = document.querySelectorAll(".alert");
        alerts.forEach(function (alert) {
        let bsAlert = bootstrap.Alert.getOrCreateInstance(alert);
        bsAlert.close();
        });
        }, 4000);
    </script>
</body>
</html>