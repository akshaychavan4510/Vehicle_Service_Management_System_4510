@model Vehicle_Service_Management_System.Application.ViewModels.JobCard.JobCardCreateViewModel

@{
    ViewData["Title"] = "Create Job Card";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Job Card | Vehicle Service Management</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <style>
            /* ────────────────────────────────────────────────────────── */
            /* Root Variables                                          */
            /* ────────────────────────────────────────────────────────── */
            :root {
                --primary: #0d6efd;
                --primary-dark: #0a58ca;
                --primary-light: #e8f0fe;
                --success: #22c55e;
                --danger: #ef4444;
                --warning: #f59e0b;
                --info: #0dcaf0;
                --dark: #1a2634;
                --gray: #6b7a8e;
                --gray-light: #eef2f7;
                --gray-bg: #f0f2f5;
                --white: #ffffff;
                --shadow-sm: 0 2px 8px rgba(0, 0, 0, 0.04);
                --shadow-md: 0 8px 30px rgba(0, 0, 0, 0.08);
                --shadow-lg: 0 16px 48px rgba(0, 0, 0, 0.12);
                --shadow-xl: 0 24px 64px rgba(0, 0, 0, 0.16);
                --radius: 20px;
                --radius-sm: 12px;
                --radius-xs: 8px;
                --transition: 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            }

            /* ────────────────────────────────────────────────────────── */
            /* Base Styles                                             */
            /* ────────────────────────────────────────────────────────── */
            body {
                background: var(--gray-bg);
                font-family: 'Inter', -apple-system, system-ui, sans-serif;
                padding: 2rem 1.5rem;
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                color: var(--dark);
                line-height: 1.6;
            }

            .create-wrapper {
                max-width: 1000px;
                width: 100%;
                background: var(--white);
                border-radius: var(--radius);
                box-shadow: var(--shadow-xl);
                overflow: hidden;
                animation: slideUp 0.5s ease-out;
            }

            @@keyframes slideUp {
                from {
                    opacity: 0;
                    transform: translateY(30px);
                }

                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            /* ────────────────────────────────────────────────────────── */
            /* Header - Premium Gradient                               */
            /* ────────────────────────────────────────────────────────── */
            .header-premium {
                background: linear-gradient(135deg, #0c0e1a 0%, #1a1a3e 40%, #0d6efd 100%);
                padding: 2.5rem 3rem 2rem;
                color: #fff;
                position: relative;
                overflow: hidden;
            }

                .header-premium::before {
                    content: '';
                    position: absolute;
                    top: -60%;
                    right: -10%;
                    width: 500px;
                    height: 500px;
                    background: radial-gradient(circle, rgba(255, 255, 255, 0.06) 0%, transparent 70%);
                    border-radius: 50%;
                    pointer-events: none;
                }

                .header-premium::after {
                    content: '';
                    position: absolute;
                    bottom: -40%;
                    left: -5%;
                    width: 300px;
                    height: 300px;
                    background: radial-gradient(circle, rgba(13, 202, 240, 0.08) 0%, transparent 70%);
                    border-radius: 50%;
                    pointer-events: none;
                }

            .header-content {
                position: relative;
                z-index: 1;
                display: flex;
                flex-wrap: wrap;
                align-items: center;
                justify-content: space-between;
                gap: 1rem;
            }

            .header-title {
                display: flex;
                align-items: center;
                gap: 1rem;
            }

                .header-title .icon-wrapper {
                    width: 56px;
                    height: 56px;
                    background: rgba(255, 255, 255, 0.15);
                    border-radius: 50%;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    font-size: 1.8rem;
                    backdrop-filter: blur(4px);
                    border: 1px solid rgba(255, 255, 255, 0.1);
                    flex-shrink: 0;
                }

                .header-title h1 {
                    font-weight: 800;
                    font-size: 1.8rem;
                    margin: 0;
                    letter-spacing: -0.02em;
                    background: linear-gradient(135deg, #fff 60%, #94a3b8);
                    -webkit-background-clip: text;
                    -webkit-text-fill-color: transparent;
                    background-clip: text;
                }

                .header-title .subtitle {
                    font-size: 0.9rem;
                    font-weight: 400;
                    color: rgba(255, 255, 255, 0.7);
                    background: rgba(255, 255, 255, 0.1);
                    padding: 0.25rem 1rem;
                    border-radius: 50px;
                    border: 1px solid rgba(255, 255, 255, 0.1);
                    -webkit-text-fill-color: rgba(255, 255, 255, 0.7);
                }

            .header-actions {
                display: flex;
                align-items: center;
                gap: 0.75rem;
                flex-wrap: wrap;
            }

            .btn-header {
                background: rgba(255, 255, 255, 0.12);
                border: 1px solid rgba(255, 255, 255, 0.15);
                color: #fff;
                border-radius: 50px;
                padding: 0.5rem 1.4rem;
                font-weight: 500;
                font-size: 0.9rem;
                transition: var(--transition);
                text-decoration: none;
                display: inline-flex;
                align-items: center;
                gap: 0.5rem;
                backdrop-filter: blur(4px);
            }

                .btn-header:hover {
                    background: rgba(255, 255, 255, 0.25);
                    transform: translateY(-2px);
                    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.2);
                    color: #fff;
                }

            /* ────────────────────────────────────────────────────────── */
            /* Toast / Notification                                     */
            /* ────────────────────────────────────────────────────────── */
            .toast-container {
                position: fixed;
                top: 20px;
                right: 20px;
                z-index: 9999;
            }

            .toast-custom {
                background: var(--white);
                border-radius: var(--radius-sm);
                padding: 1rem 1.5rem;
                box-shadow: var(--shadow-lg);
                border-left: 4px solid var(--primary);
                min-width: 300px;
                animation: slideInRight 0.5s ease-out;
                margin-bottom: 0.75rem;
            }

                .toast-custom.success {
                    border-left-color: var(--success);
                }

                .toast-custom.error {
                    border-left-color: var(--danger);
                }

                .toast-custom .toast-title {
                    font-weight: 700;
                    font-size: 0.95rem;
                }

                .toast-custom .toast-message {
                    font-size: 0.85rem;
                    color: var(--gray);
                }

            @@keyframes slideInRight {
                from {
                    opacity: 0;
                    transform: translateX(100px);
                }

                to {
                    opacity: 1;
                    transform: translateX(0);
                }
            }

            /* ────────────────────────────────────────────────────────── */
            /* Body                                                     */
            /* ────────────────────────────────────────────────────────── */
            .body-content {
                padding: 2rem 3rem 2.5rem;
            }

            /* ────────────────────────────────────────────────────────── */
            /* Alert Messages                                           */
            /* ────────────────────────────────────────────────────────── */
            .alert-custom {
                border-radius: var(--radius-sm);
                padding: 1rem 1.5rem;
                border: none;
                box-shadow: var(--shadow-sm);
                margin-bottom: 1.5rem;
            }

                .alert-custom.alert-danger {
                    background: #fee2e2;
                    color: #991b1b;
                    border-left: 4px solid var(--danger);
                }

                .alert-custom.alert-success {
                    background: #dcfce7;
                    color: #166534;
                    border-left: 4px solid var(--success);
                }

            /* ────────────────────────────────────────────────────────── */
            /* Form Card                                                */
            /* ────────────────────────────────────────────────────────── */
            .form-card {
                background: var(--white);
                border-radius: var(--radius-sm);
                padding: 1.75rem 2rem;
                box-shadow: var(--shadow-sm);
                border: 1px solid var(--gray-light);
                transition: var(--transition);
            }

                .form-card:hover {
                    border-color: var(--primary);
                    box-shadow: var(--shadow-md);
                }

                .form-card .card-header-custom {
                    font-weight: 700;
                    font-size: 1.1rem;
                    color: var(--dark);
                    margin-bottom: 1.5rem;
                    display: flex;
                    align-items: center;
                    gap: 0.75rem;
                    padding-bottom: 0.75rem;
                    border-bottom: 2px solid var(--gray-light);
                }

                    .form-card .card-header-custom i {
                        color: var(--success);
                        font-size: 1.3rem;
                    }

            /* ────────────────────────────────────────────────────────── */
            /* Form Groups                                              */
            /* ────────────────────────────────────────────────────────── */
            .form-group {
                margin-bottom: 1.25rem;
            }

                .form-group label {
                    font-weight: 600;
                    font-size: 0.85rem;
                    color: var(--dark);
                    margin-bottom: 0.4rem;
                }

                    .form-group label .required {
                        color: var(--danger);
                        margin-left: 2px;
                    }

                .form-group .form-control,
                .form-group .form-select {
                    border-radius: var(--radius-xs);
                    border: 1.5px solid var(--gray-light);
                    padding: 0.6rem 1rem;
                    font-size: 0.95rem;
                    transition: var(--transition);
                    background: var(--white);
                }

                    .form-group .form-control:focus,
                    .form-group .form-select:focus {
                        border-color: var(--primary);
                        box-shadow: 0 0 0 3px rgba(13, 110, 253, 0.15);
                    }

                    .form-group .form-control.is-invalid {
                        border-color: var(--danger);
                    }

                .form-group .text-danger {
                    font-size: 0.8rem;
                    margin-top: 0.25rem;
                }

                .form-group .form-text {
                    font-size: 0.75rem;
                    color: var(--gray);
                    margin-top: 0.25rem;
                }

            /* ────────────────────────────────────────────────────────── */
            /* Validation Summary                                       */
            /* ────────────────────────────────────────────────────────── */
            .validation-summary-errors {
                background: #fee2e2;
                border: 1px solid #fca5a5;
                border-radius: var(--radius-xs);
                padding: 0.75rem 1rem;
                margin-bottom: 1.5rem;
                color: #991b1b;
            }

                .validation-summary-errors ul {
                    margin: 0;
                    padding-left: 1.2rem;
                }

            /* ────────────────────────────────────────────────────────── */
            /* Action Buttons                                           */
            /* ────────────────────────────────────────────────────────── */
            .action-footer {
                display: flex;
                flex-wrap: wrap;
                gap: 0.75rem;
                margin-top: 2rem;
                padding-top: 1.5rem;
                border-top: 2px solid var(--gray-light);
                align-items: center;
            }

                .action-footer .btn {
                    border-radius: 50px;
                    padding: 0.6rem 1.8rem;
                    font-weight: 600;
                    font-size: 0.9rem;
                    transition: var(--transition);
                    display: inline-flex;
                    align-items: center;
                    gap: 0.6rem;
                    text-transform: uppercase;
                    letter-spacing: 0.04em;
                }

                    .action-footer .btn:hover {
                        transform: translateY(-2px);
                        box-shadow: var(--shadow-md);
                    }

                .action-footer .btn-success {
                    background: linear-gradient(135deg, #22c55e, #16a34a);
                    border: none;
                    color: #fff;
                    box-shadow: 0 4px 14px rgba(34, 197, 94, 0.3);
                }

                    .action-footer .btn-success:hover {
                        box-shadow: 0 6px 24px rgba(34, 197, 94, 0.4);
                    }

                    .action-footer .btn-success:disabled {
                        opacity: 0.6;
                        cursor: not-allowed;
                        transform: none;
                    }

                .action-footer .btn-secondary {
                    background: var(--gray-bg);
                    border: 1px solid var(--gray-light);
                    color: var(--gray);
                }

                    .action-footer .btn-secondary:hover {
                        background: var(--gray-light);
                        border-color: var(--gray);
                        color: var(--dark);
                    }

            /* ────────────────────────────────────────────────────────── */
            /* Loading Spinner                                          */
            /* ────────────────────────────────────────────────────────── */
            .spinner-overlay {
                display: none;
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background: rgba(0, 0, 0, 0.5);
                z-index: 99999;
                justify-content: center;
                align-items: center;
                backdrop-filter: blur(4px);
            }

                .spinner-overlay.active {
                    display: flex;
                }

            .spinner-box {
                background: var(--white);
                border-radius: var(--radius-sm);
                padding: 2rem 3rem;
                text-align: center;
                box-shadow: var(--shadow-xl);
            }

                .spinner-box .spinner {
                    width: 48px;
                    height: 48px;
                    border: 4px solid var(--gray-light);
                    border-top-color: var(--primary);
                    border-radius: 50%;
                    animation: spin 0.8s linear infinite;
                    margin: 0 auto 1rem;
                }

            @@keyframes spin {
                to {
                    transform: rotate(360deg);
                }
            }

            .spinner-box p {
                margin: 0;
                font-weight: 600;
                color: var(--dark);
            }

            /* ────────────────────────────────────────────────────────── */
            /* Responsive                                               */
            /* ────────────────────────────────────────────────────────── */
            @@media (max-width: 992px) {
                .header-premium {
                    padding: 2rem 1.5rem 1.5rem;
                }

                .body-content {
                    padding: 1.5rem 1.5rem 2rem;
                }
            }

            @@media (max-width: 768px) {
                body {
                    padding: 1rem 0.75rem;
                }

                .create-wrapper {
                    border-radius: var(--radius-sm);
                }

                .header-premium {
                    padding: 1.5rem 1.25rem 1.25rem;
                }

                .header-title h1 {
                    font-size: 1.3rem;
                }

                .header-title .icon-wrapper {
                    width: 44px;
                    height: 44px;
                    font-size: 1.3rem;
                }

                .header-title .subtitle {
                    font-size: 0.75rem;
                    padding: 0.15rem 0.75rem;
                }

                .header-content {
                    flex-direction: column;
                    align-items: flex-start;
                }

                .header-actions {
                    width: 100%;
                    justify-content: flex-start;
                }

                .body-content {
                    padding: 1rem 1rem 1.5rem;
                }

                .form-card {
                    padding: 1.25rem 1rem;
                    border-radius: var(--radius-xs);
                }

                    .form-card .card-header-custom {
                        font-size: 0.95rem;
                    }

                .form-group .form-control,
                .form-group .form-select {
                    font-size: 0.85rem;
                    padding: 0.5rem 0.75rem;
                }

                .action-footer {
                    flex-direction: column;
                    align-items: stretch;
                }

                    .action-footer .btn {
                        justify-content: center;
                        padding: 0.6rem 1.2rem;
                    }

                .toast-custom {
                    min-width: 250px;
                    margin: 0 0.5rem 0.75rem;
                }
            }

            @@media (max-width: 480px) {
                body {
                    padding: 0.5rem 0.5rem;
                }

                .header-premium {
                    padding: 1rem 1rem 1rem;
                    border-radius: var(--radius-xs) var(--radius-xs) 0 0;
                }

                .header-title h1 {
                    font-size: 1.1rem;
                }

                .header-title .icon-wrapper {
                    width: 36px;
                    height: 36px;
                    font-size: 1rem;
                }

                .body-content {
                    padding: 0.75rem 0.75rem 1rem;
                }

                .form-card {
                    padding: 1rem 0.75rem;
                }

                .form-group label {
                    font-size: 0.8rem;
                }

                .form-group .form-control,
                .form-group .form-select {
                    font-size: 0.8rem;
                    padding: 0.4rem 0.6rem;
                }

                .action-footer .btn {
                    font-size: 0.8rem;
                    padding: 0.5rem 1rem;
                }

                .toast-custom {
                    min-width: 200px;
                    padding: 0.75rem 1rem;
                }
            }
    </style>
</head>
<body>

    <!-- ─── Toast Container ─── -->
    <div class="toast-container" id="toastContainer"></div>

    <!-- ─── Loading Spinner ─── -->
    <div class="spinner-overlay" id="spinnerOverlay">
        <div class="spinner-box">
            <div class="spinner"></div>
            <p>Creating Job Card...</p>
        </div>
    </div>

    <div class="create-wrapper">

        <!-- ─── HEADER ─── -->
        <div class="header-premium">
            <div class="header-content">
                <div class="header-title">
                    <div class="icon-wrapper">
                        <i class="bi bi-plus-circle"></i>
                    </div>
                    <div>
                        <h1>Create Job Card</h1>
                        <span class="subtitle">New Job Card Entry</span>
                    </div>
                </div>
                <div class="header-actions">
                    <a asp-action="Index" class="btn-header">
                        <i class="bi bi-arrow-left"></i> Back to List
                    </a>
                </div>
            </div>
        </div>

        <!-- ─── BODY ─── -->
        <div class="body-content">

            <!-- Alerts -->
            @if (TempData["Error"] != null)
            {
                <div class="alert-custom alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-circle-fill me-2"></i>
                    @TempData["Error"]
                    <button type="button" class="btn-close float-end" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @if (TempData["Success"] != null)
            {
                <div class="alert-custom alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i>
                    @TempData["Success"]
                    <button type="button" class="btn-close float-end" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <!-- ─── Form ─── -->
            <div class="form-card">
                <div class="card-header-custom">
                    <i class="bi bi-card-checklist"></i>
                    Job Card Information
                    <span class="badge bg-success text-white ms-auto">New</span>
                </div>

                <form asp-action="Create" method="post" id="createForm" novalidate>
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

                    <div class="row g-3">

                        <!-- Booking Selection -->
                        <div class="col-md-6 form-group">
                            <label asp-for="BookingId" class="control-label">
                                <i class="bi bi-calendar-check me-1"></i> Booking
                                <span class="required">*</span>
                            </label>
                            <select asp-for="BookingId" class="form-select" asp-items="Model.AvailableBookings">
                                <option value="">— Select Booking —</option>
                            </select>
                            <span asp-validation-for="BookingId" class="text-danger"></span>
                            <span class="form-text">Select a completed booking to create a job card.</span>
                        </div>

                        <!-- Inspection Date -->
                        <div class="col-md-6 form-group">
                            <label asp-for="InspectionDate" class="control-label">
                                <i class="bi bi-calendar3 me-1"></i> Inspection Date
                                <span class="required">*</span>
                            </label>
                            <input asp-for="InspectionDate" type="datetime-local" class="form-control" />
                            <span asp-validation-for="InspectionDate" class="text-danger"></span>
                            <span class="form-text">Date and time of vehicle inspection.</span>
                        </div>

                        <!-- Estimated Cost -->
                        <div class="col-md-6 form-group">
                            <label asp-for="EstimatedCost" class="control-label">
                                <i class="bi bi-currency-rupee me-1"></i> Estimated Cost
                                <span class="required">*</span>
                            </label>
                            <input asp-for="EstimatedCost" class="form-control" type="number" step="0.01" placeholder="0.00" />
                            <span asp-validation-for="EstimatedCost" class="text-danger"></span>
                            <span class="form-text">Initial estimated cost for the job.</span>
                        </div>

                        <!-- Actual Cost -->
                        <div class="col-md-6 form-group">
                            <label asp-for="ActualCost" class="control-label">
                                <i class="bi bi-cash-stack me-1"></i> Actual Cost
                            </label>
                            <input asp-for="ActualCost" class="form-control" type="number" step="0.01" placeholder="0.00" />
                            <span asp-validation-for="ActualCost" class="text-danger"></span>
                            <span class="form-text">Leave as 0 if not yet finalized.</span>
                        </div>

                        <!-- Checklist -->
                        <div class="col-12 form-group">
                            <label asp-for="Checklist" class="control-label">
                                <i class="bi bi-list-check me-1"></i> Inspection Checklist
                            </label>
                            <textarea asp-for="Checklist" class="form-control" rows="3" placeholder="Enter inspection checklist items (one per line)"></textarea>
                            <span asp-validation-for="Checklist" class="text-danger"></span>
                            <span class="form-text">List all inspection items that need to be checked.</span>
                        </div>

                        <!-- Mechanic Notes -->
                        <div class="col-12 form-group">
                            <label asp-for="MechanicNotes" class="control-label">
                                <i class="bi bi-sticky-fill me-1"></i> Mechanic Notes
                            </label>
                            <textarea asp-for="MechanicNotes" class="form-control" rows="3" placeholder="Enter mechanic notes and observations"></textarea>
                            <span asp-validation-for="MechanicNotes" class="text-danger"></span>
                            <span class="form-text">Add any notes from the mechanic about the job.</span>
                        </div>

                        <!-- Work Performed -->
                        <div class="col-12 form-group">
                            <label asp-for="WorkPerformed" class="control-label">
                                <i class="bi bi-tools me-1"></i> Work Performed
                            </label>
                            <textarea asp-for="WorkPerformed" class="form-control" rows="3" placeholder="Enter details of work performed (optional)"></textarea>
                            <span asp-validation-for="WorkPerformed" class="text-danger"></span>
                            <span class="form-text">Describe the actual work done on the vehicle.</span>
                        </div>

                    </div>

                    <!-- ─── Action Buttons ─── -->
                    <div class="action-footer">
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-x-circle"></i> Cancel
                        </a>
                        <button type="submit" class="btn btn-success" id="submitBtn">
                            <i class="bi bi-check2-circle"></i> Create Job Card
                        </button>
                    </div>
                </form>
            </div>

        </div> <!-- /body-content -->
    </div> <!-- /create-wrapper -->
    <!-- ─── Validation Scripts ─── -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <script>
            $(function() {
                // ─── Toast Notification ───
                function showToast(message, type) {
                    var container = document.getElementById('toastContainer');
                    var toast = document.createElement('div');
                    toast.className = 'toast-custom ' + (type || 'success');
                    toast.innerHTML = `
                                <div class="toast-title">
                                    <i class="bi ${type === 'error' ? 'bi-exclamation-circle-fill text-danger' : 'bi-check-circle-fill text-success'}"></i>
                                    ${type === 'error' ? 'Error' : 'Success'}
                                </div>
                                <div class="toast-message">${message}</div>
                            `;
                    container.appendChild(toast);

                    setTimeout(function() {
                        toast.style.opacity = '0';
                        toast.style.transform = 'translateX(100px)';
                        toast.style.transition = '0.5s ease-out';
                        setTimeout(function() { toast.remove(); }, 500);
                    }, 5000);
                }

                // ─── Show TempData Messages ───
                @if (TempData["Error"] != null)
                    {
                        <text>showToast('@TempData["Error"]', 'error');</text>
                }

                    @if (TempData["Success"] != null)
                    {
                        <text>showToast('@TempData["Success"]', 'success');</text>
                }

                    // ─── Form Submission ───
                    $('#createForm').on('submit', function(e) {
                        // Show spinner
                        $('#spinnerOverlay').addClass('active');
                        $('#submitBtn').prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-2"></span> Creating...');
                        return true;
                    });

                // ─── Auto-dismiss alerts ───
                setTimeout(function() {
                    $('.alert-custom').alert('close');
                }, 5000);
            });
    </script>

</body>
</html>