@model Vehicle_Service_Management_System.Application.ViewModels.JobCard.JobCardCreateViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Job Card | Vehicle Service Management</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
            body {
                background: #f4f6fa;
                font-family: 'Segoe UI', sans-serif;
                padding: 2rem 1.5rem;
            }

            .card {
                border-radius: 16px;
                box-shadow: 0 16px 48px rgba(0,0,0,0.14);
            }

            .card-header {
                border-radius: 16px 16px 0 0;
                background: linear-gradient(135deg, #0d6efd, #0a58ca);
            }

                .card-header h3 {
                    font-weight: 600;
                }

            .form-label {
                font-weight: 500;
                color: #2d3748;
            }

            .form-control, .form-select {
                border-radius: 10px;
                border: 1px solid #dce2ec;
                padding: 0.6rem 1rem;
                transition: 0.25s ease;
            }

                .form-control:focus, .form-select:focus {
                    border-color: #0d6efd;
                    box-shadow: 0 0 0 4px rgba(13, 110, 253, 0.12);
                }

            .text-danger {
                font-size: 0.8rem;
            }

            .btn-success {
                background: linear-gradient(135deg, #198754, #157347);
                border: none;
                padding: 0.6rem 1.8rem;
                font-weight: 600;
                border-radius: 50px;
                box-shadow: 0 4px 14px rgba(25, 135, 84, 0.30);
            }

                .btn-success:hover {
                    transform: translateY(-2px);
                    box-shadow: 0 8px 24px rgba(25, 135, 84, 0.40);
                }

            .btn-secondary {
                border-radius: 50px;
                padding: 0.6rem 1.8rem;
                font-weight: 500;
                border-color: #d1d9e6;
            }

                .btn-secondary:hover {
                    background: #eef2f7;
                    border-color: #b0bcca;
                }

            .validation-summary-errors {
                background: #fee2e2;
                border: 1px solid #fca5a5;
                border-radius: 10px;
                padding: 0.75rem 1rem;
                margin-bottom: 1.5rem;
                color: #991b1b;
            }

                .validation-summary-errors ul {
                    margin: 0;
                    padding-left: 1.2rem;
                }

            small.text-muted {
                font-size: 0.75rem;
                color: #6b7a8e;
            }
    </style>
</head>
<body>
    <div class="container mt-4">
        <div class="card shadow">
            <div class="card-header bg-primary text-white">
                <h3 class="mb-0"><i class="bi bi-plus-circle"></i> Create Job Card</h3>
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="BookingId" class="form-label">Booking</label>
                            <select asp-for="BookingId" class="form-select" asp-items="Model.AvailableBookings">
                                <option value="">— Select Booking —</option>
                            </select>
                            <span asp-validation-for="BookingId" class="text-danger"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="InspectionDate" class="form-label">Inspection Date</label>
                            <input asp-for="InspectionDate" type="datetime-local" class="form-control" />
                            <span asp-validation-for="InspectionDate" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Checklist" class="form-label">Checklist</label>
                        <textarea asp-for="Checklist" class="form-control" rows="3" placeholder="Enter inspection checklist"></textarea>
                        <span asp-validation-for="Checklist" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="MechanicNotes" class="form-label">Mechanic Notes</label>
                        <textarea asp-for="MechanicNotes" class="form-control" rows="4" placeholder="Enter mechanic notes"></textarea>
                        <span asp-validation-for="MechanicNotes" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="WorkPerformed" class="form-label">Work Performed</label>
                        <textarea asp-for="WorkPerformed" class="form-control" rows="4" placeholder="Describe work performed (Optional)"></textarea>
                        <span asp-validation-for="WorkPerformed" class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="EstimatedCost" class="form-label">Estimated Cost</label>
                            <input asp-for="EstimatedCost" class="form-control" type="number" step="0.01" />
                            <span asp-validation-for="EstimatedCost" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="ActualCost" class="form-label">Actual Cost</label>
                            <input asp-for="ActualCost" class="form-control" type="number" step="0.01" placeholder="0.00" />
                            <span asp-validation-for="ActualCost" class="text-danger"></span>
                            <small class="text-muted">Leave empty to set later.</small>
                        </div>
                    </div>

                    <div class="mt-4 d-flex gap-2">
                        <button type="submit" class="btn btn-success"><i class="bi bi-check-circle"></i> Save Job Card</button>
                        <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left"></i> Back</a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>