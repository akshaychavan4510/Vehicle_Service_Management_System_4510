@model Vehicle_Service_Management_System.Application.ViewModels.JobCard.JobCardUpdateViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Job Card | Vehicle Service Management</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
            :root {
                --primary-gradient: linear-gradient(135deg, #0d6efd, #0a58ca);
                --shadow-sm: 0 2px 8px rgba(0, 0, 0, 0.06);
                --shadow-md: 0 8px 30px rgba(0, 0, 0, 0.10);
                --shadow-lg: 0 16px 48px rgba(0, 0, 0, 0.14);
                --radius: 16px;
                --radius-sm: 10px;
                --transition: 0.25s ease;
            }

            body {
                background: #f4f6fa;
                font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
                padding: 2rem 1.5rem;
                min-height: 100vh;
                display: flex;
                align-items: flex-start;
                justify-content: center;
            }

            .edit-wrapper {
                max-width: 1000px;
                width: 100%;
                background: #ffffff;
                border-radius: var(--radius);
                box-shadow: var(--shadow-lg);
                padding: 2rem 2.5rem 2.5rem;
                transition: var(--transition);
            }

            @@media (max-width: 576px) {
                body {
                    padding: 1rem 0.75rem;
                }

                .edit-wrapper {
                    padding: 1.25rem 1rem 1.75rem;
                    border-radius: var(--radius-sm);
                }
            }

            /* ── Header ── */
            .page-header {
                display: flex;
                flex-wrap: wrap;
                align-items: center;
                justify-content: space-between;
                gap: 1rem;
                margin-bottom: 1.75rem;
            }

                .page-header h1 {
                    font-weight: 700;
                    font-size: 1.85rem;
                    letter-spacing: -0.02em;
                    color: #1a2634;
                    margin: 0;
                    display: flex;
                    align-items: center;
                    gap: 0.5rem;
                }

                    .page-header h1 i {
                        color: #fbbf24;
                        font-size: 2rem;
                    }

                .page-header .btn-outline-secondary {
                    border-radius: 50px;
                    padding: 0.5rem 1.2rem;
                    font-weight: 500;
                    border-color: #d1d9e6;
                    transition: var(--transition);
                    display: inline-flex;
                    align-items: center;
                    gap: 0.4rem;
                }

                    .page-header .btn-outline-secondary:hover {
                        background: #eef2f7;
                        border-color: #b0bcca;
                    }

            /* ── Form Card ── */
            .form-card {
                background: #f9fafc;
                border-radius: var(--radius-sm);
                padding: 1.75rem 2rem;
                box-shadow: var(--shadow-sm);
                border: 1px solid #eef2f7;
            }

            .form-floating-custom .form-control,
            .form-floating-custom .form-select,
            .form-floating-custom textarea {
                border-radius: 10px;
                border: 1px solid #dce2ec;
                padding: 0.6rem 1rem;
                transition: var(--transition);
            }

                .form-floating-custom .form-control:focus,
                .form-floating-custom .form-select:focus,
                .form-floating-custom textarea:focus {
                    border-color: #0d6efd;
                    box-shadow: 0 0 0 4px rgba(13, 110, 253, 0.12);
                }

            .form-floating-custom label {
                font-weight: 500;
                color: #2d3748;
                margin-bottom: 0.3rem;
            }

            .form-floating-custom .text-danger {
                font-size: 0.8rem;
                margin-top: 0.2rem;
            }

            .form-floating-custom .form-control[readonly] {
                background-color: #eef2f7;
                cursor: not-allowed;
            }

            /* ── Buttons ── */
            .btn-success {
                background: #22c55e;
                border: none;
                padding: 0.6rem 1.8rem;
                font-weight: 600;
                border-radius: 50px;
                box-shadow: 0 4px 14px rgba(34, 197, 94, 0.30);
                transition: var(--transition);
                display: inline-flex;
                align-items: center;
                gap: 0.5rem;
            }

                .btn-success:hover {
                    transform: translateY(-2px);
                    box-shadow: 0 8px 24px rgba(34, 197, 94, 0.40);
                }

            .btn-secondary {
                border-radius: 50px;
                padding: 0.6rem 1.8rem;
                font-weight: 500;
                border-color: #d1d9e6;
                transition: var(--transition);
            }

                .btn-secondary:hover {
                    background: #eef2f7;
                    border-color: #b0bcca;
                }

            /* ── Validation summary ── */
            .validation-summary-errors {
                background: #fee2e2;
                border: 1px solid #fca5a5;
                border-radius: 10px;
                padding: 0.75rem 1rem;
                margin-bottom: 1.5rem;
                color: #991b1b;
            }

                .validation-summary-errors ul {
                    margin: 0;
                    padding-left: 1.2rem;
                }

            /* ── Responsive tweaks ── */
            @@media (max-width: 576px) {
                .page-header h1 {
                    font-size: 1.4rem;
                }

                    .page-header h1 i {
                        font-size: 1.5rem;
                    }

                .form-card {
                    padding: 1.25rem 1rem;
                }

                .d-flex.justify-content-between {
                    flex-direction: column-reverse;
                    gap: 0.75rem;
                    align-items: stretch;
                }

                    .d-flex.justify-content-between .btn {
                        width: 100%;
                        justify-content: center;
                    }
            }
    </style>
</head>
<body>

    <div class="edit-wrapper">

        <!-- ─── HEADER ─── -->
        <div class="page-header">
            <h1>
                <i class="bi bi-pencil-square"></i>
                Edit Job Card
            </h1>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Back to List
            </a>
        </div>

        <!-- ─── FORM ─── -->
        <div class="form-card">
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input asp-for="Id" type="hidden" />

                <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

                <div class="row g-3">

                    <!-- Job Card Number (readonly) -->
                    <div class="col-md-6 form-floating-custom">
                        <label asp-for="JobCardNumber" class="form-label"></label>
                        <input asp-for="JobCardNumber" class="form-control" readonly />
                    </div>

                    <!-- Inspection Date -->
                    <div class="col-md-6 form-floating-custom">
                        <label asp-for="InspectionDate" class="form-label"></label>
                        <input asp-for="InspectionDate" type="datetime-local" class="form-control" />
                        <span asp-validation-for="InspectionDate" class="text-danger"></span>
                    </div>

                    <!-- Estimated Cost -->
                    <div class="col-md-6 form-floating-custom">
                        <label asp-for="EstimatedCost" class="form-label"></label>
                        <input asp-for="EstimatedCost" class="form-control" type="number" step="0.01" placeholder="0.00" />
                        <span asp-validation-for="EstimatedCost" class="text-danger"></span>
                    </div>

                    <!-- Actual Cost -->
                    <div class="col-md-6 form-floating-custom">
                        <label asp-for="ActualCost" class="form-label"></label>
                        <input asp-for="ActualCost" class="form-control" type="number" step="0.01" placeholder="0.00" />
                        <span asp-validation-for="ActualCost" class="text-danger"></span>
                    </div>

                    <!-- Status -->
                    <div class="col-md-12 form-floating-custom">
                        <label asp-for="Status" class="form-label"></label>
                        <select asp-for="Status" class="form-select">
                            <option value="Pending">Pending</option>
                            <option value="InProgress">In Progress</option>
                            <option value="Completed">Completed</option>
                            <option value="Cancelled">Cancelled</option>
                        </select>
                        <span asp-validation-for="Status" class="text-danger"></span>
                    </div>

                    <!-- Checklist -->
                    <div class="col-12 form-floating-custom">
                        <label asp-for="Checklist" class="form-label"></label>
                        <textarea asp-for="Checklist" class="form-control" rows="3" placeholder="Enter inspection checklist items"></textarea>
                        <span asp-validation-for="Checklist" class="text-danger"></span>
                    </div>

                    <!-- Mechanic Notes -->
                    <div class="col-12 form-floating-custom">
                        <label asp-for="MechanicNotes" class="form-label"></label>
                        <textarea asp-for="MechanicNotes" class="form-control" rows="3" placeholder="Enter mechanic notes"></textarea>
                        <span asp-validation-for="MechanicNotes" class="text-danger"></span>
                    </div>

                    <!-- Work Performed -->
                    <div class="col-12 form-floating-custom">
                        <label asp-for="WorkPerformed" class="form-label"></label>
                        <textarea asp-for="WorkPerformed" class="form-control" rows="3" placeholder="Enter work performed details"></textarea>
                        <span asp-validation-for="WorkPerformed" class="text-danger"></span>
                    </div>

                </div>

                <hr class="my-4" />

                <div class="d-flex flex-wrap gap-2 justify-content-between align-items-center">
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="bi bi-x-lg"></i> Cancel
                    </a>
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-check-lg"></i> Update Job Card
                    </button>
                </div>
            </form>
        </div>

    </div> <!-- /.edit-wrapper -->
    <!-- ─── Validation Scripts ─── -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>