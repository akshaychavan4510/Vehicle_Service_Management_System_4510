@model Vehicle_Service_Management_System.Application.ViewModels.JobCard.JobCardDetailsViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Job Card Details | Vehicle Service Management</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
            :root {
                --primary-gradient: linear-gradient(135deg, #0d6efd, #0a58ca);
                --shadow-sm: 0 2px 8px rgba(0, 0, 0, 0.06);
                --shadow-md: 0 8px 30px rgba(0, 0, 0, 0.10);
                --shadow-lg: 0 16px 48px rgba(0, 0, 0, 0.14);
                --radius: 16px;
                --radius-sm: 10px;
                --transition: 0.25s ease;
            }

            body {
                background: #f4f6fa;
                font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
                padding: 2rem 1.5rem;
                min-height: 100vh;
                display: flex;
                align-items: flex-start;
                justify-content: center;
            }

            .details-wrapper {
                max-width: 1200px;
                width: 100%;
                background: #ffffff;
                border-radius: var(--radius);
                box-shadow: var(--shadow-lg);
                padding: 2rem 2.5rem 2.5rem;
                transition: var(--transition);
            }

            @@media (max-width: 576px) {
                body {
                    padding: 1rem 0.75rem;
                }

                .details-wrapper {
                    padding: 1.25rem 1rem 1.75rem;
                    border-radius: var(--radius-sm);
                }
            }

            .page-header {
                display: flex;
                flex-wrap: wrap;
                align-items: center;
                justify-content: space-between;
                gap: 1rem;
                margin-bottom: 1.75rem;
            }

                .page-header h1 {
                    font-weight: 700;
                    font-size: 1.85rem;
                    letter-spacing: -0.02em;
                    color: #1a2634;
                    margin: 0;
                    display: flex;
                    align-items: center;
                    gap: 0.5rem;
                }

                    .page-header h1 i {
                        color: #0d6efd;
                        font-size: 2rem;
                    }

                .page-header .btn-outline-secondary {
                    border-radius: 50px;
                    padding: 0.5rem 1.2rem;
                    font-weight: 500;
                    border-color: #d1d9e6;
                    transition: var(--transition);
                    display: inline-flex;
                    align-items: center;
                    gap: 0.4rem;
                }

                    .page-header .btn-outline-secondary:hover {
                        background: #eef2f7;
                        border-color: #b0bcca;
                    }

            .alert {
                border-radius: var(--radius-sm);
                border: none;
                box-shadow: var(--shadow-sm);
            }

            .alert-success {
                background: #dcfce7;
                color: #166534;
            }

            .alert-danger {
                background: #fee2e2;
                color: #991b1b;
            }

            .alert i {
                margin-right: 0.5rem;
            }

            .detail-card {
                background: #f9fafc;
                border-radius: var(--radius-sm);
                padding: 1.5rem 1.75rem;
                box-shadow: var(--shadow-sm);
                border: 1px solid #eef2f7;
                margin-bottom: 1.5rem;
            }

            .detail-grid {
                display: grid;
                grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
                gap: 1rem 1.8rem;
            }

            .detail-item {
                display: flex;
                flex-direction: column;
            }

                .detail-item .label {
                    font-size: 0.75rem;
                    text-transform: uppercase;
                    letter-spacing: 0.05em;
                    color: #6b7a8e;
                    font-weight: 600;
                }

                .detail-item .value {
                    font-size: 1.05rem;
                    font-weight: 500;
                    color: #1a2634;
                    word-break: break-word;
                }

                    .detail-item .value .badge-status {
                        font-weight: 500;
                        padding: 0.3rem 0.9rem;
                        border-radius: 50px;
                        font-size: 0.8rem;
                        display: inline-flex;
                        align-items: center;
                        gap: 0.4rem;
                    }

            .badge-status.bg-success {
                background: #dcfce7 !important;
                color: #166534;
            }

            .badge-status.bg-danger {
                background: #fee2e2 !important;
                color: #991b1b;
            }

            .badge-status.bg-warning {
                background: #fef3c7 !important;
                color: #b45309;
            }

            .badge-status.bg-info {
                background: #e0f2fe !important;
                color: #0369a1;
            }

            .badge-status.bg-primary {
                background: #dbeafe !important;
                color: #1d4ed8;
            }

            .badge-status i {
                font-size: 0.7rem;
            }

            .text-block {
                background: #ffffff;
                border-radius: 10px;
                padding: 1rem 1.25rem;
                border: 1px solid #eef2f7;
                min-height: 60px;
                color: #1a2634;
                font-weight: 400;
            }

                .text-block.empty {
                    color: #94a3b8;
                    font-style: italic;
                }

            .section-title {
                font-weight: 600;
                font-size: 1.1rem;
                color: #2d3748;
                margin-bottom: 0.5rem;
                display: flex;
                align-items: center;
                gap: 0.5rem;
            }

                .section-title i {
                    color: #0d6efd;
                }

            .action-footer {
                display: flex;
                flex-wrap: wrap;
                gap: 0.75rem;
                margin-top: 1.75rem;
                align-items: center;
                justify-content: flex-end;
            }

                .action-footer .btn {
                    border-radius: 50px;
                    padding: 0.5rem 1.5rem;
                    font-weight: 500;
                    transition: var(--transition);
                    display: inline-flex;
                    align-items: center;
                    gap: 0.5rem;
                }

                .action-footer .btn-warning {
                    background: #fbbf24;
                    border: none;
                    color: #1a2634;
                    box-shadow: 0 4px 14px rgba(251, 191, 36, 0.30);
                }

                    .action-footer .btn-warning:hover {
                        transform: translateY(-2px);
                        box-shadow: 0 8px 24px rgba(251, 191, 36, 0.40);
                    }

                .action-footer .btn-secondary {
                    border-color: #d1d9e6;
                }

                    .action-footer .btn-secondary:hover {
                        background: #eef2f7;
                        border-color: #b0bcca;
                    }

                .action-footer .btn-dark {
                    background: #1a2634;
                    border: none;
                    box-shadow: 0 4px 14px rgba(26, 38, 52, 0.30);
                }

                    .action-footer .btn-dark:hover {
                        transform: translateY(-2px);
                        box-shadow: 0 8px 24px rgba(26, 38, 52, 0.40);
                    }

            @@media (max-width: 576px) {
                .detail-grid {
                    grid-template-columns: 1fr;
                    gap: 0.8rem;
                }

                .action-footer {
                    flex-direction: column;
                    align-items: stretch;
                }

                    .action-footer .btn {
                        justify-content: center;
                    }

                .page-header h1 {
                    font-size: 1.4rem;
                }

                    .page-header h1 i {
                        font-size: 1.5rem;
                    }
            }
    </style>
</head>
<body>

    <div class="details-wrapper">

        <!-- ─── HEADER ─── -->
        <div class="page-header">
            <h1>
                <i class="bi bi-card-checklist"></i>
                Job Card Details
            </h1>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Back to List
            </a>
        </div>

        <!-- ─── ALERTS ─── -->
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle-fill"></i> @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-circle-fill"></i> @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <!-- ─── DETAIL CARD ─── -->
        <div class="detail-card">
            <div class="detail-grid">
                <div class="detail-item">
                    <span class="label">Job Card Number</span>
                    <span class="value">@Model.JobCardNumber</span>
                </div>
                <div class="detail-item">
                    <span class="label">Booking ID</span>
                    <span class="value">@Model.BookingId</span>
                </div>
                <div class="detail-item">
                    <span class="label">Customer</span>
                    <span class="value">@Model.CustomerName</span>
                </div>
                <div class="detail-item">
                    <span class="label">Phone</span>
                    <span class="value">@Model.PhoneNumber</span>
                </div>
                <div class="detail-item">
                    <span class="label">Vehicle</span>
                    <span class="value">@Model.VehicleRegistrationNumber</span>
                </div>
                <div class="detail-item">
                    <span class="label">Mechanic</span>
                    <span class="value">@Model.MechanicName</span>
                </div>
                <div class="detail-item">
                    <span class="label">Service Type</span>
                    <span class="value">@Model.ServicesSummary</span>
                </div>
                <div class="detail-item">
                    <span class="label">Inspection Date</span>
                    <span class="value">@(Model.InspectionDate?.ToString("dd/MM/yyyy HH:mm") ?? "—")</span>
                </div>
                <div class="detail-item">
                    <span class="label">Estimated Cost</span>
                    <span class="value">@Model.EstimatedCost.ToString("C")</span>
                </div>
                <div class="detail-item">
                    <span class="label">Actual Cost</span>
                    <span class="value">@Model.ActualCost.ToString("C")</span>
                </div>
                <!-- ❌ Removed "Total" row – property does not exist in ViewModel -->
                <div class="detail-item">
                    <span class="label">Status</span>
                    <span class="value">
                        <span class="badge-status @Model.StatusBadge">
                            @if (Model.Status == "Completed")
                            {
                                <i class="bi bi-check-circle-fill"></i>
                            }
                            else if (Model.Status == "InProgress")
                            {
                                <i class="bi bi-arrow-repeat"></i>
                            }
                            else if (Model.Status == "Pending")
                            {
                                <i class="bi bi-clock-fill"></i>
                            }
                            @Model.Status
                        </span>
                    </span>
                </div>
                <div class="detail-item">
                    <span class="label">Created</span>
                    <span class="value">@Model.CreatedOn.ToString("dd/MM/yyyy HH:mm")</span>
                </div>
                <div class="detail-item">
                    <span class="label">Last Modified</span>
                    <span class="value">@(Model.ModifiedOn?.ToString("dd/MM/yyyy HH:mm") ?? "—")</span>
                </div>
            </div>
        </div>

        <!-- ─── CHECKLIST ─── -->
        <div class="mb-3">
            <div class="section-title">
                <i class="bi bi-list-check"></i> Inspection Checklist
            </div>
            <div class="text-block @(string.IsNullOrWhiteSpace(Model.Checklist) ? "empty" : "")">
                @(string.IsNullOrWhiteSpace(Model.Checklist) ? "No checklist available." : Model.Checklist)
            </div>
        </div>

        <!-- ─── MECHANIC NOTES ─── -->
        <div class="mb-3">
            <div class="section-title">
                <i class="bi bi-sticky-fill"></i> Mechanic Notes
            </div>
            <div class="text-block @(string.IsNullOrWhiteSpace(Model.MechanicNotes) ? "empty" : "")">
                @(string.IsNullOrWhiteSpace(Model.MechanicNotes) ? "No mechanic notes." : Model.MechanicNotes)
            </div>
        </div>

        <!-- ─── WORK PERFORMED ─── -->
        <div class="mb-4">
            <div class="section-title">
                <i class="bi bi-tools"></i> Work Performed
            </div>
            <div class="text-block @(string.IsNullOrWhiteSpace(Model.WorkPerformed) ? "empty" : "")">
                @(string.IsNullOrWhiteSpace(Model.WorkPerformed) ? "Work not updated yet." : Model.WorkPerformed)
            </div>
        </div>

        <!-- ─── ACTION BUTTONS ─── -->
        <div class="action-footer">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                <i class="bi bi-pencil"></i> Edit
            </a>
            <a asp-action="Index" class="btn btn-dark">
                <i class="bi bi-arrow-left"></i> Back
            </a>
        </div>

    </div> <!-- /.details-wrapper -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Auto‑dismiss alerts after 4 seconds
        setTimeout(function () {
        let alerts = document.querySelectorAll(".alert");
        alerts.forEach(function (alert) {
        let bsAlert = bootstrap.Alert.getOrCreateInstance(alert);
        bsAlert.close();
        });
        }, 4000);
    </script>
</body>
</html>