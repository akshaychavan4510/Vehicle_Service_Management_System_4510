@model Vehicle_Service_Management_System.Application.ViewModels.JobCard.JobCardPrintViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Job Card #@Model.JobCardNumber | Print</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
            /* ── Base Styles ── */
            body {
                background: #ffffff;
                font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
                padding: 2rem;
                color: #1a2634;
            }

            .print-wrapper {
                max-width: 1000px;
                margin: 0 auto;
            }

            /* ── Header ── */
            .header {
                border-bottom: 3px solid #0d6efd;
                padding-bottom: 0.8rem;
                margin-bottom: 1.5rem;
                display: flex;
                flex-wrap: wrap;
                justify-content: space-between;
                align-items: center;
                gap: 0.75rem;
            }

            .header-left {
                display: flex;
                align-items: center;
                gap: 0.75rem;
                flex-wrap: wrap;
            }

                .header-left h1 {
                    font-size: 1.8rem;
                    font-weight: 700;
                    margin: 0;
                    color: #0d6efd;
                }

                .header-left .job-card-number {
                    font-size: 1.2rem;
                    font-weight: 600;
                }

            .header-right {
                display: flex;
                align-items: center;
                gap: 0.75rem;
                flex-wrap: wrap;
            }

            .badge-status {
                font-weight: 500;
                padding: 0.3rem 0.9rem;
                border-radius: 50px;
                font-size: 0.8rem;
                display: inline-block;
            }

                .badge-status.bg-success {
                    background: #dcfce7 !important;
                    color: #166534;
                }

                .badge-status.bg-danger {
                    background: #fee2e2 !important;
                    color: #991b1b;
                }

                .badge-status.bg-warning {
                    background: #fef3c7 !important;
                    color: #b45309;
                }

                .badge-status.bg-info {
                    background: #e0f2fe !important;
                    color: #0369a1;
                }

                .badge-status.bg-secondary {
                    background: #e2e8f0 !important;
                    color: #4a5568;
                }

            .btn-print {
                border-radius: 50px;
                padding: 0.3rem 1rem;
                font-weight: 500;
                font-size: 0.85rem;
                display: inline-flex;
                align-items: center;
                gap: 0.3rem;
            }

                .btn-print i {
                    font-size: 0.9rem;
                }

            /* ── Detail Grid ── */
            .detail-grid {
                display: grid;
                grid-template-columns: repeat(2, 1fr);
                gap: 1.5rem 2rem;
                background: #f8fafc;
                padding: 1.5rem;
                border-radius: 10px;
                border: 1px solid #eef2f7;
                margin-bottom: 2rem;
            }

            .detail-item {
                display: flex;
                flex-direction: column;
            }

                .detail-item .label {
                    font-size: 0.8rem;
                    text-transform: uppercase;
                    letter-spacing: 0.05em;
                    color: #6b7a8e;
                    font-weight: 600;
                }

                .detail-item .value {
                    font-size: 1.05rem;
                    font-weight: 500;
                    color: #1a2634;
                }

            /* ── Text Blocks ── */
            .section-title {
                font-weight: 600;
                font-size: 1.1rem;
                color: #2d3748;
                margin-top: 1.5rem;
                margin-bottom: 0.5rem;
                border-bottom: 2px solid #eef2f7;
                padding-bottom: 0.3rem;
            }

            .text-block {
                background: #ffffff;
                border-radius: 8px;
                padding: 1rem 1.25rem;
                border: 1px solid #eef2f7;
                min-height: 50px;
                margin-bottom: 1rem;
                color: #1a2634;
            }

                .text-block.empty {
                    color: #94a3b8;
                    font-style: italic;
                }

            /* ── Footer ── */
            .footer {
                margin-top: 2.5rem;
                border-top: 1px solid #e9edf4;
                padding-top: 1.5rem;
                text-align: center;
                color: #6b7a8e;
                font-size: 0.9rem;
            }

            /* ── Print-specific overrides ── */
            @@media print {
                .btn-print, .btn-outline-secondary {
                    display: none !important;
                }

                body {
                    padding: 0.5in;
                }

                .detail-grid {
                    border: none;
                    background: transparent;
                    padding: 0;
                }

                .text-block {
                    border: none;
                    background: transparent;
                    padding: 0.25rem 0;
                }

                .header {
                    border-bottom-color: #333;
                }

                .header-left h1 {
                    color: #000;
                }

                .badge-status {
                    border: 1px solid #ddd;
                }
            }

            /* ── Responsive (≤576px) ── */
            @@media (max-width: 576px) {
                body {
                    padding: 1rem;
                }

                .header {
                    flex-direction: column;
                    align-items: stretch;
                }

                .header-left {
                    justify-content: center;
                }

                .header-right {
                    justify-content: center;
                }

                .detail-grid {
                    grid-template-columns: 1fr;
                    gap: 1rem;
                    padding: 1rem;
                }

                .section-title {
                    font-size: 1rem;
                }

                .header-left h1 {
                    font-size: 1.5rem;
                }
            }
    </style>
</head>
<body>

    <div class="print-wrapper">

        <!-- ─── HEADER ─── -->
        <div class="header">
            <div class="header-left">
                <h1><i class="bi bi-card-checklist"></i> Job Card</h1>
                <span class="job-card-number">#@Model.JobCardNumber</span>
            </div>
            <div class="header-right">
                @{
                    string statusBadge = Model.Status switch
                    {
                        "Pending" => "bg-warning",
                        "InProgress" => "bg-info",
                        "Completed" => "bg-success",
                        "Cancelled" => "bg-danger",
                        _ => "bg-secondary"
                    };
                }
                <span class="badge-status @statusBadge">@Model.Status</span>
                <button class="btn btn-primary btn-print" onclick="window.print();">
                    <i class="bi bi-printer"></i> Print
                </button>
            </div>
            <a asp-action="Index" class="btn btn-outline-secondary btn-print">
                <i class="bi bi-arrow-left"></i> Back
            </a>
        </div>

        <!-- ─── DETAIL GRID ─── -->
        <div class="detail-grid">
            <div class="detail-item">
                <span class="label">Customer</span>
                <span class="value">@Model.CustomerName</span>
            </div>
            <div class="detail-item">
                <span class="label">Phone</span>
                <span class="value">@Model.PhoneNumber</span>
            </div>
            <div class="detail-item">
                <span class="label">Vehicle</span>
                <span class="value">@Model.VehicleRegistrationNumber</span>
            </div>
            <div class="detail-item">
                <span class="label">Mechanic</span>
                <span class="value">@Model.MechanicName</span>
            </div>
            <div class="detail-item">
                <span class="label">Service Type</span>
                <span class="value">@Model.ServicesSummary</span>
            </div>
            <div class="detail-item">
                <span class="label">Inspection Date</span>
                <span class="value">@(Model.InspectionDate?.ToString("dd/MM/yyyy HH:mm") ?? "—")</span>
            </div>
            <div class="detail-item">
                <span class="label">Estimated Cost</span>
                <span class="value">@Model.EstimatedCost.ToString("C")</span>
            </div>
            <div class="detail-item">
                <span class="label">Actual Cost</span>
                <span class="value">@Model.ActualCost.ToString("C")</span>
            </div>
            <div class="detail-item">
                <span class="label">Total</span>
                <span class="value"><strong>@Model.ActualCost.ToString("C")</strong></span>
            </div>
        </div>

        <!-- ─── CHECKLIST ─── -->
        <div class="section-title">
            <i class="bi bi-list-check"></i> Inspection Checklist
        </div>
        <div class="text-block @(string.IsNullOrWhiteSpace(Model.Checklist) ? "empty" : "")">
            @(string.IsNullOrWhiteSpace(Model.Checklist) ? "No checklist available." : Model.Checklist)
        </div>

        <!-- ─── MECHANIC NOTES ─── -->
        <div class="section-title">
            <i class="bi bi-sticky-fill"></i> Mechanic Notes
        </div>
        <div class="text-block @(string.IsNullOrWhiteSpace(Model.MechanicNotes) ? "empty" : "")">
            @(string.IsNullOrWhiteSpace(Model.MechanicNotes) ? "No mechanic notes." : Model.MechanicNotes)
        </div>

        <!-- ─── WORK PERFORMED ─── -->
        <div class="section-title">
            <i class="bi bi-tools"></i> Work Performed
        </div>
        <div class="text-block @(string.IsNullOrWhiteSpace(Model.WorkPerformed) ? "empty" : "")">
            @(string.IsNullOrWhiteSpace(Model.WorkPerformed) ? "Work not updated yet." : Model.WorkPerformed)
        </div>

        <!-- ─── FOOTER ─── -->
        <div class="footer">
            <small>Generated on @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</small>
        </div>

        <!-- ─── BOTTOM PRINT BUTTON ─── -->
        <div class="text-end mt-3">
            <button class="btn btn-primary btn-print" onclick="window.print();">
                <i class="bi bi-printer"></i> Print Job Card
            </button>
        </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>