@model Vehicle_Service_Management_System.Application.ViewModels.Report.MechanicReportViewModel

@{
    ViewData["Title"] = "Mechanic Performance Report";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mechanic Performance Report | Vehicle Service Management</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

    <style>
            /* ────────────────────────────────────────────────────────── */
            /* Root Variables                                          */
            /* ────────────────────────────────────────────────────────── */
            :root {
                --primary: #0d6efd;
                --primary-dark: #0a58ca;
                --primary-light: #e8f0fe;
                --success: #22c55e;
                --danger: #ef4444;
                --warning: #f59e0b;
                --info: #0dcaf0;
                --dark: #1a2634;
                --gray: #6b7a8e;
                --gray-light: #eef2f7;
                --gray-bg: #f0f2f5;
                --white: #ffffff;
                --shadow-sm: 0 2px 8px rgba(0, 0, 0, 0.04);
                --shadow-md: 0 8px 30px rgba(0, 0, 0, 0.08);
                --shadow-lg: 0 16px 48px rgba(0, 0, 0, 0.12);
                --shadow-xl: 0 24px 64px rgba(0, 0, 0, 0.16);
                --radius: 20px;
                --radius-sm: 12px;
                --radius-xs: 8px;
                --transition: 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            }

            /* ────────────────────────────────────────────────────────── */
            /* Base Styles                                             */
            /* ────────────────────────────────────────────────────────── */
            body {
                background: var(--gray-bg);
                font-family: 'Inter', -apple-system, system-ui, sans-serif;
                padding: 2rem 1.5rem;
                min-height: 100vh;
                display: flex;
                align-items: flex-start;
                justify-content: center;
                color: var(--dark);
                line-height: 1.6;
            }

            .report-wrapper {
                max-width: 1400px;
                width: 100%;
                background: var(--white);
                border-radius: var(--radius);
                box-shadow: var(--shadow-xl);
                overflow: hidden;
                animation: slideUp 0.5s ease-out;
            }

            @@keyframes slideUp {
                from {
                    opacity: 0;
                    transform: translateY(30px);
                }

                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            /* ────────────────────────────────────────────────────────── */
            /* Header - Premium Gradient                               */
            /* ────────────────────────────────────────────────────────── */
            .header-premium {
                background: linear-gradient(135deg, #0c0e1a 0%, #1a1a3e 40%, #ef4444 100%);
                padding: 2.5rem 3rem 2rem;
                color: #fff;
                position: relative;
                overflow: hidden;
            }

                .header-premium::before {
                    content: '';
                    position: absolute;
                    top: -60%;
                    right: -10%;
                    width: 500px;
                    height: 500px;
                    background: radial-gradient(circle, rgba(255, 255, 255, 0.06) 0%, transparent 70%);
                    border-radius: 50%;
                    pointer-events: none;
                }

                .header-premium::after {
                    content: '';
                    position: absolute;
                    bottom: -40%;
                    left: -5%;
                    width: 300px;
                    height: 300px;
                    background: radial-gradient(circle, rgba(239, 68, 68, 0.08) 0%, transparent 70%);
                    border-radius: 50%;
                    pointer-events: none;
                }

            .header-content {
                position: relative;
                z-index: 1;
                display: flex;
                flex-wrap: wrap;
                align-items: center;
                justify-content: space-between;
                gap: 1rem;
            }

            .header-title {
                display: flex;
                align-items: center;
                gap: 1rem;
            }

                .header-title .icon-wrapper {
                    width: 56px;
                    height: 56px;
                    background: rgba(255, 255, 255, 0.15);
                    border-radius: 50%;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    font-size: 1.8rem;
                    backdrop-filter: blur(4px);
                    border: 1px solid rgba(255, 255, 255, 0.1);
                    flex-shrink: 0;
                }

                .header-title h1 {
                    font-weight: 800;
                    font-size: 1.8rem;
                    margin: 0;
                    letter-spacing: -0.02em;
                    background: linear-gradient(135deg, #fff 60%, #94a3b8);
                    -webkit-background-clip: text;
                    -webkit-text-fill-color: transparent;
                    background-clip: text;
                }

                .header-title .date-range {
                    font-size: 0.85rem;
                    font-weight: 400;
                    color: rgba(255, 255, 255, 0.8);
                    background: rgba(255, 255, 255, 0.1);
                    padding: 0.25rem 1rem;
                    border-radius: 50px;
                    border: 1px solid rgba(255, 255, 255, 0.1);
                    -webkit-text-fill-color: rgba(255, 255, 255, 0.8);
                }

            .header-actions {
                display: flex;
                align-items: center;
                gap: 0.75rem;
                flex-wrap: wrap;
            }

            .btn-header {
                background: rgba(255, 255, 255, 0.12);
                border: 1px solid rgba(255, 255, 255, 0.15);
                color: #fff;
                border-radius: 50px;
                padding: 0.5rem 1.4rem;
                font-weight: 500;
                font-size: 0.9rem;
                transition: var(--transition);
                text-decoration: none;
                display: inline-flex;
                align-items: center;
                gap: 0.5rem;
                backdrop-filter: blur(4px);
            }

                .btn-header:hover {
                    background: rgba(255, 255, 255, 0.25);
                    transform: translateY(-2px);
                    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.2);
                    color: #fff;
                }

            .btn-header-success {
                background: rgba(34, 197, 94, 0.2);
                border: 1px solid rgba(34, 197, 94, 0.3);
                color: #fff;
            }

                .btn-header-success:hover {
                    background: rgba(34, 197, 94, 0.35);
                    color: #fff;
                }

            /* ────────────────────────────────────────────────────────── */
            /* Toast / Notification                                     */
            /* ────────────────────────────────────────────────────────── */
            .toast-container {
                position: fixed;
                top: 20px;
                right: 20px;
                z-index: 9999;
            }

            .toast-custom {
                background: var(--white);
                border-radius: var(--radius-sm);
                padding: 1rem 1.5rem;
                box-shadow: var(--shadow-lg);
                border-left: 4px solid var(--primary);
                min-width: 300px;
                animation: slideInRight 0.5s ease-out;
                margin-bottom: 0.75rem;
            }

                .toast-custom.success {
                    border-left-color: var(--success);
                }

                .toast-custom.error {
                    border-left-color: var(--danger);
                }

                .toast-custom .toast-title {
                    font-weight: 700;
                    font-size: 0.95rem;
                }

                .toast-custom .toast-message {
                    font-size: 0.85rem;
                    color: var(--gray);
                }

            @@keyframes slideInRight {
                from {
                    opacity: 0;
                    transform: translateX(100px);
                }

                to {
                    opacity: 1;
                    transform: translateX(0);
                }
            }

            /* ────────────────────────────────────────────────────────── */
            /* Body                                                     */
            /* ────────────────────────────────────────────────────────── */
            .body-content {
                padding: 2rem 3rem 2.5rem;
            }

            /* ────────────────────────────────────────────────────────── */
            /* Alert Messages                                           */
            /* ────────────────────────────────────────────────────────── */
            .alert-custom {
                border-radius: var(--radius-sm);
                padding: 1rem 1.5rem;
                border: none;
                box-shadow: var(--shadow-sm);
                margin-bottom: 1.5rem;
            }

                .alert-custom.alert-danger {
                    background: #fee2e2;
                    color: #991b1b;
                    border-left: 4px solid var(--danger);
                }

                .alert-custom.alert-success {
                    background: #dcfce7;
                    color: #166534;
                    border-left: 4px solid var(--success);
                }

            /* ────────────────────────────────────────────────────────── */
            /* Filter Section                                           */
            /* ────────────────────────────────────────────────────────── */
            .filter-section {
                background: var(--gray-bg);
                border-radius: var(--radius-sm);
                padding: 1.25rem 1.5rem;
                margin-bottom: 1.5rem;
                border: 1px solid var(--gray-light);
                transition: var(--transition);
            }

                .filter-section:hover {
                    border-color: var(--primary);
                    box-shadow: var(--shadow-sm);
                }

            .filter-row {
                display: flex;
                flex-wrap: wrap;
                align-items: flex-end;
                gap: 1rem 1.5rem;
            }

            .filter-group {
                display: flex;
                flex-direction: column;
                flex: 1 1 180px;
            }

                .filter-group label {
                    font-weight: 600;
                    font-size: 0.8rem;
                    color: var(--dark);
                    margin-bottom: 0.3rem;
                }

                    .filter-group label i {
                        color: var(--primary);
                        margin-right: 0.25rem;
                    }

                .filter-group .form-control {
                    border-radius: var(--radius-xs);
                    border: 1.5px solid var(--gray-light);
                    padding: 0.5rem 0.75rem;
                    font-size: 0.9rem;
                    transition: var(--transition);
                    background: var(--white);
                }

                    .filter-group .form-control:focus {
                        border-color: var(--primary);
                        box-shadow: 0 0 0 3px rgba(13, 110, 253, 0.12);
                    }

            .filter-buttons {
                display: flex;
                flex-wrap: wrap;
                gap: 0.5rem;
                align-items: flex-end;
            }

                .filter-buttons .btn {
                    border-radius: 50px;
                    padding: 0.45rem 1.4rem;
                    font-weight: 600;
                    font-size: 0.85rem;
                    transition: var(--transition);
                    text-transform: uppercase;
                    letter-spacing: 0.04em;
                }

                    .filter-buttons .btn:hover {
                        transform: translateY(-2px);
                        box-shadow: var(--shadow-md);
                    }

                .filter-buttons .btn-primary {
                    background: linear-gradient(135deg, #0d6efd, #0a58ca);
                    border: none;
                    color: #fff;
                    box-shadow: 0 2px 10px rgba(13, 110, 253, 0.25);
                }

                    .filter-buttons .btn-primary:hover {
                        box-shadow: 0 4px 18px rgba(13, 110, 253, 0.35);
                    }

                .filter-buttons .btn-success {
                    background: linear-gradient(135deg, #22c55e, #16a34a);
                    border: none;
                    color: #fff;
                    box-shadow: 0 2px 10px rgba(34, 197, 94, 0.25);
                }

                    .filter-buttons .btn-success:hover {
                        box-shadow: 0 4px 18px rgba(34, 197, 94, 0.35);
                    }

                .filter-buttons .btn-outline-secondary {
                    background: transparent;
                    color: var(--gray);
                    border: 1.5px solid var(--gray-light);
                }

                    .filter-buttons .btn-outline-secondary:hover {
                        background: var(--gray-bg);
                        border-color: var(--gray);
                        color: var(--dark);
                    }

            /* ────────────────────────────────────────────────────────── */
            /* Metrics Cards                                            */
            /* ────────────────────────────────────────────────────────── */
            .metrics-grid {
                display: grid;
                grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
                gap: 1rem;
                margin-bottom: 2rem;
            }

            .metric-card {
                background: var(--white);
                border-radius: var(--radius-sm);
                padding: 1.25rem 1.5rem;
                box-shadow: var(--shadow-sm);
                border: 1px solid var(--gray-light);
                text-align: center;
                transition: var(--transition);
                position: relative;
                overflow: hidden;
            }

                .metric-card::before {
                    content: '';
                    position: absolute;
                    top: 0;
                    left: 0;
                    right: 0;
                    height: 3px;
                    opacity: 0;
                    transition: var(--transition);
                }

                .metric-card:hover {
                    transform: translateY(-4px);
                    box-shadow: var(--shadow-md);
                    border-color: var(--primary);
                }

                    .metric-card:hover::before {
                        opacity: 1;
                    }

                .metric-card.primary::before {
                    background: linear-gradient(90deg, var(--primary), var(--info));
                }

                .metric-card.success::before {
                    background: linear-gradient(90deg, var(--success), var(--info));
                }

                .metric-card.danger::before {
                    background: linear-gradient(90deg, var(--danger), var(--warning));
                }

                .metric-card.warning::before {
                    background: linear-gradient(90deg, var(--warning), var(--primary));
                }

                .metric-card .metric-icon {
                    font-size: 1.5rem;
                    opacity: 0.3;
                    position: absolute;
                    right: 0.75rem;
                    bottom: 0.5rem;
                }

                    .metric-card .metric-icon.primary {
                        color: var(--primary);
                    }

                    .metric-card .metric-icon.success {
                        color: var(--success);
                    }

                    .metric-card .metric-icon.danger {
                        color: var(--danger);
                    }

                    .metric-card .metric-icon.warning {
                        color: var(--warning);
                    }

                .metric-card .metric-label {
                    font-size: 0.7rem;
                    text-transform: uppercase;
                    letter-spacing: 0.06em;
                    color: var(--gray);
                    font-weight: 600;
                }

                .metric-card .metric-value {
                    font-size: 1.6rem;
                    font-weight: 800;
                    color: var(--dark);
                    display: block;
                    letter-spacing: -0.02em;
                }

                    .metric-card .metric-value.text-primary {
                        color: var(--primary);
                    }

                    .metric-card .metric-value.text-success {
                        color: var(--success);
                    }

                    .metric-card .metric-value.text-danger {
                        color: var(--danger);
                    }

                    .metric-card .metric-value.text-warning {
                        color: var(--warning);
                    }

                .metric-card .metric-sub {
                    font-size: 0.75rem;
                    color: var(--gray);
                }

            /* ────────────────────────────────────────────────────────── */
            /* Table Card                                               */
            /* ────────────────────────────────────────────────────────── */
            .table-card {
                background: var(--white);
                border-radius: var(--radius-sm);
                border: 1px solid var(--gray-light);
                overflow: hidden;
                box-shadow: var(--shadow-sm);
            }

                .table-card .table-header {
                    background: var(--gray-bg);
                    padding: 0.75rem 1.5rem;
                    border-bottom: 1px solid var(--gray-light);
                    display: flex;
                    flex-wrap: wrap;
                    align-items: center;
                    justify-content: space-between;
                    gap: 0.75rem;
                }

                    .table-card .table-header .title {
                        font-weight: 700;
                        font-size: 0.95rem;
                        color: var(--dark);
                        display: flex;
                        align-items: center;
                        gap: 0.5rem;
                    }

                        .table-card .table-header .title i {
                            color: var(--primary);
                        }

                    .table-card .table-header .badge-count {
                        background: var(--primary-light);
                        color: var(--primary);
                        padding: 0.1rem 0.7rem;
                        border-radius: 50px;
                        font-size: 0.7rem;
                        font-weight: 600;
                    }

            /* ────────────────────────────────────────────────────────── */
            /* Table Styling                                            */
            /* ────────────────────────────────────────────────────────── */
            .table-responsive-custom {
                overflow-x: auto;
                -webkit-overflow-scrolling: touch;
            }

            .table {
                margin: 0;
                font-size: 0.9rem;
                vertical-align: middle;
                border-collapse: separate;
                border-spacing: 0;
                width: 100%;
            }

                .table thead th {
                    background: var(--gray-bg);
                    color: var(--dark);
                    font-weight: 600;
                    font-size: 0.75rem;
                    text-transform: uppercase;
                    letter-spacing: 0.05em;
                    padding: 0.6rem 1rem;
                    border-bottom: 2px solid var(--gray-light);
                    white-space: nowrap;
                }

                    .table thead th.text-end {
                        text-align: right;
                    }

                .table tbody td {
                    padding: 0.6rem 1rem;
                    border-bottom: 1px solid var(--gray-light);
                    color: var(--dark);
                    background: var(--white);
                }

                .table tbody tr:hover td {
                    background: var(--gray-bg);
                }

                .table tbody tr:last-child td {
                    border-bottom: none;
                }

                .table .rank-badge {
                    display: inline-flex;
                    align-items: center;
                    justify-content: center;
                    width: 28px;
                    height: 28px;
                    border-radius: 50%;
                    font-weight: 700;
                    font-size: 0.75rem;
                }

                    .table .rank-badge.gold {
                        background: #fef3c7;
                        color: #b45309;
                    }

                    .table .rank-badge.silver {
                        background: #f1f5f9;
                        color: #475569;
                    }

                    .table .rank-badge.bronze {
                        background: #fef3c7;
                        color: #b45309;
                    }

                    .table .rank-badge.default {
                        background: var(--gray-bg);
                        color: var(--gray);
                    }

            /* ────────────────────────────────────────────────────────── */
            /* Completion Rate Badge                                    */
            /* ────────────────────────────────────────────────────────── */
            .rate-badge {
                font-weight: 600;
                padding: 0.2rem 0.8rem;
                border-radius: 50px;
                font-size: 0.75rem;
                text-transform: uppercase;
                letter-spacing: 0.04em;
            }

                .rate-badge.high {
                    background: #dcfce7;
                    color: #166534;
                }

                .rate-badge.medium {
                    background: #fef3c7;
                    color: #b45309;
                }

                .rate-badge.low {
                    background: #fee2e2;
                    color: #991b1b;
                }

                .rate-badge i {
                    font-size: 0.6rem;
                    margin-right: 0.2rem;
                }

            /* ────────────────────────────────────────────────────────── */
            /* Empty State                                              */
            /* ────────────────────────────────────────────────────────── */
            .empty-state {
                padding: 3rem 1rem !important;
                text-align: center;
                color: var(--gray);
            }

                .empty-state i {
                    font-size: 3rem;
                    display: block;
                    margin-bottom: 0.75rem;
                    color: var(--gray-light);
                }

                .empty-state h5 {
                    color: var(--dark);
                    font-weight: 600;
                }

            /* ────────────────────────────────────────────────────────── */
            /* Responsive                                               */
            /* ────────────────────────────────────────────────────────── */
            @@media (max-width: 992px) {
                .header-premium {
                    padding: 2rem 1.5rem 1.5rem;
                }

                .body-content {
                    padding: 1.5rem 1.5rem 2rem;
                }
            }

            @@media (max-width: 768px) {
                body {
                    padding: 1rem 0.75rem;
                }

                .report-wrapper {
                    border-radius: var(--radius-sm);
                }

                .header-premium {
                    padding: 1.5rem 1.25rem 1.25rem;
                }

                .header-title h1 {
                    font-size: 1.3rem;
                }

                .header-title .icon-wrapper {
                    width: 44px;
                    height: 44px;
                    font-size: 1.3rem;
                }

                .header-title .date-range {
                    font-size: 0.7rem;
                    padding: 0.15rem 0.6rem;
                }

                .header-content {
                    flex-direction: column;
                    align-items: flex-start;
                }

                .header-actions {
                    width: 100%;
                    justify-content: flex-start;
                }

                .body-content {
                    padding: 1rem 1rem 1.5rem;
                }

                .metrics-grid {
                    grid-template-columns: 1fr 1fr;
                    gap: 0.75rem;
                }

                .metric-card {
                    padding: 1rem 0.75rem;
                }

                    .metric-card .metric-value {
                        font-size: 1.3rem;
                    }

                .filter-row {
                    flex-direction: column;
                    align-items: stretch;
                }

                .filter-group {
                    flex: unset;
                }

                .filter-buttons {
                    justify-content: stretch;
                }

                    .filter-buttons .btn {
                        flex: 1;
                        justify-content: center;
                    }

                .table thead th,
                .table tbody td {
                    padding: 0.5rem 0.75rem;
                    font-size: 0.8rem;
                }

                .table-card .table-header {
                    padding: 0.6rem 1rem;
                }

                .toast-custom {
                    min-width: 250px;
                    margin: 0 0.5rem 0.75rem;
                }
            }

            @@media (max-width: 480px) {
                body {
                    padding: 0.5rem 0.5rem;
                }

                .header-premium {
                    padding: 1rem 1rem 1rem;
                    border-radius: var(--radius-xs) var(--radius-xs) 0 0;
                }

                .header-title h1 {
                    font-size: 1.1rem;
                }

                .header-title .icon-wrapper {
                    width: 36px;
                    height: 36px;
                    font-size: 1rem;
                }

                .body-content {
                    padding: 0.75rem 0.75rem 1rem;
                }

                .metrics-grid {
                    grid-template-columns: 1fr 1fr;
                    gap: 0.5rem;
                }

                .metric-card {
                    padding: 0.75rem 0.5rem;
                }

                    .metric-card .metric-value {
                        font-size: 1.1rem;
                    }

                    .metric-card .metric-label {
                        font-size: 0.55rem;
                    }

                .table thead th,
                .table tbody td {
                    padding: 0.4rem 0.5rem;
                    font-size: 0.75rem;
                }

                .filter-buttons .btn {
                    font-size: 0.7rem;
                    padding: 0.35rem 0.8rem;
                }

                .toast-custom {
                    min-width: 200px;
                    padding: 0.75rem 1rem;
                }
            }
    </style>
</head>
<body>

    <!-- ─── Toast Container ─── -->
    <div class="toast-container" id="toastContainer"></div>

    <div class="report-wrapper">

        <!-- ─── HEADER ─── -->
        <div class="header-premium">
            <div class="header-content">
                <div class="header-title">
                    <div class="icon-wrapper">
                        <i class="bi bi-person-workspace"></i>
                    </div>
                    <div>
                        <h1>Mechanic Performance</h1>
                        <span class="date-range">
                            <i class="bi bi-calendar3"></i>
                            @(Model.DateFrom?.ToString("dd/MM/yyyy") ?? "Start")
                            -
                            @(Model.DateTo?.ToString("dd/MM/yyyy") ?? "End")
                        </span>
                    </div>
                </div>
                <div class="header-actions">
                    <a asp-action="Mechanics" asp-route-export="csv" class="btn-header btn-header-success">
                        <i class="bi bi-file-earmark-spreadsheet"></i> Export CSV
                    </a>
                    <a asp-action="Index" class="btn-header">
                        <i class="bi bi-arrow-left"></i> All Reports
                    </a>
                </div>
            </div>
        </div>

        <!-- ─── BODY ─── -->
        <div class="body-content">

            <!-- Alerts -->
            @if (TempData["Error"] != null)
            {
                <div class="alert-custom alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-circle-fill me-2"></i>
                    @TempData["Error"]
                    <button type="button" class="btn-close float-end" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @if (TempData["Success"] != null)
            {
                <div class="alert-custom alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i>
                    @TempData["Success"]
                    <button type="button" class="btn-close float-end" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <!-- ─── Filter Section ─── -->
            <div class="filter-section">
                <form method="get" id="filterForm">
                    <div class="filter-row">
                        <div class="filter-group">
                            <label><i class="bi bi-calendar3"></i> From Date</label>
                            <input type="date" name="from" class="form-control" value="@Model.DateFrom?.ToString("yyyy-MM-dd")" />
                        </div>

                        <div class="filter-group">
                            <label><i class="bi bi-calendar3"></i> To Date</label>
                            <input type="date" name="to" class="form-control" value="@Model.DateTo?.ToString("yyyy-MM-dd")" />
                        </div>

                        <div class="filter-buttons">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-funnel"></i> Filter
                            </button>
                            <a asp-action="Mechanics" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-counterclockwise"></i> Reset
                            </a>
                        </div>
                    </div>
                </form>
            </div>

            <!-- ─── Metrics ─── -->
            <div class="metrics-grid">
                <div class="metric-card primary">
                    <span class="metric-icon primary"><i class="bi bi-person-workspace"></i></span>
                    <span class="metric-label">Total Mechanics</span>
                    <span class="metric-value text-primary">@Model.Mechanics.Count</span>
                    <span class="metric-sub">Active mechanics</span>
                </div>

                <div class="metric-card success">
                    <span class="metric-icon success"><i class="bi bi-check-circle"></i></span>
                    <span class="metric-label">Total Completed</span>
                    <span class="metric-value text-success">
                        @{
                            var totalCompleted = Model.Mechanics.Sum(m => m.CompletedBookings);
                        }
                        @totalCompleted
                    </span>
                    <span class="metric-sub">Completed bookings</span>
                </div>

                <div class="metric-card warning">
                    <span class="metric-icon warning"><i class="bi bi-star"></i></span>
                    <span class="metric-label">Best Performer</span>
                    <span class="metric-value text-warning">
                        @{
                            var bestPerformer = Model.Mechanics.OrderByDescending(m => m.CompletionRate).FirstOrDefault();
                        }
                        @(bestPerformer?.FullName?.Split(' ').FirstOrDefault() ?? "N/A")
                    </span>
                    <span class="metric-sub">@(bestPerformer?.CompletionRate.ToString("F0") ?? "0")% completion</span>
                </div>

                <div class="metric-card danger">
                    <span class="metric-icon danger"><i class="bi bi-currency-rupee"></i></span>
                    <span class="metric-label">Top Revenue</span>
                    <span class="metric-value text-danger">
                        @{
                            var topRevenue = Model.Mechanics.OrderByDescending(m => m.RevenueGenerated).FirstOrDefault();
                        }
                        @(topRevenue?.RevenueGenerated.ToString("C") ?? "₹0")
                    </span>
                    <span class="metric-sub">@(topRevenue?.FullName ?? "N/A")</span>
                </div>
            </div>

            <!-- ─── Performance Table ─── -->
            <div class="table-card">
                <div class="table-header">
                    <span class="title">
                        <i class="bi bi-person-lines-fill"></i>
                        Performance by Mechanic
                    </span>
                    <span class="badge-count">@Model.Mechanics.Count mechanics</span>
                </div>

                <div class="table-responsive-custom">
                    <table class="table">
                        <thead>
                            <tr>
                                <th style="width:50px;">#</th>
                                <th>Mechanic</th>
                                <th>Specialization</th>
                                <th class="text-end">Total Bookings</th>
                                <th class="text-end">Completed</th>
                                <th class="text-end">Completion Rate</th>
                                <th class="text-end">Revenue Generated</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Mechanics.Any())
                            {
                                int rank = 1;
                                @foreach (var row in Model.Mechanics.OrderByDescending(m => m.CompletionRate))
                                {
                                    string rankClass = rank == 1 ? "gold" : rank == 2 ? "silver" : rank == 3 ? "bronze" : "default";
                                    string rankIcon = rank == 1 ? "🥇" : rank == 2 ? "🥈" : rank == 3 ? "🥉" : rank.ToString();
                                    string rateClass = row.CompletionRate >= 80 ? "high" : row.CompletionRate >= 50 ? "medium" : "low";
                                    string rateIcon = row.CompletionRate >= 80 ? "bi-check-circle-fill" : row.CompletionRate >= 50 ? "bi-clock-fill" : "bi-exclamation-triangle-fill";
                                    <tr>
                                        <td>
                                            <span class="rank-badge @rankClass">@rankIcon</span>
                                        </td>
                                        <td>
                                            <strong>@row.FullName</strong>
                                            @if (rank == 1)
                                            {
                                                <span class="badge bg-warning text-dark ms-1" style="font-size:0.6rem;">TOP</span>
                                            }
                                        </td>
                                        <td>@(string.IsNullOrEmpty(row.Specialization) ? "—" : row.Specialization)</td>
                                        <td class="text-end">@row.TotalBookings</td>
                                        <td class="text-end" style="color:var(--success);font-weight:600;">
                                            @row.CompletedBookings
                                        </td>
                                        <td class="text-end">
                                            <span class="rate-badge @rateClass">
                                                <i class="bi @rateIcon"></i>
                                                @row.CompletionRate.ToString("F0")%
                                            </span>
                                        </td>
                                        <td class="text-end" style="font-weight:700;color:var(--primary);">
                                            ₹@row.RevenueGenerated.ToString("N2")
                                        </td>
                                    </tr>
                                    rank++;
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="7">
                                        <div class="empty-state">
                                            <i class="bi bi-person-workspace"></i>
                                            <h5>No Mechanics Found</h5>
                                            <p class="text-muted">No mechanic data available for the selected date range.</p>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

        </div> <!-- /body-content -->
    </div> <!-- /report-wrapper -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <script>
            // ─── Toast Notification ───
            function showToast(message, type) {
                var container = document.getElementById('toastContainer');
                var toast = document.createElement('div');
                toast.className = 'toast-custom ' + (type || 'success');
                toast.innerHTML = `
                            <div class="toast-title">
                                <i class="bi ${type === 'error' ? 'bi-exclamation-circle-fill text-danger' : 'bi-check-circle-fill text-success'}"></i>
                                ${type === 'error' ? 'Error' : 'Success'}
                            </div>
                            <div class="toast-message">${message}</div>
                        `;
                container.appendChild(toast);

                setTimeout(function() {
                    toast.style.opacity = '0';
                    toast.style.transform = 'translateX(100px)';
                    toast.style.transition = '0.5s ease-out';
                    setTimeout(function() { toast.remove(); }, 500);
                }, 5000);
            }

            // ─── Show TempData Messages ───
            @if (TempData["Error"] != null)
                {
                    <text>showToast('@TempData["Error"]', 'error');</text>
            }

                @if (TempData["Success"] != null)
                {
                    <text>showToast('@TempData["Success"]', 'success');</text>
            }

                // ─── Auto-dismiss alerts ───
                setTimeout(function() {
                    document.querySelectorAll('.alert-custom').forEach(function(alert) {
                        var closeBtn = alert.querySelector('.btn-close');
                        if (closeBtn) {
                            closeBtn.click();
                        }
                    });
                }, 5000);
    </script>

</body>
</html>