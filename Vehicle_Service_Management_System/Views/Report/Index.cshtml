@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reports | Vehicle Service Management</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
            :root {
                --primary-gradient: linear-gradient(135deg, #0d6efd, #0a58ca);
                --shadow-sm: 0 2px 8px rgba(0, 0, 0, 0.06);
                --shadow-md: 0 8px 30px rgba(0, 0, 0, 0.10);
                --shadow-lg: 0 16px 48px rgba(0, 0, 0, 0.14);
                --radius: 16px;
                --radius-sm: 10px;
                --transition: 0.25s ease;
            }

            * {
                box-sizing: border-box;
            }

            html, body {
                overflow-x: hidden;
            }

            body {
                background: #f4f6fa;
                font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
                padding: clamp(1rem, 3vw, 2rem) clamp(0.75rem, 2vw, 1.5rem);
                min-height: 100vh;
                display: flex;
                align-items: flex-start;
                justify-content: center;
            }

            .reports-wrapper {
                max-width: 1400px;
                width: 100%;
                background: #ffffff;
                border-radius: var(--radius);
                box-shadow: var(--shadow-lg);
                padding: clamp(1.25rem, 3vw, 2rem) clamp(1rem, 3vw, 2rem) clamp(1.5rem, 4vw, 2.5rem);
                transition: var(--transition);
            }

            /* ── Header ── */
            .page-header {
                margin-bottom: clamp(1.25rem, 3vw, 2rem);
            }

                .page-header h1 {
                    font-weight: 700;
                    font-size: clamp(1.4rem, 4vw, 1.85rem);
                    letter-spacing: -0.02em;
                    color: #1a2634;
                    margin: 0 0 0.25rem 0;
                    display: flex;
                    align-items: center;
                    gap: 0.5rem;
                    flex-wrap: wrap;
                }

                    .page-header h1 i {
                        color: #0d6efd;
                        font-size: clamp(1.5rem, 4.5vw, 2rem);
                    }

                .page-header p {
                    color: #6b7a8e;
                    font-size: clamp(0.85rem, 2vw, 0.95rem);
                    margin: 0;
                }

            /* ── Report Cards ── */
            .report-card {
                display: block;
                text-decoration: none;
                color: inherit;
                height: 100%;
                width: 100%;
                transition: transform var(--transition) ease, box-shadow var(--transition) ease;
                border: 1px solid #eef2f7;
                border-radius: var(--radius-sm);
                background: #ffffff;
                box-shadow: var(--shadow-sm);
            }

                .report-card:hover {
                    transform: translateY(-6px);
                    box-shadow: var(--shadow-md);
                    border-color: #dbeafe;
                }

                .report-card .card-body {
                    padding: clamp(1.1rem, 2.5vw, 1.5rem) clamp(1rem, 2.5vw, 1.25rem);
                    display: flex;
                    flex-direction: column;
                    align-items: flex-start;
                    height: 100%;
                }

                .report-card .icon-wrapper {
                    width: clamp(44px, 8vw, 56px);
                    height: clamp(44px, 8vw, 56px);
                    border-radius: 12px;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    font-size: clamp(1.3rem, 3vw, 1.8rem);
                    margin-bottom: 0.75rem;
                    flex-shrink: 0;
                }

                    .report-card .icon-wrapper.icon-success {
                        background: #dcfce7;
                        color: #166534;
                    }

                    .report-card .icon-wrapper.icon-primary {
                        background: #dbeafe;
                        color: #1d4ed8;
                    }

                    .report-card .icon-wrapper.icon-info {
                        background: #e0f2fe;
                        color: #0369a1;
                    }

                    .report-card .icon-wrapper.icon-warning {
                        background: #fef3c7;
                        color: #b45309;
                    }

                    .report-card .icon-wrapper.icon-danger {
                        background: #fee2e2;
                        color: #b91c1c;
                    }

                    .report-card .icon-wrapper.icon-secondary {
                        background: #f1f5f9;
                        color: #475569;
                    }

                .report-card .card-title {
                    font-weight: 600;
                    font-size: clamp(1.02rem, 2.5vw, 1.15rem);
                    color: #1a2634;
                    margin: 0 0 0.3rem 0;
                }

                .report-card .card-text {
                    color: #6b7a8e;
                    font-size: clamp(0.82rem, 2vw, 0.9rem);
                    margin: 0;
                    line-height: 1.5;
                    flex: 1;
                }

                .report-card .card-arrow {
                    margin-top: 0.75rem;
                    font-size: 0.9rem;
                    color: #0d6efd;
                    display: flex;
                    align-items: center;
                    gap: 0.3rem;
                    font-weight: 500;
                    opacity: 0;
                    transition: opacity var(--transition) ease, transform var(--transition) ease;
                    transform: translateX(-4px);
                }

                .report-card:hover .card-arrow {
                    opacity: 1;
                    transform: translateX(0);
                }

            /* On touch/no-hover devices, always show the arrow since hover never fires */
            @@media (hover: none) {
                .report-card .card-arrow {
                    opacity: 1;
                    transform: translateX(0);
                }
            }

            /* Tablet tightening */
            @@media (max-width: 768px) {
                .reports-wrapper {
                    border-radius: var(--radius-sm);
                }

                .row.g-4 {
                    --bs-gutter-x: 1rem;
                    --bs-gutter-y: 1rem;
                }
            }

            /* Small phones */
            @@media (max-width: 576px) {
                body {
                    padding: 0.75rem 0.5rem;
                }

                .reports-wrapper {
                    padding: 1.1rem 0.9rem 1.5rem;
                }

                .page-header h1 {
                    font-size: 1.3rem;
                }

                .report-card .card-body {
                    padding: 1.1rem 0.9rem;
                }

                .report-card .icon-wrapper {
                    width: 44px;
                    height: 44px;
                    font-size: 1.3rem;
                }

                .report-card .card-title {
                    font-size: 1rem;
                }

                .report-card .card-text {
                    font-size: 0.85rem;
                }
            }

            /* Extra-small phones */
            @@media (max-width: 360px) {
                .page-header h1 {
                    font-size: 1.15rem;
                }

                    .page-header h1 i {
                        font-size: 1.3rem;
                    }
            }
    </style>
</head>
<body>

    <div class="reports-wrapper">

        <!-- ─── PAGE HEADER ─── -->
        <div class="page-header">
            <h1>
                <i class="bi bi-bar-chart-line"></i>
                Reports
            </h1>
            <p>Pick a report below. Every report has its own date-range filter and a CSV export you can open in Excel.</p>
        </div>

        <!-- ─── REPORT CARDS ─── -->
        <div class="row g-4">

            <!-- Revenue Report -->
            <div class="col-12 col-sm-6 col-lg-4">
                <a class="report-card" asp-action="Revenue">
                    <div class="card-body">
                        <div class="icon-wrapper icon-success">
                            <i class="bi bi-cash-coin"></i>
                        </div>
                        <h5 class="card-title">Revenue Report</h5>
                        <p class="card-text">Invoiced vs. collected revenue, monthly trend, payment mode split.</p>
                        <div class="card-arrow">
                            View Report <i class="bi bi-arrow-right"></i>
                        </div>
                    </div>
                </a>
            </div>

            <!-- Booking Report -->
            <div class="col-12 col-sm-6 col-lg-4">
                <a class="report-card" asp-action="Bookings">
                    <div class="card-body">
                        <div class="icon-wrapper icon-primary">
                            <i class="bi bi-calendar-check"></i>
                        </div>
                        <h5 class="card-title">Booking Report</h5>
                        <p class="card-text">Bookings by status and service type, full booking list.</p>
                        <div class="card-arrow">
                            View Report <i class="bi bi-arrow-right"></i>
                        </div>
                    </div>
                </a>
            </div>

            <!-- Customer Report -->
            <div class="col-12 col-sm-6 col-lg-4">
                <a class="report-card" asp-action="Customers">
                    <div class="card-body">
                        <div class="icon-wrapper icon-info">
                            <i class="bi bi-people"></i>
                        </div>
                        <h5 class="card-title">Customer Report</h5>
                        <p class="card-text">Top customers by spend, new customers in range.</p>
                        <div class="card-arrow">
                            View Report <i class="bi bi-arrow-right"></i>
                        </div>
                    </div>
                </a>
            </div>

            <!-- Vehicle Report -->
            <div class="col-12 col-sm-6 col-lg-4">
                <a class="report-card" asp-action="Vehicles">
                    <div class="card-body">
                        <div class="icon-wrapper icon-warning">
                            <i class="bi bi-car-front"></i>
                        </div>
                        <h5 class="card-title">Vehicle Report</h5>
                        <p class="card-text">Fleet by brand/type, most-serviced vehicles.</p>
                        <div class="card-arrow">
                            View Report <i class="bi bi-arrow-right"></i>
                        </div>
                    </div>
                </a>
            </div>

            <!-- Mechanic Performance -->
            <div class="col-12 col-sm-6 col-lg-4">
                <a class="report-card" asp-action="Mechanics">
                    <div class="card-body">
                        <div class="icon-wrapper icon-danger">
                            <i class="bi bi-person-workspace"></i>
                        </div>
                        <h5 class="card-title">Mechanic Performance</h5>
                        <p class="card-text">Bookings handled, completion rate, revenue generated per mechanic.</p>
                        <div class="card-arrow">
                            View Report <i class="bi bi-arrow-right"></i>
                        </div>
                    </div>
                </a>
            </div>

            <!-- GST Report -->
            <div class="col-12 col-sm-6 col-lg-4">
                <a class="report-card" asp-action="Gst">
                    <div class="card-body">
                        <div class="icon-wrapper icon-secondary">
                            <i class="bi bi-receipt-cutoff"></i>
                        </div>
                        <h5 class="card-title">GST Report</h5>
                        <p class="card-text">Invoice-wise taxable amount, GST and grand total.</p>
                        <div class="card-arrow">
                            View Report <i class="bi bi-arrow-right"></i>
                        </div>
                    </div>
                </a>
            </div>

        </div>

    </div> <!-- /.reports-wrapper -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
