@model Vehicle_Service_Management_System.Application.ViewModels.Report.BookingReportViewModel
@using Vehicle_Service_Management_System.Domain.Enums

@{
    ViewData["Title"] = "Booking Report";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Booking Report | Vehicle Service Management</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

    <style>
            /* ────────────────────────────────────────────────────────── */
            /* Root Variables                                          */
            /* ────────────────────────────────────────────────────────── */
            :root {
                --primary: #0d6efd;
                --primary-dark: #0a58ca;
                --primary-light: #e8f0fe;
                --success: #22c55e;
                --danger: #ef4444;
                --warning: #f59e0b;
                --info: #0dcaf0;
                --dark: #1a2634;
                --gray: #6b7a8e;
                --gray-light: #eef2f7;
                --gray-bg: #f0f2f5;
                --white: #ffffff;
                --shadow-sm: 0 2px 8px rgba(0, 0, 0, 0.04);
                --shadow-md: 0 8px 30px rgba(0, 0, 0, 0.08);
                --shadow-lg: 0 16px 48px rgba(0, 0, 0, 0.12);
                --shadow-xl: 0 24px 64px rgba(0, 0, 0, 0.16);
                --radius: 20px;
                --radius-sm: 12px;
                --radius-xs: 8px;
                --transition: 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            }

            /* ────────────────────────────────────────────────────────── */
            /* Base Styles                                             */
            /* ────────────────────────────────────────────────────────── */
            body {
                background: var(--gray-bg);
                font-family: 'Inter', -apple-system, system-ui, sans-serif;
                padding: 2rem 1.5rem;
                min-height: 100vh;
                display: flex;
                align-items: flex-start;
                justify-content: center;
                color: var(--dark);
                line-height: 1.6;
            }

            .report-wrapper {
                max-width: 1400px;
                width: 100%;
                background: var(--white);
                border-radius: var(--radius);
                box-shadow: var(--shadow-xl);
                overflow: hidden;
                animation: slideUp 0.5s ease-out;
            }

            @@keyframes slideUp {
                from {
                    opacity: 0;
                    transform: translateY(30px);
                }

                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            /* ────────────────────────────────────────────────────────── */
            /* Header - Premium Gradient                               */
            /* ────────────────────────────────────────────────────────── */
            .header-premium {
                background: linear-gradient(135deg, #0c0e1a 0%, #1a1a3e 40%, #0d6efd 100%);
                padding: 2.5rem 3rem 2rem;
                color: #fff;
                position: relative;
                overflow: hidden;
            }

                .header-premium::before {
                    content: '';
                    position: absolute;
                    top: -60%;
                    right: -10%;
                    width: 500px;
                    height: 500px;
                    background: radial-gradient(circle, rgba(255, 255, 255, 0.06) 0%, transparent 70%);
                    border-radius: 50%;
                    pointer-events: none;
                }

                .header-premium::after {
                    content: '';
                    position: absolute;
                    bottom: -40%;
                    left: -5%;
                    width: 300px;
                    height: 300px;
                    background: radial-gradient(circle, rgba(13, 202, 240, 0.08) 0%, transparent 70%);
                    border-radius: 50%;
                    pointer-events: none;
                }

            .header-content {
                position: relative;
                z-index: 1;
                display: flex;
                flex-wrap: wrap;
                align-items: center;
                justify-content: space-between;
                gap: 1rem;
            }

            .header-title {
                display: flex;
                align-items: center;
                gap: 1rem;
            }

                .header-title .icon-wrapper {
                    width: 56px;
                    height: 56px;
                    background: rgba(255, 255, 255, 0.15);
                    border-radius: 50%;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    font-size: 1.8rem;
                    backdrop-filter: blur(4px);
                    border: 1px solid rgba(255, 255, 255, 0.1);
                    flex-shrink: 0;
                }

                .header-title h1 {
                    font-weight: 800;
                    font-size: 1.8rem;
                    margin: 0;
                    letter-spacing: -0.02em;
                    background: linear-gradient(135deg, #fff 60%, #94a3b8);
                    -webkit-background-clip: text;
                    -webkit-text-fill-color: transparent;
                    background-clip: text;
                }

                .header-title .date-range {
                    font-size: 0.85rem;
                    font-weight: 400;
                    color: rgba(255, 255, 255, 0.8);
                    background: rgba(255, 255, 255, 0.1);
                    padding: 0.25rem 1rem;
                    border-radius: 50px;
                    border: 1px solid rgba(255, 255, 255, 0.1);
                    -webkit-text-fill-color: rgba(255, 255, 255, 0.8);
                }

            .header-actions {
                display: flex;
                align-items: center;
                gap: 0.75rem;
                flex-wrap: wrap;
            }

            .btn-header {
                background: rgba(255, 255, 255, 0.12);
                border: 1px solid rgba(255, 255, 255, 0.15);
                color: #fff;
                border-radius: 50px;
                padding: 0.5rem 1.4rem;
                font-weight: 500;
                font-size: 0.9rem;
                transition: var(--transition);
                text-decoration: none;
                display: inline-flex;
                align-items: center;
                gap: 0.5rem;
                backdrop-filter: blur(4px);
            }

                .btn-header:hover {
                    background: rgba(255, 255, 255, 0.25);
                    transform: translateY(-2px);
                    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.2);
                    color: #fff;
                }

            .btn-header-success {
                background: rgba(34, 197, 94, 0.2);
                border: 1px solid rgba(34, 197, 94, 0.3);
                color: #fff;
            }

                .btn-header-success:hover {
                    background: rgba(34, 197, 94, 0.35);
                    color: #fff;
                }

            /* ────────────────────────────────────────────────────────── */
            /* Toast / Notification                                     */
            /* ────────────────────────────────────────────────────────── */
            .toast-container {
                position: fixed;
                top: 20px;
                right: 20px;
                z-index: 9999;
            }

            .toast-custom {
                background: var(--white);
                border-radius: var(--radius-sm);
                padding: 1rem 1.5rem;
                box-shadow: var(--shadow-lg);
                border-left: 4px solid var(--primary);
                min-width: 300px;
                animation: slideInRight 0.5s ease-out;
                margin-bottom: 0.75rem;
            }

                .toast-custom.success {
                    border-left-color: var(--success);
                }

                .toast-custom.error {
                    border-left-color: var(--danger);
                }

                .toast-custom .toast-title {
                    font-weight: 700;
                    font-size: 0.95rem;
                }

                .toast-custom .toast-message {
                    font-size: 0.85rem;
                    color: var(--gray);
                }

            @@keyframes slideInRight {
                from {
                    opacity: 0;
                    transform: translateX(100px);
                }

                to {
                    opacity: 1;
                    transform: translateX(0);
                }
            }

            /* ────────────────────────────────────────────────────────── */
            /* Body                                                     */
            /* ────────────────────────────────────────────────────────── */
            .body-content {
                padding: 2rem 3rem 2.5rem;
            }

            /* ────────────────────────────────────────────────────────── */
            /* Alert Messages                                           */
            /* ────────────────────────────────────────────────────────── */
            .alert-custom {
                border-radius: var(--radius-sm);
                padding: 1rem 1.5rem;
                border: none;
                box-shadow: var(--shadow-sm);
                margin-bottom: 1.5rem;
            }

                .alert-custom.alert-danger {
                    background: #fee2e2;
                    color: #991b1b;
                    border-left: 4px solid var(--danger);
                }

                .alert-custom.alert-success {
                    background: #dcfce7;
                    color: #166534;
                    border-left: 4px solid var(--success);
                }

            /* ────────────────────────────────────────────────────────── */
            /* Filter Section                                           */
            /* ────────────────────────────────────────────────────────── */
            .filter-section {
                background: var(--gray-bg);
                border-radius: var(--radius-sm);
                padding: 1.25rem 1.5rem;
                margin-bottom: 1.5rem;
                border: 1px solid var(--gray-light);
                transition: var(--transition);
            }

                .filter-section:hover {
                    border-color: var(--primary);
                    box-shadow: var(--shadow-sm);
                }

            .filter-row {
                display: flex;
                flex-wrap: wrap;
                align-items: flex-end;
                gap: 1rem 1.5rem;
            }

            .filter-group {
                display: flex;
                flex-direction: column;
                flex: 1 1 160px;
            }

                .filter-group label {
                    font-weight: 600;
                    font-size: 0.8rem;
                    color: var(--dark);
                    margin-bottom: 0.3rem;
                }

                    .filter-group label i {
                        color: var(--primary);
                        margin-right: 0.25rem;
                    }

                .filter-group .form-control,
                .filter-group .form-select {
                    border-radius: var(--radius-xs);
                    border: 1.5px solid var(--gray-light);
                    padding: 0.5rem 0.75rem;
                    font-size: 0.9rem;
                    transition: var(--transition);
                    background: var(--white);
                }

                    .filter-group .form-control:focus,
                    .filter-group .form-select:focus {
                        border-color: var(--primary);
                        box-shadow: 0 0 0 3px rgba(13, 110, 253, 0.12);
                    }

            .filter-buttons {
                display: flex;
                flex-wrap: wrap;
                gap: 0.5rem;
                align-items: flex-end;
            }

                .filter-buttons .btn {
                    border-radius: 50px;
                    padding: 0.45rem 1.4rem;
                    font-weight: 600;
                    font-size: 0.85rem;
                    transition: var(--transition);
                    text-transform: uppercase;
                    letter-spacing: 0.04em;
                }

                    .filter-buttons .btn:hover {
                        transform: translateY(-2px);
                        box-shadow: var(--shadow-md);
                    }

                .filter-buttons .btn-primary {
                    background: linear-gradient(135deg, #0d6efd, #0a58ca);
                    border: none;
                    color: #fff;
                    box-shadow: 0 2px 10px rgba(13, 110, 253, 0.25);
                }

                    .filter-buttons .btn-primary:hover {
                        box-shadow: 0 4px 18px rgba(13, 110, 253, 0.35);
                    }

                .filter-buttons .btn-success {
                    background: linear-gradient(135deg, #22c55e, #16a34a);
                    border: none;
                    color: #fff;
                    box-shadow: 0 2px 10px rgba(34, 197, 94, 0.25);
                }

                    .filter-buttons .btn-success:hover {
                        box-shadow: 0 4px 18px rgba(34, 197, 94, 0.35);
                    }

                .filter-buttons .btn-outline-secondary {
                    background: transparent;
                    color: var(--gray);
                    border: 1.5px solid var(--gray-light);
                }

                    .filter-buttons .btn-outline-secondary:hover {
                        background: var(--gray-bg);
                        border-color: var(--gray);
                        color: var(--dark);
                    }

            /* ────────────────────────────────────────────────────────── */
            /* Summary Cards                                            */
            /* ────────────────────────────────────────────────────────── */
            .summary-grid {
                display: grid;
                grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
                gap: 1rem;
                margin-bottom: 2rem;
            }

            .summary-card {
                background: var(--white);
                border-radius: var(--radius-sm);
                padding: 1.25rem 1.5rem;
                box-shadow: var(--shadow-sm);
                border: 1px solid var(--gray-light);
                transition: var(--transition);
                position: relative;
                overflow: hidden;
            }

                .summary-card::before {
                    content: '';
                    position: absolute;
                    top: 0;
                    left: 0;
                    right: 0;
                    height: 3px;
                    opacity: 0;
                    transition: var(--transition);
                }

                .summary-card:hover {
                    transform: translateY(-4px);
                    box-shadow: var(--shadow-md);
                    border-color: var(--primary);
                }

                    .summary-card:hover::before {
                        opacity: 1;
                    }

                .summary-card.primary::before {
                    background: linear-gradient(90deg, var(--primary), var(--info));
                }

                .summary-card.success::before {
                    background: linear-gradient(90deg, var(--success), var(--info));
                }

                .summary-card.danger::before {
                    background: linear-gradient(90deg, var(--danger), var(--warning));
                }

                .summary-card.warning::before {
                    background: linear-gradient(90deg, var(--warning), var(--primary));
                }

                .summary-card .card-icon {
                    font-size: 1.5rem;
                    opacity: 0.3;
                    position: absolute;
                    right: 0.75rem;
                    bottom: 0.5rem;
                }

                    .summary-card .card-icon.primary {
                        color: var(--primary);
                    }

                    .summary-card .card-icon.success {
                        color: var(--success);
                    }

                    .summary-card .card-icon.danger {
                        color: var(--danger);
                    }

                    .summary-card .card-icon.warning {
                        color: var(--warning);
                    }

                .summary-card .card-label {
                    font-size: 0.7rem;
                    text-transform: uppercase;
                    letter-spacing: 0.06em;
                    color: var(--gray);
                    font-weight: 600;
                }

                .summary-card .card-value {
                    font-size: 1.6rem;
                    font-weight: 800;
                    color: var(--dark);
                    display: block;
                    letter-spacing: -0.02em;
                }

                    .summary-card .card-value.text-primary {
                        color: var(--primary);
                    }

                    .summary-card .card-value.text-success {
                        color: var(--success);
                    }

                    .summary-card .card-value.text-danger {
                        color: var(--danger);
                    }

                    .summary-card .card-value.text-warning {
                        color: var(--warning);
                    }

                .summary-card .card-sub {
                    font-size: 0.75rem;
                    color: var(--gray);
                }

            /* ────────────────────────────────────────────────────────── */
            /* Status Breakdown & Service Type                         */
            /* ────────────────────────────────────────────────────────── */
            .breakdown-grid {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 1.5rem;
                margin-bottom: 2rem;
            }

            .breakdown-card {
                background: var(--white);
                border-radius: var(--radius-sm);
                padding: 1.25rem 1.5rem;
                box-shadow: var(--shadow-sm);
                border: 1px solid var(--gray-light);
                transition: var(--transition);
            }

                .breakdown-card:hover {
                    border-color: var(--primary);
                    box-shadow: var(--shadow-sm);
                }

                .breakdown-card .card-title {
                    font-weight: 700;
                    font-size: 0.95rem;
                    color: var(--dark);
                    display: flex;
                    align-items: center;
                    gap: 0.5rem;
                    margin-bottom: 1rem;
                    padding-bottom: 0.5rem;
                    border-bottom: 2px solid var(--gray-light);
                }

                    .breakdown-card .card-title i {
                        color: var(--primary);
                    }

                    .breakdown-card .card-title .badge-count {
                        background: var(--primary-light);
                        color: var(--primary);
                        padding: 0.1rem 0.7rem;
                        border-radius: 50px;
                        font-size: 0.7rem;
                        font-weight: 600;
                        margin-left: auto;
                    }

            /* ────────────────────────────────────────────────────────── */
            /* Status Badge                                            */
            /* ────────────────────────────────────────────────────────── */
            .badge-status {
                font-weight: 600;
                padding: 0.25rem 0.9rem;
                border-radius: 50px;
                font-size: 0.75rem;
                text-transform: uppercase;
                letter-spacing: 0.04em;
            }

                .badge-status.bg-pending {
                    background: #fef3c7;
                    color: #b45309;
                }

                .badge-status.bg-inprogress {
                    background: #e0f2fe;
                    color: #0369a1;
                }

                .badge-status.bg-completed {
                    background: #dcfce7;
                    color: #166534;
                }

                .badge-status.bg-cancelled {
                    background: #fee2e2;
                    color: #991b1b;
                }

                .badge-status i {
                    font-size: 0.6rem;
                    margin-right: 0.2rem;
                }

            /* ────────────────────────────────────────────────────────── */
            /* Table Card                                               */
            /* ────────────────────────────────────────────────────────── */
            .table-card {
                background: var(--white);
                border-radius: var(--radius-sm);
                border: 1px solid var(--gray-light);
                overflow: hidden;
                box-shadow: var(--shadow-sm);
            }

                .table-card .table-header {
                    background: var(--gray-bg);
                    padding: 0.75rem 1.5rem;
                    border-bottom: 1px solid var(--gray-light);
                    display: flex;
                    flex-wrap: wrap;
                    align-items: center;
                    justify-content: space-between;
                    gap: 0.75rem;
                }

                    .table-card .table-header .title {
                        font-weight: 700;
                        font-size: 0.95rem;
                        color: var(--dark);
                        display: flex;
                        align-items: center;
                        gap: 0.5rem;
                    }

                        .table-card .table-header .title i {
                            color: var(--primary);
                        }

                    .table-card .table-header .badge-total {
                        background: var(--primary-light);
                        color: var(--primary);
                        padding: 0.1rem 0.7rem;
                        border-radius: 50px;
                        font-size: 0.7rem;
                        font-weight: 600;
                    }

            /* ────────────────────────────────────────────────────────── */
            /* Table Styling                                            */
            /* ────────────────────────────────────────────────────────── */
            .table-responsive-custom {
                overflow-x: auto;
                -webkit-overflow-scrolling: touch;
            }

            .table {
                margin: 0;
                font-size: 0.9rem;
                vertical-align: middle;
                border-collapse: separate;
                border-spacing: 0;
                width: 100%;
            }

                .table thead th {
                    background: var(--gray-bg);
                    color: var(--dark);
                    font-weight: 600;
                    font-size: 0.75rem;
                    text-transform: uppercase;
                    letter-spacing: 0.05em;
                    padding: 0.6rem 1rem;
                    border-bottom: 2px solid var(--gray-light);
                    white-space: nowrap;
                }

                    .table thead th.text-end {
                        text-align: right;
                    }

                .table tbody td {
                    padding: 0.6rem 1rem;
                    border-bottom: 1px solid var(--gray-light);
                    color: var(--dark);
                    background: var(--white);
                }

                .table tbody tr:hover td {
                    background: var(--gray-bg);
                }

                .table tbody tr:last-child td {
                    border-bottom: none;
                }

            /* ────────────────────────────────────────────────────────── */
            /* Empty State                                              */
            /* ────────────────────────────────────────────────────────── */
            .empty-state {
                padding: 3rem 1rem !important;
                text-align: center;
                color: var(--gray);
            }

                .empty-state i {
                    font-size: 3rem;
                    display: block;
                    margin-bottom: 0.75rem;
                    color: var(--gray-light);
                }

                .empty-state h5 {
                    color: var(--dark);
                    font-weight: 600;
                }

            /* ────────────────────────────────────────────────────────── */
            /* Responsive                                               */
            /* ────────────────────────────────────────────────────────── */
            @@media (max-width: 992px) {
                .header-premium {
                    padding: 2rem 1.5rem 1.5rem;
                }

                .body-content {
                    padding: 1.5rem 1.5rem 2rem;
                }

                .breakdown-grid {
                    grid-template-columns: 1fr;
                    gap: 1rem;
                }
            }

            @@media (max-width: 768px) {
                body {
                    padding: 1rem 0.75rem;
                }

                .report-wrapper {
                    border-radius: var(--radius-sm);
                }

                .header-premium {
                    padding: 1.5rem 1.25rem 1.25rem;
                }

                .header-title h1 {
                    font-size: 1.3rem;
                }

                .header-title .icon-wrapper {
                    width: 44px;
                    height: 44px;
                    font-size: 1.3rem;
                }

                .header-title .date-range {
                    font-size: 0.7rem;
                    padding: 0.15rem 0.6rem;
                }

                .header-content {
                    flex-direction: column;
                    align-items: flex-start;
                }

                .header-actions {
                    width: 100%;
                    justify-content: flex-start;
                }

                .body-content {
                    padding: 1rem 1rem 1.5rem;
                }

                .summary-grid {
                    grid-template-columns: 1fr 1fr;
                    gap: 0.75rem;
                }

                .summary-card {
                    padding: 1rem 0.75rem;
                }

                    .summary-card .card-value {
                        font-size: 1.3rem;
                    }

                .filter-row {
                    flex-direction: column;
                    align-items: stretch;
                }

                .filter-group {
                    flex: unset;
                }

                .filter-buttons {
                    justify-content: stretch;
                }

                    .filter-buttons .btn {
                        flex: 1;
                        justify-content: center;
                    }

                .table thead th,
                .table tbody td {
                    padding: 0.5rem 0.75rem;
                    font-size: 0.8rem;
                }

                .table-card .table-header {
                    padding: 0.6rem 1rem;
                }

                .toast-custom {
                    min-width: 250px;
                    margin: 0 0.5rem 0.75rem;
                }
            }

            @@media (max-width: 480px) {
                body {
                    padding: 0.5rem 0.5rem;
                }

                .header-premium {
                    padding: 1rem 1rem 1rem;
                    border-radius: var(--radius-xs) var(--radius-xs) 0 0;
                }

                .header-title h1 {
                    font-size: 1.1rem;
                }

                .header-title .icon-wrapper {
                    width: 36px;
                    height: 36px;
                    font-size: 1rem;
                }

                .body-content {
                    padding: 0.75rem 0.75rem 1rem;
                }

                .summary-grid {
                    grid-template-columns: 1fr 1fr;
                    gap: 0.5rem;
                }

                .summary-card {
                    padding: 0.75rem 0.5rem;
                }

                    .summary-card .card-value {
                        font-size: 1.1rem;
                    }

                    .summary-card .card-label {
                        font-size: 0.55rem;
                    }

                .breakdown-card {
                    padding: 1rem 0.75rem;
                }

                .table thead th,
                .table tbody td {
                    padding: 0.4rem 0.5rem;
                    font-size: 0.75rem;
                }

                .filter-buttons .btn {
                    font-size: 0.7rem;
                    padding: 0.35rem 0.8rem;
                }

                .toast-custom {
                    min-width: 200px;
                    padding: 0.75rem 1rem;
                }
            }
    </style>
</head>
<body>

    <!-- ─── Toast Container ─── -->
    <div class="toast-container" id="toastContainer"></div>

    <div class="report-wrapper">

        <!-- ─── HEADER ─── -->
        <div class="header-premium">
            <div class="header-content">
                <div class="header-title">
                    <div class="icon-wrapper">
                        <i class="bi bi-calendar-check"></i>
                    </div>
                    <div>
                        <h1>Booking Report</h1>
                        <span class="date-range">
                            <i class="bi bi-calendar3"></i>
                            @(Model.DateFrom?.ToString("dd/MM/yyyy") ?? "Start")
                            -
                            @(Model.DateTo?.ToString("dd/MM/yyyy") ?? "End")
                        </span>
                    </div>
                </div>
                <div class="header-actions">
                    <a asp-action="Bookings" asp-route-export="csv" class="btn-header btn-header-success">
                        <i class="bi bi-file-earmark-spreadsheet"></i> Export CSV
                    </a>
                    <a asp-action="Index" class="btn-header">
                        <i class="bi bi-arrow-left"></i> All Reports
                    </a>
                </div>
            </div>
        </div>

        <!-- ─── BODY ─── -->
        <div class="body-content">

            <!-- Alerts -->
            @if (TempData["Error"] != null)
            {
                <div class="alert-custom alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-circle-fill me-2"></i>
                    @TempData["Error"]
                    <button type="button" class="btn-close float-end" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @if (TempData["Success"] != null)
            {
                <div class="alert-custom alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i>
                    @TempData["Success"]
                    <button type="button" class="btn-close float-end" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <!-- ─── Filter Section ─── -->
            <div class="filter-section">
                <form method="get" id="filterForm">
                    <div class="filter-row">
                        <div class="filter-group">
                            <label><i class="bi bi-calendar3"></i> From Date</label>
                            <input type="date" name="from" class="form-control" value="@Model.DateFrom?.ToString("yyyy-MM-dd")" />
                        </div>

                        <div class="filter-group">
                            <label><i class="bi bi-calendar3"></i> To Date</label>
                            <input type="date" name="to" class="form-control" value="@Model.DateTo?.ToString("yyyy-MM-dd")" />
                        </div>

                        <div class="filter-group">
                            <label><i class="bi bi-filter"></i> Status</label>
                            <select name="status" class="form-select">
                                <option value="">All Statuses</option>
                                @foreach (BookingStatus status in Enum.GetValues(typeof(BookingStatus)))
                                {
                                    var selected = Model.Status == status ? "selected" : "";
                                    <option value="@status" selected="@selected">@status</option>
                                }
                            </select>
                        </div>

                        <div class="filter-buttons">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-funnel"></i> Filter
                            </button>
                            <a asp-action="Bookings" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-counterclockwise"></i> Reset
                            </a>
                        </div>
                    </div>
                </form>
            </div>

            <!-- ─── Summary Stats ─── -->
            <div class="summary-grid">
                <div class="summary-card primary">
                    <span class="card-icon primary"><i class="bi bi-calendar-check"></i></span>
                    <span class="card-label">Total Bookings</span>
                    <span class="card-value text-primary">@Model.TotalBookings</span>
                    <span class="card-sub">In selected date range</span>
                </div>

                <div class="summary-card success">
                    <span class="card-icon success"><i class="bi bi-check-circle"></i></span>
                    <span class="card-label">Completed</span>
                    <span class="card-value text-success">
                        @{
                            var completed = Model.StatusBreakdown.FirstOrDefault(s => s.Status == "Completed")?.Count ?? 0;
                        }
                        @completed
                    </span>
                    <span class="card-sub">
                        @(Model.TotalBookings > 0 ? (completed * 100 / Model.TotalBookings).ToString("F0") : "0")% of total
                    </span>
                </div>

                <div class="summary-card warning">
                    <span class="card-icon warning"><i class="bi bi-clock"></i></span>
                    <span class="card-label">Pending / In Progress</span>
                    <span class="card-value text-warning">
                        @{
                            var pending = Model.StatusBreakdown.FirstOrDefault(s => s.Status == "Pending")?.Count ?? 0;
                            var inProgress = Model.StatusBreakdown.FirstOrDefault(s => s.Status == "InProgress")?.Count ?? 0;
                        }
                        @(pending + inProgress)
                    </span>
                    <span class="card-sub">@pending pending, @inProgress in progress</span>
                </div>

                <div class="summary-card danger">
                    <span class="card-icon danger"><i class="bi bi-x-circle"></i></span>
                    <span class="card-label">Cancelled</span>
                    <span class="card-value text-danger">
                        @{
                            var cancelled = Model.StatusBreakdown.FirstOrDefault(s => s.Status == "Cancelled")?.Count ?? 0;
                        }
                        @cancelled
                    </span>
                    <span class="card-sub">
                        @(Model.TotalBookings > 0 ? (cancelled * 100 / Model.TotalBookings).ToString("F0") : "0")% of total
                    </span>
                </div>
            </div>

            <!-- ─── Breakdown Cards ─── -->
            <div class="breakdown-grid">

                <!-- Status Breakdown -->
                <div class="breakdown-card">
                    <div class="card-title">
                        <i class="bi bi-pie-chart"></i>
                        Status Breakdown
                        <span class="badge-count">@Model.StatusBreakdown.Count statuses</span>
                    </div>
                    <div class="table-responsive-custom">
                        <table class="table table-sm mb-0">
                            <tbody>
                                @if (Model.StatusBreakdown.Any())
                                {
                                    @foreach (var row in Model.StatusBreakdown)
                                    {
                                        var badgeClass = row.Status.ToLower() switch
                                        {
                                            "pending" => "bg-pending",
                                            "inprogress" => "bg-inprogress",
                                            "completed" => "bg-completed",
                                            "cancelled" => "bg-cancelled",
                                            _ => "bg-secondary"
                                        };
                                        var icon = row.Status.ToLower() switch
                                        {
                                            "pending" => "bi-clock",
                                            "inprogress" => "bi-arrow-repeat",
                                            "completed" => "bi-check-circle",
                                            "cancelled" => "bi-x-circle",
                                            _ => "bi-dot"
                                        };
                                        var percentage = Model.TotalBookings > 0 ? (row.Count * 100 / Model.TotalBookings) : 0;
                                        <tr>
                                            <td>
                                                <span class="badge-status @badgeClass">
                                                    <i class="bi @icon"></i> @row.Status
                                                </span>
                                            </td>
                                            <td class="text-end" style="font-weight:700;font-size:1.1rem;">
                                                @row.Count
                                            </td>
                                            <td class="text-end text-muted" style="width:60px;">
                                                @percentage%
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="3" class="empty-state" style="padding:1.5rem 0 !important;">
                                            <i class="bi bi-bar-chart" style="font-size:1.5rem;"></i>
                                            No data available
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Service Type Breakdown -->
                <div class="breakdown-card">
                    <div class="card-title">
                        <i class="bi bi-tools"></i>
                        Service Type Breakdown
                        <span class="badge-count">@Model.ByServiceType.Count types</span>
                    </div>
                    <div class="table-responsive-custom">
                        <table class="table table-sm mb-0">
                            <thead>
                                <tr>
                                    <th>Service Type</th>
                                    <th class="text-end">Bookings</th>
                                    <th class="text-end">Revenue</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.ByServiceType.Any())
                                {
                                    @foreach (var row in Model.ByServiceType)
                                    {
                                        <tr>
                                            <td>@row.ServiceTypeName</td>
                                            <td class="text-end">@row.BookingCount</td>
                                            <td class="text-end">₹@row.Revenue.ToString("N2")</td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="3" class="empty-state" style="padding:1.5rem 0 !important;">
                                            <i class="bi bi-tools" style="font-size:1.5rem;"></i>
                                            No service types found
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- ─── Booking Details Table ─── -->
            <div class="table-card">
                <div class="table-header">
                    <span class="title">
                        <i class="bi bi-list-ul"></i>
                        Booking Details
                    </span>
                    <span class="badge-total">@Model.Bookings.Count records</span>
                </div>

                <div class="table-responsive-custom">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Booking #</th>
                                <th>Date</th>
                                <th>Customer</th>
                                <th>Vehicle</th>
                                <th>Service Type</th>
                                <th>Mechanic</th>
                                <th>Status</th>
                                <th class="text-end">Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Bookings.Any())
                            {
                                @foreach (var row in Model.Bookings)
                                {
                                    var badgeClass = row.Status.ToLower() switch
                                    {
                                        "pending" => "bg-pending",
                                        "inprogress" => "bg-inprogress",
                                        "completed" => "bg-completed",
                                        "cancelled" => "bg-cancelled",
                                        _ => "bg-secondary"
                                    };
                                    var icon = row.Status.ToLower() switch
                                    {
                                        "pending" => "bi-clock",
                                        "inprogress" => "bi-arrow-repeat",
                                        "completed" => "bi-check-circle",
                                        "cancelled" => "bi-x-circle",
                                        _ => "bi-dot"
                                    };
                                    <tr>
                                        <td><strong>@row.BookingNumber</strong></td>
                                        <td>@row.BookingDate.ToString("dd-MMM-yyyy")</td>
                                        <td>@row.CustomerName</td>
                                        <td>@row.VehicleReg</td>
                                        <td>@row.ServiceTypeName</td>
                                        <td>@row.MechanicName</td>
                                        <td>
                                            <span class="badge-status @badgeClass">
                                                <i class="bi @icon"></i> @row.Status
                                            </span>
                                        </td>
                                        <td class="text-end" style="font-weight:600;">₹@row.Amount.ToString("N2")</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="8">
                                        <div class="empty-state">
                                            <i class="bi bi-calendar-x"></i>
                                            <h5>No Bookings Found</h5>
                                            <p class="text-muted">No bookings match the selected filter criteria.</p>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

        </div> <!-- /body-content -->
    </div> <!-- /report-wrapper -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <script>
            // ─── Toast Notification ───
            function showToast(message, type) {
                var container = document.getElementById('toastContainer');
                var toast = document.createElement('div');
                toast.className = 'toast-custom ' + (type || 'success');
                toast.innerHTML = `
                            <div class="toast-title">
                                <i class="bi ${type === 'error' ? 'bi-exclamation-circle-fill text-danger' : 'bi-check-circle-fill text-success'}"></i>
                                ${type === 'error' ? 'Error' : 'Success'}
                            </div>
                            <div class="toast-message">${message}</div>
                        `;
                container.appendChild(toast);

                setTimeout(function() {
                    toast.style.opacity = '0';
                    toast.style.transform = 'translateX(100px)';
                    toast.style.transition = '0.5s ease-out';
                    setTimeout(function() { toast.remove(); }, 500);
                }, 5000);
            }

            // ─── Show TempData Messages ───
            @if (TempData["Error"] != null)
                {
                    <text>showToast('@TempData["Error"]', 'error');</text>
            }

                @if (TempData["Success"] != null)
                {
                    <text>showToast('@TempData["Success"]', 'success');</text>
            }

                // ─── Auto-dismiss alerts ───
                setTimeout(function() {
                    document.querySelectorAll('.alert-custom').forEach(function(alert) {
                        var closeBtn = alert.querySelector('.btn-close');
                        if (closeBtn) {
                            closeBtn.click();
                        }
                    });
                }, 5000);
    </script>

</body>
</html>