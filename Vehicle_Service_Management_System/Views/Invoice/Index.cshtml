@model IEnumerable<Vehicle_Service_Management_System.Application.ViewModels.Invoice.InvoiceListViewModel>

@{
    ViewData["Title"] = "Invoices";
    Layout = null;
    var currentPage = ViewBag.CurrentPage ?? 1;
    var pageSize = ViewBag.PageSize ?? 10;
    var totalRecords = ViewBag.TotalRecords ?? 0;
    var totalPages = (int)Math.Ceiling((double)totalRecords / pageSize);
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Invoices | Vehicle Service Management</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <style>
            /* ────────────────────────────────────────────────────────── */
            /* Root Variables                                          */
            /* ────────────────────────────────────────────────────────── */
            :root {
                --primary: #0d6efd;
                --primary-dark: #0a58ca;
                --primary-light: #e8f0fe;
                --success: #22c55e;
                --danger: #ef4444;
                --warning: #f59e0b;
                --info: #0dcaf0;
                --dark: #1a2634;
                --gray: #6b7a8e;
                --gray-light: #eef2f7;
                --gray-bg: #f0f2f5;
                --white: #ffffff;
                --shadow-sm: 0 2px 8px rgba(0, 0, 0, 0.04);
                --shadow-md: 0 8px 30px rgba(0, 0, 0, 0.08);
                --shadow-lg: 0 16px 48px rgba(0, 0, 0, 0.12);
                --shadow-xl: 0 24px 64px rgba(0, 0, 0, 0.16);
                --radius: 20px;
                --radius-sm: 12px;
                --radius-xs: 8px;
                --transition: 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            }

            /* ────────────────────────────────────────────────────────── */
            /* Base Styles                                             */
            /* ────────────────────────────────────────────────────────── */
            body {
                background: var(--gray-bg);
                font-family: 'Inter', -apple-system, system-ui, sans-serif;
                padding: 1.5rem 1rem;
                min-height: 100vh;
                display: flex;
                align-items: flex-start;
                justify-content: center;
                color: var(--dark);
                line-height: 1.6;
            }

            .invoices-wrapper {
                max-width: 95%;
                width: 100%;
                background: var(--white);
                border-radius: var(--radius);
                box-shadow: var(--shadow-xl);
                overflow: hidden;
                animation: slideUp 0.5s ease-out;
            }

            @@keyframes slideUp {
                from {
                    opacity: 0;
                    transform: translateY(30px);
                }

                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            /* ────────────────────────────────────────────────────────── */
            /* Header - Premium Gradient                               */
            /* ────────────────────────────────────────────────────────── */
            .header-premium {
                background: linear-gradient(135deg, #0c0e1a 0%, #1a1a3e 40%, #0d6efd 100%);
                padding: 2rem 2.5rem 1.5rem;
                color: #fff;
                position: relative;
                overflow: hidden;
            }

                .header-premium::before {
                    content: '';
                    position: absolute;
                    top: -60%;
                    right: -10%;
                    width: 500px;
                    height: 500px;
                    background: radial-gradient(circle, rgba(255, 255, 255, 0.06) 0%, transparent 70%);
                    border-radius: 50%;
                    pointer-events: none;
                }

                .header-premium::after {
                    content: '';
                    position: absolute;
                    bottom: -40%;
                    left: -5%;
                    width: 300px;
                    height: 300px;
                    background: radial-gradient(circle, rgba(13, 202, 240, 0.08) 0%, transparent 70%);
                    border-radius: 50%;
                    pointer-events: none;
                }

            .header-content {
                position: relative;
                z-index: 1;
                display: flex;
                flex-wrap: wrap;
                align-items: center;
                justify-content: space-between;
                gap: 1rem;
            }

            .header-title {
                display: flex;
                align-items: center;
                gap: 0.75rem;
            }

                .header-title .icon-wrapper {
                    width: 48px;
                    height: 48px;
                    background: rgba(255, 255, 255, 0.15);
                    border-radius: 50%;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    font-size: 1.5rem;
                    backdrop-filter: blur(4px);
                    border: 1px solid rgba(255, 255, 255, 0.1);
                    flex-shrink: 0;
                }

                .header-title h1 {
                    font-weight: 800;
                    font-size: 1.6rem;
                    margin: 0;
                    letter-spacing: -0.02em;
                    background: linear-gradient(135deg, #fff 60%, #94a3b8);
                    -webkit-background-clip: text;
                    -webkit-text-fill-color: transparent;
                    background-clip: text;
                }

                .header-title .badge-count {
                    font-size: 0.75rem;
                    font-weight: 500;
                    color: rgba(255, 255, 255, 0.9);
                    background: rgba(255, 255, 255, 0.15);
                    padding: 0.15rem 0.7rem;
                    border-radius: 50px;
                    border: 1px solid rgba(255, 255, 255, 0.15);
                    -webkit-text-fill-color: rgba(255, 255, 255, 0.9);
                }

            .header-actions {
                display: flex;
                align-items: center;
                gap: 0.5rem;
                flex-wrap: wrap;
            }

            .btn-header {
                background: rgba(255, 255, 255, 0.12);
                border: 1px solid rgba(255, 255, 255, 0.15);
                color: #fff;
                border-radius: 50px;
                padding: 0.4rem 1.2rem;
                font-weight: 500;
                font-size: 0.8rem;
                transition: var(--transition);
                text-decoration: none;
                display: inline-flex;
                align-items: center;
                gap: 0.4rem;
                backdrop-filter: blur(4px);
            }

                .btn-header:hover {
                    background: rgba(255, 255, 255, 0.25);
                    transform: translateY(-2px);
                    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.2);
                    color: #fff;
                }

            .btn-header-primary {
                background: rgba(255, 255, 255, 0.2);
                border: 1px solid rgba(255, 255, 255, 0.3);
                color: #fff;
            }

                .btn-header-primary:hover {
                    background: rgba(255, 255, 255, 0.35);
                    color: #fff;
                }

            .btn-header-danger {
                background: rgba(239, 68, 68, 0.3);
                border: 1px solid rgba(239, 68, 68, 0.3);
                color: #fff;
            }

                .btn-header-danger:hover {
                    background: rgba(239, 68, 68, 0.5);
                    color: #fff;
                }

            /* ────────────────────────────────────────────────────────── */
            /* Toast / Notification                                     */
            /* ────────────────────────────────────────────────────────── */
            .toast-container {
                position: fixed;
                top: 20px;
                right: 20px;
                z-index: 9999;
            }

            .toast-custom {
                background: var(--white);
                border-radius: var(--radius-sm);
                padding: 1rem 1.5rem;
                box-shadow: var(--shadow-lg);
                border-left: 4px solid var(--primary);
                min-width: 300px;
                animation: slideInRight 0.5s ease-out;
                margin-bottom: 0.75rem;
            }

                .toast-custom.success {
                    border-left-color: var(--success);
                }

                .toast-custom.error {
                    border-left-color: var(--danger);
                }

                .toast-custom .toast-title {
                    font-weight: 700;
                    font-size: 0.95rem;
                }

                .toast-custom .toast-message {
                    font-size: 0.85rem;
                    color: var(--gray);
                }

            @@keyframes slideInRight {
                from {
                    opacity: 0;
                    transform: translateX(100px);
                }

                to {
                    opacity: 1;
                    transform: translateX(0);
                }
            }

            /* ────────────────────────────────────────────────────────── */
            /* Body                                                     */
            /* ────────────────────────────────────────────────────────── */
            .body-content {
                padding: 1.5rem 2rem 2rem;
            }

            /* ────────────────────────────────────────────────────────── */
            /* Alert Messages                                           */
            /* ────────────────────────────────────────────────────────── */
            .alert-custom {
                border-radius: var(--radius-sm);
                padding: 0.75rem 1.25rem;
                border: none;
                box-shadow: var(--shadow-sm);
                margin-bottom: 1rem;
                font-size: 0.9rem;
            }

                .alert-custom.alert-danger {
                    background: #fee2e2;
                    color: #991b1b;
                    border-left: 4px solid var(--danger);
                }

                .alert-custom.alert-success {
                    background: #dcfce7;
                    color: #166534;
                    border-left: 4px solid var(--success);
                }

            /* ────────────────────────────────────────────────────────── */
            /* Stats Row - Modern Cards                                */
            /* ────────────────────────────────────────────────────────── */
            .stats-grid {
                display: grid;
                grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
                gap: 0.75rem;
                margin-bottom: 1.25rem;
            }

            .stat-card {
                background: var(--gray-bg);
                border-radius: var(--radius-sm);
                padding: 0.75rem 1rem;
                text-align: center;
                border: 1px solid var(--gray-light);
                transition: var(--transition);
                position: relative;
                overflow: hidden;
            }

                .stat-card::before {
                    content: '';
                    position: absolute;
                    top: 0;
                    left: 0;
                    right: 0;
                    height: 3px;
                    background: linear-gradient(90deg, var(--primary), var(--info));
                    opacity: 0;
                    transition: var(--transition);
                }

                .stat-card:hover {
                    transform: translateY(-3px);
                    box-shadow: var(--shadow-sm);
                    border-color: var(--primary);
                }

                    .stat-card:hover::before {
                        opacity: 1;
                    }

                .stat-card .stat-number {
                    font-size: 1.3rem;
                    font-weight: 800;
                    color: var(--dark);
                    display: block;
                    letter-spacing: -0.02em;
                }

                .stat-card .stat-label {
                    font-size: 0.65rem;
                    text-transform: uppercase;
                    letter-spacing: 0.06em;
                    color: var(--gray);
                    font-weight: 600;
                    display: block;
                    margin-top: 0.1rem;
                }

                .stat-card .stat-icon {
                    font-size: 1rem;
                    color: var(--primary);
                    opacity: 0.3;
                    position: absolute;
                    right: 0.5rem;
                    bottom: 0.3rem;
                }

            /* ────────────────────────────────────────────────────────── */
            /* Filter Section                                           */
            /* ────────────────────────────────────────────────────────── */
            .filter-section {
                background: var(--gray-bg);
                border-radius: var(--radius-sm);
                padding: 0.75rem 1.25rem;
                margin-bottom: 1rem;
                border: 1px solid var(--gray-light);
                transition: var(--transition);
            }

                .filter-section:hover {
                    border-color: var(--primary);
                }

            .filter-row {
                display: flex;
                flex-wrap: wrap;
                align-items: center;
                gap: 0.5rem 1rem;
            }

                .filter-row + .filter-row {
                    margin-top: 0.5rem;
                }

            .filter-label {
                font-weight: 600;
                color: var(--dark);
                font-size: 0.8rem;
                margin-right: 0.1rem;
                white-space: nowrap;
            }

                .filter-label i {
                    color: var(--primary);
                }

            .search-wrapper {
                position: relative;
                flex: 1 1 250px;
                min-width: 180px;
            }

                .search-wrapper .form-control {
                    border: 1.5px solid var(--gray-light);
                    background: var(--white);
                    border-radius: 50px;
                    padding: 0.4rem 1.8rem 0.4rem 1rem;
                    font-size: 0.85rem;
                    transition: var(--transition);
                    width: 100%;
                    height: 36px;
                }

                    .search-wrapper .form-control:focus {
                        border-color: var(--primary);
                        box-shadow: 0 0 0 3px rgba(13, 110, 253, 0.12);
                    }

                    .search-wrapper .form-control::placeholder {
                        color: var(--gray);
                        font-size: 0.8rem;
                    }

            .search-clear {
                position: absolute;
                right: 8px;
                top: 50%;
                transform: translateY(-50%);
                background: none;
                border: none;
                color: var(--gray);
                cursor: pointer;
                font-size: 0.9rem;
                padding: 0.1rem 0.3rem;
                display: none;
                transition: var(--transition);
                line-height: 1;
                z-index: 5;
            }

                .search-clear:hover {
                    color: var(--danger);
                }

                .search-clear.visible {
                    display: block;
                }

            .filter-input {
                border: 1.5px solid var(--gray-light);
                background: var(--white);
                border-radius: 50px;
                padding: 0.4rem 1rem;
                font-size: 0.85rem;
                transition: var(--transition);
                min-width: 120px;
                height: 36px;
            }

                .filter-input:focus {
                    border-color: var(--primary);
                    box-shadow: 0 0 0 3px rgba(13, 110, 253, 0.12);
                    outline: none;
                }

            .date-separator {
                color: var(--gray);
                font-weight: 500;
                margin: 0 0.1rem;
                font-size: 0.8rem;
            }

            .filter-buttons {
                display: flex;
                flex-wrap: wrap;
                gap: 0.4rem;
            }

                .filter-buttons .btn {
                    border-radius: 50px;
                    padding: 0.3rem 1.2rem;
                    font-weight: 600;
                    font-size: 0.75rem;
                    transition: var(--transition);
                    text-transform: uppercase;
                    letter-spacing: 0.04em;
                    height: 36px;
                }

                .filter-buttons .btn-primary {
                    background: linear-gradient(135deg, #0d6efd, #0a58ca);
                    border: none;
                    color: #fff;
                    box-shadow: 0 2px 10px rgba(13, 110, 253, 0.25);
                }

                    .filter-buttons .btn-primary:hover {
                        transform: translateY(-2px);
                        box-shadow: 0 4px 18px rgba(13, 110, 253, 0.35);
                    }

                .filter-buttons .btn-outline-secondary {
                    background: transparent;
                    color: var(--gray);
                    border: 1.5px solid var(--gray-light);
                }

                    .filter-buttons .btn-outline-secondary:hover {
                        background: var(--gray-bg);
                        border-color: var(--gray);
                        color: var(--dark);
                    }

            /* ────────────────────────────────────────────────────────── */
            /* Table Card                                               */
            /* ────────────────────────────────────────────────────────── */
            .table-card {
                background: var(--white);
                border-radius: var(--radius-sm);
                border: 1px solid var(--gray-light);
                overflow: hidden;
                box-shadow: var(--shadow-sm);
            }

                .table-card .table-header {
                    background: var(--gray-bg);
                    padding: 0.5rem 1.25rem;
                    border-bottom: 1px solid var(--gray-light);
                    display: flex;
                    flex-wrap: wrap;
                    align-items: center;
                    justify-content: space-between;
                    gap: 0.5rem;
                }

                    .table-card .table-header .title {
                        font-weight: 600;
                        font-size: 0.85rem;
                        color: var(--dark);
                        display: flex;
                        align-items: center;
                        gap: 0.4rem;
                    }

                        .table-card .table-header .title i {
                            color: var(--primary);
                        }

            /* ────────────────────────────────────────────────────────── */
            /* Table Styling - One Line Rows                           */
            /* ────────────────────────────────────────────────────────── */
            .table-responsive-custom {
                overflow-x: auto;
                -webkit-overflow-scrolling: touch;
            }

            .table {
                margin: 0;
                font-size: 0.8rem;
                vertical-align: middle;
                border-collapse: separate;
                border-spacing: 0;
                min-width: 800px;
                width: 100%;
            }

                .table thead th {
                    background: var(--gray-bg);
                    color: var(--dark);
                    font-weight: 600;
                    font-size: 0.65rem;
                    text-transform: uppercase;
                    letter-spacing: 0.04em;
                    padding: 0.5rem 0.6rem;
                    border-bottom: 2px solid var(--gray-light);
                    white-space: nowrap;
                    text-align: left;
                }

                    .table thead th i {
                        margin-right: 0.2rem;
                        color: var(--primary);
                        font-size: 0.7rem;
                    }

                    .table thead th.text-end {
                        text-align: right;
                    }

                    .table thead th.text-center {
                        text-align: center;
                    }

                .table tbody td {
                    padding: 0.4rem 0.6rem;
                    border-bottom: 1px solid var(--gray-light);
                    background: var(--white);
                    transition: background var(--transition);
                    white-space: nowrap;
                    vertical-align: middle;
                }

                .table tbody tr:hover td {
                    background: var(--gray-bg);
                }

                .table tbody tr:last-child td {
                    border-bottom: none;
                }

                /* Column Widths */
                .table .col-sno {
                    width: 40px;
                    text-align: center;
                }

                .table .col-invoice {
                    width: 110px;
                    font-weight: 600;
                }

                .table .col-customer {
                    width: 140px;
                }

                .table .col-vehicle {
                    width: 120px;
                }

                .table .col-amount {
                    width: 100px;
                    text-align: right;
                    font-weight: 600;
                }

                .table .col-paid {
                    width: 100px;
                    text-align: right;
                }

                .table .col-balance {
                    width: 100px;
                    text-align: right;
                    font-weight: 600;
                }

                .table .col-status {
                    width: 90px;
                    text-align: center;
                }

                .table .col-date {
                    width: 90px;
                    text-align: center;
                }

                .table .col-actions {
                    width: 180px;
                    text-align: right;
                }

            /* ────────────────────────────────────────────────────────── */
            /* Status Badge                                            */
            /* ────────────────────────────────────────────────────────── */
            .badge-status {
                font-weight: 600;
                padding: 0.15rem 0.7rem;
                border-radius: 50px;
                font-size: 0.65rem;
                display: inline-flex;
                align-items: center;
                gap: 0.25rem;
                text-transform: uppercase;
                letter-spacing: 0.03em;
            }

                .badge-status.bg-paid {
                    background: #dcfce7;
                    color: #166534;
                }

                .badge-status.bg-unpaid {
                    background: #fee2e2;
                    color: #991b1b;
                }

                .badge-status i {
                    font-size: 0.55rem;
                }

            /* ────────────────────────────────────────────────────────── */
            /* Action Buttons                                           */
            /* ────────────────────────────────────────────────────────── */
            .action-group {
                display: flex;
                flex-wrap: nowrap;
                gap: 0.2rem;
                align-items: center;
                justify-content: flex-end;
            }

                .action-group .btn {
                    border-radius: 50px;
                    padding: 0.15rem 0.5rem;
                    font-size: 0.6rem;
                    font-weight: 600;
                    transition: var(--transition);
                    display: inline-flex;
                    align-items: center;
                    gap: 0.2rem;
                    text-transform: uppercase;
                    letter-spacing: 0.02em;
                    white-space: nowrap;
                    height: 26px;
                }

                    .action-group .btn:hover {
                        transform: translateY(-2px);
                        box-shadow: var(--shadow-sm);
                    }

                .action-group .btn-outline-info {
                    border-color: var(--gray-light);
                    color: var(--primary);
                }

                    .action-group .btn-outline-info:hover {
                        background: var(--primary-light);
                        border-color: var(--primary);
                    }

                .action-group .btn-outline-secondary {
                    border-color: var(--gray-light);
                    color: var(--gray);
                }

                    .action-group .btn-outline-secondary:hover {
                        background: var(--gray-bg);
                        border-color: var(--gray);
                        color: var(--dark);
                    }

                .action-group .btn-success {
                    background: linear-gradient(135deg, #22c55e, #16a34a);
                    border: none;
                    color: #fff;
                    box-shadow: 0 2px 6px rgba(34, 197, 94, 0.25);
                }

                    .action-group .btn-success:hover {
                        box-shadow: 0 4px 12px rgba(34, 197, 94, 0.35);
                    }

                .action-group .btn-warning {
                    background: linear-gradient(135deg, #f59e0b, #d97706);
                    border: none;
                    color: #fff;
                    box-shadow: 0 2px 6px rgba(245, 158, 11, 0.25);
                }

                    .action-group .btn-warning:hover {
                        box-shadow: 0 4px 12px rgba(245, 158, 11, 0.35);
                    }

                .action-group .btn i {
                    font-size: 0.6rem;
                }

            /* ────────────────────────────────────────────────────────── */
            /* Empty State                                              */
            /* ────────────────────────────────────────────────────────── */
            .empty-state {
                padding: 2.5rem 1rem !important;
                text-align: center;
                color: var(--gray);
                font-size: 0.9rem;
            }

                .empty-state i {
                    font-size: 2.5rem;
                    display: block;
                    margin-bottom: 0.5rem;
                    color: var(--gray-light);
                }

                .empty-state h5 {
                    color: var(--dark);
                    font-weight: 600;
                    font-size: 1.1rem;
                }

            /* ────────────────────────────────────────────────────────── */
            /* Pagination                                               */
            /* ────────────────────────────────────────────────────────── */
            .pagination-wrapper {
                display: flex;
                justify-content: space-between;
                align-items: center;
                flex-wrap: wrap;
                gap: 0.5rem;
                padding: 0.5rem 1.25rem;
                background: var(--gray-bg);
                border-top: 1px solid var(--gray-light);
            }

            .pagination-info {
                font-size: 0.8rem;
                color: var(--gray);
            }

                .pagination-info strong {
                    color: var(--dark);
                }

            .pagination-controls {
                display: flex;
                align-items: center;
                gap: 0.2rem;
                flex-wrap: wrap;
            }

                .pagination-controls .page-link {
                    border-radius: 50px;
                    padding: 0.2rem 0.6rem;
                    font-size: 0.75rem;
                    border: 1.5px solid var(--gray-light);
                    color: var(--dark);
                    background: var(--white);
                    transition: var(--transition);
                    cursor: pointer;
                    text-decoration: none;
                    display: inline-flex;
                    align-items: center;
                    justify-content: center;
                    min-width: 30px;
                    height: 30px;
                    font-weight: 500;
                }

                    .pagination-controls .page-link:hover {
                        background: var(--gray-bg);
                        border-color: var(--primary);
                    }

                    .pagination-controls .page-link.active {
                        background: linear-gradient(135deg, #0d6efd, #0a58ca);
                        color: #fff;
                        border-color: var(--primary);
                        box-shadow: 0 2px 8px rgba(13, 110, 253, 0.25);
                    }

                    .pagination-controls .page-link.disabled {
                        opacity: 0.4;
                        pointer-events: none;
                    }

            /* ────────────────────────────────────────────────────────── */
            /* Table Footer                                             */
            /* ────────────────────────────────────────────────────────── */
            .table-footer {
                padding: 0.5rem 1.25rem;
                background: var(--gray-bg);
                border-top: 1px solid var(--gray-light);
                font-size: 0.8rem;
                color: var(--gray);
                display: flex;
                flex-wrap: wrap;
                justify-content: space-between;
                align-items: center;
                gap: 0.5rem;
            }

                .table-footer strong {
                    color: var(--dark);
                }

            /* ────────────────────────────────────────────────────────── */
            /* Responsive - Optimized for 90% Screen                   */
            /* ────────────────────────────────────────────────────────── */
            @@media (max-width: 1400px) {
                .invoices-wrapper {
                    max-width: 98%;
                }
            }

            @@media (max-width: 1200px) {
                .invoices-wrapper {
                    max-width: 100%;
                }

                .table .col-customer {
                    width: 110px;
                }

                .table .col-vehicle {
                    width: 100px;
                }

                .table .col-amount,
                .table .col-paid,
                .table .col-balance {
                    width: 80px;
                }
            }

            @@media (max-width: 992px) {
                .header-premium {
                    padding: 1.5rem 1.5rem 1rem;
                }

                .body-content {
                    padding: 1rem 1rem 1.5rem;
                }

                .table {
                    font-size: 0.75rem;
                    min-width: 700px;
                }

                    .table thead th {
                        font-size: 0.6rem;
                        padding: 0.4rem 0.4rem;
                    }

                    .table tbody td {
                        padding: 0.3rem 0.4rem;
                    }

                    .table .col-invoice {
                        width: 90px;
                    }

                    .table .col-customer {
                        width: 90px;
                    }

                    .table .col-vehicle {
                        width: 80px;
                    }

                    .table .col-amount,
                    .table .col-paid,
                    .table .col-balance {
                        width: 70px;
                    }

                    .table .col-actions {
                        width: 150px;
                    }

                .action-group .btn {
                    font-size: 0.55rem;
                    padding: 0.1rem 0.4rem;
                    height: 22px;
                }
            }

            @@media (max-width: 768px) {
                body {
                    padding: 0.75rem 0.5rem;
                }

                .invoices-wrapper {
                    border-radius: var(--radius-sm);
                }

                .header-premium {
                    padding: 1rem 1rem 0.75rem;
                }

                .header-title h1 {
                    font-size: 1.2rem;
                }

                .header-title .icon-wrapper {
                    width: 36px;
                    height: 36px;
                    font-size: 1.1rem;
                }

                .header-title .badge-count {
                    font-size: 0.65rem;
                    padding: 0.1rem 0.5rem;
                }

                .header-content {
                    flex-direction: column;
                    align-items: flex-start;
                }

                .header-actions {
                    width: 100%;
                    justify-content: flex-start;
                }

                .btn-header {
                    font-size: 0.7rem;
                    padding: 0.3rem 0.8rem;
                }

                .body-content {
                    padding: 0.75rem 0.75rem 1rem;
                }

                .stats-grid {
                    grid-template-columns: 1fr 1fr;
                    gap: 0.5rem;
                }

                .stat-card {
                    padding: 0.5rem 0.6rem;
                }

                    .stat-card .stat-number {
                        font-size: 1rem;
                    }

                    .stat-card .stat-label {
                        font-size: 0.55rem;
                    }

                .filter-row {
                    flex-direction: column;
                    align-items: stretch;
                }

                .search-wrapper {
                    flex: unset;
                    min-width: unset;
                }

                .filter-input {
                    width: 100%;
                    min-width: unset;
                }

                .filter-buttons {
                    justify-content: stretch;
                }

                    .filter-buttons .btn {
                        flex: 1;
                        justify-content: center;
                        height: 32px;
                        font-size: 0.7rem;
                    }

                .table {
                    font-size: 0.7rem;
                    min-width: 600px;
                }

                    .table thead th {
                        font-size: 0.55rem;
                        padding: 0.3rem 0.3rem;
                    }

                    .table tbody td {
                        padding: 0.25rem 0.3rem;
                    }

                    .table .col-invoice {
                        width: 75px;
                    }

                    .table .col-customer {
                        width: 75px;
                    }

                    .table .col-vehicle {
                        width: 65px;
                    }

                    .table .col-amount,
                    .table .col-paid,
                    .table .col-balance {
                        width: 60px;
                    }

                    .table .col-actions {
                        width: 120px;
                    }

                .action-group .btn {
                    font-size: 0.5rem;
                    padding: 0.1rem 0.3rem;
                    height: 20px;
                }

                    .action-group .btn i {
                        font-size: 0.5rem;
                    }

                .badge-status {
                    font-size: 0.55rem;
                    padding: 0.1rem 0.4rem;
                }

                .pagination-wrapper {
                    flex-direction: column;
                    align-items: stretch;
                    gap: 0.5rem;
                }

                .pagination-controls {
                    justify-content: center;
                }

                    .pagination-controls .page-link {
                        min-width: 26px;
                        height: 26px;
                        font-size: 0.65rem;
                        padding: 0.1rem 0.4rem;
                    }

                .table-footer {
                    flex-direction: column;
                    text-align: center;
                    padding: 0.4rem 0.75rem;
                    font-size: 0.7rem;
                }

                .toast-custom {
                    min-width: 200px;
                    margin: 0 0.3rem 0.5rem;
                    padding: 0.75rem 1rem;
                }
            }

            @@media (max-width: 480px) {
                body {
                    padding: 0.3rem 0.3rem;
                }

                .header-premium {
                    padding: 0.75rem 0.75rem 0.5rem;
                    border-radius: var(--radius-xs) var(--radius-xs) 0 0;
                }

                .header-title h1 {
                    font-size: 1rem;
                }

                .header-title .icon-wrapper {
                    width: 30px;
                    height: 30px;
                    font-size: 0.9rem;
                }

                .body-content {
                    padding: 0.5rem 0.5rem 0.75rem;
                }

                .stats-grid {
                    grid-template-columns: 1fr 1fr;
                    gap: 0.3rem;
                }

                .stat-card {
                    padding: 0.4rem 0.4rem;
                }

                    .stat-card .stat-number {
                        font-size: 0.9rem;
                    }

                    .stat-card .stat-label {
                        font-size: 0.5rem;
                    }

                .table {
                    font-size: 0.6rem;
                    min-width: 500px;
                }

                    .table thead th {
                        font-size: 0.5rem;
                        padding: 0.2rem 0.2rem;
                    }

                    .table tbody td {
                        padding: 0.2rem 0.2rem;
                    }

                    .table .col-invoice {
                        width: 60px;
                    }

                    .table .col-customer {
                        width: 60px;
                    }

                    .table .col-vehicle {
                        width: 50px;
                    }

                    .table .col-amount,
                    .table .col-paid,
                    .table .col-balance {
                        width: 50px;
                    }

                    .table .col-actions {
                        width: 90px;
                    }

                .action-group .btn {
                    font-size: 0.45rem;
                    padding: 0.05rem 0.25rem;
                    height: 18px;
                }

                    .action-group .btn i {
                        font-size: 0.4rem;
                    }

                .badge-status {
                    font-size: 0.45rem;
                    padding: 0.05rem 0.3rem;
                }

                .pagination-controls .page-link {
                    min-width: 22px;
                    height: 22px;
                    font-size: 0.55rem;
                    padding: 0.05rem 0.3rem;
                }

                .table-footer {
                    font-size: 0.6rem;
                    padding: 0.3rem 0.5rem;
                }
            }
    </style>
</head>
<body>

    <!-- ─── Toast Container ─── -->
    <div class="toast-container" id="toastContainer"></div>

    <div class="invoices-wrapper">

        <!-- ─── HEADER ─── -->
        <div class="header-premium">
            <div class="header-content">
                <div class="header-title">
                    <div class="icon-wrapper">
                        <i class="bi bi-receipt"></i>
                    </div>
                    <div>
                        <h1>Invoice List</h1>
                        <span class="badge-count">@totalRecords records</span>
                    </div>
                </div>
                <div class="header-actions">
                    <a asp-action="Create" class="btn-header btn-header-primary">
                        <i class="bi bi-plus-lg"></i> Generate Invoice
                    </a>
                    <a asp-action="Deleted" class="btn-header btn-header-danger">
                        <i class="bi bi-archive"></i> Deleted
                    </a>
                </div>
            </div>
        </div>

        <!-- ─── BODY ─── -->
        <div class="body-content">

            <!-- Alerts -->
            @if (TempData["Error"] != null)
            {
                <div class="alert-custom alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-circle-fill me-2"></i>
                    @TempData["Error"]
                    <button type="button" class="btn-close float-end" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @if (TempData["Success"] != null)
            {
                <div class="alert-custom alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i>
                    @TempData["Success"]
                    <button type="button" class="btn-close float-end" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <!-- ─── Stats ─── -->
            <div class="stats-grid">
                <div class="stat-card">
                    <span class="stat-number">@totalRecords</span>
                    <span class="stat-label">Total Invoices</span>
                    <i class="bi bi-receipt stat-icon"></i>
                </div>
                <div class="stat-card">
                    <span class="stat-number">
                        @{
                            int paidCount = Model.Count(m => m.IsPaid);
                        }
                        @paidCount
                    </span>
                    <span class="stat-label">Paid</span>
                    <i class="bi bi-check-circle stat-icon"></i>
                </div>
                <div class="stat-card">
                    <span class="stat-number">
                        @{
                            int unpaidCount = Model.Count(m => !m.IsPaid);
                        }
                        @unpaidCount
                    </span>
                    <span class="stat-label">Unpaid</span>
                    <i class="bi bi-x-circle stat-icon"></i>
                </div>
                <div class="stat-card">
                    <span class="stat-number">
                        @{
                            decimal totalRevenue = Model.Sum(m => m.GrandTotal);
                        }
                        @totalRevenue.ToString("N0")
                    </span>
                    <span class="stat-label">Total Revenue</span>
                    <i class="bi bi-currency-rupee stat-icon"></i>
                </div>
            </div>

            <!-- ─── Filter Section ─── -->
            <form asp-action="Index" method="get" id="filterForm">
                <input type="hidden" name="page" id="pageInput" value="@currentPage" />
                <input type="hidden" name="pageSize" value="@pageSize" />

                <div class="filter-section">
                    <div class="filter-row">
                        <span class="filter-label"><i class="bi bi-search"></i> Search</span>
                        <div class="search-wrapper">
                            <input type="text" name="search" id="searchInput" value="@ViewBag.Search"
                                   class="form-control"
                                   placeholder="Invoice, Customer, Vehicle…" />
                            <button type="button" class="search-clear" id="searchClear" title="Clear search">
                                <i class="bi bi-x-circle-fill"></i>
                            </button>
                        </div>
                    </div>

                    <div class="filter-row">
                        <span class="filter-label"><i class="bi bi-calendar3"></i> Date Range</span>
                        <input type="date" name="dateFrom" id="dateFrom" value="@ViewBag.DateFrom" class="filter-input" />
                        <span class="date-separator">to</span>
                        <input type="date" name="dateTo" id="dateTo" value="@ViewBag.DateTo" class="filter-input" />

                        <div class="filter-buttons">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-funnel"></i> Filter
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-counterclockwise"></i> Reset
                            </a>
                        </div>
                    </div>
                </div>
            </form>

            <!-- ─── Table ─── -->
            <div class="table-card">
                <div class="table-header">
                    <span class="title">
                        <i class="bi bi-table"></i>
                        Invoice List
                    </span>
                    <span class="text-muted" style="font-size:0.75rem;">
                        <i class="bi bi-info-circle"></i>
                        @totalRecords record(s)
                    </span>
                </div>

                <div class="table-responsive-custom">
                    <table class="table">
                        <thead>
                            <tr>
                                <th class="col-sno">#</th>
                                <th class="col-invoice"><i class="bi bi-hash"></i> Invoice No.</th>
                                <th class="col-customer"><i class="bi bi-person"></i> Customer</th>
                                <th class="col-vehicle"><i class="bi bi-truck"></i> Vehicle</th>
                                <th class="col-amount"><i class="bi bi-currency-rupee"></i> Grand Total</th>
                                <th class="col-paid"><i class="bi bi-check-circle"></i> Paid</th>
                                <th class="col-balance"><i class="bi bi-arrow-left-right"></i> Balance</th>
                                <th class="col-status"><i class="bi bi-info-circle"></i> Status</th>
                                <th class="col-date"><i class="bi bi-calendar3"></i> Date</th>
                                <th class="col-actions"><i class="bi bi-gear"></i> Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Any())
                            {
                                int srNo = 1;
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td class="col-sno">@srNo</td>
                                        <td class="col-invoice"><span style="font-weight:600;">@item.InvoiceNumber</span></td>
                                        <td class="col-customer">@item.CustomerName</td>
                                        <td class="col-vehicle">@item.VehicleRegistrationNumber</td>
                                        <td class="col-amount">@item.GrandTotal.ToString("N2")</td>
                                        <td class="col-paid" style="color:var(--success);">@item.AmountPaid.ToString("N2")</td>
                                        <td class="col-balance" style="color:@(item.Balance > 0 ? "var(--danger)" : "var(--success)");">
                                            @item.Balance.ToString("N2")
                                        </td>
                                        <td class="col-status">
                                            <span class="badge-status @(item.IsPaid ? "bg-paid" : "bg-unpaid")">
                                                <i class="bi @(item.IsPaid ? "bi-check-circle-fill" : "bi-x-circle-fill")"></i>
                                                @(item.IsPaid ? "Paid" : "Unpaid")
                                            </span>
                                        </td>
                                        <td class="col-date">@item.CreatedOn.ToString("dd-MM-yyyy")</td>
                                        <td class="col-actions">
                                            <div class="action-group">
                                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info" title="View">
                                                    <i class="bi bi-eye"></i> View
                                                </a>
                                                <a asp-action="Print" asp-route-id="@item.Id" class="btn btn-outline-secondary" title="Print" target="_blank">
                                                    <i class="bi bi-printer"></i>
                                                </a>
                                                @if (!item.IsPaid)
                                                {
                                                    <form asp-action="MarkAsPaid" asp-route-id="@item.Id" method="post" style="display:inline;">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-success" title="Paid"
                                                                onclick="return confirm('Mark this invoice as paid?');">
                                                            <i class="bi bi-check2"></i> Paid
                                                        </button>
                                                    </form>
                                                }
                                                else
                                                {
                                                    <form asp-action="MarkAsUnpaid" asp-route-id="@item.Id" method="post" style="display:inline;">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-warning" title="Unpaid"
                                                                onclick="return confirm('Mark this invoice as unpaid?');">
                                                            <i class="bi bi-arrow-counterclockwise"></i> Unpaid
                                                        </button>
                                                    </form>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                    srNo++;
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="10">
                                        <div class="empty-state">
                                            <i class="bi bi-receipt"></i>
                                            <h5>No Invoices Found</h5>
                                            <p class="text-muted">There are no invoices matching your criteria.</p>
                                            <a asp-action="Create" class="btn btn-primary mt-2" style="border-radius:50px;padding:0.4rem 1.2rem;font-size:0.8rem;">
                                                <i class="bi bi-plus-lg"></i> Generate Invoice
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- ─── Pagination ─── -->
                @if (totalRecords > 0)
                {
                    <div class="pagination-wrapper">
                        <div class="pagination-info">
                            <i class="bi bi-database"></i>
                            Showing <strong>@((currentPage - 1) * pageSize + 1)</strong> –
                            <strong>@Math.Min(currentPage * pageSize, totalRecords)</strong>
                            of <strong>@totalRecords</strong>
                        </div>
                        <div class="pagination-controls">
                            <a href="#" class="page-link @(currentPage <= 1 ? "disabled" : "")"
                               data-page="@(currentPage - 1)" data-action="page">
                                <i class="bi bi-chevron-left"></i>
                            </a>
                            @for (int p = 1; p <= totalPages; p++)
                            {
                                if (p == currentPage || p == 1 || p == totalPages || Math.Abs(p - currentPage) <= 2)
                                {
                                    <a href="#" class="page-link @(p == currentPage ? "active" : "")"
                                       data-page="@p" data-action="page">@p</a>
                                }
                                else if (p == currentPage - 3 || p == currentPage + 3)
                                {
                                    <span class="page-link disabled">…</span>
                                }
                            }
                            <a href="#" class="page-link @(currentPage >= totalPages ? "disabled" : "")"
                               data-page="@(currentPage + 1)" data-action="page">
                                <i class="bi bi-chevron-right"></i>
                            </a>
                        </div>
                    </div>
                }
            </div>

            <!-- ─── Table Footer ─── -->
            <div class="table-footer">
                <span>
                    <i class="bi bi-database"></i>
                    Total: <strong>@totalRecords</strong>
                </span>
                <span>
                    <i class="bi bi-clock-history"></i>
                    @DateTime.Now.ToString("dd/MM/yyyy HH:mm")
                </span>
            </div>

        </div> <!-- /body-content -->
    </div> <!-- /invoices-wrapper -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <script>
            document.addEventListener('DOMContentLoaded', function() {
                // ─── Toast Notification ───
                function showToast(message, type) {
                    var container = document.getElementById('toastContainer');
                    var toast = document.createElement('div');
                    toast.className = 'toast-custom ' + (type || 'success');
                    toast.innerHTML = `
                                <div class="toast-title">
                                    <i class="bi ${type === 'error' ? 'bi-exclamation-circle-fill text-danger' : 'bi-check-circle-fill text-success'}"></i>
                                    ${type === 'error' ? 'Error' : 'Success'}
                                </div>
                                <div class="toast-message">${message}</div>
                            `;
                    container.appendChild(toast);

                    setTimeout(function() {
                        toast.style.opacity = '0';
                        toast.style.transform = 'translateX(100px)';
                        toast.style.transition = '0.5s ease-out';
                        setTimeout(function() { toast.remove(); }, 500);
                    }, 5000);
                }

                // ─── Show TempData Messages ───
                @if (TempData["Error"] != null)
                    {
                        <text>showToast('@TempData["Error"]', 'error');</text>
                }

                    @if (TempData["Success"] != null)
                    {
                        <text>showToast('@TempData["Success"]', 'success');</text>
                }

                        // ─── Form Elements ───
                        var form = document.getElementById('filterForm');
                var searchInput = document.getElementById('searchInput');
                var clearBtn = document.getElementById('searchClear');
                var dateFrom = document.getElementById('dateFrom');
                var dateTo = document.getElementById('dateTo');
                var pageInput = document.getElementById('pageInput');

                // ─── Toggle Clear Button ───
                function toggleClearButton() {
                    if (searchInput.value.length > 0) {
                        clearBtn.classList.add('visible');
                    } else {
                        clearBtn.classList.remove('visible');
                    }
                }
                toggleClearButton();
                searchInput.addEventListener('input', toggleClearButton);

                // ─── Clear Search ───
                clearBtn.addEventListener('click', function(e) {
                    e.preventDefault();
                    searchInput.value = '';
                    toggleClearButton();
                    pageInput.value = 1;
                    form.submit();
                });

                // ─── Search with Debounce ───
                var searchTimer = null;
                searchInput.addEventListener('input', function() {
                    clearTimeout(searchTimer);
                    searchTimer = setTimeout(function() {
                        pageInput.value = 1;
                        form.submit();
                    }, 400);
                });

                // ─── Date Filter Change ───
                [dateFrom, dateTo].forEach(function(input) {
                    input.addEventListener('change', function() {
                        pageInput.value = 1;
                        form.submit();
                    });
                });

                // ─── Pagination Clicks ───
                document.querySelectorAll('.pagination-controls .page-link[data-action="page"]').forEach(function(link) {
                    link.addEventListener('click', function(e) {
                        e.preventDefault();
                        var page = parseInt(this.getAttribute('data-page'));
                        if (!isNaN(page) && page > 0) {
                            pageInput.value = page;
                            form.submit();
                        }
                    });
                });

                // ─── Auto-dismiss alerts ───
                setTimeout(function() {
                    document.querySelectorAll('.alert-custom').forEach(function(alert) {
                        var closeBtn = alert.querySelector('.btn-close');
                        if (closeBtn) {
                            closeBtn.click();
                        }
                    });
                }, 5000);
            });
    </script>

</body>
</html>