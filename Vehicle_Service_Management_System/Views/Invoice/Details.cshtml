@model Vehicle_Service_Management_System.Application.ViewModels.Invoice.InvoiceDetailsViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Invoice Details | Vehicle Service Management</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
            /* ── All styles – unchanged ── */
            :root {
                --primary-gradient: linear-gradient(135deg, #0d6efd, #0a58ca);
                --shadow-sm: 0 2px 8px rgba(0, 0, 0, 0.06);
                --shadow-md: 0 8px 30px rgba(0, 0, 0, 0.10);
                --shadow-lg: 0 16px 48px rgba(0, 0, 0, 0.14);
                --radius: 16px;
                --radius-sm: 10px;
                --transition: 0.25s ease;
            }

            body {
                background: #f4f6fa;
                font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
                padding: 2rem 1.5rem;
                min-height: 100vh;
                display: flex;
                align-items: flex-start;
                justify-content: center;
            }

            .details-wrapper {
                max-width: 1200px;
                width: 100%;
                background: #ffffff;
                border-radius: var(--radius);
                box-shadow: var(--shadow-lg);
                padding: 2rem 2.5rem 2.5rem;
                transition: var(--transition);
            }

            @@media (max-width: 576px) {
                body {
                    padding: 1rem 0.75rem;
                }

                .details-wrapper {
                    padding: 1.25rem 1rem 1.75rem;
                    border-radius: var(--radius-sm);
                }
            }

            .page-header {
                display: flex;
                flex-wrap: wrap;
                align-items: center;
                justify-content: space-between;
                gap: 1rem;
                margin-bottom: 1.75rem;
            }

                .page-header h1 {
                    font-weight: 700;
                    font-size: 1.85rem;
                    letter-spacing: -0.02em;
                    color: #1a2634;
                    margin: 0;
                    display: flex;
                    align-items: center;
                    gap: 0.5rem;
                }

                    .page-header h1 i {
                        color: #0d6efd;
                        font-size: 2rem;
                    }

                .page-header .btn-outline-secondary {
                    border-radius: 50px;
                    padding: 0.5rem 1.2rem;
                    font-weight: 500;
                    border-color: #d1d9e6;
                    transition: var(--transition);
                    display: inline-flex;
                    align-items: center;
                    gap: 0.4rem;
                }

                    .page-header .btn-outline-secondary:hover {
                        background: #eef2f7;
                        border-color: #b0bcca;
                    }

                .page-header .btn-secondary {
                    border-radius: 50px;
                    padding: 0.5rem 1.2rem;
                    font-weight: 500;
                    border-color: #d1d9e6;
                    transition: var(--transition);
                    display: inline-flex;
                    align-items: center;
                    gap: 0.4rem;
                }

                    .page-header .btn-secondary:hover {
                        background: #eef2f7;
                        border-color: #b0bcca;
                    }

            .alert {
                border-radius: var(--radius-sm);
                border: none;
                box-shadow: var(--shadow-sm);
            }

            .alert-success {
                background: #dcfce7;
                color: #166534;
            }

            .alert-danger {
                background: #fee2e2;
                color: #991b1b;
            }

            .alert i {
                margin-right: 0.5rem;
            }

            .detail-card {
                background: #f9fafc;
                border-radius: var(--radius-sm);
                padding: 1.5rem 1.75rem;
                box-shadow: var(--shadow-sm);
                border: 1px solid #eef2f7;
                margin-bottom: 1.5rem;
            }

                .detail-card .card-title {
                    font-weight: 600;
                    font-size: 1.1rem;
                    color: #2d3748;
                    margin-bottom: 1rem;
                    display: flex;
                    align-items: center;
                    gap: 0.5rem;
                }

                    .detail-card .card-title i {
                        color: #0d6efd;
                    }

            .detail-grid {
                display: grid;
                grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
                gap: 0.8rem 1.8rem;
            }

            .detail-item {
                display: flex;
                flex-direction: column;
            }

                .detail-item .label {
                    font-size: 0.75rem;
                    text-transform: uppercase;
                    letter-spacing: 0.05em;
                    color: #6b7a8e;
                    font-weight: 600;
                }

                .detail-item .value {
                    font-size: 1.05rem;
                    font-weight: 500;
                    color: #1a2634;
                    word-break: break-word;
                }

                    .detail-item .value .badge-status {
                        font-weight: 500;
                        padding: 0.3rem 0.9rem;
                        border-radius: 50px;
                        font-size: 0.8rem;
                        display: inline-flex;
                        align-items: center;
                        gap: 0.4rem;
                    }

            .badge-status.bg-success {
                background: #dcfce7 !important;
                color: #166534;
            }

            .badge-status.bg-danger {
                background: #fee2e2 !important;
                color: #991b1b;
            }

            .badge-status i {
                font-size: 0.7rem;
            }

            .stat-chip {
                background: white;
                border-radius: 60px;
                padding: 0.2rem 1rem;
                box-shadow: var(--shadow-sm);
                border: 1px solid #e9edf4;
                display: inline-block;
                font-weight: 500;
                color: #1a2634;
                font-size: 0.95rem;
            }

                .stat-chip i {
                    color: #0d6efd;
                    margin-right: 0.3rem;
                }

                .stat-chip.gold {
                    background: #fef3c7;
                    border-color: #fde68a;
                }

                .stat-chip.green {
                    background: #dcfce7;
                    border-color: #86efac;
                }

            .table-card {
                background: #ffffff;
                border-radius: var(--radius-sm);
                box-shadow: var(--shadow-sm);
                overflow: hidden;
                border: 1px solid #eef2f7;
                margin-top: 0.5rem;
            }

            .table-responsive-custom {
                overflow-x: auto;
                -webkit-overflow-scrolling: touch;
                padding: 0 0.25rem;
            }

            .table {
                margin: 0;
                font-size: 0.92rem;
                vertical-align: middle;
                border-collapse: separate;
                border-spacing: 0;
                min-width: 500px;
            }

                .table thead th {
                    background: #f8fafc;
                    color: #2d3748;
                    font-weight: 600;
                    font-size: 0.8rem;
                    text-transform: uppercase;
                    letter-spacing: 0.04em;
                    padding: 0.8rem 1rem;
                    border-bottom: 2px solid #e2e8f0;
                    white-space: nowrap;
                }

                .table tbody td,
                .table tfoot td {
                    padding: 0.75rem 1rem;
                    border-bottom: 1px solid #edf2f7;
                    background: #fff;
                    transition: background var(--transition);
                }

                .table tbody tr:hover td {
                    background: #fafcff;
                }

                .table tbody tr:last-child td {
                    border-bottom: none;
                }

                .table tfoot td {
                    border-top: 2px solid #e2e8f0;
                    font-weight: 600;
                }

                .table tfoot tr:last-child td {
                    border-bottom: none;
                }

                .table tfoot .total-row td {
                    background: #dcfce7;
                    font-weight: 700;
                    font-size: 1.05rem;
                }

            .empty-state {
                padding: 2.5rem 1rem !important;
                text-align: center;
                color: #94a3b8;
            }

                .empty-state i {
                    font-size: 2rem;
                    display: block;
                    margin-bottom: 0.5rem;
                    color: #cbd5e1;
                }

            .action-footer {
                display: flex;
                flex-wrap: wrap;
                gap: 0.75rem;
                margin-top: 1.75rem;
                align-items: center;
                justify-content: flex-end;
            }

                .action-footer .btn {
                    border-radius: 50px;
                    padding: 0.5rem 1.5rem;
                    font-weight: 500;
                    transition: var(--transition);
                    display: inline-flex;
                    align-items: center;
                    gap: 0.5rem;
                }

                .action-footer .btn-success {
                    background: #22c55e;
                    border: none;
                    box-shadow: 0 4px 14px rgba(34, 197, 94, 0.30);
                }

                    .action-footer .btn-success:hover {
                        transform: translateY(-2px);
                        box-shadow: 0 8px 24px rgba(34, 197, 94, 0.40);
                    }

                .action-footer .btn-warning {
                    background: #fbbf24;
                    border: none;
                    color: #1a2634;
                    box-shadow: 0 4px 14px rgba(251, 191, 36, 0.30);
                }

                    .action-footer .btn-warning:hover {
                        transform: translateY(-2px);
                        box-shadow: 0 8px 24px rgba(251, 191, 36, 0.40);
                    }

                .action-footer .btn-danger {
                    background: #ef4444;
                    border: none;
                    box-shadow: 0 4px 14px rgba(239, 68, 68, 0.30);
                }

                    .action-footer .btn-danger:hover {
                        transform: translateY(-2px);
                        box-shadow: 0 8px 24px rgba(239, 68, 68, 0.40);
                    }

            @@media (max-width: 576px) {
                .detail-grid {
                    grid-template-columns: 1fr;
                    gap: 0.6rem;
                }

                .action-footer {
                    flex-direction: column;
                    align-items: stretch;
                }

                    .action-footer .btn {
                        justify-content: center;
                    }

                .page-header h1 {
                    font-size: 1.4rem;
                }

                    .page-header h1 i {
                        font-size: 1.5rem;
                    }
            }
    </style>
</head>
<body>

    <div class="details-wrapper">

        <!-- ─── HEADER ─── -->
        <div class="page-header">
            <h1>
                <i class="bi bi-receipt"></i>
                Invoice Details
            </h1>
            <div>
                <a asp-action="Print" asp-route-id="@Model.Id" class="btn btn-outline-secondary" target="_blank">
                    <i class="bi bi-printer"></i> Print
                </a>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-arrow-left"></i> Back
                </a>
            </div>
        </div>

        <!-- ─── ALERTS ─── -->
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle-fill"></i> @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-circle-fill"></i> @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <!-- ─── INVOICE INFORMATION ─── -->
        <div class="detail-card">
            <div class="card-title">
                <i class="bi bi-info-circle"></i> Invoice Information
            </div>
            <div class="detail-grid">
                <div class="detail-item">
                    <span class="label">Invoice No</span>
                    <span class="value">@Model.InvoiceNumber</span>
                </div>
                <div class="detail-item">
                    <span class="label">Booking ID</span>
                    <span class="value">#@Model.BookingId</span>
                </div>
                <div class="detail-item">
                    <span class="label">Customer</span>
                    <span class="value">@Model.CustomerName</span>
                </div>
                <div class="detail-item">
                    <span class="label">Vehicle</span>
                    <span class="value">@Model.VehicleRegistrationNumber</span>
                </div>
                <div class="detail-item">
                    <span class="label">Services</span>
                    <span class="value">@Model.ServicesSummary</span>
                </div>
                <div class="detail-item">
                    <span class="label">Status</span>
                    <span class="value">
                        <span class="badge-status @(Model.IsPaid ? "bg-success" : "bg-danger")">
                            <i class="bi @(Model.IsPaid ? "bi-check-circle-fill" : "bi-x-circle-fill")"></i>
                            @(Model.IsPaid ? "Paid" : "Unpaid")
                        </span>
                    </span>
                </div>
            </div>
        </div>

        <!-- ─── FINANCIAL SUMMARY ─── -->
        <div class="detail-card">
            <div class="card-title">
                <i class="bi bi-calculator"></i> Financial Summary
            </div>
            <div class="detail-grid">
                <div class="detail-item">
                    <span class="label">Labour Charge</span>
                    <span class="value">@Model.LabourCharge.ToString("C")</span>
                </div>
                <div class="detail-item">
                    <span class="label">Spare Parts</span>
                    <span class="value">@Model.SparePartsTotal.ToString("C")</span>
                </div>
                <div class="detail-item">
                    <span class="label">GST (@Model.GSTPercentage.ToString("F2")%)</span>
                    <span class="value">@Model.GSTAmount.ToString("C")</span>
                </div>
                <div class="detail-item">
                    <span class="label">Discount</span>
                    <span class="value text-danger">- @Model.DiscountAmount.ToString("C")</span>
                </div>
                <div class="detail-item">
                    <span class="label">Grand Total</span>
                    <span class="value">
                        <span class="stat-chip gold">
                            <i class="bi bi-currency-rupee"></i> @Model.GrandTotal.ToString("C")
                        </span>
                    </span>
                </div>
            </div>
        </div>

        <!-- ─── SPARE PARTS USED ─── -->
        <div class="detail-card">
            <div class="card-title">
                <i class="bi bi-gear"></i> Spare Parts Used
            </div>
            @if (Model.Items.Any())
            {
                <div class="table-card">
                    <div class="table-responsive-custom">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Part Name</th>
                                    <th class="text-center">Qty</th>
                                    <th class="text-end">Unit Price</th>
                                    <th class="text-end">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Items)
                                {
                                    <tr>
                                        <td>@item.SparePartName</td>
                                        <td class="text-center">@item.Quantity</td>
                                        <td class="text-end">@item.UnitPrice.ToString("C")</td>
                                        <td class="text-end">@item.TotalAmount.ToString("C")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
            else
            {
                <div class="empty-state">
                    <i class="bi bi-gear"></i>
                    No Spare Parts Used.
                </div>
            }
        </div>

        <!-- ─── PAYMENTS ─── -->
        <div class="detail-card">
            <div class="card-title">
                <i class="bi bi-credit-card"></i> Payments
            </div>
            @if (Model.Payments.Any())
            {
                <div class="table-card">
                    <div class="table-responsive-custom">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Payment Mode</th>
                                    <th class="text-end">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var payment in Model.Payments)
                                {
                                    <tr>
                                        <td>@payment.PaymentDate.ToString("dd/MM/yyyy")</td>
                                        <td>@payment.PaymentMode</td>
                                        <td class="text-end">@payment.AmountPaid.ToString("C")</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="2" class="text-end">Total Paid</td>
                                    <td class="text-end">
                                        <span class="stat-chip green">
                                            <i class="bi bi-check-circle-fill"></i> @Model.AmountPaid.ToString("C")
                                        </span>
                                    </td>
                                </tr>
                                <tr class="total-row">
                                    <td colspan="2" class="text-end">Balance</td>
                                    <td class="text-end">
                                        <span class="stat-chip" style="background: #fee2e2; border-color: #fca5a5;">
                                            <i class="bi bi-currency-rupee"></i> @Model.Balance.ToString("C")
                                        </span>
                                    </td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            }
            else
            {
                <div class="empty-state">
                    <i class="bi bi-credit-card"></i>
                    No Payments Found.
                </div>
            }
        </div>

        <!-- ─── REMARKS ─── -->
        @if (!string.IsNullOrWhiteSpace(Model.Remarks))
        {
            <div class="detail-card">
                <div class="card-title">
                    <i class="bi bi-chat-square-text"></i> Remarks
                </div>
                <div class="text-block" style="background:#ffffff; border-radius:10px; padding:1rem 1.25rem; border:1px solid #eef2f7; color:#1a2634;">
                    @Model.Remarks
                </div>
            </div>
        }

        <!-- ─── ACTION BUTTONS ─── -->
        <div class="action-footer">
            @if (!Model.IsPaid)
            {
                <form asp-action="MarkAsPaid" asp-route-id="@Model.Id" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-success" onclick="return confirm('Mark this invoice as paid?');">
                        <i class="bi bi-check2"></i> Mark As Paid
                    </button>
                </form>
            }
            else
            {
                <form asp-action="MarkAsUnpaid" asp-route-id="@Model.Id" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-warning" onclick="return confirm('Mark this invoice as unpaid?');">
                        <i class="bi bi-arrow-counterclockwise"></i> Mark As Unpaid
                    </button>
                </form>
            }

            <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-danger" onclick="return confirm('Are you sure you want to delete this invoice?');">
                    <i class="bi bi-trash"></i> Delete
                </button>
            </form>
        </div>

    </div> <!-- /.details-wrapper -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
            // Auto‑dismiss alerts after 4 seconds
            setTimeout(function() {
                let alerts = document.querySelectorAll(".alert");
                alerts.forEach(function(alert) {
                    let bsAlert = bootstrap.Alert.getOrCreateInstance(alert);
                    bsAlert.close();
                });
            }, 4000);
    </script>
</body>
</html>