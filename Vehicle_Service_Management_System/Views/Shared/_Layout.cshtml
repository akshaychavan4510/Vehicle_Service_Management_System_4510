<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0f172a" />
    <meta name="description" content="Vehicle Service Management System - manage customers, vehicles, bookings, job cards, invoices and payments." />

    <title>@ViewData["Title"] - Vehicle Service Management</title>

    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />

    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" />

    <!-- Custom Styles -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
            /* ============================================================
                   VEHICLE SERVICE MANAGEMENT
                   Modern Premium Dashboard Theme
                   ============================================================ */

            :root {
                --sidebar-width: 270px;
                --sidebar-bg: #0b1220;
                --sidebar-bg-2: #111c33;
                --sidebar-hover: rgba(59, 130, 246, 0.12);
                --sidebar-active: #2563eb;
                --sidebar-active-2: #4f46e5;
                --text-dark: #0f172a;
                --text-muted: #64748b;
                --text-light: #cbd5e1;
                --page-bg: #f4f7fb;
                --card-bg: #ffffff;
                --border: #e5e7eb;
                --primary: #2563eb;
                --primary-dark: #1d4ed8;
                --purple: #6366f1;
                --danger: #ef4444;
                --shadow-sm: 0 2px 8px rgba(15, 23, 42, 0.05);
                --shadow-md: 0 8px 25px rgba(15, 23, 42, 0.08);
                --shadow-lg: 0 15px 40px rgba(15, 23, 42, 0.12);
                --radius: 12px;
                --transition: 0.25s ease;
                --font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
            }

            /* ============================================================
                   GLOBAL RESET
                   ============================================================ */

            *,
            *::before,
            *::after {
                box-sizing: border-box;
            }

            html {
                scroll-behavior: smooth;
            }

            body {
                margin: 0;
                padding: 0;
                background: radial-gradient( circle at top right, rgba(59, 130, 246, 0.06), transparent 30% ), var(--page-bg);
                font-family: var(--font-family);
                color: var(--text-dark);
                overflow-x: hidden;
            }

            a {
                text-decoration: none;
            }

                /* ============================================================
                   ACCESSIBILITY
                   ============================================================ */

                a:focus-visible,
                button:focus-visible,
                input:focus-visible,
                select:focus-visible,
                textarea:focus-visible {
                    outline: 3px solid rgba(37, 99, 235, 0.35);
                    outline-offset: 2px;
                    border-radius: 6px;
                }

            /* ============================================================
                   SIDEBAR
                   ============================================================ */

            .sidebar {
                position: fixed;
                top: 0;
                left: 0;
                bottom: 0;
                width: var(--sidebar-width);
                background: radial-gradient( circle at top left, rgba(37, 99, 235, 0.25), transparent 35% ), linear-gradient( 160deg, var(--sidebar-bg) 0%, var(--sidebar-bg-2) 100% );
                color: var(--text-light);
                z-index: 1050;
                display: flex;
                flex-direction: column;
                overflow-y: auto;
                overflow-x: hidden;
                border-right: 1px solid rgba(255,255,255,0.06);
                box-shadow: 8px 0 30px rgba(15,23,42,0.08);
                transition: transform var(--transition), width var(--transition);
            }

                .sidebar::-webkit-scrollbar {
                    width: 5px;
                }

                .sidebar::-webkit-scrollbar-track {
                    background: transparent;
                }

                .sidebar::-webkit-scrollbar-thumb {
                    background: rgba(148,163,184,0.25);
                    border-radius: 10px;
                }

            /* ============================================================
                   SIDEBAR BRAND
                   ============================================================ */

            .sidebar-brand {
                min-height: 82px;
                display: flex;
                align-items: center;
                gap: 13px;
                padding: 18px 20px;
                border-bottom: 1px solid rgba(255,255,255,0.07);
                flex-shrink: 0;
            }

                .sidebar-brand .brand-icon {
                    width: 44px;
                    height: 44px;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    flex-shrink: 0;
                    border-radius: 13px;
                    background: linear-gradient( 135deg, #2563eb, #6366f1 );
                    color: white;
                    font-size: 1.45rem;
                    box-shadow: 0 8px 20px rgba(37,99,235,0.35);
                    transition: transform var(--transition);
                }

                .sidebar-brand:hover .brand-icon {
                    transform: rotate(-5deg) scale(1.05);
                }

                .sidebar-brand .brand-text {
                    color: white;
                    font-size: 1.05rem;
                    font-weight: 700;
                    letter-spacing: -0.3px;
                    line-height: 1.2;
                    white-space: nowrap;
                    overflow: hidden;
                    text-overflow: ellipsis;
                }

                    .sidebar-brand .brand-text small {
                        display: block;
                        margin-top: 4px;
                        color: #94a3b8;
                        font-size: 0.58rem;
                        font-weight: 500;
                        letter-spacing: 0.7px;
                        text-transform: uppercase;
                    }

            /* ============================================================
                   SIDEBAR NAVIGATION
                   ============================================================ */

            .sidebar-nav {
                flex: 1;
                padding: 14px 12px 20px;
                overflow-y: auto;
            }

                .sidebar-nav .nav {
                    gap: 3px;
                }

                .sidebar-nav .nav-item {
                    list-style: none;
                }

            /* ============================================================
                   NAV CATEGORY
                   ============================================================ */

            .nav-category {
                display: flex;
                align-items: center;
                gap: 8px;
                margin-top: 12px;
                margin-bottom: 5px;
                padding: 9px 11px;
                color: #64748b;
                font-size: 0.64rem;
                font-weight: 700;
                letter-spacing: 0.8px;
                text-transform: uppercase;
                border-radius: 7px;
                user-select: none;
            }

                .nav-category:first-child {
                    margin-top: 0;
                }

                .nav-category i:first-child {
                    font-size: 0.75rem;
                    opacity: 0.7;
                }

            .nav-category-toggle {
                cursor: pointer;
                transition: background var(--transition), color var(--transition);
            }

                .nav-category-toggle:hover {
                    background: rgba(255,255,255,0.04);
                    color: #94a3b8;
                }

                .nav-category-toggle .chevron {
                    margin-left: auto;
                    font-size: 0.65rem;
                    opacity: 0.5;
                    transition: transform var(--transition);
                }

                    .nav-category-toggle .chevron.open {
                        transform: rotate(90deg);
                    }

            /* ============================================================
                   NAV LINKS
                   ============================================================ */

            .sidebar-nav .nav-link {
                position: relative;
                display: flex;
                align-items: center;
                gap: 12px;
                min-height: 43px;
                padding: 9px 12px;
                margin-bottom: 2px;
                border-radius: 9px;
                color: #aebbd0;
                font-size: 0.86rem;
                font-weight: 500;
                white-space: nowrap;
                overflow: hidden;
                transition: background var(--transition), color var(--transition), transform var(--transition), box-shadow var(--transition);
            }

                .sidebar-nav .nav-link i {
                    width: 23px;
                    flex-shrink: 0;
                    text-align: center;
                    font-size: 1.08rem;
                    transition: transform var(--transition);
                }

                .sidebar-nav .nav-link:hover {
                    background: var(--sidebar-hover);
                    color: #ffffff;
                    transform: translateX(3px);
                }

                    .sidebar-nav .nav-link:hover i {
                        transform: scale(1.08);
                    }

                /* ============================================================
                   ACTIVE LINK
                   ============================================================ */

                .sidebar-nav .nav-link.active {
                    background: linear-gradient( 135deg, var(--sidebar-active), var(--sidebar-active-2) );
                    color: white;
                    font-weight: 600;
                    box-shadow: 0 7px 18px rgba(37,99,235,0.28);
                }

                    .sidebar-nav .nav-link.active::before {
                        content: "";
                        position: absolute;
                        left: 0;
                        top: 50%;
                        width: 3px;
                        height: 24px;
                        transform: translateY(-50%);
                        background: white;
                        border-radius: 0 5px 5px 0;
                    }

                    .sidebar-nav .nav-link.active i {
                        color: white;
                    }

            .sidebar-nav .nav-label {
                overflow: hidden;
                text-overflow: ellipsis;
            }

            /* ============================================================
                   CATEGORY CHILDREN
                   ============================================================ */

            .category-collapse {
                overflow: hidden;
                transition: height var(--transition);
            }

                .category-collapse .nav {
                    margin-left: 9px;
                    padding-left: 9px;
                    border-left: 1px solid rgba(148,163,184,0.12);
                }

                .category-collapse .nav-link {
                    min-height: 40px;
                    padding: 8px 10px;
                    font-size: 0.83rem;
                }

                    .category-collapse .nav-link i {
                        width: 21px;
                        font-size: 0.98rem;
                    }

            /* ============================================================
                   SIDEBAR FOOTER
                   ============================================================ */

            .sidebar-footer {
                padding: 13px;
                border-top: 1px solid rgba(255,255,255,0.07);
                flex-shrink: 0;
            }

                .sidebar-footer .btn-logout {
                    width: 100%;
                    border: 1px solid rgba(239,68,68,0.15);
                    border-radius: 9px;
                    padding: 10px;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    gap: 9px;
                    background: rgba(239,68,68,0.08);
                    color: #f87171;
                    font-size: 0.86rem;
                    font-weight: 600;
                    cursor: pointer;
                    transition: background var(--transition), color var(--transition), transform var(--transition);
                }

                    .sidebar-footer .btn-logout:hover {
                        background: rgba(239,68,68,0.18);
                        color: #fecaca;
                        transform: translateY(-1px);
                    }

            /* ============================================================
                   MAIN WRAPPER
                   ============================================================ */

            .main-wrapper {
                min-height: 100vh;
                margin-left: var(--sidebar-width);
                display: flex;
                flex-direction: column;
                transition: margin-left var(--transition);
            }

            /* ============================================================
                   TOP NAVBAR
                   ============================================================ */

            .top-navbar {
                position: sticky;
                top: 0;
                z-index: 1040;
                min-height: 70px;
                padding: 12px 24px;
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 15px;
                background: rgba(255,255,255,0.88);
                backdrop-filter: blur(16px);
                -webkit-backdrop-filter: blur(16px);
                border-bottom: 1px solid rgba(226,232,240,0.8);
                box-shadow: 0 2px 15px rgba(15,23,42,0.04);
            }

            .navbar-left {
                display: flex;
                align-items: center;
                gap: 12px;
                min-width: 0;
            }

            .page-title {
                margin: 0;
                color: #0f172a;
                font-size: 1.15rem;
                font-weight: 700;
                letter-spacing: -0.3px;
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
            }

            /* ============================================================
                   HAMBURGER
                   ============================================================ */

            .hamburger {
                display: none;
                width: 40px;
                height: 40px;
                border: 1px solid #e2e8f0;
                border-radius: 9px;
                background: white;
                color: #334155;
                font-size: 1.35rem;
                cursor: pointer;
                transition: background var(--transition), transform var(--transition);
            }

                .hamburger:hover {
                    background: #f1f5f9;
                    transform: scale(1.03);
                }

            /* ============================================================
                   NAVBAR RIGHT
                   ============================================================ */

            .navbar-right {
                display: flex;
                align-items: center;
                gap: 12px;
                flex-shrink: 0;
            }

            /* ============================================================
                   USER BADGE
                   ============================================================ */

            .user-badge {
                display: flex;
                align-items: center;
                gap: 10px;
                padding: 5px 14px 5px 6px;
                background: white;
                border: 1px solid #e2e8f0;
                border-radius: 40px;
                box-shadow: var(--shadow-sm);
                color: #334155;
                transition: box-shadow var(--transition), transform var(--transition);
            }

                .user-badge:hover {
                    box-shadow: var(--shadow-md);
                    transform: translateY(-1px);
                }

                .user-badge .avatar {
                    width: 34px;
                    height: 34px;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    border-radius: 50%;
                    background: linear-gradient( 135deg, #2563eb, #6366f1 );
                    color: white;
                    font-size: 0.8rem;
                    font-weight: 700;
                    box-shadow: 0 4px 10px rgba(37,99,235,0.25);
                }

            .user-email {
                max-width: 180px;
                color: #334155;
                font-size: 0.82rem;
                font-weight: 600;
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
            }

            /* ============================================================
                   TOP LOGOUT
                   ============================================================ */

            .btn-logout-top {
                border: 1px solid #fecaca;
                border-radius: 9px;
                padding: 8px 13px;
                display: flex;
                align-items: center;
                gap: 7px;
                background: #fff1f2;
                color: #dc2626;
                font-size: 0.8rem;
                font-weight: 600;
                cursor: pointer;
                transition: background var(--transition), transform var(--transition), box-shadow var(--transition);
            }

                .btn-logout-top:hover {
                    background: #fee2e2;
                    transform: translateY(-1px);
                    box-shadow: 0 4px 10px rgba(239,68,68,0.12);
                }

            /* ============================================================
                   MAIN CONTENT
                   ============================================================ */

            .main-content {
                flex: 1;
                padding: 25px;
            }

            /* ============================================================
                   CARD DESIGN
                   ============================================================ */

            .card {
                border: 1px solid rgba(226,232,240,0.8);
                border-radius: var(--radius);
                background: var(--card-bg);
                box-shadow: var(--shadow-sm);
                transition: transform var(--transition), box-shadow var(--transition), border-color var(--transition);
            }

                .card:hover {
                    transform: translateY(-2px);
                    box-shadow: var(--shadow-md);
                    border-color: rgba(59,130,246,0.15);
                }

            .card-header {
                background: transparent;
                border-bottom: 1px solid #eef2f7;
                font-weight: 600;
            }

            /* ============================================================
                   BUTTONS
                   ============================================================ */

            .btn {
                border-radius: 8px;
                font-weight: 600;
                transition: transform var(--transition), box-shadow var(--transition);
            }

                .btn:hover {
                    transform: translateY(-1px);
                }

            .btn-primary {
                background: linear-gradient( 135deg, #2563eb, #4f46e5 );
                border: none;
                box-shadow: 0 5px 12px rgba(37,99,235,0.20);
            }

                .btn-primary:hover {
                    background: linear-gradient( 135deg, #1d4ed8, #4338ca );
                    box-shadow: 0 8px 18px rgba(37,99,235,0.28);
                }

            /* ============================================================
                   FORM CONTROLS
                   ============================================================ */

            .form-control,
            .form-select {
                border: 1px solid #dbe3ed;
                border-radius: 8px;
                min-height: 42px;
                transition: border-color var(--transition), box-shadow var(--transition);
            }

                .form-control:focus,
                .form-select:focus {
                    border-color: #60a5fa;
                    box-shadow: 0 0 0 3px rgba(59,130,246,0.10);
                }

            /* ============================================================
                   TABLE
                   ============================================================ */

            .table {
                vertical-align: middle;
            }

                .table thead th {
                    background: #f8fafc;
                    color: #475569;
                    font-size: 0.78rem;
                    font-weight: 700;
                    text-transform: uppercase;
                    letter-spacing: 0.4px;
                    border-bottom: 1px solid #e2e8f0;
                }

                .table tbody tr {
                    transition: background var(--transition);
                }

                    .table tbody tr:hover {
                        background: #f8fbff;
                    }

            /* ============================================================
                   BADGES
                   ============================================================ */

            .badge {
                border-radius: 6px;
                padding: 5px 9px;
                font-weight: 600;
            }

            /* ============================================================
                   BACK TO TOP
                   ============================================================ */

            .back-to-top {
                position: fixed;
                right: 22px;
                bottom: 22px;
                width: 44px;
                height: 44px;
                display: flex;
                align-items: center;
                justify-content: center;
                border: none;
                border-radius: 50%;
                background: linear-gradient(135deg, #2563eb, #4f46e5);
                color: white;
                font-size: 1.1rem;
                box-shadow: 0 10px 25px rgba(37,99,235,0.30);
                cursor: pointer;
                opacity: 0;
                visibility: hidden;
                transform: translateY(10px);
                transition: opacity var(--transition), transform var(--transition), visibility var(--transition);
                z-index: 1030;
            }

                .back-to-top.visible {
                    opacity: 1;
                    visibility: visible;
                    transform: translateY(0);
                }

                .back-to-top:hover {
                    transform: translateY(-3px);
                }

            /* ============================================================
                   SIDEBAR MOBILE OVERLAY
                   ============================================================ */

            .sidebar-overlay {
                display: none;
                position: fixed;
                inset: 0;
                background: rgba(15,23,42,0.50);
                backdrop-filter: blur(3px);
                z-index: 1045;
                opacity: 0;
                transition: opacity 0.25s ease;
            }

                .sidebar-overlay.show {
                    display: block;
                    opacity: 1;
                }

            /* ============================================================
                   ANIMATION
                   ============================================================ */

            @@keyframes fadeSlideIn {
                from {
                    opacity: 0;
                    transform: translateY(-5px);
                }

                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            .category-collapse .nav-item {
                animation: fadeSlideIn 0.2s ease forwards;
            }

            /* ============================================================
                   RESPONSIVE - TABLET
                   ============================================================ */

            @@media (max-width: 992px) {

                .sidebar {
                    transform: translateX(-100%);
                    width: 270px;
                }

                    .sidebar.open {
                        transform: translateX(0);
                    }

                .main-wrapper {
                    margin-left: 0;
                }

                .hamburger {
                    display: flex;
                    align-items: center;
                    justify-content: center;
                }

                .main-content {
                    padding: 20px;
                }
            }

            /* ============================================================
                   RESPONSIVE - MOBILE
                   ============================================================ */

            @@media (max-width: 576px) {

                .top-navbar {
                    min-height: 62px;
                    padding: 10px 12px;
                }

                .page-title {
                    max-width: 150px;
                    font-size: 0.95rem;
                }

                .navbar-right {
                    gap: 7px;
                }

                .user-badge {
                    padding: 4px;
                }

                .user-email {
                    display: none;
                }

                .user-badge .avatar {
                    width: 32px;
                    height: 32px;
                }

                .btn-logout-top {
                    width: 38px;
                    height: 38px;
                    padding: 0;
                    justify-content: center;
                }

                    .btn-logout-top span {
                        display: none;
                    }

                .main-content {
                    padding: 12px;
                }

                .sidebar {
                    width: 280px;
                }

                .back-to-top {
                    right: 14px;
                    bottom: 14px;
                    width: 40px;
                    height: 40px;
                }
            }

            /* ============================================================
                   REDUCED MOTION
                   ============================================================ */

            @@media (prefers-reduced-motion: reduce) {

                *,
                *::before,
                *::after {
                    animation-duration: 0.001ms !important;
                    animation-iteration-count: 1 !important;
                    transition-duration: 0.001ms !important;
                    scroll-behavior: auto !important;
                }
            }

            /* ============================================================
                   PRINT
                   ============================================================ */

            @@media print {

                .sidebar,
                .top-navbar,
                .sidebar-overlay,
                .back-to-top {
                    display: none !important;
                }

                .main-wrapper {
                    margin-left: 0 !important;
                }

                .main-content {
                    padding: 0 !important;
                }
            }
    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>

<body>

    <!-- ============================================================ -->
    <!-- SIDEBAR                                                       -->
    <!-- ============================================================ -->
    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        <nav class="sidebar" id="sidebar" aria-label="Main navigation">

            <!-- Brand -->
            <a asp-controller="Home" asp-action="Index" class="sidebar-brand" style="color:inherit;">
                <div class="brand-icon" aria-hidden="true">
                    <i class="bi bi-car-front-fill"></i>
                </div>
                <div class="brand-text">
                    Vehicle Service
                    <small>Management System</small>
                </div>
            </a>

            <!-- Navigation -->
            <div class="sidebar-nav">

                <!-- ─── DASHBOARD ─── -->
                <ul class="nav flex-column">
                    <li class="nav-item">
                        <a asp-controller="Home" asp-action="Index"
                           class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")">
                            <i class="bi bi-speedometer2" aria-hidden="true"></i>
                            <span class="nav-label">Dashboard</span>
                        </a>
                    </li>
                </ul>

                <!-- ─── MANAGEMENT ─── -->
                <div class="nav-category nav-category-toggle"
                     role="button"
                     tabindex="0"
                     data-bs-toggle="collapse"
                     data-bs-target="#catManagement"
                     aria-expanded="true"
                     aria-controls="catManagement">
                    <i class="bi bi-folder" aria-hidden="true"></i>
                    Management
                    <i class="bi bi-chevron-right chevron open" aria-hidden="true"></i>
                </div>

                <div class="category-collapse collapse show" id="catManagement">
                    <ul class="nav flex-column">
                        <li class="nav-item">
                            <a asp-controller="Customer" asp-action="Index"
                               class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Customer" ? "active" : "")">
                                <i class="bi bi-people" aria-hidden="true"></i>
                                <span class="nav-label">Customers</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-controller="Vehicle" asp-action="Index"
                               class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Vehicle" ? "active" : "")">
                                <i class="bi bi-car-front" aria-hidden="true"></i>
                                <span class="nav-label">Vehicles</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-controller="VehicleBrand" asp-action="Index"
                               class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "VehicleBrand" ? "active" : "")">
                                <i class="bi bi-tags" aria-hidden="true"></i>
                                <span class="nav-label">Vehicle Brands</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-controller="VehicleType" asp-action="Index"
                               class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "VehicleType" ? "active" : "")">
                                <i class="bi bi-truck" aria-hidden="true"></i>
                                <span class="nav-label">Vehicle Types</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-controller="Mechanic" asp-action="Index"
                               class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Mechanic" ? "active" : "")">
                                <i class="bi bi-person-workspace" aria-hidden="true"></i>
                                <span class="nav-label">Mechanics</span>
                            </a>
                        </li>
                    </ul>
                </div>

                <!-- ─── SERVICES ─── -->
                <div class="nav-category nav-category-toggle mt-2"
                     role="button"
                     tabindex="0"
                     data-bs-toggle="collapse"
                     data-bs-target="#catServices"
                     aria-expanded="true"
                     aria-controls="catServices">
                    <i class="bi bi-tools" aria-hidden="true"></i>
                    Services
                    <i class="bi bi-chevron-right chevron open" aria-hidden="true"></i>
                </div>

                <div class="category-collapse collapse show" id="catServices">
                    <ul class="nav flex-column">
                        <li class="nav-item">
                            <a asp-controller="ServiceBooking" asp-action="Index"
                               class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "ServiceBooking" ? "active" : "")">
                                <i class="bi bi-calendar-check" aria-hidden="true"></i>
                                <span class="nav-label">Service Bookings</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-controller="JobCard" asp-action="Index"
                               class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "JobCard" ? "active" : "")">
                                <i class="bi bi-file-earmark-text" aria-hidden="true"></i>
                                <span class="nav-label">Job Cards</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-controller="ServiceType" asp-action="Index"
                               class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "ServiceType" ? "active" : "")">
                                <i class="bi bi-clipboard-check" aria-hidden="true"></i>
                                <span class="nav-label">Service Types</span>
                            </a>
                        </li>
                    </ul>
                </div>

                <!-- ─── INVENTORY ─── -->
                <div class="nav-category nav-category-toggle mt-2"
                     role="button"
                     tabindex="0"
                     data-bs-toggle="collapse"
                     data-bs-target="#catInventory"
                     aria-expanded="true"
                     aria-controls="catInventory">
                    <i class="bi bi-box-seam" aria-hidden="true"></i>
                    Inventory
                    <i class="bi bi-chevron-right chevron open" aria-hidden="true"></i>
                </div>

                <div class="category-collapse collapse show" id="catInventory">
                    <ul class="nav flex-column">
                        <li class="nav-item">
                            <a asp-controller="SparePartCategory" asp-action="Index"
                               class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "SparePartCategory" ? "active" : "")">
                                <i class="bi bi-tag" aria-hidden="true"></i>
                                <span class="nav-label">Spare Categories</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-controller="SparePart" asp-action="Index"
                               class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "SparePart" ? "active" : "")">
                                <i class="bi bi-gear" aria-hidden="true"></i>
                                <span class="nav-label">Spare Parts</span>
                            </a>
                        </li>
                    </ul>
                </div>

                <!-- ─── FINANCE ─── -->
                <div class="nav-category nav-category-toggle mt-2"
                     role="button"
                     tabindex="0"
                     data-bs-toggle="collapse"
                     data-bs-target="#catFinance"
                     aria-expanded="true"
                     aria-controls="catFinance">
                    <i class="bi bi-wallet2" aria-hidden="true"></i>
                    Finance
                    <i class="bi bi-chevron-right chevron open" aria-hidden="true"></i>
                </div>

                <div class="category-collapse collapse show" id="catFinance">
                    <ul class="nav flex-column">
                        <li class="nav-item">
                            <a asp-controller="Invoice" asp-action="Index"
                               class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Invoice" ? "active" : "")">
                                <i class="bi bi-receipt" aria-hidden="true"></i>
                                <span class="nav-label">Invoices</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-controller="Payment" asp-action="Index"
                               class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Payment" ? "active" : "")">
                                <i class="bi bi-cash-stack" aria-hidden="true"></i>
                                <span class="nav-label">Payments</span>
                            </a>
                        </li>
                    </ul>
                </div>

                <!-- ─── REPORTS ─── -->
                <div class="nav-category nav-category-toggle mt-2"
                     role="button"
                     tabindex="0"
                     data-bs-toggle="collapse"
                     data-bs-target="#catReports"
                     aria-expanded="true"
                     aria-controls="catReports">
                    <i class="bi bi-bar-chart-line" aria-hidden="true"></i>
                    Reports
                    <i class="bi bi-chevron-right chevron open" aria-hidden="true"></i>
                </div>

                <div class="category-collapse collapse show" id="catReports">
                    <ul class="nav flex-column">
                        <li class="nav-item">
                            <a asp-controller="Report" asp-action="Index"
                               class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Report" ? "active" : "")">
                                <i class="bi bi-bar-chart-line" aria-hidden="true"></i>
                                <span class="nav-label">All Reports</span>
                            </a>
                        </li>
                    </ul>
                </div>

            </div>

            <!-- Sidebar Footer: Logout -->
            <div class="sidebar-footer">
                <form asp-controller="Account" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn-logout">
                        <i class="bi bi-box-arrow-right" aria-hidden="true"></i>
                        Logout
                    </button>
                </form>
            </div>

        </nav>

        <!-- Overlay (mobile) -->
        <div class="sidebar-overlay" id="sidebarOverlay"></div>
    }

    <!-- ============================================================ -->
    <!-- MAIN WRAPPER                                                  -->
    <!-- ============================================================ -->
    <div class="main-wrapper" id="mainWrapper">

        <!-- ─── TOP NAVBAR ─── -->
        <header class="top-navbar">
            <div class="navbar-left">
                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <button class="hamburger" id="hamburgerBtn" aria-label="Toggle sidebar" aria-expanded="false" aria-controls="sidebar">
                        <i class="bi bi-list" aria-hidden="true"></i>
                    </button>
                }
                <h1 class="page-title">@ViewData["Title"]</h1>
            </div>

            <div class="navbar-right">
                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    var displayName = string.IsNullOrWhiteSpace(User.Identity.Name) ? "User" : User.Identity.Name;
                    var initial = displayName.Trim().Substring(0, 1).ToUpper();

                    <div class="user-badge">
                        <span class="avatar" aria-hidden="true">
                            @initial
                        </span>
                        <span class="user-email">@displayName</span>
                    </div>

                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn-logout-top">
                            <i class="bi bi-box-arrow-right" aria-hidden="true"></i>
                            <span>Logout</span>
                        </button>
                    </form>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-sm">
                        <i class="bi bi-box-arrow-in-right" aria-hidden="true"></i> Login
                    </a>
                }
            </div>
        </header>

        <!-- ─── MAIN CONTENT ─── -->
        <main class="main-content">
            @RenderBody()
        </main>

    </div>

    <!-- ─── BACK TO TOP ─── -->
    <button type="button" class="back-to-top" id="backToTop" aria-label="Back to top">
        <i class="bi bi-arrow-up" aria-hidden="true"></i>
    </button>

    <!-- ============================================================ -->
    <!-- SCRIPTS                                                       -->
    <!-- ============================================================ -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script>
            (function() {
                'use strict';

                const sidebar = document.getElementById('sidebar');
                const overlay = document.getElementById('sidebarOverlay');
                const hamburger = document.getElementById('hamburgerBtn');
                const backToTop = document.getElementById('backToTop');

                function toggleSidebar() {
                    if (!sidebar) return;
                    const isOpen = sidebar.classList.toggle('open');
                    if (overlay) {
                        overlay.classList.toggle('show', isOpen);
                    }
                    if (hamburger) {
                        hamburger.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
                    }
                }

                function closeSidebar() {
                    if (!sidebar) return;
                    sidebar.classList.remove('open');
                    if (overlay) {
                        overlay.classList.remove('show');
                    }
                    if (hamburger) {
                        hamburger.setAttribute('aria-expanded', 'false');
                    }
                }

                if (hamburger) {
                    hamburger.addEventListener('click', toggleSidebar);
                }

                if (overlay) {
                    overlay.addEventListener('click', closeSidebar);
                }

                document.addEventListener('keydown', function(e) {
                    if (e.key === 'Escape' && sidebar && sidebar.classList.contains('open')) {
                        closeSidebar();
                    }
                });

                let resizeTimer;
                window.addEventListener('resize', function() {
                    clearTimeout(resizeTimer);
                    resizeTimer = setTimeout(function() {
                        if (window.innerWidth > 992 && sidebar) {
                            sidebar.classList.remove('open');
                            if (overlay) {
                                overlay.classList.remove('show');
                            }
                        }
                    }, 150);
                });

                // Category toggle chevron handling
                document.querySelectorAll('.nav-category-toggle').forEach(function(toggle) {
                    toggle.addEventListener('click', function() {
                        const chevron = this.querySelector('.chevron');
                        if (chevron) {
                            chevron.classList.toggle('open');
                        }
                    });

                    toggle.addEventListener('keydown', function(e) {
                        if (e.key === 'Enter' || e.key === ' ') {
                            e.preventDefault();
                            this.click();
                        }
                    });

                    const targetId = toggle.getAttribute('data-bs-target');
                    if (targetId) {
                        const targetEl = document.querySelector(targetId);
                        if (targetEl) {
                            targetEl.addEventListener('shown.bs.collapse', function() {
                                const ch = toggle.querySelector('.chevron');
                                if (ch) ch.classList.add('open');
                                toggle.setAttribute('aria-expanded', 'true');
                            });
                            targetEl.addEventListener('hidden.bs.collapse', function() {
                                const ch = toggle.querySelector('.chevron');
                                if (ch) ch.classList.remove('open');
                                toggle.setAttribute('aria-expanded', 'false');
                            });
                        }
                    }
                });

                // Auto-expand category containing active link
                const activeLink = document.querySelector('.sidebar-nav .nav-link.active');
                if (activeLink) {
                    const collapseEl = activeLink.closest('.category-collapse');
                    if (collapseEl && !collapseEl.classList.contains('show')) {
                        const toggle = document.querySelector('[data-bs-target="#' + collapseEl.id + '"]');
                        if (toggle && window.bootstrap) {
                            new bootstrap.Collapse(collapseEl, { toggle: true, show: true });
                            const ch = toggle.querySelector('.chevron');
                            if (ch) ch.classList.add('open');
                        }
                    }
                }

                // Ensure sidebar is closed on mobile initial load
                if (window.innerWidth <= 992 && sidebar) {
                    sidebar.classList.remove('open');
                    if (overlay) {
                        overlay.classList.remove('show');
                    }
                }

                // Back to top button
                if (backToTop) {
                    window.addEventListener('scroll', function() {
                        backToTop.classList.toggle('visible', window.scrollY > 300);
                    });
                    backToTop.addEventListener('click', function() {
                        window.scrollTo({ top: 0, behavior: 'smooth' });
                    });
                }
            })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
