<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0f172a" />

    <title>@ViewData["Title"] - Vehicle Service Management</title>

    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />

    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" />

    <!-- Custom Styles -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
            /* ────────────────────────────────────────────────────────── */
            /* Root Variables                                          */
            /* ────────────────────────────────────────────────────────── */
            :root {
                --sidebar-width: 280px;
                --sidebar-collapsed-width: 72px;
                --sidebar-bg: #0f172a;
                --sidebar-bg-end: #1a2744;
                --sidebar-hover: #1e293b;
                --sidebar-active: #3b82f6;
                --sidebar-active-end: #6366f1;
                --sidebar-text: #cbd5e1;
                --sidebar-text-hover: #f1f5f9;
                --header-bg: #ffffff;
                --border-color: #e2e8f0;
                --transition-speed: 0.25s;
                --font-family: 'Inter', -apple-system, system-ui, sans-serif;
            }

            /* ────────────────────────────────────────────────────────── */
            /* Global Reset                                             */
            /* ────────────────────────────────────────────────────────── */
            * {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }

            body {
                background: #f1f5f9;
                font-family: var(--font-family);
                overflow-x: hidden;
                color: #1a2634;
            }

            /* ────────────────────────────────────────────────────────── */
            /* Accessibility: Visible Keyboard Focus                   */
            /* ────────────────────────────────────────────────────────── */
            a:focus-visible,
            button:focus-visible,
            input:focus-visible,
            select:focus-visible,
            textarea:focus-visible,
            .nav-link:focus-visible {
                outline: 2px solid #3b82f6;
                outline-offset: 2px;
                border-radius: 4px;
            }

            /* ────────────────────────────────────────────────────────── */
            /* Global Card Hover Effect                                */
            /* ────────────────────────────────────────────────────────── */
            .card.shadow {
                transition: transform 0.15s ease, box-shadow 0.15s ease;
            }

                .card.shadow:hover {
                    transform: translateY(-2px);
                    box-shadow: 0 10px 24px rgba(15, 23, 42, 0.10) !important;
                }

            /* ────────────────────────────────────────────────────────── */
            /* Sidebar                                                  */
            /* ────────────────────────────────────────────────────────── */
            .sidebar {
                position: fixed;
                top: 0;
                left: 0;
                bottom: 0;
                width: var(--sidebar-width);
                background: linear-gradient(180deg, var(--sidebar-bg) 0%, var(--sidebar-bg-end) 100%);
                color: var(--sidebar-text);
                z-index: 1050;
                transition: transform var(--transition-speed) ease, width var(--transition-speed) ease;
                overflow-y: auto;
                overflow-x: hidden;
                display: flex;
                flex-direction: column;
                border-right: 1px solid rgba(255, 255, 255, 0.05);
            }

                .sidebar::-webkit-scrollbar {
                    width: 4px;
                }

                .sidebar::-webkit-scrollbar-track {
                    background: transparent;
                }

                .sidebar::-webkit-scrollbar-thumb {
                    background: #334155;
                    border-radius: 8px;
                }

            /* ────────────────────────────────────────────────────────── */
            /* Sidebar Brand                                            */
            /* ────────────────────────────────────────────────────────── */
            .sidebar-brand {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 1.25rem 1.25rem 0.75rem 1.25rem;
                border-bottom: 1px solid rgba(255, 255, 255, 0.06);
                min-height: 72px;
                flex-shrink: 0;
            }

                .sidebar-brand .brand-icon {
                    width: 40px;
                    height: 40px;
                    background: linear-gradient(135deg, var(--sidebar-active) 0%, var(--sidebar-active-end) 100%);
                    border-radius: 10px;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    font-size: 1.4rem;
                    color: #fff;
                    flex-shrink: 0;
                    box-shadow: 0 4px 10px rgba(59, 130, 246, 0.35);
                }

                .sidebar-brand .brand-text {
                    font-size: 1.15rem;
                    font-weight: 700;
                    color: #fff;
                    letter-spacing: -0.3px;
                    white-space: nowrap;
                    overflow: hidden;
                    text-overflow: ellipsis;
                }

                    .sidebar-brand .brand-text small {
                        display: block;
                        font-size: 0.6rem;
                        font-weight: 400;
                        color: #94a3b8;
                        letter-spacing: 0.3px;
                        text-transform: uppercase;
                    }

            /* ────────────────────────────────────────────────────────── */
            /* Sidebar Navigation                                       */
            /* ────────────────────────────────────────────────────────── */
            .sidebar-nav {
                flex: 1;
                padding: 0.75rem 0.75rem 1rem 0.75rem;
                overflow-y: auto;
            }

            .nav-category {
                font-size: 0.65rem;
                font-weight: 600;
                text-transform: uppercase;
                letter-spacing: 0.6px;
                color: #64748b;
                padding: 0.75rem 0.75rem 0.4rem 0.75rem;
                cursor: default;
                user-select: none;
                display: flex;
                align-items: center;
                gap: 6px;
                border-bottom: 1px solid rgba(255, 255, 255, 0.04);
                margin-bottom: 0.25rem;
            }

                .nav-category i {
                    font-size: 0.7rem;
                    opacity: 0.5;
                }

            .sidebar-nav .nav-item {
                list-style: none;
                margin-bottom: 1px;
            }

            .sidebar-nav .nav-link {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 0.6rem 0.75rem;
                border-radius: 8px;
                color: var(--sidebar-text);
                text-decoration: none;
                font-size: 0.9rem;
                font-weight: 500;
                transition: background 0.15s ease, color 0.15s ease, padding 0.15s ease;
                position: relative;
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
            }

                .sidebar-nav .nav-link:hover {
                    background: var(--sidebar-hover);
                    color: var(--sidebar-text-hover);
                }

                .sidebar-nav .nav-link.active {
                    background: linear-gradient(135deg, var(--sidebar-active) 0%, var(--sidebar-active-end) 100%);
                    color: #fff;
                    box-shadow: 0 4px 12px rgba(59, 130, 246, 0.3);
                }

                .sidebar-nav .nav-link i {
                    font-size: 1.2rem;
                    width: 24px;
                    text-align: center;
                    flex-shrink: 0;
                }

                .sidebar-nav .nav-link .nav-label {
                    flex: 1;
                    overflow: hidden;
                    text-overflow: ellipsis;
                }

                .sidebar-nav .nav-link.active::before {
                    content: '';
                    position: absolute;
                    left: 0;
                    top: 50%;
                    transform: translateY(-50%);
                    width: 3px;
                    height: 24px;
                    background: #fff;
                    border-radius: 0 4px 4px 0;
                }

            /* ────────────────────────────────────────────────────────── */
            /* Category Collapse                                        */
            /* ────────────────────────────────────────────────────────── */
            .nav-category-toggle {
                cursor: pointer;
                user-select: none;
                transition: background 0.15s ease;
                border-radius: 6px;
                padding: 0.5rem 0.75rem;
                margin-bottom: 0.125rem;
            }

                .nav-category-toggle:hover {
                    background: rgba(255, 255, 255, 0.04);
                }

                .nav-category-toggle .chevron {
                    margin-left: auto;
                    font-size: 0.7rem;
                    transition: transform var(--transition-speed) ease;
                    opacity: 0.5;
                }

                    .nav-category-toggle .chevron.open {
                        transform: rotate(90deg);
                    }

            .category-collapse {
                overflow: hidden;
                transition: height var(--transition-speed) ease;
            }

                .category-collapse .nav {
                    padding-left: 0.5rem;
                    border-left: 1px solid rgba(255, 255, 255, 0.06);
                    margin-left: 0.5rem;
                }

                .category-collapse .nav-item .nav-link {
                    padding-left: 0.5rem;
                    font-size: 0.85rem;
                }

                    .category-collapse .nav-item .nav-link i {
                        font-size: 1rem;
                        width: 22px;
                    }

                .category-collapse .nav-item {
                    opacity: 0;
                    transform: translateY(-4px);
                    animation: fadeSlideIn 0.2s ease forwards;
                }

                    .category-collapse .nav-item:nth-child(1) {
                        animation-delay: 0.02s;
                    }

                    .category-collapse .nav-item:nth-child(2) {
                        animation-delay: 0.04s;
                    }

                    .category-collapse .nav-item:nth-child(3) {
                        animation-delay: 0.06s;
                    }

                    .category-collapse .nav-item:nth-child(4) {
                        animation-delay: 0.08s;
                    }

                    .category-collapse .nav-item:nth-child(5) {
                        animation-delay: 0.10s;
                    }

            @@keyframes fadeSlideIn {
                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            /* ────────────────────────────────────────────────────────── */
            /* Sidebar Footer                                           */
            /* ────────────────────────────────────────────────────────── */
            .sidebar-footer {
                padding: 0.75rem;
                border-top: 1px solid rgba(255, 255, 255, 0.06);
                flex-shrink: 0;
            }

                .sidebar-footer .btn-logout {
                    width: 100%;
                    padding: 0.6rem;
                    border: none;
                    border-radius: 8px;
                    background: rgba(239, 68, 68, 0.15);
                    color: #f87171;
                    font-weight: 500;
                    font-size: 0.9rem;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    gap: 10px;
                    transition: background 0.15s ease, color 0.15s ease;
                    cursor: pointer;
                }

                    .sidebar-footer .btn-logout:hover {
                        background: rgba(239, 68, 68, 0.25);
                        color: #fca5a5;
                    }

                    .sidebar-footer .btn-logout i {
                        font-size: 1.1rem;
                    }

            /* ────────────────────────────────────────────────────────── */
            /* Main Content                                             */
            /* ────────────────────────────────────────────────────────── */
            .main-wrapper {
                margin-left: var(--sidebar-width);
                transition: margin-left var(--transition-speed) ease;
                min-height: 100vh;
                display: flex;
                flex-direction: column;
            }

            .top-navbar {
                background: var(--header-bg);
                border-bottom: 1px solid var(--border-color);
                padding: 0.75rem 1.5rem;
                display: flex;
                align-items: center;
                justify-content: space-between;
                flex-wrap: wrap;
                gap: 0.75rem;
                position: sticky;
                top: 0;
                z-index: 1040;
                backdrop-filter: blur(8px);
                background: rgba(255, 255, 255, 0.92);
            }

                .top-navbar .navbar-left {
                    display: flex;
                    align-items: center;
                    gap: 12px;
                }

                    .top-navbar .navbar-left .hamburger {
                        display: none;
                        background: none;
                        border: none;
                        font-size: 1.5rem;
                        color: #1e293b;
                        padding: 4px 8px;
                        border-radius: 6px;
                        cursor: pointer;
                        transition: background 0.15s ease;
                    }

                        .top-navbar .navbar-left .hamburger:hover {
                            background: #f1f5f9;
                        }

                .top-navbar .page-title {
                    font-size: 1.1rem;
                    font-weight: 600;
                    color: #0f172a;
                    margin: 0;
                    white-space: nowrap;
                    overflow: hidden;
                    text-overflow: ellipsis;
                }

                .top-navbar .navbar-right {
                    display: flex;
                    align-items: center;
                    gap: 16px;
                    flex-wrap: wrap;
                }

                .top-navbar .user-badge {
                    display: flex;
                    align-items: center;
                    gap: 10px;
                    padding: 4px 14px 4px 10px;
                    border-radius: 40px;
                    background: #f1f5f9;
                    font-size: 0.85rem;
                    color: #1e293b;
                }

                    .top-navbar .user-badge .avatar {
                        width: 32px;
                        height: 32px;
                        border-radius: 50%;
                        background: linear-gradient(135deg, var(--sidebar-active) 0%, var(--sidebar-active-end) 100%);
                        color: #fff;
                        display: flex;
                        align-items: center;
                        justify-content: center;
                        font-weight: 600;
                        font-size: 0.8rem;
                    }

                    .top-navbar .user-badge .user-email {
                        font-weight: 500;
                        max-width: 160px;
                        overflow: hidden;
                        text-overflow: ellipsis;
                        white-space: nowrap;
                    }

                .top-navbar .btn-logout-top {
                    padding: 0.4rem 1rem;
                    border: none;
                    border-radius: 40px;
                    background: #fee2e2;
                    color: #b91c1c;
                    font-size: 0.8rem;
                    font-weight: 500;
                    display: flex;
                    align-items: center;
                    gap: 6px;
                    transition: background 0.15s ease;
                    cursor: pointer;
                }

                    .top-navbar .btn-logout-top:hover {
                        background: #fecaca;
                    }

            .main-content {
                flex: 1;
                padding: 1.5rem;
            }

            /* ────────────────────────────────────────────────────────── */
            /* Sidebar Overlay (Mobile)                                 */
            /* ────────────────────────────────────────────────────────── */
            .sidebar-overlay {
                display: none;
                position: fixed;
                inset: 0;
                background: rgba(0, 0, 0, 0.4);
                z-index: 1045;
                backdrop-filter: blur(2px);
                transition: opacity 0.3s ease;
            }

                .sidebar-overlay.show {
                    display: block;
                }

            /* ────────────────────────────────────────────────────────── */
            /* Responsive                                               */
            /* ────────────────────────────────────────────────────────── */
            @@media (max-width: 992px) {
                .sidebar {
                    transform: translateX(-100%);
                    width: var(--sidebar-width);
                }

                    .sidebar.open {
                        transform: translateX(0);
                    }

                .main-wrapper {
                    margin-left: 0;
                }

                .top-navbar .navbar-left .hamburger {
                    display: block;
                }

                .sidebar-overlay.show {
                    display: block;
                }

                .sidebar-brand .brand-text {
                    font-size: 1rem;
                }
            }

            @@media (max-width: 576px) {
                .top-navbar {
                    padding: 0.5rem 0.75rem;
                }

                    .top-navbar .page-title {
                        font-size: 0.95rem;
                        max-width: 120px;
                    }

                    .top-navbar .user-badge .user-email {
                        display: none;
                    }

                    .top-navbar .user-badge {
                        padding: 4px 8px;
                    }

                    .top-navbar .btn-logout-top span {
                        display: none;
                    }

                    .top-navbar .btn-logout-top {
                        padding: 0.4rem 0.7rem;
                    }

                .main-content {
                    padding: 0.75rem;
                }

                .sidebar {
                    width: 280px;
                }
            }

            @@media (prefers-reduced-motion: reduce) {
                * {
                    animation-duration: 0.001ms !important;
                    animation-iteration-count: 1 !important;
                    transition-duration: 0.001ms !important;
                }
            }

            @@media print {
                .sidebar,
                .top-navbar,
                .sidebar-overlay {
                    display: none !important;
                }

                .main-wrapper {
                    margin-left: 0 !important;
                }

                .main-content {
                    padding: 0 !important;
                }
            }
    </style>
</head>

<body>

    <!-- ============================================================ -->
    <!-- SIDEBAR                                                       -->
    <!-- ============================================================ -->
    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        <nav class="sidebar" id="sidebar" aria-label="Main navigation">

            <!-- Brand -->
            <div class="sidebar-brand">
                <div class="brand-icon">
                    <i class="bi bi-car-front-fill"></i>
                </div>
                <div class="brand-text">
                    Vehicle Service
                    <small>Management System</small>
                </div>
            </div>

            <!-- Navigation -->
            <div class="sidebar-nav">

                <!-- ─── DASHBOARD ─── -->
                <ul class="nav flex-column">
                    <li class="nav-item">
                        <a asp-controller="Home" asp-action="Index"
                           class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")">
                            <i class="bi bi-speedometer2"></i>
                            <span class="nav-label">Dashboard</span>
                        </a>
                    </li>
                </ul>

                <!-- ─── MANAGEMENT ─── -->
                <div class="nav-category nav-category-toggle"
                     data-bs-toggle="collapse"
                     data-bs-target="#catManagement"
                     aria-expanded="true"
                     aria-controls="catManagement">
                    <i class="bi bi-folder"></i>
                    Management
                    <i class="bi bi-chevron-right chevron open"></i>
                </div>

                <div class="category-collapse collapse show" id="catManagement">
                    <ul class="nav flex-column">
                        <li class="nav-item">
                            <a asp-controller="Customer" asp-action="Index"
                               class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Customer" ? "active" : "")">
                                <i class="bi bi-people"></i>
                                <span class="nav-label">Customers</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-controller="Vehicle" asp-action="Index"
                               class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Vehicle" ? "active" : "")">
                                <i class="bi bi-car-front"></i>
                                <span class="nav-label">Vehicles</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-controller="VehicleBrand" asp-action="Index"
                               class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "VehicleBrand" ? "active" : "")">
                                <i class="bi bi-tags"></i>
                                <span class="nav-label">Vehicle Brands</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-controller="VehicleType" asp-action="Index"
                               class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "VehicleType" ? "active" : "")">
                                <i class="bi bi-truck"></i>
                                <span class="nav-label">Vehicle Types</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-controller="Mechanic" asp-action="Index"
                               class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Mechanic" ? "active" : "")">
                                <i class="bi bi-person-workspace"></i>
                                <span class="nav-label">Mechanics</span>
                            </a>
                        </li>
                    </ul>
                </div>

                <!-- ─── SERVICES ─── -->
                <div class="nav-category nav-category-toggle mt-2"
                     data-bs-toggle="collapse"
                     data-bs-target="#catServices"
                     aria-expanded="true"
                     aria-controls="catServices">
                    <i class="bi bi-tools"></i>
                    Services
                    <i class="bi bi-chevron-right chevron open"></i>
                </div>

                <div class="category-collapse collapse show" id="catServices">
                    <ul class="nav flex-column">
                        <li class="nav-item">
                            <a asp-controller="ServiceBooking" asp-action="Index"
                               class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "ServiceBooking" ? "active" : "")">
                                <i class="bi bi-calendar-check"></i>
                                <span class="nav-label">Service Bookings</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-controller="JobCard" asp-action="Index"
                               class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "JobCard" ? "active" : "")">
                                <i class="bi bi-file-earmark-text"></i>
                                <span class="nav-label">Job Cards</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-controller="ServiceType" asp-action="Index"
                               class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "ServiceType" ? "active" : "")">
                                <i class="bi bi-clipboard-check"></i>
                                <span class="nav-label">Service Types</span>
                            </a>
                        </li>
                    </ul>
                </div>

                <!-- ─── INVENTORY ─── -->
                <div class="nav-category nav-category-toggle mt-2"
                     data-bs-toggle="collapse"
                     data-bs-target="#catInventory"
                     aria-expanded="true"
                     aria-controls="catInventory">
                    <i class="bi bi-box-seam"></i>
                    Inventory
                    <i class="bi bi-chevron-right chevron open"></i>
                </div>

                <div class="category-collapse collapse show" id="catInventory">
                    <ul class="nav flex-column">
                        <li class="nav-item">
                            <a asp-controller="SparePartCategory" asp-action="Index"
                               class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "SparePartCategory" ? "active" : "")">
                                <i class="bi bi-tag"></i>
                                <span class="nav-label">Spare Categories</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-controller="SparePart" asp-action="Index"
                               class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "SparePart" ? "active" : "")">
                                <i class="bi bi-gear"></i>
                                <span class="nav-label">Spare Parts</span>
                            </a>
                        </li>
                    </ul>
                </div>

                <!-- ─── FINANCE ─── -->
                <div class="nav-category nav-category-toggle mt-2"
                     data-bs-toggle="collapse"
                     data-bs-target="#catFinance"
                     aria-expanded="true"
                     aria-controls="catFinance">
                    <i class="bi bi-wallet2"></i>
                    Finance
                    <i class="bi bi-chevron-right chevron open"></i>
                </div>

                <div class="category-collapse collapse show" id="catFinance">
                    <ul class="nav flex-column">
                        <li class="nav-item">
                            <a asp-controller="Invoice" asp-action="Index"
                               class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Invoice" ? "active" : "")">
                                <i class="bi bi-receipt"></i>
                                <span class="nav-label">Invoices</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-controller="Payment" asp-action="Index"
                               class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Payment" ? "active" : "")">
                                <i class="bi bi-cash-stack"></i>
                                <span class="nav-label">Payments</span>
                            </a>
                        </li>
                    </ul>
                </div>

                <!-- ─── REPORTS ─── -->
                <div class="nav-category nav-category-toggle mt-2"
                     data-bs-toggle="collapse"
                     data-bs-target="#catReports"
                     aria-expanded="true"
                     aria-controls="catReports">
                    <i class="bi bi-bar-chart-line"></i>
                    Reports
                    <i class="bi bi-chevron-right chevron open"></i>
                </div>

                <div class="category-collapse collapse show" id="catReports">
                    <ul class="nav flex-column">
                        <li class="nav-item">
                            <a asp-controller="Report" asp-action="Index"
                               class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Report" ? "active" : "")">
                                <i class="bi bi-bar-chart-line"></i>
                                <span class="nav-label">All Reports</span>
                            </a>
                        </li>
                    </ul>
                </div>

            </div>

            <!-- Sidebar Footer: Logout -->
            <div class="sidebar-footer">
                <form asp-controller="Account" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn-logout">
                        <i class="bi bi-box-arrow-right"></i>
                        Logout
                    </button>
                </form>
            </div>

        </nav>

        <!-- Overlay (mobile) -->
        <div class="sidebar-overlay" id="sidebarOverlay"></div>
    }

    <!-- ============================================================ -->
    <!-- MAIN WRAPPER                                                  -->
    <!-- ============================================================ -->
    <div class="main-wrapper" id="mainWrapper">

        <!-- ─── TOP NAVBAR ─── -->
        <header class="top-navbar">
            <div class="navbar-left">
                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <button class="hamburger" id="hamburgerBtn" aria-label="Toggle sidebar">
                        <i class="bi bi-list"></i>
                    </button>
                }
                <h1 class="page-title">@ViewData["Title"]</h1>
            </div>

            <div class="navbar-right">
                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <div class="user-badge">
                        <span class="avatar">
                            @User.Identity.Name?.Substring(0, 1).ToUpper()
                        </span>
                        <span class="user-email">@User.Identity.Name</span>
                    </div>

                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn-logout-top">
                            <i class="bi bi-box-arrow-right"></i>
                            <span>Logout</span>
                        </button>
                    </form>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-sm">
                        <i class="bi bi-box-arrow-in-right"></i> Login
                    </a>
                }
            </div>
        </header>

        <!-- ─── MAIN CONTENT ─── -->
        <main class="main-content">
            @RenderBody()
        </main>

    </div>

    <!-- ============================================================ -->
    <!-- SCRIPTS                                                       -->
    <!-- ============================================================ -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script>
            (function() {
                'use strict';

                const sidebar = document.getElementById('sidebar');
                const overlay = document.getElementById('sidebarOverlay');
                const hamburger = document.getElementById('hamburgerBtn');

                function toggleSidebar() {
                    if (!sidebar) return;
                    const isOpen = sidebar.classList.toggle('open');
                    if (overlay) {
                        overlay.classList.toggle('show', isOpen);
                    }
                }

                function closeSidebar() {
                    if (!sidebar) return;
                    sidebar.classList.remove('open');
                    if (overlay) {
                        overlay.classList.remove('show');
                    }
                }

                if (hamburger) {
                    hamburger.addEventListener('click', toggleSidebar);
                }

                if (overlay) {
                    overlay.addEventListener('click', closeSidebar);
                }

                document.addEventListener('keydown', function(e) {
                    if (e.key === 'Escape' && sidebar && sidebar.classList.contains('open')) {
                        closeSidebar();
                    }
                });

                let resizeTimer;
                window.addEventListener('resize', function() {
                    clearTimeout(resizeTimer);
                    resizeTimer = setTimeout(function() {
                        if (window.innerWidth > 992 && sidebar) {
                            sidebar.classList.remove('open');
                            if (overlay) {
                                overlay.classList.remove('show');
                            }
                        }
                    }, 150);
                });

                // Category toggle chevron handling
                document.querySelectorAll('.nav-category-toggle').forEach(function(toggle) {
                    toggle.addEventListener('click', function(e) {
                        const chevron = this.querySelector('.chevron');
                        if (chevron) {
                            chevron.classList.toggle('open');
                        }
                    });

                    const targetId = toggle.getAttribute('data-bs-target');
                    if (targetId) {
                        const targetEl = document.querySelector(targetId);
                        if (targetEl) {
                            targetEl.addEventListener('shown.bs.collapse', function() {
                                const ch = toggle.querySelector('.chevron');
                                if (ch) ch.classList.add('open');
                            });
                            targetEl.addEventListener('hidden.bs.collapse', function() {
                                const ch = toggle.querySelector('.chevron');
                                if (ch) ch.classList.remove('open');
                            });
                        }
                    }
                });

                // Auto-expand category containing active link
                const activeLink = document.querySelector('.sidebar-nav .nav-link.active');
                if (activeLink) {
                    const collapseEl = activeLink.closest('.category-collapse');
                    if (collapseEl && !collapseEl.classList.contains('show')) {
                        const toggle = document.querySelector(`[data-bs-target="#${collapseEl.id}"]`);
                        if (toggle) {
                            new bootstrap.Collapse(collapseEl, { toggle: true, show: true });
                            const ch = toggle.querySelector('.chevron');
                            if (ch) ch.classList.add('open');
                        }
                    }
                }

                // Ensure sidebar is closed on mobile initial load
                if (window.innerWidth <= 992 && sidebar) {
                    sidebar.classList.remove('open');
                    if (overlay) {
                        overlay.classList.remove('show');
                    }
                }
            })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>