@model Vehicle_Service_Management_System.Application.ViewModels.ServiceBooking.ServiceBookingDetailsViewModel
@using Vehicle_Service_Management_System.Domain.Enums
@{
    ViewData["Title"] = "Booking Details";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Booking Details | Vehicle Service Management</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
            /* ── (your existing styles – unchanged) ── */
            :root {
                --primary-gradient: linear-gradient(135deg, #0d6efd, #0a58ca);
                --shadow-sm: 0 2px 8px rgba(0, 0, 0, 0.06);
                --shadow-md: 0 8px 30px rgba(0, 0, 0, 0.10);
                --shadow-lg: 0 16px 48px rgba(0, 0, 0, 0.14);
                --radius: 16px;
                --radius-sm: 10px;
                --transition: 0.25s ease;
            }

            body {
                background: #f4f6fa;
                font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
                padding: 2rem 1.5rem;
                min-height: 100vh;
                display: flex;
                align-items: flex-start;
                justify-content: center;
            }

            .details-wrapper {
                max-width: 1200px;
                width: 100%;
                background: #ffffff;
                border-radius: var(--radius);
                box-shadow: var(--shadow-lg);
                padding: 2rem 2.5rem 2.5rem;
                transition: var(--transition);
            }

            @@media (max-width: 576px) {
                body {
                    padding: 1rem 0.75rem;
                }

                .details-wrapper {
                    padding: 1.25rem 1rem 1.75rem;
                    border-radius: var(--radius-sm);
                }
            }

            .page-header {
                display: flex;
                flex-wrap: wrap;
                align-items: center;
                justify-content: space-between;
                gap: 1rem;
                margin-bottom: 1.75rem;
            }

                .page-header h1 {
                    font-weight: 700;
                    font-size: 1.85rem;
                    letter-spacing: -0.02em;
                    color: #1a2634;
                    margin: 0;
                    display: flex;
                    align-items: center;
                    gap: 0.5rem;
                }

                    .page-header h1 i {
                        color: #0d6efd;
                        font-size: 2rem;
                    }

                .page-header .btn-outline-secondary {
                    border-radius: 50px;
                    padding: 0.5rem 1.2rem;
                    font-weight: 500;
                    border-color: #d1d9e6;
                    transition: var(--transition);
                    display: inline-flex;
                    align-items: center;
                    gap: 0.4rem;
                }

                    .page-header .btn-outline-secondary:hover {
                        background: #eef2f7;
                        border-color: #b0bcca;
                    }

            .detail-card {
                background: #f9fafc;
                border-radius: var(--radius-sm);
                padding: 1.5rem 1.75rem;
                box-shadow: var(--shadow-sm);
                border: 1px solid #eef2f7;
                height: 100%;
            }

                .detail-card .card-title {
                    font-weight: 600;
                    font-size: 1.1rem;
                    color: #2d3748;
                    margin-bottom: 1rem;
                    display: flex;
                    align-items: center;
                    gap: 0.5rem;
                }

                    .detail-card .card-title i {
                        color: #0d6efd;
                    }

            .detail-grid {
                display: grid;
                grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
                gap: 1rem 1.8rem;
            }

            .detail-item {
                display: flex;
                flex-direction: column;
            }

                .detail-item .label {
                    font-size: 0.75rem;
                    text-transform: uppercase;
                    letter-spacing: 0.05em;
                    color: #6b7a8e;
                    font-weight: 600;
                }

                .detail-item .value {
                    font-size: 1.05rem;
                    font-weight: 500;
                    color: #1a2634;
                    word-break: break-word;
                }

            .badge-status {
                font-weight: 500;
                padding: 0.3rem 0.9rem;
                border-radius: 50px;
                font-size: 0.8rem;
                display: inline-flex;
                align-items: center;
                gap: 0.4rem;
            }

                .badge-status.bg-success {
                    background: #dcfce7 !important;
                    color: #166534;
                }

                .badge-status.bg-danger {
                    background: #fee2e2 !important;
                    color: #991b1b;
                }

                .badge-status.bg-warning {
                    background: #fef3c7 !important;
                    color: #b45309;
                }

                .badge-status.bg-info {
                    background: #e0f2fe !important;
                    color: #0369a1;
                }

                .badge-status.bg-primary {
                    background: #dbeafe !important;
                    color: #1d4ed8;
                }

                .badge-status i {
                    font-size: 0.7rem;
                }

            .customer-detail {
                font-weight: 500;
                color: #1a2634;
            }

                .customer-detail .phone,
                .customer-detail .email {
                    font-weight: 400;
                    color: #4a5568;
                    font-size: 0.9rem;
                }

            .action-card {
                background: #f9fafc;
                border-radius: var(--radius-sm);
                padding: 1.25rem 1.5rem;
                box-shadow: var(--shadow-sm);
                border: 1px solid #eef2f7;
                height: 100%;
            }

                .action-card .card-title {
                    font-weight: 600;
                    font-size: 1rem;
                    color: #2d3748;
                    margin-bottom: 0.75rem;
                    display: flex;
                    align-items: center;
                    gap: 0.5rem;
                }

                    .action-card .card-title i {
                        color: #0d6efd;
                    }

                .action-card .btn {
                    border-radius: 40px;
                    padding: 0.45rem 1.2rem;
                    font-weight: 500;
                    transition: var(--transition);
                }

                .action-card .btn-primary {
                    background: var(--primary-gradient);
                    border: none;
                    box-shadow: 0 4px 14px rgba(13, 110, 253, 0.25);
                }

                    .action-card .btn-primary:hover {
                        transform: translateY(-2px);
                        box-shadow: 0 8px 24px rgba(13, 110, 253, 0.35);
                    }

                .action-card .form-control,
                .action-card .form-select {
                    border-radius: 10px;
                    border: 1px solid #dce2ec;
                    padding: 0.5rem 1rem;
                    transition: var(--transition);
                }

                    .action-card .form-control:focus,
                    .action-card .form-select:focus {
                        border-color: #0d6efd;
                        box-shadow: 0 0 0 4px rgba(13, 110, 253, 0.12);
                    }

            .action-footer {
                display: flex;
                flex-wrap: wrap;
                gap: 0.75rem;
                margin-top: 1.75rem;
                align-items: center;
                justify-content: flex-start;
            }

                .action-footer .btn {
                    border-radius: 50px;
                    padding: 0.5rem 1.5rem;
                    font-weight: 500;
                    transition: var(--transition);
                    display: inline-flex;
                    align-items: center;
                    gap: 0.5rem;
                }

                .action-footer .btn-primary {
                    background: var(--primary-gradient);
                    border: none;
                    box-shadow: 0 4px 14px rgba(13, 110, 253, 0.30);
                }

                    .action-footer .btn-primary:hover {
                        transform: translateY(-2px);
                        box-shadow: 0 8px 24px rgba(13, 110, 253, 0.40);
                    }

                .action-footer .btn-outline-success {
                    border-color: #86efac;
                    color: #15803d;
                }

                    .action-footer .btn-outline-success:hover {
                        background: #dcfce7;
                        border-color: #15803d;
                    }

                .action-footer .btn-outline-danger {
                    border-color: #fca5a5;
                    color: #b91c1c;
                }

                    .action-footer .btn-outline-danger:hover {
                        background: #fee2e2;
                        border-color: #b91c1c;
                    }

                .action-footer .btn-secondary {
                    border-color: #d1d9e6;
                }

                    .action-footer .btn-secondary:hover {
                        background: #eef2f7;
                        border-color: #b0bcca;
                    }

                .action-footer .btn-warning {
                    background: #fbbf24;
                    border: none;
                    color: #1a2634;
                    box-shadow: 0 4px 14px rgba(251, 191, 36, 0.30);
                }

                    .action-footer .btn-warning:hover {
                        transform: translateY(-2px);
                        box-shadow: 0 8px 24px rgba(251, 191, 36, 0.40);
                    }

            @@media (max-width: 576px) {
                .detail-grid {
                    grid-template-columns: 1fr;
                    gap: 0.8rem;
                }

                .action-footer .btn {
                    flex: 1;
                    justify-content: center;
                }

                .page-header h1 {
                    font-size: 1.4rem;
                }

                    .page-header h1 i {
                        font-size: 1.5rem;
                    }

                .action-card .btn {
                    width: 100%;
                    justify-content: center;
                }

                .action-card .d-flex.gap-2 {
                    flex-direction: column;
                    align-items: stretch;
                }
            }
    </style>
</head>
<body>

    <div class="details-wrapper">

        <div class="page-header">
            <h1>
                <i class="bi bi-calendar-check"></i>
                Booking Details
                <span class="text-muted" style="font-size:1.2rem;">#@Model.BookingNumber</span>
            </h1>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Back to List
            </a>
        </div>

        <!-- ─── MAIN INFORMATION ─── -->
        <div class="detail-card mb-4">
            <div class="card-title">
                <i class="bi bi-info-circle"></i> Booking Information
            </div>
            <div class="detail-grid">
                <div class="detail-item">
                    <span class="label">Customer</span>
                    <span class="value customer-detail">
                        @Model.CustomerName
                        <span class="phone">
                            <i class="bi bi-telephone-fill" style="font-size:0.8rem;"></i> @Model.PhoneNumber
                        </span>
                        @if (!string.IsNullOrEmpty(Model.Email))
                        {
                            <span class="email">
                                <i class="bi bi-envelope-fill" style="font-size:0.8rem;"></i> @Model.Email
                            </span>
                        }
                    </span>
                </div>
                <div class="detail-item">
                    <span class="label">Vehicle</span>
                    <span class="value">@Model.VehicleRegistrationNumber <span class="text-muted" style="font-weight:400;">(@Model.VehicleModel)</span></span>
                </div>
                <div class="detail-item">
                    <span class="label">Services</span>
                    <span class="value">
                        @if (Model.Services != null && Model.Services.Any())
                        {
                            @string.Join(", ", Model.Services.Select(s => s.ServiceName))
                        }
                        else
                        {
                            <text>—</text>
                        }
                    </span>
                </div>
                <div class="detail-item">
                    <span class="label">Mechanic</span>
                    <span class="value">@Model.MechanicName</span>
                </div>
                <div class="detail-item">
                    <span class="label">Booking Date</span>
                    <span class="value">@Model.BookingDate.ToString("dd/MM/yyyy HH:mm")</span>
                </div>
                <div class="detail-item">
                    <span class="label">Expected Delivery</span>
                    <span class="value">@(Model.ExpectedDeliveryDate?.ToString("dd/MM/yyyy") ?? "—")</span>
                </div>
                <div class="detail-item">
                    <span class="label">Delivery Date</span>
                    <span class="value">@(Model.DeliveryDate?.ToString("dd/MM/yyyy HH:mm") ?? "—")</span>
                </div>
                <div class="detail-item">
                    <span class="label">Odometer</span>
                    <span class="value">@Model.OdometerReading</span>
                </div>
                <div class="detail-item">
                    <span class="label">Complaint</span>
                    <span class="value">@Model.Complaint</span>
                </div>
                <div class="detail-item">
                    <span class="label">Amount</span>
                    <span class="value">@Model.TotalAmount.ToString("C")</span>
                </div>
                <div class="detail-item">
                    <span class="label">Remarks</span>
                    <span class="value">@(string.IsNullOrEmpty(Model.Remarks) ? "—" : Model.Remarks)</span>
                </div>
                <div class="detail-item">
                    <span class="label">Status</span>
                    <span class="value">
                        @{
                            string statusBadgeClass = Model.Status switch
                            {
                                "Pending" => "bg-warning",
                                "InProgress" => "bg-info",
                                "Completed" => "bg-success",
                                "Cancelled" => "bg-danger",
                                _ => "bg-secondary"
                            };
                            string statusIcon = Model.Status switch
                            {
                                "Pending" => "bi-clock-fill",
                                "InProgress" => "bi-arrow-repeat",
                                "Completed" => "bi-check-circle-fill",
                                "Cancelled" => "bi-x-circle-fill",
                                _ => "bi-dot"
                            };
                        }
                        <span class="badge-status @statusBadgeClass">
                            <i class="bi @statusIcon"></i> @Model.Status
                        </span>
                    </span>
                </div>
            </div>
        </div>

        <!-- ─── FOOTER ACTIONS ─── -->
        <div class="action-footer">
            @if (!Model.HasJobCard)
            {
                <a asp-controller="JobCard" asp-action="Create" asp-route-bookingId="@Model.Id" class="btn btn-outline-success">
                    <i class="bi bi-file-earmark-plus"></i> Create Job Card
                </a>
            }

            @if (!Model.HasInvoice)
            {
                <a asp-controller="Invoice" asp-action="Create" asp-route-bookingId="@Model.Id" class="btn btn-outline-success">
                    <i class="bi bi-receipt"></i> Generate Invoice
                </a>
            }

            <a asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Back to List
            </a>
        </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>