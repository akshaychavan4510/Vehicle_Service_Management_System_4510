@model Vehicle_Service_Management_System.Application.ViewModels.Payment.PaymentDetailsViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Payment Details | Vehicle Service Management</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
            /* ── all existing styles ── */
            :root {
                --primary-gradient: linear-gradient(135deg, #0d6efd, #0a58ca);
                --shadow-sm: 0 2px 8px rgba(0, 0, 0, 0.06);
                --shadow-md: 0 8px 30px rgba(0, 0, 0, 0.10);
                --shadow-lg: 0 16px 48px rgba(0, 0, 0, 0.14);
                --radius: 16px;
                --radius-sm: 10px;
                --transition: 0.25s ease;
            }

            body {
                background: #f4f6fa;
                font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
                padding: 2rem 1.5rem;
                min-height: 100vh;
                display: flex;
                align-items: flex-start;
                justify-content: center;
            }

            .details-wrapper {
                max-width: 1000px;
                width: 100%;
                background: #ffffff;
                border-radius: var(--radius);
                box-shadow: var(--shadow-lg);
                padding: 2rem 2.5rem 2.5rem;
                transition: var(--transition);
            }

            @@media (max-width: 576px) {
                body {
                    padding: 1rem 0.75rem;
                }

                .details-wrapper {
                    padding: 1.25rem 1rem 1.75rem;
                    border-radius: var(--radius-sm);
                }
            }

            .page-header {
                display: flex;
                flex-wrap: wrap;
                align-items: center;
                justify-content: space-between;
                gap: 1rem;
                margin-bottom: 1.75rem;
            }

                .page-header h1 {
                    font-weight: 700;
                    font-size: 1.85rem;
                    letter-spacing: -0.02em;
                    color: #1a2634;
                    margin: 0;
                    display: flex;
                    align-items: center;
                    gap: 0.5rem;
                }

                    .page-header h1 i {
                        color: #0d6efd;
                        font-size: 2rem;
                    }

                .page-header .btn-outline-secondary {
                    border-radius: 50px;
                    padding: 0.5rem 1.2rem;
                    font-weight: 500;
                    border-color: #d1d9e6;
                    transition: var(--transition);
                    display: inline-flex;
                    align-items: center;
                    gap: 0.4rem;
                }

                    .page-header .btn-outline-secondary:hover {
                        background: #eef2f7;
                        border-color: #b0bcca;
                    }

            .detail-card {
                background: #f9fafc;
                border-radius: var(--radius-sm);
                padding: 1.5rem 1.75rem;
                box-shadow: var(--shadow-sm);
                border: 1px solid #eef2f7;
                margin-bottom: 1.75rem;
            }

            .detail-grid {
                display: grid;
                grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
                gap: 1rem 1.8rem;
            }

            .detail-item {
                display: flex;
                flex-direction: column;
            }

                .detail-item .label {
                    font-size: 0.75rem;
                    text-transform: uppercase;
                    letter-spacing: 0.05em;
                    color: #6b7a8e;
                    font-weight: 600;
                }

                .detail-item .value {
                    font-size: 1.05rem;
                    font-weight: 500;
                    color: #1a2634;
                    word-break: break-word;
                }

                    .detail-item .value a {
                        color: #0d6efd;
                        text-decoration: none;
                        font-weight: 600;
                    }

                        .detail-item .value a:hover {
                            text-decoration: underline;
                        }

                    .detail-item .value .badge-status {
                        font-weight: 500;
                        padding: 0.3rem 0.9rem;
                        border-radius: 50px;
                        font-size: 0.8rem;
                        display: inline-flex;
                        align-items: center;
                        gap: 0.4rem;
                    }

            .badge-status.bg-success {
                background: #dcfce7 !important;
                color: #166534;
            }

            .badge-status.bg-danger {
                background: #fee2e2 !important;
                color: #991b1b;
            }

            .badge-status i {
                font-size: 0.7rem;
            }

            .stat-chip {
                background: white;
                border-radius: 60px;
                padding: 0.2rem 1rem;
                box-shadow: var(--shadow-sm);
                border: 1px solid #e9edf4;
                display: inline-block;
                font-weight: 500;
                color: #1a2634;
                font-size: 0.95rem;
            }

                .stat-chip i {
                    color: #0d6efd;
                    margin-right: 0.3rem;
                }

                .stat-chip.gold {
                    background: #fef3c7;
                    border-color: #fde68a;
                }

                .stat-chip.green {
                    background: #dcfce7;
                    border-color: #86efac;
                }

                .stat-chip.blue {
                    background: #e0f2fe;
                    border-color: #b8d4fe;
                }

            .action-footer {
                display: flex;
                flex-wrap: wrap;
                gap: 0.75rem;
                margin-top: 1.75rem;
                align-items: center;
            }

                .action-footer .btn {
                    border-radius: 50px;
                    padding: 0.5rem 1.5rem;
                    font-weight: 500;
                    transition: var(--transition);
                    display: inline-flex;
                    align-items: center;
                    gap: 0.5rem;
                }

                .action-footer .btn-primary {
                    background: var(--primary-gradient);
                    border: none;
                    box-shadow: 0 4px 14px rgba(13, 110, 253, 0.30);
                }

                    .action-footer .btn-primary:hover {
                        transform: translateY(-2px);
                        box-shadow: 0 8px 24px rgba(13, 110, 253, 0.40);
                    }

                .action-footer .btn-outline-danger {
                    border-color: #fca5a5;
                    color: #b91c1c;
                }

                    .action-footer .btn-outline-danger:hover {
                        background: #fee2e2;
                        border-color: #b91c1c;
                    }

                .action-footer .btn-secondary {
                    border-color: #d1d9e6;
                }

                    .action-footer .btn-secondary:hover {
                        background: #eef2f7;
                        border-color: #b0bcca;
                    }

            @@media (max-width: 576px) {
                .detail-grid {
                    grid-template-columns: 1fr;
                    gap: 0.8rem;
                }

                .action-footer .btn {
                    flex: 1;
                    justify-content: center;
                }

                .page-header h1 {
                    font-size: 1.4rem;
                }

                    .page-header h1 i {
                        font-size: 1.5rem;
                    }
            }
    </style>
</head>
<body>

    <div class="details-wrapper">

        <div class="page-header">
            <h1>
                <i class="bi bi-credit-card-2-front"></i>
                Payment Details
            </h1>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Back to List
            </a>
        </div>

        <div class="detail-card">
            <div class="detail-grid">
                <div class="detail-item">
                    <span class="label">Invoice No.</span>
                    <span class="value">
                        <a asp-controller="Invoice" asp-action="Details" asp-route-id="@Model.InvoiceId">
                            @Model.InvoiceNumber
                        </a>
                    </span>
                </div>
                <div class="detail-item">
                    <span class="label">Customer</span>
                    <span class="value">@Model.CustomerName</span>
                </div>
                <div class="detail-item">
                    <span class="label">Vehicle</span>
                    <span class="value">@Model.VehicleNumber</span>
                </div>
                <div class="detail-item">
                    <span class="label">Payment Date</span>
                    <span class="value">@Model.PaymentDate.ToString("dd/MM/yyyy HH:mm")</span>
                </div>
                <div class="detail-item">
                    <span class="label">Payment Mode</span>
                    <span class="value">@Model.PaymentMode</span>
                </div>
                <div class="detail-item">
                    <span class="label">Amount Paid</span>
                    <span class="value">
                        <span class="stat-chip gold">
                            <i class="bi bi-currency-rupee"></i> @Model.AmountPaid.ToString("C")
                        </span>
                    </span>
                </div>
                <div class="detail-item">
                    <span class="label">Transaction Reference</span>
                    <span class="value">@(string.IsNullOrEmpty(Model.TransactionReference) ? "—" : Model.TransactionReference)</span>
                </div>
                <div class="detail-item">
                    <span class="label">Remarks</span>
                    <span class="value">@(string.IsNullOrEmpty(Model.Remarks) ? "—" : Model.Remarks)</span>
                </div>
                <div class="detail-item">
                    <span class="label">Invoice Grand Total</span>
                    <span class="value">
                        <span class="stat-chip blue">
                            <i class="bi bi-receipt"></i> @Model.InvoiceGrandTotal.ToString("C")
                        </span>
                    </span>
                </div>
                <div class="detail-item">
                    <span class="label">Total Paid (Invoice)</span>
                    <span class="value">
                        <span class="stat-chip green">
                            <i class="bi bi-check-circle-fill"></i> @Model.TotalPaid.ToString("C")
                        </span>
                    </span>
                </div>
                <div class="detail-item">
                    <span class="label">Created On</span>
                    <span class="value">@Model.CreatedOn.ToString("dd/MM/yyyy HH:mm")</span>
                </div>
            </div>
        </div>

        <div class="action-footer">
            <a asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Back to List
            </a>
        </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>