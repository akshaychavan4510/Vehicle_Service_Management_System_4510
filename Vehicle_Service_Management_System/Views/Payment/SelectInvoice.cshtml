@model IEnumerable<Vehicle_Service_Management_System.Application.ViewModels.Invoice.InvoiceListViewModel>

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Select Invoice | Vehicle Service Management</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
            /* ── all existing styles ── */
            :root {
                --primary-gradient: linear-gradient(135deg, #0d6efd, #0a58ca);
                --shadow-sm: 0 2px 8px rgba(0, 0, 0, 0.06);
                --shadow-md: 0 8px 30px rgba(0, 0, 0, 0.10);
                --shadow-lg: 0 16px 48px rgba(0, 0, 0, 0.14);
                --radius: 16px;
                --radius-sm: 10px;
                --transition: 0.25s ease;
            }

            body {
                background: #f4f6fa;
                font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
                padding: 2rem 1.5rem;
                min-height: 100vh;
                display: flex;
                align-items: flex-start;
                justify-content: center;
            }

            .select-wrapper {
                max-width: 1200px;
                width: 100%;
                background: #ffffff;
                border-radius: var(--radius);
                box-shadow: var(--shadow-lg);
                padding: 2rem 2rem 2.5rem;
                transition: var(--transition);
            }

            @@media (max-width: 576px) {
                body {
                    padding: 1rem 0.75rem;
                }

                .select-wrapper {
                    padding: 1.25rem 1rem 1.75rem;
                    border-radius: var(--radius-sm);
                }
            }

            .page-header {
                display: flex;
                flex-wrap: wrap;
                align-items: center;
                justify-content: space-between;
                gap: 1rem;
                margin-bottom: 1.75rem;
            }

                .page-header h1 {
                    font-weight: 700;
                    font-size: 1.85rem;
                    letter-spacing: -0.02em;
                    color: #1a2634;
                    margin: 0;
                    display: flex;
                    align-items: center;
                    gap: 0.5rem;
                }

                    .page-header h1 i {
                        color: #0d6efd;
                        font-size: 2rem;
                    }

                .page-header .btn-outline-secondary {
                    border-radius: 50px;
                    padding: 0.5rem 1.2rem;
                    font-weight: 500;
                    border-color: #d1d9e6;
                    transition: var(--transition);
                    display: inline-flex;
                    align-items: center;
                    gap: 0.4rem;
                }

                    .page-header .btn-outline-secondary:hover {
                        background: #eef2f7;
                        border-color: #b0bcca;
                    }

            .table-card {
                background: #ffffff;
                border-radius: var(--radius-sm);
                box-shadow: var(--shadow-sm);
                overflow: hidden;
                border: 1px solid #eef2f7;
                margin-top: 0.5rem;
            }

            .table-responsive-custom {
                overflow-x: auto;
                -webkit-overflow-scrolling: touch;
                padding: 0 0.25rem;
            }

            .table {
                margin: 0;
                font-size: 0.92rem;
                vertical-align: middle;
                border-collapse: separate;
                border-spacing: 0;
                min-width: 700px;
            }

                .table thead th {
                    background: #f8fafc;
                    color: #2d3748;
                    font-weight: 600;
                    font-size: 0.8rem;
                    text-transform: uppercase;
                    letter-spacing: 0.04em;
                    padding: 0.9rem 1rem;
                    border-bottom: 2px solid #e2e8f0;
                    white-space: nowrap;
                }

                .table tbody td {
                    padding: 0.85rem 1rem;
                    border-bottom: 1px solid #edf2f7;
                    background: #fff;
                    transition: background var(--transition);
                }

                .table tbody tr:hover td {
                    background: #fafcff;
                }

                .table tbody tr:last-child td {
                    border-bottom: none;
                }

            .action-group .btn {
                border-radius: 30px;
                padding: 0.25rem 0.75rem;
                font-size: 0.75rem;
                font-weight: 500;
                transition: var(--transition);
                display: inline-flex;
                align-items: center;
                gap: 0.3rem;
            }

            .action-group .btn-success {
                background: #22c55e;
                border: none;
                color: #fff;
                box-shadow: 0 2px 8px rgba(34, 197, 94, 0.25);
            }

                .action-group .btn-success:hover {
                    transform: translateY(-1px);
                    box-shadow: 0 4px 14px rgba(34, 197, 94, 0.35);
                }

            .empty-state td {
                padding: 3.5rem 1rem !important;
                text-align: center;
                color: #94a3b8;
                font-size: 1rem;
            }

                .empty-state td i {
                    font-size: 2.8rem;
                    display: block;
                    margin-bottom: 0.75rem;
                    color: #cbd5e1;
                }

            .badge-status {
                font-weight: 500;
                padding: 0.4rem 0.9rem;
                border-radius: 50px;
                font-size: 0.75rem;
                display: inline-flex;
                align-items: center;
                gap: 0.4rem;
                letter-spacing: 0.02em;
            }

                .badge-status.bg-success {
                    background: #dcfce7 !important;
                    color: #166534;
                }

                .badge-status.bg-danger {
                    background: #fee2e2 !important;
                    color: #991b1b;
                }

                .badge-status i {
                    font-size: 0.7rem;
                }

            .table-footer {
                padding: 0.75rem 1.25rem;
                background: #f8fafc;
                border-top: 1px solid #eef2f7;
                font-size: 0.9rem;
                color: #4a5568;
            }

                .table-footer strong {
                    color: #1a2634;
                }

            @@media (max-width: 480px) {
                .page-header h1 {
                    font-size: 1.4rem;
                }

                    .page-header h1 i {
                        font-size: 1.5rem;
                    }

                .table tbody td {
                    padding: 0.6rem 0.5rem;
                    font-size: 0.82rem;
                }

                .table thead th {
                    padding: 0.6rem 0.5rem;
                    font-size: 0.7rem;
                }

                .action-group .btn {
                    font-size: 0.65rem;
                    padding: 0.15rem 0.5rem;
                }
            }
    </style>
</head>
<body>

    <div class="select-wrapper">

        <div class="page-header">
            <h1>
                <i class="bi bi-credit-card-2-front"></i>
                Select Invoice for Payment
            </h1>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Back to Payments
            </a>
        </div>

        <div class="table-card">
            <div class="table-responsive-custom">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Invoice No.</th>
                            <th>Customer</th>
                            <th>Vehicle</th>
                            <th>Grand Total</th>
                            <th>Balance Due</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <span class="fw-500">@item.InvoiceNumber</span>
                                    </td>
                                    <td>@item.CustomerName</td>
                                    <td>@item.VehicleRegistrationNumber</td>
                                    <td>@item.GrandTotal.ToString("C")</td>
                                    <td>@item.Balance.ToString("C")</td>
                                    <td>
                                        <span class="badge-status @(item.IsPaid ? "bg-success" : "bg-danger")">
                                            <i class="bi @(item.IsPaid ? "bi-check-circle-fill" : "bi-x-circle-fill")"></i>
                                            @(item.IsPaid ? "Paid" : "Unpaid")
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <div class="action-group justify-content-end">
                                            <a asp-action="Create" asp-route-invoiceId="@item.Id" class="btn btn-success">
                                                <i class="bi bi-plus-lg"></i> Record Payment
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr class="empty-state">
                                <td colspan="7">
                                    <i class="bi bi-credit-card"></i>
                                    No invoices with outstanding balance.
                                    <div class="mt-2">
                                        <a asp-controller="Invoice" asp-action="Index" class="btn btn-sm btn-primary">
                                            <i class="bi bi-plus-lg"></i> View all invoices
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="table-footer">
            Total Records: <strong>@Model.Count()</strong>
        </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>