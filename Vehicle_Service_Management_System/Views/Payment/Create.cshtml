@model Vehicle_Service_Management_System.Application.ViewModels.Payment.PaymentCreateViewModel
@using Vehicle_Service_Management_System.Domain.Enums
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Record Payment | Vehicle Service Management</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
            :root {
                --primary-gradient: linear-gradient(135deg, #0d6efd, #0a58ca);
                --shadow-sm: 0 2px 8px rgba(0, 0, 0, 0.06);
                --shadow-md: 0 8px 30px rgba(0, 0, 0, 0.10);
                --shadow-lg: 0 16px 48px rgba(0, 0, 0, 0.14);
                --radius: 16px;
                --radius-sm: 10px;
                --transition: 0.25s ease;
            }

            body {
                background: #f4f6fa;
                font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
                padding: 2rem 1.5rem;
                min-height: 100vh;
                display: flex;
                align-items: flex-start;
                justify-content: center;
            }

            .create-wrapper {
                max-width: 900px;
                width: 100%;
                background: #ffffff;
                border-radius: var(--radius);
                box-shadow: var(--shadow-lg);
                padding: 2rem 2.5rem 2.5rem;
                transition: var(--transition);
            }

            @@media (max-width: 576px) {
                body {
                    padding: 1rem 0.75rem;
                }

                .create-wrapper {
                    padding: 1.25rem 1rem 1.75rem;
                    border-radius: var(--radius-sm);
                }
            }

            /* ── Header ── */
            .page-header {
                display: flex;
                flex-wrap: wrap;
                align-items: center;
                justify-content: space-between;
                gap: 1rem;
                margin-bottom: 1.75rem;
            }

                .page-header h1 {
                    font-weight: 700;
                    font-size: 1.85rem;
                    letter-spacing: -0.02em;
                    color: #1a2634;
                    margin: 0;
                    display: flex;
                    align-items: center;
                    gap: 0.5rem;
                }

                    .page-header h1 i {
                        color: #0d6efd;
                        font-size: 2rem;
                    }

                .page-header .btn-outline-secondary {
                    border-radius: 50px;
                    padding: 0.5rem 1.2rem;
                    font-weight: 500;
                    border-color: #d1d9e6;
                    transition: var(--transition);
                    display: inline-flex;
                    align-items: center;
                    gap: 0.4rem;
                }

                    .page-header .btn-outline-secondary:hover {
                        background: #eef2f7;
                        border-color: #b0bcca;
                    }

            /* ── Form Card ── */
            .form-card {
                background: #f9fafc;
                border-radius: var(--radius-sm);
                padding: 1.75rem 2rem;
                box-shadow: var(--shadow-sm);
                border: 1px solid #eef2f7;
            }

            @@media (max-width: 576px) {
                .form-card {
                    padding: 1.25rem 1rem;
                }
            }

            /* ── Info Box ── */
            .info-box {
                display: grid;
                grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
                gap: 1rem 2rem;
                background: #eef2f7;
                border-radius: var(--radius-sm);
                padding: 1.25rem 1.5rem;
                margin-bottom: 1.75rem;
                border-left: 4px solid #0d6efd;
            }

                .info-box > div {
                    display: flex;
                    flex-direction: column;
                }

                .info-box .label {
                    font-size: 0.7rem;
                    text-transform: uppercase;
                    letter-spacing: 0.05em;
                    color: #6b7a8e;
                    font-weight: 600;
                }

                .info-box .value {
                    font-size: 1.15rem;
                    font-weight: 600;
                    color: #1a2634;
                }

                .info-box .balance {
                    color: #dc3545;
                }

            @@media (max-width: 480px) {
                .info-box {
                    grid-template-columns: 1fr;
                    gap: 0.5rem;
                    padding: 1rem;
                }
            }

            /* ── Form Fields ── */
            .form-floating-custom .form-control,
            .form-floating-custom .form-select,
            .form-floating-custom textarea {
                border-radius: 10px;
                border: 1px solid #dce2ec;
                padding: 0.6rem 1rem;
                transition: var(--transition);
            }

                .form-floating-custom .form-control:focus,
                .form-floating-custom .form-select:focus,
                .form-floating-custom textarea:focus {
                    border-color: #0d6efd;
                    box-shadow: 0 0 0 4px rgba(13, 110, 253, 0.12);
                }

            .form-floating-custom label {
                font-weight: 500;
                color: #2d3748;
                margin-bottom: 0.3rem;
            }

            .form-floating-custom .text-danger {
                font-size: 0.8rem;
                margin-top: 0.2rem;
            }

            /* ── Buttons ── */
            .btn-primary {
                background: var(--primary-gradient);
                border: none;
                padding: 0.6rem 1.8rem;
                font-weight: 600;
                border-radius: 50px;
                box-shadow: 0 4px 14px rgba(13, 110, 253, 0.30);
                transition: var(--transition);
                display: inline-flex;
                align-items: center;
                gap: 0.5rem;
            }

                .btn-primary:hover {
                    transform: translateY(-2px);
                    box-shadow: 0 8px 24px rgba(13, 110, 253, 0.40);
                }

            .btn-secondary {
                border-radius: 50px;
                padding: 0.6rem 1.8rem;
                font-weight: 500;
                border-color: #d1d9e6;
                transition: var(--transition);
            }

                .btn-secondary:hover {
                    background: #eef2f7;
                    border-color: #b0bcca;
                }

            /* ── Validation Summary ── */
            .validation-summary-errors {
                background: #fee2e2;
                border: 1px solid #fca5a5;
                border-radius: 10px;
                padding: 0.75rem 1rem;
                margin-bottom: 1.5rem;
                color: #991b1b;
            }

                .validation-summary-errors ul {
                    margin: 0;
                    padding-left: 1.2rem;
                }

            /* ── Responsive tweaks ── */
            @@media (max-width: 576px) {
                .page-header h1 {
                    font-size: 1.4rem;
                }

                    .page-header h1 i {
                        font-size: 1.5rem;
                    }

                .d-flex.gap-2 {
                    flex-direction: column;
                    align-items: stretch;
                }

                    .d-flex.gap-2 .btn {
                        width: 100%;
                        justify-content: center;
                    }

                .info-box .value {
                    font-size: 1rem;
                }
            }

            @@media (max-width: 400px) {
                body {
                    padding: 0.5rem;
                }

                .create-wrapper {
                    padding: 0.75rem;
                }

                .form-card {
                    padding: 0.75rem;
                }
            }
    </style>
</head>
<body>

    <div class="create-wrapper">

        <!-- ─── HEADER ─── -->
        <div class="page-header">
            <h1>
                <i class="bi bi-credit-card"></i>
                Record Payment
            </h1>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Back to Payments
            </a>
        </div>

        <!-- ─── FORM ─── -->
        <div class="form-card">

            <!-- ─── Info Box ─── -->
            <div class="info-box">
                <div>
                    <span class="label">Invoice</span>
                    <span class="value">#@ViewBag.InvoiceNumber</span>
                </div>
                <div>
                    <span class="label">Grand Total</span>
                    <span class="value">@(((decimal)ViewBag.GrandTotal).ToString("C"))</span>
                </div>
                <div>
                    <span class="label">Balance Due</span>
                    <span class="value balance">@(((decimal)ViewBag.Balance).ToString("C"))</span>
                </div>
            </div>

            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="InvoiceId" />

                <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

                <div class="row g-3">

                    <!-- Payment Date -->
                    <div class="col-md-6 form-floating-custom">
                        <label asp-for="PaymentDate" class="form-label">Payment Date</label>
                        <input asp-for="PaymentDate" class="form-control" type="datetime-local" />
                        <span asp-validation-for="PaymentDate" class="text-danger"></span>
                    </div>

                    <!-- Payment Mode -->
                    <div class="col-md-6 form-floating-custom">
                        <label asp-for="PaymentMode" class="form-label">Payment Mode</label>
                        <select asp-for="PaymentMode" class="form-select" asp-items="Html.GetEnumSelectList<PaymentMode>()">
                            <option value="">— Select Payment Mode —</option>
                        </select>
                        <span asp-validation-for="PaymentMode" class="text-danger"></span>
                    </div>

                    <!-- Amount Paid -->
                    <div class="col-md-6 form-floating-custom">
                        <label asp-for="AmountPaid" class="form-label">Amount Paid</label>
                        <input asp-for="AmountPaid" class="form-control" type="number" step="0.01" placeholder="0.00" />
                        <span asp-validation-for="AmountPaid" class="text-danger"></span>
                    </div>

                    <!-- Transaction Reference -->
                    <div class="col-md-6 form-floating-custom">
                        <label asp-for="TransactionReference" class="form-label">Transaction Reference</label>
                        <input asp-for="TransactionReference" class="form-control" placeholder="e.g. TXN123456" />
                        <span asp-validation-for="TransactionReference" class="text-danger"></span>
                    </div>

                    <!-- Remarks -->
                    <div class="col-12 form-floating-custom">
                        <label asp-for="Remarks" class="form-label">Remarks</label>
                        <textarea asp-for="Remarks" class="form-control" rows="3" placeholder="Additional remarks"></textarea>
                        <span asp-validation-for="Remarks" class="text-danger"></span>
                    </div>

                </div>

                <hr class="my-4" />

                <!-- ─── ACTION BUTTONS ─── -->
                <div class="d-flex flex-wrap gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-lg"></i> Record Payment
                    </button>
                    <a asp-controller="Invoice" asp-action="Details" asp-route-id="@Model.InvoiceId" class="btn btn-secondary">
                        <i class="bi bi-x-lg"></i> Cancel
                    </a>
                </div>

            </form>
        </div>

    </div>

    <!-- ─── SCRIPTS ─── -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        // ─── Auto‑dismiss alerts after 4 seconds ───
        document.addEventListener('DOMContentLoaded', function () {
        const alerts = document.querySelectorAll('.alert');
        alerts.forEach(function (alert) {
        setTimeout(function () {
        const bsAlert = bootstrap.Alert.getOrCreateInstance(alert);
        bsAlert.close();
        }, 4000);
        });
        });
    </script>
</body>
</html>