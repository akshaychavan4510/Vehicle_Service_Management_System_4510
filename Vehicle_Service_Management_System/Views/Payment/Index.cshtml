@model Vehicle_Service_Management_System.Application.ViewModels.Common.PagedResult<Vehicle_Service_Management_System.Application.ViewModels.Payment.PaymentListViewModel>
@using Vehicle_Service_Management_System.Domain.Enums

@{
    ViewData["Title"] = "Payments";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Payments | Vehicle Service Management</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <style>
            /* ────────────────────────────────────────────────────────── */
            /* Root Variables                                          */
            /* ────────────────────────────────────────────────────────── */
            :root {
                --primary: #0d6efd;
                --primary-dark: #0a58ca;
                --primary-light: #e8f0fe;
                --success: #22c55e;
                --danger: #ef4444;
                --warning: #f59e0b;
                --info: #0dcaf0;
                --dark: #1a2634;
                --gray: #6b7a8e;
                --gray-light: #eef2f7;
                --gray-bg: #f0f2f5;
                --white: #ffffff;
                --shadow-sm: 0 2px 8px rgba(0, 0, 0, 0.04);
                --shadow-md: 0 8px 30px rgba(0, 0, 0, 0.08);
                --shadow-lg: 0 16px 48px rgba(0, 0, 0, 0.12);
                --shadow-xl: 0 24px 64px rgba(0, 0, 0, 0.16);
                --radius: 20px;
                --radius-sm: 12px;
                --radius-xs: 8px;
                --transition: 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            }

            /* ────────────────────────────────────────────────────────── */
            /* Base Styles                                             */
            /* ────────────────────────────────────────────────────────── */
            body {
                background: var(--gray-bg);
                font-family: 'Inter', -apple-system, system-ui, sans-serif;
                padding: 2rem 1.5rem;
                min-height: 100vh;
                display: flex;
                align-items: flex-start;
                justify-content: center;
                color: var(--dark);
                line-height: 1.6;
            }

            .payments-wrapper {
                max-width: 1400px;
                width: 100%;
                background: var(--white);
                border-radius: var(--radius);
                box-shadow: var(--shadow-xl);
                overflow: hidden;
                animation: slideUp 0.5s ease-out;
            }

            @@keyframes slideUp {
                from {
                    opacity: 0;
                    transform: translateY(30px);
                }

                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            /* ────────────────────────────────────────────────────────── */
            /* Header - Premium Gradient                               */
            /* ────────────────────────────────────────────────────────── */
            .header-premium {
                background: linear-gradient(135deg, #0c0e1a 0%, #1a1a3e 40%, #0d6efd 100%);
                padding: 2.5rem 3rem 2rem;
                color: #fff;
                position: relative;
                overflow: hidden;
            }

                .header-premium::before {
                    content: '';
                    position: absolute;
                    top: -60%;
                    right: -10%;
                    width: 500px;
                    height: 500px;
                    background: radial-gradient(circle, rgba(255, 255, 255, 0.06) 0%, transparent 70%);
                    border-radius: 50%;
                    pointer-events: none;
                }

                .header-premium::after {
                    content: '';
                    position: absolute;
                    bottom: -40%;
                    left: -5%;
                    width: 300px;
                    height: 300px;
                    background: radial-gradient(circle, rgba(13, 202, 240, 0.08) 0%, transparent 70%);
                    border-radius: 50%;
                    pointer-events: none;
                }

            .header-content {
                position: relative;
                z-index: 1;
                display: flex;
                flex-wrap: wrap;
                align-items: center;
                justify-content: space-between;
                gap: 1rem;
            }

            .header-title {
                display: flex;
                align-items: center;
                gap: 1rem;
            }

                .header-title .icon-wrapper {
                    width: 56px;
                    height: 56px;
                    background: rgba(255, 255, 255, 0.15);
                    border-radius: 50%;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    font-size: 1.8rem;
                    backdrop-filter: blur(4px);
                    border: 1px solid rgba(255, 255, 255, 0.1);
                    flex-shrink: 0;
                }

                .header-title h1 {
                    font-weight: 800;
                    font-size: 1.8rem;
                    margin: 0;
                    letter-spacing: -0.02em;
                    background: linear-gradient(135deg, #fff 60%, #94a3b8);
                    -webkit-background-clip: text;
                    -webkit-text-fill-color: transparent;
                    background-clip: text;
                }

                .header-title .badge-count {
                    font-size: 0.8rem;
                    font-weight: 500;
                    color: rgba(255, 255, 255, 0.9);
                    background: rgba(255, 255, 255, 0.15);
                    padding: 0.15rem 0.8rem;
                    border-radius: 50px;
                    border: 1px solid rgba(255, 255, 255, 0.15);
                    -webkit-text-fill-color: rgba(255, 255, 255, 0.9);
                }

            .header-actions {
                display: flex;
                align-items: center;
                gap: 0.75rem;
                flex-wrap: wrap;
            }

            .btn-header {
                background: rgba(255, 255, 255, 0.12);
                border: 1px solid rgba(255, 255, 255, 0.15);
                color: #fff;
                border-radius: 50px;
                padding: 0.5rem 1.4rem;
                font-weight: 500;
                font-size: 0.9rem;
                transition: var(--transition);
                text-decoration: none;
                display: inline-flex;
                align-items: center;
                gap: 0.5rem;
                backdrop-filter: blur(4px);
            }

                .btn-header:hover {
                    background: rgba(255, 255, 255, 0.25);
                    transform: translateY(-2px);
                    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.2);
                    color: #fff;
                }

            .btn-header-primary {
                background: rgba(255, 255, 255, 0.2);
                border: 1px solid rgba(255, 255, 255, 0.3);
                color: #fff;
            }

                .btn-header-primary:hover {
                    background: rgba(255, 255, 255, 0.35);
                    color: #fff;
                }

            /* ────────────────────────────────────────────────────────── */
            /* Toast / Notification                                     */
            /* ────────────────────────────────────────────────────────── */
            .toast-container {
                position: fixed;
                top: 20px;
                right: 20px;
                z-index: 9999;
            }

            .toast-custom {
                background: var(--white);
                border-radius: var(--radius-sm);
                padding: 1rem 1.5rem;
                box-shadow: var(--shadow-lg);
                border-left: 4px solid var(--primary);
                min-width: 300px;
                animation: slideInRight 0.5s ease-out;
                margin-bottom: 0.75rem;
            }

                .toast-custom.success {
                    border-left-color: var(--success);
                }

                .toast-custom.error {
                    border-left-color: var(--danger);
                }

                .toast-custom .toast-title {
                    font-weight: 700;
                    font-size: 0.95rem;
                }

                .toast-custom .toast-message {
                    font-size: 0.85rem;
                    color: var(--gray);
                }

            @@keyframes slideInRight {
                from {
                    opacity: 0;
                    transform: translateX(100px);
                }

                to {
                    opacity: 1;
                    transform: translateX(0);
                }
            }

            /* ────────────────────────────────────────────────────────── */
            /* Body                                                     */
            /* ────────────────────────────────────────────────────────── */
            .body-content {
                padding: 2rem 3rem 2.5rem;
            }

            /* ────────────────────────────────────────────────────────── */
            /* Alert Messages                                           */
            /* ────────────────────────────────────────────────────────── */
            .alert-custom {
                border-radius: var(--radius-sm);
                padding: 1rem 1.5rem;
                border: none;
                box-shadow: var(--shadow-sm);
                margin-bottom: 1.5rem;
            }

                .alert-custom.alert-danger {
                    background: #fee2e2;
                    color: #991b1b;
                    border-left: 4px solid var(--danger);
                }

                .alert-custom.alert-success {
                    background: #dcfce7;
                    color: #166534;
                    border-left: 4px solid var(--success);
                }

            /* ────────────────────────────────────────────────────────── */
            /* Stats Row - Modern Cards                                */
            /* ────────────────────────────────────────────────────────── */
            .stats-grid {
                display: grid;
                grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
                gap: 1rem;
                margin-bottom: 2rem;
            }

            .stat-card {
                background: var(--gray-bg);
                border-radius: var(--radius-sm);
                padding: 1.25rem 1.5rem;
                text-align: center;
                border: 1px solid var(--gray-light);
                transition: var(--transition);
                position: relative;
                overflow: hidden;
            }

                .stat-card::before {
                    content: '';
                    position: absolute;
                    top: 0;
                    left: 0;
                    right: 0;
                    height: 3px;
                    background: linear-gradient(90deg, var(--primary), var(--info));
                    opacity: 0;
                    transition: var(--transition);
                }

                .stat-card:hover {
                    transform: translateY(-4px);
                    box-shadow: var(--shadow-md);
                    border-color: var(--primary);
                }

                    .stat-card:hover::before {
                        opacity: 1;
                    }

                .stat-card .stat-number {
                    font-size: 1.6rem;
                    font-weight: 800;
                    color: var(--dark);
                    display: block;
                    letter-spacing: -0.02em;
                }

                .stat-card .stat-label {
                    font-size: 0.7rem;
                    text-transform: uppercase;
                    letter-spacing: 0.06em;
                    color: var(--gray);
                    font-weight: 600;
                    display: block;
                    margin-top: 0.25rem;
                }

                .stat-card .stat-icon {
                    font-size: 1.2rem;
                    color: var(--primary);
                    opacity: 0.4;
                    position: absolute;
                    right: 0.75rem;
                    bottom: 0.5rem;
                }

            /* ────────────────────────────────────────────────────────── */
            /* Filter Section                                           */
            /* ────────────────────────────────────────────────────────── */
            .filter-section {
                background: var(--gray-bg);
                border-radius: var(--radius-sm);
                padding: 1.25rem 1.5rem;
                margin-bottom: 1.5rem;
                border: 1px solid var(--gray-light);
                transition: var(--transition);
            }

                .filter-section:hover {
                    border-color: var(--primary);
                }

            .filter-row {
                display: flex;
                flex-wrap: wrap;
                align-items: center;
                gap: 0.75rem 1.5rem;
            }

                .filter-row + .filter-row {
                    margin-top: 0.75rem;
                }

            .filter-label {
                font-weight: 600;
                color: var(--dark);
                font-size: 0.85rem;
                margin-right: 0.25rem;
                white-space: nowrap;
            }

                .filter-label i {
                    color: var(--primary);
                }

            .search-wrapper {
                position: relative;
                flex: 1 1 300px;
                min-width: 200px;
            }

                .search-wrapper .form-control {
                    border: 1.5px solid var(--gray-light);
                    background: var(--white);
                    border-radius: 50px;
                    padding: 0.6rem 2rem 0.6rem 1.2rem;
                    font-size: 0.95rem;
                    transition: var(--transition);
                    width: 100%;
                }

                    .search-wrapper .form-control:focus {
                        border-color: var(--primary);
                        box-shadow: 0 0 0 3px rgba(13, 110, 253, 0.12);
                    }

                    .search-wrapper .form-control::placeholder {
                        color: var(--gray);
                    }

            .search-clear {
                position: absolute;
                right: 12px;
                top: 50%;
                transform: translateY(-50%);
                background: none;
                border: none;
                color: var(--gray);
                cursor: pointer;
                font-size: 1.1rem;
                padding: 0.2rem 0.4rem;
                display: none;
                transition: var(--transition);
                line-height: 1;
                z-index: 5;
            }

                .search-clear:hover {
                    color: var(--danger);
                }

                .search-clear.visible {
                    display: block;
                }

            .filter-select,
            .filter-input {
                border: 1.5px solid var(--gray-light);
                background: var(--white);
                border-radius: 50px;
                padding: 0.6rem 1.2rem;
                font-size: 0.95rem;
                transition: var(--transition);
                outline: none;
            }

            .filter-select {
                min-width: 160px;
                appearance: none;
                background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3e%3cpath fill='none' stroke='%23343a40' stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M2 5l6 6 6-6'/%3e%3c/svg%3e");
                background-repeat: no-repeat;
                background-position: right 0.75rem center;
                background-size: 16px 12px;
                padding-right: 2.2rem;
                cursor: pointer;
            }

                .filter-select:focus,
                .filter-input:focus {
                    border-color: var(--primary);
                    box-shadow: 0 0 0 3px rgba(13, 110, 253, 0.12);
                }

            .filter-input {
                min-width: 150px;
            }

            .date-separator {
                color: var(--gray);
                font-weight: 500;
                margin: 0 0.1rem;
            }

            .filter-buttons {
                display: flex;
                flex-wrap: wrap;
                gap: 0.5rem;
            }

                .filter-buttons .btn {
                    border-radius: 50px;
                    padding: 0.45rem 1.4rem;
                    font-weight: 600;
                    font-size: 0.85rem;
                    transition: var(--transition);
                    text-transform: uppercase;
                    letter-spacing: 0.04em;
                }

                .filter-buttons .btn-primary {
                    background: linear-gradient(135deg, #0d6efd, #0a58ca);
                    border: none;
                    color: #fff;
                    box-shadow: 0 2px 10px rgba(13, 110, 253, 0.25);
                }

                    .filter-buttons .btn-primary:hover {
                        transform: translateY(-2px);
                        box-shadow: 0 4px 18px rgba(13, 110, 253, 0.35);
                    }

                .filter-buttons .btn-outline-secondary {
                    background: transparent;
                    color: var(--gray);
                    border: 1.5px solid var(--gray-light);
                }

                    .filter-buttons .btn-outline-secondary:hover {
                        background: var(--gray-bg);
                        border-color: var(--gray);
                        color: var(--dark);
                    }

            /* ────────────────────────────────────────────────────────── */
            /* Table Card                                               */
            /* ────────────────────────────────────────────────────────── */
            .table-card {
                background: var(--white);
                border-radius: var(--radius-sm);
                border: 1px solid var(--gray-light);
                overflow: hidden;
                box-shadow: var(--shadow-sm);
            }

                .table-card .table-header {
                    background: var(--gray-bg);
                    padding: 0.75rem 1.5rem;
                    border-bottom: 1px solid var(--gray-light);
                    display: flex;
                    flex-wrap: wrap;
                    align-items: center;
                    justify-content: space-between;
                    gap: 0.75rem;
                }

                    .table-card .table-header .title {
                        font-weight: 600;
                        font-size: 0.95rem;
                        color: var(--dark);
                        display: flex;
                        align-items: center;
                        gap: 0.5rem;
                    }

                        .table-card .table-header .title i {
                            color: var(--primary);
                        }

            /* ────────────────────────────────────────────────────────── */
            /* Table Styling                                            */
            /* ────────────────────────────────────────────────────────── */
            .table-responsive-custom {
                overflow-x: auto;
                -webkit-overflow-scrolling: touch;
            }

            .table {
                margin: 0;
                font-size: 0.9rem;
                vertical-align: middle;
                border-collapse: separate;
                border-spacing: 0;
                min-width: 800px;
            }

                .table thead th {
                    background: var(--gray-bg);
                    color: var(--dark);
                    font-weight: 600;
                    font-size: 0.75rem;
                    text-transform: uppercase;
                    letter-spacing: 0.05em;
                    padding: 0.75rem 1rem;
                    border-bottom: 2px solid var(--gray-light);
                    white-space: nowrap;
                }

                    .table thead th i {
                        margin-right: 0.25rem;
                        color: var(--primary);
                    }

                    .table thead th.text-end {
                        text-align: right;
                    }

                .table tbody td {
                    padding: 0.75rem 1rem;
                    border-bottom: 1px solid var(--gray-light);
                    background: var(--white);
                    transition: background var(--transition);
                }

                .table tbody tr:hover td {
                    background: var(--gray-bg);
                }

                .table tbody tr:last-child td {
                    border-bottom: none;
                }

            /* ────────────────────────────────────────────────────────── */
            /* Payment Mode Badge                                       */
            /* ────────────────────────────────────────────────────────── */
            .badge-mode {
                font-weight: 600;
                padding: 0.25rem 0.9rem;
                border-radius: 50px;
                font-size: 0.7rem;
                text-transform: uppercase;
                letter-spacing: 0.04em;
            }

                .badge-mode.cash {
                    background: #dcfce7;
                    color: #166534;
                }

                .badge-mode.card {
                    background: #e0f2fe;
                    color: #0369a1;
                }

                .badge-mode.upi {
                    background: #fef3c7;
                    color: #b45309;
                }

                .badge-mode.netbanking {
                    background: #e9d5ff;
                    color: #6b21a8;
                }

                .badge-mode.other {
                    background: #f3f4f6;
                    color: #4b5563;
                }

                .badge-mode i {
                    font-size: 0.6rem;
                    margin-right: 0.25rem;
                }

            /* ────────────────────────────────────────────────────────── */
            /* Action Buttons                                           */
            /* ────────────────────────────────────────────────────────── */
            .action-group {
                display: flex;
                flex-wrap: wrap;
                gap: 0.3rem;
                align-items: center;
                justify-content: flex-end;
            }

                .action-group .btn {
                    border-radius: 50px;
                    padding: 0.25rem 0.8rem;
                    font-size: 0.75rem;
                    font-weight: 600;
                    transition: var(--transition);
                    display: inline-flex;
                    align-items: center;
                    gap: 0.3rem;
                    text-transform: uppercase;
                    letter-spacing: 0.03em;
                }

                    .action-group .btn:hover {
                        transform: translateY(-2px);
                        box-shadow: var(--shadow-md);
                    }

                .action-group .btn-outline-info {
                    border-color: var(--gray-light);
                    color: var(--primary);
                }

                    .action-group .btn-outline-info:hover {
                        background: var(--primary-light);
                        border-color: var(--primary);
                    }

                .action-group .btn-outline-primary {
                    border-color: var(--gray-light);
                    color: var(--primary);
                }

                    .action-group .btn-outline-primary:hover {
                        background: var(--primary-light);
                        border-color: var(--primary);
                    }

                .action-group .btn-outline-danger {
                    border-color: var(--gray-light);
                    color: var(--danger);
                }

                    .action-group .btn-outline-danger:hover {
                        background: #fee2e2;
                        border-color: var(--danger);
                    }

            /* ────────────────────────────────────────────────────────── */
            /* Empty State                                              */
            /* ────────────────────────────────────────────────────────── */
            .empty-state {
                padding: 3.5rem 1rem !important;
                text-align: center;
                color: var(--gray);
                font-size: 1rem;
            }

                .empty-state i {
                    font-size: 3rem;
                    display: block;
                    margin-bottom: 0.75rem;
                    color: var(--gray-light);
                }

                .empty-state h5 {
                    color: var(--dark);
                    font-weight: 600;
                }

            /* ────────────────────────────────────────────────────────── */
            /* Pagination                                               */
            /* ────────────────────────────────────────────────────────── */
            .pagination-wrapper {
                display: flex;
                justify-content: space-between;
                align-items: center;
                flex-wrap: wrap;
                gap: 0.5rem;
                padding: 1rem 1.5rem;
                background: var(--gray-bg);
                border-top: 1px solid var(--gray-light);
            }

            .pagination-info {
                font-size: 0.85rem;
                color: var(--gray);
            }

                .pagination-info strong {
                    color: var(--dark);
                }

            .pagination-controls {
                display: flex;
                align-items: center;
                gap: 0.3rem;
                flex-wrap: wrap;
            }

                .pagination-controls .page-link {
                    border-radius: 50px;
                    padding: 0.3rem 0.8rem;
                    font-size: 0.85rem;
                    border: 1.5px solid var(--gray-light);
                    color: var(--dark);
                    background: var(--white);
                    transition: var(--transition);
                    cursor: pointer;
                    text-decoration: none;
                    display: inline-flex;
                    align-items: center;
                    justify-content: center;
                    min-width: 36px;
                    height: 36px;
                    font-weight: 500;
                }

                    .pagination-controls .page-link:hover {
                        background: var(--gray-bg);
                        border-color: var(--primary);
                    }

                    .pagination-controls .page-link.active {
                        background: linear-gradient(135deg, #0d6efd, #0a58ca);
                        color: #fff;
                        border-color: var(--primary);
                        box-shadow: 0 2px 10px rgba(13, 110, 253, 0.25);
                    }

                    .pagination-controls .page-link.disabled {
                        opacity: 0.4;
                        pointer-events: none;
                    }

            /* ────────────────────────────────────────────────────────── */
            /* Responsive                                               */
            /* ────────────────────────────────────────────────────────── */
            @@media (max-width: 992px) {
                .header-premium {
                    padding: 2rem 1.5rem 1.5rem;
                }

                .body-content {
                    padding: 1.5rem 1.5rem 2rem;
                }
            }

            @@media (max-width: 768px) {
                body {
                    padding: 1rem 0.75rem;
                }

                .payments-wrapper {
                    border-radius: var(--radius-sm);
                }

                .header-premium {
                    padding: 1.5rem 1.25rem 1.25rem;
                }

                .header-title h1 {
                    font-size: 1.3rem;
                }

                .header-title .icon-wrapper {
                    width: 44px;
                    height: 44px;
                    font-size: 1.3rem;
                }

                .header-title .badge-count {
                    font-size: 0.7rem;
                    padding: 0.1rem 0.6rem;
                }

                .header-content {
                    flex-direction: column;
                    align-items: flex-start;
                }

                .header-actions {
                    width: 100%;
                    justify-content: flex-start;
                }

                .body-content {
                    padding: 1rem 1rem 1.5rem;
                }

                .stats-grid {
                    grid-template-columns: 1fr 1fr;
                    gap: 0.75rem;
                }

                .stat-card {
                    padding: 1rem 0.75rem;
                }

                    .stat-card .stat-number {
                        font-size: 1.3rem;
                    }

                .filter-row {
                    flex-direction: column;
                    align-items: stretch;
                }

                .search-wrapper {
                    flex: unset;
                    min-width: unset;
                }

                .filter-select,
                .filter-input {
                    width: 100%;
                    min-width: unset;
                }

                .filter-buttons {
                    justify-content: stretch;
                }

                    .filter-buttons .btn {
                        flex: 1;
                        justify-content: center;
                    }

                .table tbody td {
                    padding: 0.6rem 0.75rem;
                    font-size: 0.82rem;
                }

                .table thead th {
                    padding: 0.6rem 0.75rem;
                    font-size: 0.7rem;
                }

                .action-group .btn {
                    font-size: 0.65rem;
                    padding: 0.2rem 0.6rem;
                }

                .pagination-wrapper {
                    flex-direction: column;
                    align-items: stretch;
                    gap: 0.75rem;
                }

                .pagination-controls {
                    justify-content: center;
                }

                .toast-custom {
                    min-width: 250px;
                    margin: 0 0.5rem 0.75rem;
                }
            }

            @@media (max-width: 480px) {
                body {
                    padding: 0.5rem 0.5rem;
                }

                .header-premium {
                    padding: 1rem 1rem 1rem;
                    border-radius: var(--radius-xs) var(--radius-xs) 0 0;
                }

                .header-title h1 {
                    font-size: 1.1rem;
                }

                .header-title .icon-wrapper {
                    width: 36px;
                    height: 36px;
                    font-size: 1rem;
                }

                .body-content {
                    padding: 0.75rem 0.75rem 1rem;
                }

                .stats-grid {
                    grid-template-columns: 1fr 1fr;
                    gap: 0.5rem;
                }

                .stat-card {
                    padding: 0.75rem 0.5rem;
                }

                    .stat-card .stat-number {
                        font-size: 1.1rem;
                    }

                    .stat-card .stat-label {
                        font-size: 0.6rem;
                    }

                .table thead th {
                    padding: 0.4rem 0.5rem;
                    font-size: 0.65rem;
                }

                .table tbody td {
                    padding: 0.4rem 0.5rem;
                    font-size: 0.75rem;
                }

                .action-group .btn {
                    font-size: 0.6rem;
                    padding: 0.15rem 0.4rem;
                }

                .pagination-controls .page-link {
                    min-width: 30px;
                    height: 30px;
                    font-size: 0.75rem;
                    padding: 0.2rem 0.5rem;
                }

                .toast-custom {
                    min-width: 200px;
                    padding: 0.75rem 1rem;
                }
            }
    </style>
</head>
<body>

    <!-- ─── Toast Container ─── -->
    <div class="toast-container" id="toastContainer"></div>

    <div class="payments-wrapper">

        <!-- ─── HEADER ─── -->
        <div class="header-premium">
            <div class="header-content">
                <div class="header-title">
                    <div class="icon-wrapper">
                        <i class="bi bi-credit-card-2-front"></i>
                    </div>
                    <div>
                        <h1>Payments</h1>
                        <span class="badge-count">@Model.TotalCount records</span>
                    </div>
                </div>
                <div class="header-actions">
                    <a asp-action="SelectInvoice" class="btn-header btn-header-primary">
                        <i class="bi bi-plus-lg"></i> Record Payment
                    </a>
                </div>
            </div>
        </div>

        <!-- ─── BODY ─── -->
        <div class="body-content">

            <!-- Alerts -->
            @if (TempData["Error"] != null)
            {
                <div class="alert-custom alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-circle-fill me-2"></i>
                    @TempData["Error"]
                    <button type="button" class="btn-close float-end" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @if (TempData["Success"] != null)
            {
                <div class="alert-custom alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i>
                    @TempData["Success"]
                    <button type="button" class="btn-close float-end" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <!-- ─── Stats ─── -->
            <div class="stats-grid">
                <div class="stat-card">
                    <span class="stat-number">@Model.TotalCount</span>
                    <span class="stat-label">Total Payments</span>
                    <i class="bi bi-credit-card stat-icon"></i>
                </div>
                <div class="stat-card">
                    <span class="stat-number">
                        @{
                            decimal totalAmount = Model.Items?.Sum(m => m.AmountPaid) ?? 0;
                        }
                        @totalAmount.ToString("N0")
                    </span>
                    <span class="stat-label">Total Amount</span>
                    <i class="bi bi-currency-rupee stat-icon"></i>
                </div>
                <div class="stat-card">
                    <span class="stat-number">@Model.PageNumber</span>
                    <span class="stat-label">Current Page</span>
                    <i class="bi bi-file-earmark-text stat-icon"></i>
                </div>
                <div class="stat-card">
                    <span class="stat-number">@Model.TotalPages</span>
                    <span class="stat-label">Total Pages</span>
                    <i class="bi bi-files stat-icon"></i>
                </div>
            </div>

            <!-- ─── Filter Section ─── -->
            <form asp-action="Index" method="get" id="filterForm">
                <input type="hidden" name="page" id="pageInput" value="@Model.PageNumber" />

                <div class="filter-section">
                    <div class="filter-row">
                        <span class="filter-label"><i class="bi bi-search"></i> Search</span>
                        <div class="search-wrapper">
                            <input type="text" name="search" id="searchInput" value="@ViewBag.Search"
                                   class="form-control"
                                   placeholder="By invoice, customer, reference…" />
                            <button type="button" class="search-clear" id="searchClear" title="Clear search">
                                <i class="bi bi-x-circle-fill"></i>
                            </button>
                        </div>
                    </div>

                    <div class="filter-row">
                        <span class="filter-label"><i class="bi bi-filter"></i> Payment Mode</span>
                        <select name="paymentMode" id="paymentModeSelect" class="filter-select">
                            <option value="">All Modes</option>
                            @{
                                var selectedMode = ViewBag.PaymentMode?.ToString();
                                foreach (PaymentMode mode in Enum.GetValues(typeof(PaymentMode)))
                                {
                                    var isSelected = selectedMode == mode.ToString();
                                    if (isSelected)
                                    {
                                        <option value="@mode" selected="selected">@mode</option>
                                    }
                                    else
                                    {
                                        <option value="@mode">@mode</option>
                                    }
                                }
                            }
                        </select>

                        <span class="filter-label"><i class="bi bi-calendar3"></i> Date Range</span>
                        <input type="date" name="dateFrom" id="dateFrom" value="@ViewBag.DateFrom" class="filter-input" />
                        <span class="date-separator">to</span>
                        <input type="date" name="dateTo" id="dateTo" value="@ViewBag.DateTo" class="filter-input" />

                        <div class="filter-buttons">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-funnel"></i> Filter
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-counterclockwise"></i> Reset
                            </a>
                        </div>
                    </div>
                </div>
            </form>

            <!-- ─── Table ─── -->
            <div class="table-card">
                <div class="table-header">
                    <span class="title">
                        <i class="bi bi-table"></i>
                        Payment List
                    </span>
                    <span class="text-muted" style="font-size:0.85rem;">
                        <i class="bi bi-info-circle"></i>
                        @Model.TotalCount record(s) found
                    </span>
                </div>

                <div class="table-responsive-custom">
                    <table class="table">
                        <thead>
                            <tr>
                                <th><i class="bi bi-hash"></i> Invoice No.</th>
                                <th><i class="bi bi-person"></i> Customer</th>
                                <th><i class="bi bi-calendar3"></i> Date</th>
                                <th><i class="bi bi-credit-card"></i> Mode</th>
                                <th class="text-end"><i class="bi bi-currency-rupee"></i> Amount</th>
                                <th><i class="bi bi-file-text"></i> Reference</th>
                                <th class="text-end"><i class="bi bi-gear"></i> Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Items.Any())
                            {
                                @foreach (var item in Model.Items)
                                {
                                    string modeClass = item.PaymentMode?.ToLower() switch
                                    {
                                        "cash" => "cash",
                                        "card" => "card",
                                        "upi" => "upi",
                                        "netbanking" or "net banking" or "netbanking" => "netbanking",
                                        "bank" or "banktransfer" or "bank transfer" => "netbanking",
                                        _ => "other"
                                    };
                                    string modeIcon = item.PaymentMode?.ToLower() switch
                                    {
                                        "cash" => "bi-cash",
                                        "card" => "bi-credit-card",
                                        "upi" => "bi-phone",
                                        "netbanking" or "net banking" => "bi-bank",
                                        "bank" or "banktransfer" or "bank transfer" => "bi-bank",
                                        _ => "bi-credit-card-2-front"
                                    };
                                    <tr>
                                        <td><span style="font-weight:600;">@item.InvoiceNumber</span></td>
                                        <td>@item.CustomerName</td>
                                        <td>@item.PaymentDate.ToString("dd/MM/yyyy")</td>
                                        <td>
                                            <span class="badge-mode @modeClass">
                                                <i class="bi @modeIcon"></i> @item.PaymentMode
                                            </span>
                                        </td>
                                        <td class="text-end" style="font-weight:600;color:var(--success);">
                                            @item.AmountPaid.ToString("C")
                                        </td>
                                        <td>@(string.IsNullOrEmpty(item.TransactionReference) ? "—" : item.TransactionReference)</td>
                                        <td class="text-end">
                                            <div class="action-group">
                                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info" title="View Details">
                                                    <i class="bi bi-eye"></i> View
                                                </a>
                                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary" title="Edit">
                                                    <i class="bi bi-pencil"></i> Edit
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="7">
                                        <div class="empty-state">
                                            <i class="bi bi-credit-card-2-front"></i>
                                            <h5>No Payments Found</h5>
                                            <p class="text-muted">There are no payments matching your criteria.</p>
                                            <a asp-action="SelectInvoice" class="btn btn-primary mt-2" style="border-radius:50px;padding:0.5rem 1.5rem;">
                                                <i class="bi bi-plus-lg"></i> Record Payment
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- ─── Pagination ─── -->
                @if (Model.TotalPages > 1)
                {
                    <div class="pagination-wrapper">
                        <div class="pagination-info">
                            <i class="bi bi-database"></i>
                            Showing <strong>@Model.Items.Count</strong> of <strong>@Model.TotalCount</strong> payments
                            · Page <strong>@Model.PageNumber</strong> of <strong>@Model.TotalPages</strong>
                        </div>
                        <div class="pagination-controls">
                            <a href="#" class="page-link @(Model.PageNumber <= 1 ? "disabled" : "")"
                               data-page="@(Model.PageNumber - 1)" data-action="page">
                                <i class="bi bi-chevron-left"></i>
                            </a>
                            @for (int p = 1; p <= Model.TotalPages; p++)
                            {
                                if (p == Model.PageNumber || p == 1 || p == Model.TotalPages || Math.Abs(p - Model.PageNumber) <= 2)
                                {
                                    <a href="#" class="page-link @(p == Model.PageNumber ? "active" : "")"
                                       data-page="@p" data-action="page">@p</a>
                                }
                                else if (p == Model.PageNumber - 3 || p == Model.PageNumber + 3)
                                {
                                    <span class="page-link disabled">…</span>
                                }
                            }
                            <a href="#" class="page-link @(Model.PageNumber >= Model.TotalPages ? "disabled" : "")"
                               data-page="@(Model.PageNumber + 1)" data-action="page">
                                <i class="bi bi-chevron-right"></i>
                            </a>
                        </div>
                    </div>
                }
            </div>

        </div> <!-- /body-content -->
    </div> <!-- /payments-wrapper -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <script>
            document.addEventListener('DOMContentLoaded', function() {
                // ─── Toast Notification ───
                function showToast(message, type) {
                    var container = document.getElementById('toastContainer');
                    var toast = document.createElement('div');
                    toast.className = 'toast-custom ' + (type || 'success');
                    toast.innerHTML = `
                                <div class="toast-title">
                                    <i class="bi ${type === 'error' ? 'bi-exclamation-circle-fill text-danger' : 'bi-check-circle-fill text-success'}"></i>
                                    ${type === 'error' ? 'Error' : 'Success'}
                                </div>
                                <div class="toast-message">${message}</div>
                            `;
                    container.appendChild(toast);

                    setTimeout(function() {
                        toast.style.opacity = '0';
                        toast.style.transform = 'translateX(100px)';
                        toast.style.transition = '0.5s ease-out';
                        setTimeout(function() { toast.remove(); }, 500);
                    }, 5000);
                }

                // ─── Show TempData Messages ───
                @if (TempData["Error"] != null)
                    {
                        <text>showToast('@TempData["Error"]', 'error');</text>
                }

                    @if (TempData["Success"] != null)
                    {
                        <text>showToast('@TempData["Success"]', 'success');</text>
                }

                        // ─── Form Elements ───
                        var form = document.getElementById('filterForm');
                var searchInput = document.getElementById('searchInput');
                var clearBtn = document.getElementById('searchClear');
                var paymentModeSelect = document.getElementById('paymentModeSelect');
                var dateFrom = document.getElementById('dateFrom');
                var dateTo = document.getElementById('dateTo');
                var pageInput = document.getElementById('pageInput');

                // ─── Toggle Clear Button ───
                function toggleClearButton() {
                    if (searchInput.value.length > 0) {
                        clearBtn.classList.add('visible');
                    } else {
                        clearBtn.classList.remove('visible');
                    }
                }
                toggleClearButton();
                searchInput.addEventListener('input', toggleClearButton);

                // ─── Clear Search ───
                clearBtn.addEventListener('click', function(e) {
                    e.preventDefault();
                    searchInput.value = '';
                    toggleClearButton();
                    pageInput.value = 1;
                    form.submit();
                });

                // ─── Search with Debounce ───
                var searchTimer = null;
                searchInput.addEventListener('input', function() {
                    clearTimeout(searchTimer);
                    searchTimer = setTimeout(function() {
                        pageInput.value = 1;
                        form.submit();
                    }, 400);
                });

                // ─── Payment Mode Change ───
                paymentModeSelect.addEventListener('change', function() {
                    pageInput.value = 1;
                    form.submit();
                });

                // ─── Date Filter Change ───
                [dateFrom, dateTo].forEach(function(input) {
                    input.addEventListener('change', function() {
                        pageInput.value = 1;
                        form.submit();
                    });
                });

                // ─── Pagination Clicks ───
                document.querySelectorAll('.pagination-controls .page-link[data-action="page"]').forEach(function(link) {
                    link.addEventListener('click', function(e) {
                        e.preventDefault();
                        var page = parseInt(this.getAttribute('data-page'));
                        if (!isNaN(page) && page > 0) {
                            pageInput.value = page;
                            form.submit();
                        }
                    });
                });

                // ─── Auto-dismiss alerts ───
                setTimeout(function() {
                    document.querySelectorAll('.alert-custom').forEach(function(alert) {
                        var closeBtn = alert.querySelector('.btn-close');
                        if (closeBtn) {
                            closeBtn.click();
                        }
                    });
                }, 5000);
            });
    </script>

</body>
</html>