@model Vehicle_Service_Management_System.Application.ViewModels.Common.PagedResult<Vehicle_Service_Management_System.Application.ViewModels.Payment.PaymentListViewModel>
@using Vehicle_Service_Management_System.Domain.Enums
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Payments | Vehicle Service Management</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        /* ── All existing styles remain unchanged ── */
        :root {
            --primary-gradient: linear-gradient(135deg, #0d6efd, #0a58ca);
            --shadow-sm: 0 2px 8px rgba(0, 0, 0, 0.06);
            --shadow-md: 0 8px 30px rgba(0, 0, 0, 0.10);
            --shadow-lg: 0 16px 48px rgba(0, 0, 0, 0.14);
            --radius: 16px;
            --radius-sm: 10px;
            --transition: 0.25s ease;
        }

        body {
            background: #f4f6fa;
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            padding: 2rem 1.5rem;
            min-height: 100vh;
            display: flex;
            align-items: flex-start;
            justify-content: center;
        }

        .payments-wrapper {
            max-width: 1400px;
            width: 100%;
            background: #ffffff;
            border-radius: var(--radius);
            box-shadow: var(--shadow-lg);
            padding: 2rem 2rem 2.5rem;
            transition: var(--transition);
        }

        @@media (max-width: 576px) {
            body { padding: 1rem 0.75rem; }
            .payments-wrapper { padding: 1.25rem 1rem 1.75rem; border-radius: var(--radius-sm); }
        }

        /* ── Header ── */
        .page-header {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            margin-bottom: 1.75rem;
        }
        .page-header h1 {
            font-weight: 700;
            font-size: 1.85rem;
            letter-spacing: -0.02em;
            color: #1a2634;
            margin: 0;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }
        .page-header h1 i {
            color: #0d6efd;
            font-size: 2rem;
        }
        .page-header .btn-primary {
            background: var(--primary-gradient);
            border: none;
            padding: 0.6rem 1.4rem;
            font-weight: 600;
            border-radius: 50px;
            box-shadow: 0 4px 14px rgba(13, 110, 253, 0.30);
            transition: var(--transition);
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
        }
        .page-header .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(13, 110, 253, 0.40);
        }

        /* ── Filter Section ── */
        .filter-section {
            background: #f8fafc;
            border-radius: var(--radius-sm);
            padding: 1.25rem 1.5rem;
            margin-bottom: 1.5rem;
            border: 1px solid #e9edf4;
            box-shadow: var(--shadow-sm);
        }
        .filter-row {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 0.75rem 1.5rem;
        }
        .filter-row + .filter-row {
            margin-top: 0.75rem;
        }
        .filter-label {
            font-weight: 600;
            color: #2d3748;
            font-size: 0.85rem;
            margin-right: 0.25rem;
            white-space: nowrap;
        }

        .search-wrapper {
            position: relative;
            flex: 1 1 300px;
            min-width: 200px;
        }
        .search-wrapper .form-control {
            border: 1px solid #d1d9e6;
            background: #fff;
            border-radius: 40px;
            padding: 0.6rem 2rem 0.6rem 1.2rem;
            font-size: 0.95rem;
            outline: none;
            box-shadow: none !important;
            width: 100%;
            transition: var(--transition);
        }
        .search-wrapper .form-control:focus {
            border-color: #0d6efd;
            box-shadow: 0 0 0 3px rgba(13, 110, 253, 0.12) !important;
        }
        .search-wrapper .form-control::placeholder {
            color: #a0aec0;
        }
        .search-clear {
            position: absolute;
            right: 12px;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            color: #94a3b8;
            cursor: pointer;
            font-size: 1.1rem;
            padding: 0.2rem 0.4rem;
            display: none;
            transition: var(--transition);
            line-height: 1;
            z-index: 5;
        }
        .search-clear:hover {
            color: #dc3545;
        }
        .search-clear.visible {
            display: block;
        }

        .filter-select,
        .filter-input {
            border: 1px solid #d1d9e6;
            background: #fff;
            border-radius: 40px;
            padding: 0.6rem 1.2rem;
            font-size: 0.95rem;
            outline: none;
            box-shadow: none !important;
            transition: var(--transition);
        }
        .filter-select {
            min-width: 140px;
            appearance: none;
            background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3e%3cpath fill='none' stroke='%23343a40' stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M2 5l6 6 6-6'/%3e%3c/svg%3e");
            background-repeat: no-repeat;
            background-position: right 0.75rem center;
            background-size: 16px 12px;
            padding-right: 2.2rem;
            cursor: pointer;
        }
        .filter-input {
            min-width: 150px;
            padding-right: 0.75rem;
        }
        .filter-select:focus,
        .filter-input:focus {
            border-color: #0d6efd;
            box-shadow: 0 0 0 3px rgba(13, 110, 253, 0.12) !important;
        }

        .filter-buttons {
            display: flex;
            flex-wrap: wrap;
            gap: 0.4rem;
        }
        .filter-buttons .btn {
            border-radius: 40px;
            padding: 0.45rem 1.4rem;
            font-weight: 500;
            border: none;
            transition: var(--transition);
        }
        .filter-buttons .btn-primary {
            background: var(--primary-gradient);
            color: #fff;
            box-shadow: 0 2px 10px rgba(13, 110, 253, 0.25);
        }
        .filter-buttons .btn-primary:hover {
            transform: scale(1.02);
            box-shadow: 0 4px 18px rgba(13, 110, 253, 0.35);
        }
        .filter-buttons .btn-outline-secondary {
            background: transparent;
            color: #4a5568;
            border: 1px solid #d1d9e6;
        }
        .filter-buttons .btn-outline-secondary:hover {
            background: #e9edf4;
            border-color: #b0bcca;
        }
        .date-separator {
            color: #4a5568;
            font-weight: 500;
            margin: 0 0.1rem;
        }

        @@media (max-width: 768px) {
            .filter-row {
                flex-direction: column;
                align-items: stretch;
            }
            .search-wrapper {
                flex: unset;
                min-width: unset;
            }
            .filter-select,
            .filter-input {
                width: 100%;
            }
            .filter-buttons {
                justify-content: stretch;
            }
            .filter-buttons .btn {
                flex: 1;
                justify-content: center;
            }
        }

        /* ── Alert / Toast ── */
        .alert-container {
            margin-bottom: 1.5rem;
        }
        .alert-container .alert {
            border-radius: 12px;
            border: none;
            box-shadow: var(--shadow-sm);
            padding: 0.75rem 1.25rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        .alert-container .alert i {
            font-size: 1.25rem;
            margin-right: 0.5rem;
        }
        .alert-container .alert .btn-close {
            font-size: 0.7rem;
        }
        .alert-success {
            background: #dcfce7;
            color: #166534;
        }
        .alert-danger {
            background: #fee2e2;
            color: #991b1b;
        }

        /* ── Table ── */
        .table-card {
            background: #ffffff;
            border-radius: var(--radius-sm);
            box-shadow: var(--shadow-sm);
            overflow: hidden;
            border: 1px solid #eef2f7;
            margin-top: 0.5rem;
        }
        .table-responsive-custom {
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
            padding: 0 0.25rem;
        }
        .table {
            margin: 0;
            font-size: 0.92rem;
            vertical-align: middle;
            border-collapse: separate;
            border-spacing: 0;
            min-width: 800px;
        }
        .table thead th {
            background: #f8fafc;
            color: #2d3748;
            font-weight: 600;
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            padding: 0.9rem 1rem;
            border-bottom: 2px solid #e2e8f0;
            white-space: nowrap;
        }
        .table tbody td {
            padding: 0.85rem 1rem;
            border-bottom: 1px solid #edf2f7;
            background: #fff;
            transition: background var(--transition);
        }
        .table tbody tr:hover td {
            background: #fafcff;
        }
        .table tbody tr:last-child td {
            border-bottom: none;
        }

        .action-group {
            display: flex;
            flex-wrap: wrap;
            gap: 0.3rem;
            align-items: center;
        }
        .action-group .btn {
            border-radius: 30px;
            padding: 0.25rem 0.75rem;
            font-size: 0.75rem;
            font-weight: 500;
            border: 1px solid transparent;
            transition: var(--transition);
            display: inline-flex;
            align-items: center;
            gap: 0.3rem;
        }
        .action-group .btn-outline-info {
            border-color: #b8d4fe;
            color: #0a58ca;
        }
        .action-group .btn-outline-info:hover {
            background: #e9f0ff;
            border-color: #0a58ca;
        }
        .action-group .btn-outline-primary {
            border-color: #c7d9f7;
            color: #0d6efd;
        }
        .action-group .btn-outline-primary:hover {
            background: #e9f0ff;
            border-color: #0d6efd;
        }

        .empty-state td {
            padding: 3.5rem 1rem !important;
            text-align: center;
            color: #94a3b8;
            font-size: 1rem;
        }
        .empty-state td i {
            font-size: 2.8rem;
            display: block;
            margin-bottom: 0.75rem;
            color: #cbd5e1;
        }

        .pagination-wrap {
            margin-top: 1.75rem;
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: space-between;
            gap: 0.75rem;
        }
        .pagination-wrap .info-text {
            font-size: 0.88rem;
            color: #4a5568;
        }
        .pagination-wrap .info-text strong {
            color: #1a2634;
        }
        .pagination {
            margin: 0;
            gap: 0.25rem;
            flex-wrap: wrap;
        }
        .pagination .page-link {
            border: none;
            border-radius: 30px;
            padding: 0.45rem 0.95rem;
            font-weight: 500;
            color: #2d3748;
            background: transparent;
            transition: var(--transition);
            box-shadow: none;
            font-size: 0.88rem;
        }
        .pagination .page-link:hover {
            background: #e9edf4;
            color: #0d6efd;
        }
        .pagination .page-item.active .page-link {
            background: var(--primary-gradient);
            color: #fff;
            box-shadow: 0 4px 14px rgba(13, 110, 253, 0.30);
        }
        .pagination .page-item.disabled .page-link {
            color: #b0b8c4;
            background: transparent;
        }

        @@media (max-width: 576px) {
            .pagination-wrap {
                flex-direction: column;
                align-items: stretch;
                text-align: center;
            }
            .pagination {
                justify-content: center;
            }
            .pagination .page-link {
                padding: 0.35rem 0.7rem;
                font-size: 0.8rem;
            }
        }

        @@media (max-width: 480px) {
            .page-header h1 {
                font-size: 1.4rem;
            }
            .page-header h1 i {
                font-size: 1.5rem;
            }
            .table tbody td {
                padding: 0.6rem 0.5rem;
                font-size: 0.82rem;
            }
            .table thead th {
                padding: 0.6rem 0.5rem;
                font-size: 0.7rem;
            }
            .action-group .btn {
                font-size: 0.65rem;
                padding: 0.15rem 0.5rem;
            }
        }
    </style>
</head>
<body>

    <div class="payments-wrapper">

        <!-- ─── HEADER ─── -->
        <div class="page-header">
            <h1>
                <i class="bi bi-credit-card-2-front"></i>
                Payments
            </h1>
            <a asp-action="SelectInvoice" class="btn btn-primary">
                <i class="bi bi-plus-lg"></i> Record Payment
            </a>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle-fill"></i> @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-circle-fill"></i> @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <!-- ─── FILTER SECTION ─── -->
        <form asp-action="Index" method="get" id="filterForm">
            <div class="filter-section">
                <!-- Row 1: Search -->
                <div class="filter-row">
                    <span class="filter-label"><i class="bi bi-search"></i> Search</span>
                    <div class="search-wrapper">
                        <input type="text" name="search" id="searchInput" value="@ViewBag.Search"
                               class="form-control"
                               placeholder="By invoice, customer, reference…" />
                        <button type="button" class="search-clear" id="searchClear" title="Clear search">
                            <i class="bi bi-x-circle-fill"></i>
                        </button>
                    </div>
                </div>

                <!-- Row 2: Payment Mode + Date Range + Buttons (combined) -->
                <div class="filter-row">
                    <span class="filter-label"><i class="bi bi-filter"></i> Payment Mode</span>
                    <select name="paymentMode" id="paymentModeSelect" class="filter-select">
                        <option value="">All Modes</option>
                        @foreach (var m in Enum.GetValues(typeof(PaymentMode)))
                        {
                            var selected = ViewBag.PaymentMode?.ToString() == m.ToString() ? "selected" : "";
                            <option value="@m" selected="@selected">@m</option>
                        }
                    </select>

                    <span class="filter-label"><i class="bi bi-calendar3"></i> Date Range</span>
                    <input type="date" name="dateFrom" id="dateFrom" value="@ViewBag.DateFrom" class="filter-input" />
                    <span class="date-separator">to</span>
                    <input type="date" name="dateTo" id="dateTo" value="@ViewBag.DateTo" class="filter-input" />

                    <div class="filter-buttons">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-funnel"></i> Filter
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-counterclockwise"></i> Reset
                        </a>
                    </div>
                </div>
            </div>
        </form>

        <!-- ─── TABLE ─── -->
        <div class="table-card">
            <div class="table-responsive-custom">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Invoice No.</th>
                            <th>Customer</th>
                            <th>Date</th>
                            <th>Mode</th>
                            <th class="text-end">Amount</th>
                            <th>Reference</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Items.Any())
                        {
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td>
                                        <span class="fw-500">@item.InvoiceNumber</span>
                                    </td>
                                    <td>@item.CustomerName</td>
                                    <td>@item.PaymentDate.ToString("dd/MM/yyyy")</td>
                                    <td>@item.PaymentMode</td>
                                    <td class="text-end">@item.AmountPaid.ToString("C")</td>
                                    <td>@item.TransactionReference</td>
                                    <td class="text-end">
                                        <div class="action-group justify-content-end">
                                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info" title="Details">
                                                <i class="bi bi-eye"></i> View
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary" title="Edit">
                                                <i class="bi bi-pencil"></i> Edit
                                            </a>
                                            <!-- Optional Delete button – uncomment if needed -->
                                            @*
                                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-outline-danger" onclick="return confirm('Delete this payment?');">
                                                    <i class="bi bi-trash3"></i>
                                                </button>
                                            </form>
                                            *@
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr class="empty-state">
                                <td colspan="7">
                                    <i class="bi bi-credit-card-2-front"></i>
                                    No payments found.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- ─── PAGINATION ─── -->
        @if (Model.TotalPages > 1)
        {
            <div class="pagination-wrap">
                <div class="info-text">
                    Showing <strong>@Model.Items.Count</strong> of <strong>@Model.TotalCount</strong> payments
                    · Page <strong>@Model.PageNumber</strong> of <strong>@Model.TotalPages</strong>
                </div>
                <nav>
                    <ul class="pagination">
                        @for (int p = 1; p <= Model.TotalPages; p++)
                        {
                            <li class="page-item @(p == Model.PageNumber ? "active" : "")">
                                <a class="page-link" asp-action="Index"
                                   asp-route-page="@p"
                                   asp-route-search="@ViewBag.Search"
                                   asp-route-paymentMode="@ViewBag.PaymentMode"
                                   asp-route-dateFrom="@ViewBag.DateFrom"
                                   asp-route-dateTo="@ViewBag.DateTo">
                                    @p
                                </a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>
        }

    </div> <!-- /.payments-wrapper -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const form = document.getElementById('filterForm');
            const searchInput = document.getElementById('searchInput');
            const clearBtn = document.getElementById('searchClear');
            const paymentModeSelect = document.getElementById('paymentModeSelect');
            const dateFrom = document.getElementById('dateFrom');
            const dateTo = document.getElementById('dateTo');

            // ── Search clear button ──
            function toggleClearButton() {
                if (searchInput.value.length > 0) {
                    clearBtn.classList.add('visible');
                } else {
                    clearBtn.classList.remove('visible');
                }
            }
            toggleClearButton();
            searchInput.addEventListener('input', toggleClearButton);

            clearBtn.addEventListener('click', function(e) {
                e.preventDefault();
                searchInput.value = '';
                toggleClearButton();
                form.submit();
            });

            // ── Auto‑submit on search input (debounce) ──
            let searchTimer = null;
            searchInput.addEventListener('input', function() {
                clearTimeout(searchTimer);
                searchTimer = setTimeout(function() {
                    form.submit();
                }, 400);
            });

            // ── Auto‑submit on payment mode change ──
            paymentModeSelect.addEventListener('change', function() {
                form.submit();
            });

            // ── Auto‑submit on date change ──
            [dateFrom, dateTo].forEach(function(input) {
                input.addEventListener('change', function() {
                    form.submit();
                });
            });

            // ── Auto‑dismiss alerts ──
            const alerts = document.querySelectorAll('.alert');
            alerts.forEach(function(alert) {
                setTimeout(function() {
                    const bsAlert = new bootstrap.Alert(alert);
                    bsAlert.close();
                }, 5000);
            });
        });
    </script>
</body>
</html>