@model Vehicle_Service_Management_System.Application.ViewModels.SparePart.SparePartStockUpdateViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Update Stock | Vehicle Service Management</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400;14..32,500;14..32,600;14..32,700;14..32,800&display=swap" rel="stylesheet">
    <style>
            /* ── Reset & Base ── */
            * {
                box-sizing: border-box;
            }

            :root {
                --primary: #4f46e5;
                --primary-light: #818cf8;
                --primary-dark: #3730a3;
                --primary-gradient: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%);
                --success: #22c55e;
                --warning: #f59e0b;
                --danger: #ef4444;
                --gray-50: #f8fafc;
                --gray-100: #f1f5f9;
                --gray-200: #e2e8f0;
                --gray-300: #cbd5e1;
                --gray-400: #94a3b8;
                --gray-500: #64748b;
                --gray-600: #475569;
                --gray-700: #334155;
                --gray-800: #1e293b;
                --gray-900: #0f172a;
                --radius: 20px;
                --radius-sm: 12px;
                --radius-xs: 8px;
                --shadow-sm: 0 1px 3px rgba(0,0,0,0.06), 0 1px 2px rgba(0,0,0,0.04);
                --shadow-md: 0 10px 40px rgba(0,0,0,0.08), 0 2px 8px rgba(0,0,0,0.04);
                --shadow-lg: 0 20px 60px rgba(0,0,0,0.12), 0 4px 16px rgba(0,0,0,0.06);
                --shadow-xl: 0 30px 80px rgba(0,0,0,0.16);
                --transition: 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            }

            body {
                background: var(--gray-50);
                font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
                padding: 2rem 1.5rem;
                min-height: 100vh;
                display: flex;
                align-items: flex-start;
                justify-content: center;
                background-image: radial-gradient(ellipse at 10% 20%, rgba(79,70,229,0.04) 0%, transparent 60%), radial-gradient(ellipse at 90% 80%, rgba(124,58,237,0.04) 0%, transparent 60%);
            }

            .stock-wrapper {
                max-width: 720px;
                width: 100%;
                background: rgba(255,255,255,0.7);
                backdrop-filter: blur(16px);
                -webkit-backdrop-filter: blur(16px);
                border-radius: var(--radius);
                box-shadow: var(--shadow-xl), 0 0 0 1px rgba(255,255,255,0.8) inset;
                padding: 2rem 2rem 2.5rem;
                transition: var(--transition);
                border: 1px solid rgba(255,255,255,0.6);
                animation: fadeSlideUp 0.5s ease forwards;
            }

            @@media (max-width: 576px) {
                body {
                    padding: 0.75rem;
                }

                .stock-wrapper {
                    padding: 1.25rem 1rem 1.75rem;
                    border-radius: var(--radius-sm);
                }
            }

            @@keyframes fadeSlideUp {
                from {
                    opacity: 0;
                    transform: translateY(20px);
                }

                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            /* ── Header ── */
            .page-header {
                display: flex;
                flex-wrap: wrap;
                align-items: center;
                justify-content: space-between;
                gap: 1rem;
                margin-bottom: 1.75rem;
            }

            .page-header-left {
                display: flex;
                align-items: center;
                gap: 0.75rem;
            }

            .header-icon {
                width: 48px;
                height: 48px;
                background: var(--primary-gradient);
                border-radius: var(--radius-sm);
                display: flex;
                align-items: center;
                justify-content: center;
                color: #fff;
                font-size: 1.4rem;
                box-shadow: 0 8px 24px rgba(79,70,229,0.30);
                flex-shrink: 0;
            }

            .page-header h1 {
                font-weight: 800;
                font-size: 1.7rem;
                letter-spacing: -0.03em;
                color: var(--gray-900);
                margin: 0;
                line-height: 1.2;
            }

                .page-header h1 small {
                    display: block;
                    font-weight: 500;
                    font-size: 0.75rem;
                    color: var(--gray-500);
                    letter-spacing: 0.02em;
                    margin-top: 0.05rem;
                }

            .btn-back {
                border-radius: 60px;
                padding: 0.5rem 1.3rem;
                font-weight: 600;
                font-size: 0.85rem;
                border: 1px solid var(--gray-200);
                background: #fff;
                color: var(--gray-700);
                transition: var(--transition);
                display: inline-flex;
                align-items: center;
                gap: 0.5rem;
                box-shadow: var(--shadow-sm);
                text-decoration: none;
            }

                .btn-back:hover {
                    background: var(--gray-100);
                    border-color: var(--gray-300);
                    transform: translateY(-1px);
                    box-shadow: var(--shadow-md);
                    color: var(--gray-900);
                }

            /* ── Form Card ── */
            .form-card {
                background: #fff;
                border-radius: var(--radius-sm);
                padding: 1.75rem 2rem;
                box-shadow: var(--shadow-md);
                border: 1px solid var(--gray-200);
                transition: var(--transition);
            }

                .form-card:hover {
                    box-shadow: var(--shadow-lg);
                }

            .form-floating-custom .form-control,
            .form-floating-custom .form-select {
                border-radius: var(--radius-xs);
                border: 1px solid var(--gray-200);
                padding: 0.6rem 1rem;
                transition: var(--transition);
                background: #fff;
                font-size: 0.95rem;
            }

                .form-floating-custom .form-control:focus,
                .form-floating-custom .form-select:focus {
                    border-color: var(--primary);
                    box-shadow: 0 0 0 4px rgba(79,70,229,0.12);
                }

                .form-floating-custom .form-control[readonly] {
                    background-color: var(--gray-50);
                    cursor: not-allowed;
                    color: var(--gray-600);
                }

            .form-floating-custom label {
                font-weight: 600;
                color: var(--gray-700);
                margin-bottom: 0.25rem;
                font-size: 0.85rem;
                display: flex;
                align-items: center;
                gap: 0.4rem;
            }

                .form-floating-custom label i {
                    color: var(--gray-400);
                    font-size: 0.9rem;
                }

            .text-danger {
                font-size: 0.8rem;
                margin-top: 0.2rem;
            }

            /* ── Stock Preview ── */
            .stock-preview {
                background: var(--gray-50);
                border-radius: var(--radius-xs);
                padding: 0.75rem 1rem;
                border: 1px solid var(--gray-200);
                display: flex;
                align-items: center;
                justify-content: space-between;
                flex-wrap: wrap;
                gap: 0.5rem;
                margin-top: 0.25rem;
            }

                .stock-preview .current {
                    font-weight: 600;
                    color: var(--gray-700);
                }

                .stock-preview .new-stock-value {
                    font-weight: 700;
                    font-size: 1.1rem;
                    color: var(--primary);
                }

                    .stock-preview .new-stock-value.negative {
                        color: var(--danger);
                    }

                    .stock-preview .new-stock-value.positive {
                        color: var(--success);
                    }

            /* ── Range Slider ── */
            .range-slider-wrap {
                padding: 0.25rem 0;
            }

                .range-slider-wrap input[type="range"] {
                    width: 100%;
                    height: 6px;
                    -webkit-appearance: none;
                    appearance: none;
                    background: var(--gray-200);
                    border-radius: 20px;
                    outline: none;
                    transition: background 0.2s;
                }

                    .range-slider-wrap input[type="range"]::-webkit-slider-thumb {
                        -webkit-appearance: none;
                        appearance: none;
                        width: 20px;
                        height: 20px;
                        border-radius: 50%;
                        background: var(--primary-gradient);
                        cursor: pointer;
                        box-shadow: 0 2px 8px rgba(79,70,229,0.40);
                        transition: var(--transition);
                    }

                        .range-slider-wrap input[type="range"]::-webkit-slider-thumb:hover {
                            transform: scale(1.12);
                        }

                    .range-slider-wrap input[type="range"]::-moz-range-thumb {
                        width: 20px;
                        height: 20px;
                        border-radius: 50%;
                        background: var(--primary-gradient);
                        cursor: pointer;
                        border: none;
                    }

            /* ── Buttons ── */
            .btn-primary {
                background: var(--primary-gradient);
                border: none;
                padding: 0.6rem 2rem;
                font-weight: 600;
                border-radius: 60px;
                box-shadow: 0 4px 14px rgba(79,70,229,0.35);
                transition: var(--transition);
                display: inline-flex;
                align-items: center;
                gap: 0.6rem;
                color: #fff;
            }

                .btn-primary:hover {
                    transform: translateY(-2px);
                    box-shadow: 0 8px 28px rgba(79,70,229,0.45);
                    color: #fff;
                    background: var(--primary-gradient);
                }

            .btn-secondary {
                border-radius: 60px;
                padding: 0.6rem 1.8rem;
                font-weight: 500;
                border: 1px solid var(--gray-200);
                background: #fff;
                color: var(--gray-700);
                transition: var(--transition);
            }

                .btn-secondary:hover {
                    background: var(--gray-50);
                    border-color: var(--gray-300);
                    color: var(--gray-900);
                }

            /* ── Validation Summary ── */
            .validation-summary-errors {
                background: #fef2f2;
                border: 1px solid #fca5a5;
                border-radius: var(--radius-xs);
                padding: 0.75rem 1rem;
                margin-bottom: 1.5rem;
                color: #991b1b;
                font-size: 0.9rem;
            }

                .validation-summary-errors ul {
                    margin: 0;
                    padding-left: 1.2rem;
                }

            /* ── Responsive ── */
            @@media (max-width: 576px) {
                .page-header h1 {
                    font-size: 1.4rem;
                }

                    .page-header h1 small {
                        font-size: 0.65rem;
                    }

                .header-icon {
                    width: 40px;
                    height: 40px;
                    font-size: 1.2rem;
                }

                .form-card {
                    padding: 1.25rem 1rem;
                }

                .stock-preview {
                    flex-direction: column;
                    align-items: flex-start;
                }

                .d-flex.gap-2 {
                    flex-direction: column;
                    align-items: stretch;
                }

                    .d-flex.gap-2 .btn {
                        width: 100%;
                        justify-content: center;
                    }
            }

            /* ── Scrollbar ── */
            ::-webkit-scrollbar {
                width: 6px;
                height: 6px;
            }

            ::-webkit-scrollbar-track {
                background: var(--gray-100);
                border-radius: 10px;
            }

            ::-webkit-scrollbar-thumb {
                background: var(--gray-300);
                border-radius: 10px;
            }

                ::-webkit-scrollbar-thumb:hover {
                    background: var(--gray-400);
                }

            /* ── Divider ── */
            .divider {
                border: 0;
                border-top: 2px dashed var(--gray-200);
                margin: 1.5rem 0;
            }

            /* ── Input group icon ── */
            .input-group-icon {
                position: relative;
            }

                .input-group-icon .form-control {
                    padding-left: 2.5rem;
                }

                .input-group-icon .input-icon {
                    position: absolute;
                    left: 0.9rem;
                    top: 50%;
                    transform: translateY(-50%);
                    color: var(--gray-400);
                    font-size: 1.1rem;
                    pointer-events: none;
                    z-index: 4;
                }
    </style>
</head>
<body>

    <div class="stock-wrapper">

        <!-- ─── HEADER ─── -->
        <div class="page-header">
            <div class="page-header-left">
                <div class="header-icon">
                    <i class="bi bi-box-seam"></i>
                </div>
                <div>
                    <h1>
                        Update Stock
                        <small>Adjust inventory for spare part</small>
                    </h1>
                </div>
            </div>
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn-back">
                <i class="bi bi-arrow-left"></i> Back
            </a>
        </div>

        <!-- ─── FORM ─── -->
        <div class="form-card">
            <form asp-action="UpdateStock" method="post" id="updateStockForm">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="PartName" />
                <input type="hidden" asp-for="CurrentStock" />

                <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

                <div class="row g-4">
                    <!-- Part Name (display only) -->
                    <div class="col-12 form-floating-custom">
                        <label><i class="bi bi-tag"></i> Part Name</label>
                        <input value="@Model.PartName" class="form-control" readonly />
                    </div>

                    <!-- Current Stock (display only) -->
                    <div class="col-12 form-floating-custom">
                        <label><i class="bi bi-database"></i> Current Stock</label>
                        <input value="@Model.CurrentStock" class="form-control" readonly id="currentStockDisplay" />
                    </div>

                    <!-- New Stock Quantity with slider -->
                    <div class="col-12 form-floating-custom">
                        <label asp-for="NewStockQuantity"><i class="bi bi-plus-slash-minus"></i> New Stock Quantity</label>
                        <div class="input-group-icon">
                            <span class="input-icon"><i class="bi bi-hash"></i></span>
                            <input asp-for="NewStockQuantity" class="form-control" type="number" step="1" placeholder="Enter new quantity" id="newStockInput" />
                        </div>
                        <span asp-validation-for="NewStockQuantity" class="text-danger"></span>
                        <!-- Slider for visual adjustment -->
                        <div class="range-slider-wrap mt-2">
                            <input type="range" id="stockSlider" min="0" max="@(Model.CurrentStock * 2 + 20)" value="@Model.CurrentStock" step="1" />
                        </div>
                        <!-- Stock preview -->
                        <div class="stock-preview" id="stockPreview">
                            <span class="current">Current: <strong>@Model.CurrentStock</strong></span>
                            <span>
                                New: <span class="new-stock-value" id="newStockPreview">@Model.CurrentStock</span>
                            </span>
                            <span id="stockChangeIndicator" style="font-size:0.8rem; font-weight:600;"></span>
                        </div>
                    </div>

                    <!-- Reason -->
                    <div class="col-12 form-floating-custom">
                        <label asp-for="Reason"><i class="bi bi-pencil-square"></i> Reason</label>
                        <input asp-for="Reason" class="form-control" placeholder="e.g. Restock, Correction, Damaged" />
                        <span asp-validation-for="Reason" class="text-danger"></span>
                    </div>
                </div>

                <hr class="divider" />

                <div class="d-flex flex-wrap gap-2">
                    <button type="submit" class="btn btn-primary" id="submitBtn">
                        <i class="bi bi-check-lg"></i> Update Stock
                    </button>
                    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">
                        <i class="bi bi-x-lg"></i> Cancel
                    </a>
                </div>
            </form>
        </div>

    </div>
    <!-- /.stock-wrapper -->
    <!-- ─── Validation & Interactivity Scripts ─── -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        $(document).ready(function () {

        // DOM refs
        const newStockInput = $('#newStockInput');
        const stockSlider = $('#stockSlider');
        const newStockPreview = $('#newStockPreview');
        const stockChangeIndicator = $('#stockChangeIndicator');
        const currentStock = parseInt(@Model.CurrentStock) || 0;

        // Function to update preview and slider from input
        function updateFromInput(value) {
        let val = parseInt(value);
        if (isNaN(val) || val < 0) val = 0;
        // Update slider if not focused
        stockSlider.val(val);
        updatePreview(val);
        }

        // Function to update preview and input from slider
        function updateFromSlider(value) {
        let val = parseInt(value);
        if (isNaN(val) || val < 0) val = 0;
        newStockInput.val(val);
        updatePreview(val);
        }

        // Update preview and indicator
        function updatePreview(newVal) {
        newVal = parseInt(newVal) || 0;
        newStockPreview.text(newVal);
        // Color based on change
        const diff = newVal - currentStock;
        const indicator = stockChangeIndicator;
        if (diff === 0) {
        indicator.text('(no change)');
        indicator.css('color', 'var(--gray-400)');
        newStockPreview.removeClass('positive negative');
        } else if (diff > 0) {
        indicator.text(`(+${diff})`);
        indicator.css('color', 'var(--success)');
        newStockPreview.removeClass('negative').addClass('positive');
        } else {
        indicator.text(`(${diff})`);
        indicator.css('color', 'var(--danger)');
        newStockPreview.removeClass('positive').addClass('negative');
        }
        }

        // Event: input change on number field
        newStockInput.on('input', function () {
        let val = $(this).val();
        if (val === '') val = 0;
        updateFromInput(val);
        });

        // Event: slider change
        stockSlider.on('input', function () {
        let val = $(this).val();
        updateFromSlider(val);
        });

        // Initialize preview
        updatePreview(currentStock);

        // Set slider max dynamically based on current stock (could be extended)
        // Also ensure slider value matches input on load
        const initialVal = parseInt(newStockInput.val()) || currentStock;
        stockSlider.val(initialVal);
        updatePreview(initialVal);

        

        });
    </script>
</body>
</html>