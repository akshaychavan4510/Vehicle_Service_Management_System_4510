@model Vehicle_Service_Management_System.Application.ViewModels.Customer.CustomerFormViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Customer | Vehicle Service Management</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
            /* ── Root Variables ── */
            :root {
                --primary-gradient: linear-gradient(135deg, #0d6efd, #6f42c1);
                --primary: #0d6efd;
                --primary-dark: #0a58ca;
                --shadow-sm: 0 2px 12px rgba(0,0,0,0.04);
                --shadow-md: 0 8px 30px rgba(0,0,0,0.08);
                --shadow-lg: 0 16px 48px rgba(0,0,0,0.12);
                --radius: 20px;
                --radius-sm: 12px;
                --transition: 0.25s cubic-bezier(0.4,0,0.2,1);
            }

            body {
                background: #f0f2f5;
                font-family: 'Inter', -apple-system, system-ui, sans-serif;
                min-height: 100vh;
                padding: 2rem 1rem;
                display: flex;
                align-items: center;
                justify-content: center;
                position: relative;
            }
                /* Subtle background decoration */
                body::before {
                    content: '';
                    position: fixed;
                    top: -50%;
                    left: -50%;
                    width: 200%;
                    height: 200%;
                    background: radial-gradient(circle at 30% 50%, rgba(13,110,253,0.03) 0%, transparent 60%), radial-gradient(circle at 70% 80%, rgba(111,66,193,0.03) 0%, transparent 60%);
                    pointer-events: none;
                    z-index: 0;
                }

            .create-wrapper {
                width: 100%;
                max-width: 820px;
                animation: slideUp 0.6s ease-out;
                position: relative;
                z-index: 1;
            }

            @@keyframes slideUp {
                from {
                    opacity: 0;
                    transform: translateY(40px);
                }

                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            .card-custom {
                border: none;
                border-radius: var(--radius);
                box-shadow: var(--shadow-lg);
                overflow: hidden;
                transition: transform 0.3s ease, box-shadow 0.3s ease;
                background: #ffffff;
            }

                .card-custom:hover {
                    transform: translateY(-4px);
                    box-shadow: 0 20px 60px rgba(15, 23, 42, 0.15);
                }

            /* ── Hero Header ── */
            .card-header-custom {
                background: var(--primary-gradient);
                padding: 2rem 2.5rem 1.8rem;
                color: #fff;
                position: relative;
                overflow: hidden;
                border-bottom: none;
            }

                .card-header-custom::before {
                    content: '';
                    position: absolute;
                    top: -60%;
                    right: -20%;
                    width: 300px;
                    height: 300px;
                    background: rgba(255,255,255,0.06);
                    border-radius: 50%;
                    pointer-events: none;
                }

                .card-header-custom::after {
                    content: '';
                    position: absolute;
                    bottom: -50%;
                    left: -10%;
                    width: 250px;
                    height: 250px;
                    background: rgba(255,255,255,0.04);
                    border-radius: 50%;
                    pointer-events: none;
                }

                .card-header-custom h3 {
                    font-weight: 700;
                    letter-spacing: -0.02em;
                    position: relative;
                    z-index: 1;
                }

                    .card-header-custom h3 i {
                        font-size: 1.8rem;
                        margin-right: 0.5rem;
                        opacity: 0.9;
                    }

                .card-header-custom .btn-light {
                    border-radius: 50px;
                    padding: 0.35rem 1.2rem;
                    font-weight: 500;
                    font-size: 0.85rem;
                    transition: all 0.2s ease;
                    background: rgba(255,255,255,0.2);
                    border: 1px solid rgba(255,255,255,0.3);
                    color: #fff;
                    backdrop-filter: blur(4px);
                    position: relative;
                    z-index: 1;
                }

                    .card-header-custom .btn-light:hover {
                        background: rgba(255,255,255,0.35);
                        transform: translateX(-3px);
                    }

                .card-header-custom .sub-text {
                    font-size: 0.9rem;
                    opacity: 0.85;
                    margin-top: 0.2rem;
                    position: relative;
                    z-index: 1;
                }

            /* ── Card Body ── */
            .card-body-custom {
                padding: 2rem 2.5rem 2.5rem;
            }

            @@media (max-width: 576px) {
                .card-body-custom {
                    padding: 1.5rem 1.25rem;
                }

                .card-header-custom {
                    padding: 1.5rem 1.25rem;
                }

                    .card-header-custom h3 {
                        font-size: 1.3rem;
                    }

                        .card-header-custom h3 i {
                            font-size: 1.4rem;
                        }
            }

            /* ── Form Fields ── */
            .form-floating-custom .form-control,
            .form-floating-custom .form-select,
            .form-floating-custom textarea {
                border-radius: var(--radius-sm);
                border: 1px solid #dce2ec;
                padding: 0.6rem 1rem;
                transition: all 0.25s ease;
                background: #fafcff;
                font-size: 0.95rem;
                color: #1a2634;
            }

                .form-floating-custom .form-control:focus,
                .form-floating-custom .form-select:focus,
                .form-floating-custom textarea:focus {
                    border-color: var(--primary);
                    box-shadow: 0 0 0 4px rgba(13,110,253,0.10);
                    background: #ffffff;
                }

            .form-floating-custom label {
                font-weight: 600;
                color: #2d3748;
                margin-bottom: 0.3rem;
                display: flex;
                align-items: center;
                gap: 0.4rem;
                font-size: 0.9rem;
            }

                .form-floating-custom label i {
                    color: var(--primary);
                    font-size: 0.9rem;
                    opacity: 0.7;
                    background: rgba(13,110,253,0.08);
                    padding: 0.25rem;
                    border-radius: 6px;
                }

            .form-floating-custom .text-danger {
                font-size: 0.8rem;
                margin-top: 0.2rem;
                display: block;
            }

            .form-floating-custom .required-star {
                color: #dc3545;
                font-weight: 700;
            }

            /* ── Validation Summary ── */
            .validation-summary-errors {
                background: #fee2e2;
                border: 1px solid #fca5a5;
                border-radius: var(--radius-sm);
                padding: 0.75rem 1rem;
                margin-bottom: 1.5rem;
                color: #991b1b;
            }

                .validation-summary-errors ul {
                    margin: 0;
                    padding-left: 1.2rem;
                }

            /* ── Buttons ── */
            .btn-primary {
                background: var(--primary-gradient);
                border: none;
                padding: 0.6rem 1.8rem;
                font-weight: 600;
                border-radius: 50px;
                box-shadow: 0 4px 14px rgba(13,110,253,0.30);
                transition: all 0.25s ease;
                display: inline-flex;
                align-items: center;
                gap: 0.5rem;
                color: #fff;
            }

                .btn-primary:hover {
                    transform: translateY(-2px);
                    box-shadow: 0 8px 24px rgba(13,110,253,0.40);
                    color: #fff;
                }

            .btn-secondary {
                border-radius: 50px;
                padding: 0.6rem 1.8rem;
                font-weight: 500;
                border-color: #d1d9e6;
                transition: all 0.25s ease;
                display: inline-flex;
                align-items: center;
                gap: 0.5rem;
                color: #4a5568;
            }

                .btn-secondary:hover {
                    background: #eef2f7;
                    border-color: #b0bcca;
                    transform: translateY(-2px);
                }

            .hr-divider {
                border: 0;
                height: 1px;
                background: linear-gradient(to right, transparent, #e2e8f0, transparent);
                margin: 1.5rem 0;
            }

            /* ── Toast ── */
            .toast-container {
                position: fixed;
                top: 1.5rem;
                right: 1.5rem;
                z-index: 9999;
            }

            .toast-success {
                background: #dcfce7;
                color: #166534;
                border: 1px solid #86efac;
                border-radius: 12px;
                padding: 0.75rem 1.25rem;
                box-shadow: 0 8px 24px rgba(0,0,0,0.12);
                display: flex;
                align-items: center;
                gap: 0.75rem;
                min-width: 280px;
                transform: translateX(120%);
                transition: transform 0.5s cubic-bezier(0.34,1.56,0.64,1);
            }

                .toast-success.show {
                    transform: translateX(0);
                }

                .toast-success i {
                    font-size: 1.5rem;
                }

                .toast-success .toast-body {
                    flex: 1;
                    font-weight: 500;
                }

                .toast-success .btn-close-white {
                    background: none;
                    border: none;
                    color: #166534;
                    font-size: 1.2rem;
                    cursor: pointer;
                    padding: 0.2rem;
                    line-height: 1;
                    opacity: 0.6;
                    transition: opacity 0.15s ease;
                }

                    .toast-success .btn-close-white:hover {
                        opacity: 1;
                    }

            @@media (max-width: 576px) {
                .toast-container {
                    top: 0.75rem;
                    right: 0.75rem;
                    left: 0.75rem;
                }

                .toast-success {
                    min-width: unset;
                    width: 100%;
                    font-size: 0.9rem;
                }
            }

            /* ── Spinner ── */
            .spinner-border-sm {
                width: 1rem;
                height: 1rem;
                border-width: 0.15em;
            }
    </style>
</head>
<body>

    <!-- ─── TOAST ─── -->
    <div class="toast-container" id="toastContainer">
        @if (TempData["Success"] != null)
        {
            <div class="toast-success show" id="successToast">
                <i class="bi bi-check-circle-fill"></i>
                <span class="toast-body">@TempData["Success"]</span>
                <button type="button" class="btn-close-white" onclick="this.closest('.toast-success').remove();">
                    <i class="bi bi-x"></i>
                </button>
            </div>
        }
    </div>

    <div class="create-wrapper">

        <div class="card card-custom">

            <!-- ─── HEADER ─── -->
            <div class="card-header-custom">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <div>
                        <h3 class="mb-0">
                            <i class="bi bi-person-plus-fill"></i>
                            Create Customer
                        </h3>
                        <p class="sub-text mb-0">Fill in the details to add a new customer</p>
                    </div>
                    <a asp-action="Index" class="btn btn-light">
                        <i class="bi bi-arrow-left"></i> Back
                    </a>
                </div>
            </div>

            <!-- ─── BODY ─── -->
            <div class="card-body-custom">

                <form asp-action="Create" method="post" id="customerForm" novalidate>
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

                    <div class="row g-3">

                        <!-- Full Name -->
                        <div class="col-md-6 form-floating-custom">
                            <label asp-for="FullName">
                                <i class="bi bi-person"></i> Full Name
                                <span class="required-star">*</span>
                            </label>
                            <input asp-for="FullName"
                                   class="form-control"
                                   placeholder="Enter Full Name"
                                   autocomplete="off"
                                   autofocus />
                            <span asp-validation-for="FullName" class="text-danger"></span>
                        </div>

                        <!-- Phone Number -->
                        <div class="col-md-6 form-floating-custom">
                            <label asp-for="PhoneNumber">
                                <i class="bi bi-telephone"></i> Phone Number
                                <span class="required-star">*</span>
                            </label>
                            <input asp-for="PhoneNumber"
                                   class="form-control"
                                   maxlength="10"
                                   inputmode="numeric"
                                   pattern="[0-9]{10}"
                                   placeholder="9423167713"
                                   autocomplete="off" />
                            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                        </div>

                        <!-- Email -->
                        <div class="col-md-6 form-floating-custom">
                            <label asp-for="Email">
                                <i class="bi bi-envelope"></i> Email
                            </label>
                            <input asp-for="Email"
                                   type="email"
                                   class="form-control"
                                   placeholder="akshaychavan2503@gmail.com"
                                   autocomplete="off" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <!-- Address -->
                        <div class="col-md-6 form-floating-custom">
                            <label asp-for="Address">
                                <i class="bi bi-house"></i> Address
                            </label>
                            <textarea asp-for="Address"
                                      rows="3"
                                      class="form-control"
                                      placeholder="Enter Customer Address"></textarea>
                            <span asp-validation-for="Address" class="text-danger"></span>
                        </div>

                    </div>

                    <hr class="hr-divider" />

                    <!-- ─── BUTTONS ─── -->
                    <div class="d-flex flex-wrap gap-2 justify-content-end">
                        <button type="submit"
                                id="btnSave"
                                class="btn btn-primary">
                            <i class="bi bi-check-circle-fill"></i>
                            Save Customer
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-x-circle-fill"></i>
                            Cancel
                        </a>
                    </div>

                </form>

            </div>

        </div>

    </div>

    <!-- ─── SCRIPTS ─── -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        $(function() {

        // ── Phone input: allow only numbers ──
        $("#PhoneNumber").on("keypress", function(e) {
        if (e.which < 48 || e.which > 57) {
        e.preventDefault();
        }
        });

        // ── Phone input: max 10 digits, strip non-digits ──
        $("#PhoneNumber").on("input", function() {
        this.value = this.value.replace(/\D/g, '');
        if (this.value.length > 10) {
        this.value = this.value.substring(0, 10);
        }
        });

        // ── Disable button on valid submit ──
        $("#customerForm").on("submit", function() {
        if ($(this).valid()) {
        $("#btnSave")
        .prop("disabled", true)
        .html('<span class="spinner-border spinner-border-sm me-1"></span> Saving...');
        }
        });

        // ── Auto‑dismiss toast after 4 seconds ──
        setTimeout(function() {
        var toast = document.getElementById('successToast');
        if (toast) {
        toast.classList.remove('show');
        setTimeout(function() {
        toast.remove();
        }, 500);
        }
        }, 4000);

        });
    </script>

</body>
</html>