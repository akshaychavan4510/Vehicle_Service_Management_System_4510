@model Vehicle_Service_Management_System.Application.ViewModels.Customer.CustomerFormViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Customer | Vehicle Service Management</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
            /* ── Root Variables ── */
            :root {
                --primary-gradient: linear-gradient(135deg, #0d6efd, #6f42c1);
                --primary: #0d6efd;
                --primary-dark: #0a58ca;
                --shadow-sm: 0 2px 12px rgba(0,0,0,0.04);
                --shadow-md: 0 8px 30px rgba(0,0,0,0.08);
                --shadow-lg: 0 16px 48px rgba(0,0,0,0.12);
                --radius: 20px;
                --radius-sm: 12px;
                --transition: 0.25s cubic-bezier(0.4,0,0.2,1);
            }

            body {
                background: #f0f2f5;
                font-family: 'Inter', -apple-system, system-ui, sans-serif;
                padding: 2rem 1.5rem;
                min-height: 100vh;
                display: flex;
                align-items: flex-start;
                justify-content: center;
            }

            .edit-wrapper {
                max-width: 900px;
                width: 100%;
                background: #ffffff;
                border-radius: var(--radius);
                box-shadow: var(--shadow-lg);
                padding: 0;
                overflow: hidden;
                transition: var(--transition);
                position: relative;
            }

                /* ── Top accent bar ── */
                .edit-wrapper::before {
                    content: '';
                    position: absolute;
                    top: 0;
                    left: 0;
                    right: 0;
                    height: 4px;
                    background: var(--primary-gradient);
                    z-index: 1;
                }

            /* ── Profile Header ── */
            .profile-header {
                background: var(--primary-gradient);
                padding: 2rem 2.5rem 1.8rem;
                color: #fff;
                position: relative;
                overflow: hidden;
            }

                .profile-header::before {
                    content: '';
                    position: absolute;
                    top: -60%;
                    right: -20%;
                    width: 400px;
                    height: 400px;
                    background: rgba(255,255,255,0.06);
                    border-radius: 50%;
                }

                .profile-header::after {
                    content: '';
                    position: absolute;
                    bottom: -40%;
                    left: -10%;
                    width: 300px;
                    height: 300px;
                    background: rgba(255,255,255,0.04);
                    border-radius: 50%;
                }

                .profile-header .avatar {
                    width: 72px;
                    height: 72px;
                    border-radius: 50%;
                    background: rgba(255,255,255,0.2);
                    backdrop-filter: blur(4px);
                    border: 3px solid rgba(255,255,255,0.4);
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    font-size: 1.8rem;
                    font-weight: 700;
                    color: #fff;
                    text-shadow: 0 2px 8px rgba(0,0,0,0.1);
                    flex-shrink: 0;
                }

                .profile-header .customer-name {
                    font-size: 1.4rem;
                    font-weight: 700;
                    letter-spacing: -0.02em;
                    margin: 0;
                }

                .profile-header .customer-sub {
                    font-size: 0.85rem;
                    opacity: 0.85;
                    margin: 0;
                }

                .profile-header .edit-badge {
                    background: rgba(255,255,255,0.15);
                    backdrop-filter: blur(4px);
                    border: 1px solid rgba(255,255,255,0.2);
                    border-radius: 50px;
                    padding: 0.3rem 1rem;
                    font-size: 0.7rem;
                    text-transform: uppercase;
                    letter-spacing: 0.06em;
                    font-weight: 600;
                    display: inline-block;
                }

                .profile-header .header-actions {
                    display: flex;
                    align-items: center;
                    gap: 0.75rem;
                    flex-wrap: wrap;
                }

                .profile-header .btn-outline-light {
                    border-color: rgba(255,255,255,0.3);
                    color: #fff;
                    backdrop-filter: blur(4px);
                    border-radius: 50px;
                    padding: 0.4rem 1rem;
                    font-weight: 500;
                    transition: var(--transition);
                }

                    .profile-header .btn-outline-light:hover {
                        background: rgba(255,255,255,0.15);
                        border-color: #fff;
                    }

            /* ── Body ── */
            .body-content {
                padding: 1.8rem 2.5rem 2.5rem;
            }

            /* ── Form Card ── */
            .form-card {
                background: linear-gradient(135deg, #f8faff, #eef2f7);
                border-radius: var(--radius-sm);
                padding: 1.75rem 2rem;
                box-shadow: var(--shadow-sm);
                border: 1px solid #eef2f7;
                transition: var(--transition);
                position: relative;
            }

                .form-card::before {
                    content: '';
                    position: absolute;
                    left: 0;
                    top: 0;
                    bottom: 0;
                    width: 4px;
                    border-radius: 4px 0 0 4px;
                    background: var(--primary-gradient);
                    opacity: 0.3;
                    transition: opacity var(--transition);
                }

                .form-card:hover {
                    box-shadow: var(--shadow-md);
                }

                    .form-card:hover::before {
                        opacity: 1;
                    }

            /* ── Form Fields ── */
            .form-floating-custom .form-control,
            .form-floating-custom .form-select,
            .form-floating-custom textarea {
                border-radius: 10px;
                border: 1px solid #dce2ec;
                padding: 0.6rem 1rem;
                transition: var(--transition);
                background: #ffffff;
                font-size: 0.95rem;
                color: #1a2634;
            }

                .form-floating-custom .form-control:focus,
                .form-floating-custom .form-select:focus,
                .form-floating-custom textarea:focus {
                    border-color: var(--primary);
                    box-shadow: 0 0 0 4px rgba(13,110,253,0.12);
                    background: #ffffff;
                }

                .form-floating-custom .form-control[readonly] {
                    background: #eef2f7;
                    cursor: not-allowed;
                }

            .form-floating-custom label {
                font-weight: 600;
                color: #2d3748;
                margin-bottom: 0.3rem;
                display: flex;
                align-items: center;
                gap: 0.4rem;
                font-size: 0.9rem;
            }

                .form-floating-custom label i {
                    color: var(--primary);
                    font-size: 0.9rem;
                    opacity: 0.7;
                    background: rgba(13,110,253,0.08);
                    padding: 0.25rem;
                    border-radius: 6px;
                }

            .form-floating-custom .text-danger {
                font-size: 0.8rem;
                margin-top: 0.2rem;
                display: block;
            }

            .form-floating-custom .required-star {
                color: #dc3545;
                font-weight: 700;
            }

            /* ── Validation Summary ── */
            .validation-summary-errors {
                background: #fee2e2;
                border: 1px solid #fca5a5;
                border-radius: 10px;
                padding: 0.75rem 1rem;
                margin-bottom: 1.5rem;
                color: #991b1b;
            }

                .validation-summary-errors ul {
                    margin: 0;
                    padding-left: 1.2rem;
                }

            /* ── Buttons ── */
            .btn-primary {
                background: var(--primary-gradient);
                border: none;
                padding: 0.6rem 1.8rem;
                font-weight: 600;
                border-radius: 50px;
                box-shadow: 0 4px 14px rgba(13,110,253,0.30);
                transition: var(--transition);
                display: inline-flex;
                align-items: center;
                gap: 0.5rem;
                color: #fff;
            }

                .btn-primary:hover {
                    transform: translateY(-2px);
                    box-shadow: 0 8px 24px rgba(13,110,253,0.40);
                    color: #fff;
                }

            .btn-secondary {
                border-radius: 50px;
                padding: 0.6rem 1.8rem;
                font-weight: 500;
                border-color: #d1d9e6;
                transition: var(--transition);
                display: inline-flex;
                align-items: center;
                gap: 0.5rem;
                color: #4a5568;
            }

                .btn-secondary:hover {
                    background: #eef2f7;
                    border-color: #b0bcca;
                    transform: translateY(-2px);
                }

            /* ── Divider ── */
            .hr-divider {
                border: 0;
                height: 1px;
                background: linear-gradient(to right, transparent, #e2e8f0, transparent);
                margin: 1.5rem 0;
            }

            /* ── Toast ── */
            .toast-container {
                position: fixed;
                top: 1.5rem;
                right: 1.5rem;
                z-index: 9999;
            }

            .toast-success {
                background: #dcfce7;
                color: #166534;
                border: 1px solid #86efac;
                border-radius: 12px;
                padding: 0.75rem 1.25rem;
                box-shadow: 0 8px 24px rgba(0,0,0,0.12);
                display: flex;
                align-items: center;
                gap: 0.75rem;
                min-width: 280px;
                transform: translateX(120%);
                transition: transform 0.5s cubic-bezier(0.34,1.56,0.64,1);
            }

                .toast-success.show {
                    transform: translateX(0);
                }

                .toast-success i {
                    font-size: 1.5rem;
                }

                .toast-success .toast-body {
                    flex: 1;
                    font-weight: 500;
                }

                .toast-success .btn-close-white {
                    background: none;
                    border: none;
                    color: #166534;
                    font-size: 1.2rem;
                    cursor: pointer;
                    padding: 0.2rem;
                    line-height: 1;
                    opacity: 0.6;
                    transition: opacity 0.15s ease;
                }

                    .toast-success .btn-close-white:hover {
                        opacity: 1;
                    }

            /* ── Responsive ── */
            @@media (max-width: 576px) {
                .profile-header {
                    padding: 1.5rem 1.25rem;
                }

                    .profile-header .avatar {
                        width: 56px;
                        height: 56px;
                        font-size: 1.4rem;
                    }

                    .profile-header .customer-name {
                        font-size: 1.1rem;
                    }

                .body-content {
                    padding: 1rem 1.25rem 1.5rem;
                }

                .form-card {
                    padding: 1.25rem 1rem;
                }

                .btn-primary, .btn-secondary {
                    width: 100%;
                    justify-content: center;
                }

                .toast-container {
                    top: 0.75rem;
                    right: 0.75rem;
                    left: 0.75rem;
                }

                .toast-success {
                    min-width: unset;
                    width: 100%;
                    font-size: 0.9rem;
                }

                .page-header h1 {
                    font-size: 1.4rem;
                }

                    .page-header h1 i {
                        font-size: 1.5rem;
                    }
            }

            @@media (max-width: 400px) {
                .profile-header .header-actions {
                    width: 100%;
                }

                .profile-header .btn-outline-light {
                    flex: 1;
                    justify-content: center;
                }
            }
    </style>
</head>
<body>

    <!-- ─── TOAST ─── -->
    <div class="toast-container" id="toastContainer">
        @if (TempData["Success"] != null)
        {
            <div class="toast-success show" id="successToast">
                <i class="bi bi-check-circle-fill"></i>
                <span class="toast-body">@TempData["Success"]</span>
                <button type="button" class="btn-close-white" onclick="this.closest('.toast-success').remove();">
                    <i class="bi bi-x"></i>
                </button>
            </div>
        }
    </div>

    <div class="edit-wrapper">

        <!-- ─── PROFILE HEADER ─── -->
        <div class="profile-header">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="avatar">
                        @{
                            var initials = string.IsNullOrEmpty(Model.FullName) ? "?" : string.Concat(Model.FullName.Split(' ').Where(s => !string.IsNullOrEmpty(s)).Select(s => s[0]));
                        }
                        @initials
                    </div>
                    <div>
                        <h1 class="customer-name">@(string.IsNullOrEmpty(Model.FullName) ? "Customer" : Model.FullName)</h1>
                        <p class="customer-sub">
                            <span class="edit-badge"><i class="bi bi-pencil"></i> Editing</span>
                        </p>
                    </div>
                </div>
                <div class="header-actions">
                    <a asp-action="Index" class="btn btn-outline-light btn-sm">
                        <i class="bi bi-arrow-left"></i> Back
                    </a>
                </div>
            </div>
        </div>

        <!-- ─── BODY ─── -->
        <div class="body-content">

            <!-- ─── FORM ─── -->
            <div class="form-card">
                <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />

                    <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

                    <div class="row g-3">
                        <!-- Full Name -->
                        <div class="col-md-6 form-floating-custom">
                            <label asp-for="FullName">
                                <i class="bi bi-person"></i> Full Name
                                <span class="required-star">*</span>
                            </label>
                            <input asp-for="FullName" class="form-control" placeholder="Enter full name" />
                            <span asp-validation-for="FullName" class="text-danger"></span>
                        </div>

                        <!-- Phone Number -->
                        <div class="col-md-6 form-floating-custom">
                            <label asp-for="PhoneNumber">
                                <i class="bi bi-telephone"></i> Phone Number
                                <span class="required-star">*</span>
                            </label>
                            <input asp-for="PhoneNumber" class="form-control" placeholder="9876543210" />
                            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                        </div>

                        <!-- Email -->
                        <div class="col-md-6 form-floating-custom">
                            <label asp-for="Email">
                                <i class="bi bi-envelope"></i> Email
                            </label>
                            <input asp-for="Email" class="form-control" placeholder="abc@gmail.com" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <!-- Address -->
                        <div class="col-md-6 form-floating-custom">
                            <label asp-for="Address">
                                <i class="bi bi-house"></i> Address
                            </label>
                            <textarea asp-for="Address" class="form-control" rows="3" placeholder="Enter customer address"></textarea>
                            <span asp-validation-for="Address" class="text-danger"></span>
                        </div>
                    </div>

                    <hr class="hr-divider" />

                    <!-- ─── ACTION BUTTONS ─── -->
                    <div class="d-flex flex-wrap gap-2 justify-content-end">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-circle-fill"></i> Save Changes
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-x-circle-fill"></i> Cancel
                        </a>
                    </div>
                </form>
            </div>

        </div> <!-- /body-content -->
    </div> <!-- /edit-wrapper -->
    <!-- ─── SCRIPTS ─── -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        $(function() {
        // ── Phone: allow only numbers ──
        $("#PhoneNumber").on("keypress", function(e) {
        if (e.which < 48 || e.which > 57) {
        e.preventDefault();
        }
        });

        // ── Phone: max 10 digits, strip non-digits ──
        $("#PhoneNumber").on("input", function() {
        this.value = this.value.replace(/\D/g, '');
        if (this.value.length > 10) {
        this.value = this.value.substring(0, 10);
        }
        });

        // ── Auto‑dismiss toast ──
        setTimeout(function() {
        var toast = document.getElementById('successToast');
        if (toast) {
        toast.classList.remove('show');
        setTimeout(function() {
        toast.remove();
        }, 500);
        }
        }, 4000);
        });
    </script>
</body>
</html>