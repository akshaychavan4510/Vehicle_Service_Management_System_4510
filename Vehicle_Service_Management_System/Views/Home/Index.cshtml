@model Vehicle_Service_Management_System.Application.ViewModels.Dashboard.DashboardViewModel
@using Vehicle_Service_Management_System.Domain.Enums

@{
    ViewData["Title"] = "Dashboard";

    string BookingBadge(string status) => status switch
    {
        nameof(BookingStatus.Pending) => "status-pending",
        nameof(BookingStatus.InProgress) => "status-progress",
        nameof(BookingStatus.Completed) => "status-completed",
        nameof(BookingStatus.Cancelled) => "status-cancelled",
        _ => "status-default"
    };

    string PaymentBadge(string mode) => mode switch
    {
        nameof(PaymentMode.Cash) => "payment-cash",
        nameof(PaymentMode.UPI) => "payment-upi",
        nameof(PaymentMode.CreditCard) => "payment-card",
        nameof(PaymentMode.DebitCard) => "payment-card",
        nameof(PaymentMode.NetBanking) => "payment-net",
        _ => "payment-default"
    };
}

<style>

    /* =========================================================
               RESET / GLOBAL
               ========================================================= */

    .service-dashboard {
        min-height: calc(100vh - 70px);
        padding: 28px;
        background: radial-gradient(circle at 0% 0%, rgba(99,102,241,.12), transparent 28%), radial-gradient(circle at 100% 0%, rgba(14,165,233,.10), transparent 25%), #f4f7fb;
        color: #172033;
    }

        .service-dashboard *,
        .service-dashboard *::before,
        .service-dashboard *::after {
            box-sizing: border-box;
        }

    .dashboard-wrapper {
        width: 100%;
        max-width: 1750px;
        margin: 0 auto;
    }

    /* =========================================================
               TOP BAR
               ========================================================= */

    .dashboard-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 24px;
    }

    .header-left {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .header-logo {
        width: 56px;
        height: 56px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 17px;
        color: #fff;
        font-size: 24px;
        background: linear-gradient(135deg, #4f46e5, #2563eb);
        box-shadow: 0 12px 30px rgba(79,70,229,.25), inset 0 1px 0 rgba(255,255,255,.25);
    }

    .header-title h1 {
        margin: 0;
        font-size: 1.65rem;
        line-height: 1.2;
        font-weight: 850;
        letter-spacing: -.6px;
        color: #111827;
    }

    .header-title p {
        margin: 5px 0 0;
        font-size: .86rem;
        color: #64748b;
    }

    .date-card {
        display: flex;
        align-items: center;
        gap: 9px;
        padding: 12px 17px;
        border: 1px solid #e4e8f0;
        border-radius: 13px;
        background: rgba(255,255,255,.88);
        box-shadow: 0 8px 25px rgba(15,23,42,.05);
        color: #475569;
        font-size: .82rem;
        font-weight: 700;
        white-space: nowrap;
    }

        .date-card i {
            color: #4f46e5;
            font-size: 1rem;
        }

    /* =========================================================
               HERO
               ========================================================= */

    .hero {
        position: relative;
        overflow: hidden;
        min-height: 205px;
        padding: 34px;
        margin-bottom: 25px;
        border-radius: 25px;
        background: radial-gradient(circle at 78% 25%, rgba(255,255,255,.18), transparent 22%), radial-gradient(circle at 95% 100%, rgba(56,189,248,.18), transparent 30%), linear-gradient(120deg, #111827 0%, #1e3a8a 48%, #2563eb 100%);
        color: white;
        box-shadow: 0 20px 45px rgba(30,58,138,.22);
    }

        .hero::before {
            content: "";
            position: absolute;
            width: 260px;
            height: 260px;
            right: -80px;
            top: -120px;
            border-radius: 50%;
            background: rgba(255,255,255,.07);
        }

        .hero::after {
            content: "";
            position: absolute;
            width: 170px;
            height: 170px;
            right: 180px;
            bottom: -110px;
            border-radius: 50%;
            background: rgba(255,255,255,.055);
        }

    .hero-content {
        position: relative;
        z-index: 2;
        max-width: 850px;
    }

    .hero-badge {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 7px 12px;
        border: 1px solid rgba(255,255,255,.15);
        border-radius: 50px;
        background: rgba(255,255,255,.10);
        color: #e0e7ff;
        font-size: .67rem;
        font-weight: 800;
        letter-spacing: .8px;
        backdrop-filter: blur(10px);
    }

    .hero h2 {
        margin: 16px 0 0;
        font-size: 2rem;
        line-height: 1.2;
        font-weight: 850;
        letter-spacing: -.8px;
    }

    .hero p {
        max-width: 700px;
        margin: 10px 0 0;
        color: #cbd5e1;
        font-size: .91rem;
        line-height: 1.7;
    }

    /* =========================================================
               STATISTICS
               ========================================================= */

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 17px;
        margin-bottom: 24px;
    }

    .stat-card {
        --accent: #6366f1;
        --soft: #eef2ff;
        position: relative;
        overflow: hidden;
        min-height: 160px;
        padding: 20px;
        border: 1px solid #e6eaf1;
        border-radius: 19px;
        background: rgba(255,255,255,.96);
        color: inherit;
        text-decoration: none;
        box-shadow: 0 6px 18px rgba(15,23,42,.045);
        transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease;
    }

        .stat-card:hover,
        .stat-card:focus-visible {
            transform: translateY(-6px);
            border-color: rgba(99,102,241,.15);
            box-shadow: 0 20px 40px rgba(15,23,42,.10);
            color: inherit;
        }

        .stat-card::after {
            content: "";
            position: absolute;
            width: 135px;
            height: 135px;
            right: -60px;
            bottom: -60px;
            border-radius: 50%;
            background: var(--soft);
            opacity: .7;
            transition: transform .3s ease;
        }

        .stat-card:hover::after {
            transform: scale(1.15);
        }

    .stat-card-indigo {
        --accent: #6366f1;
        --soft: #eef2ff;
    }

    .stat-card-orange {
        --accent: #f59e0b;
        --soft: #fff7df;
    }

    .stat-card-cyan {
        --accent: #06b6d4;
        --soft: #e6fbff;
    }

    .stat-card-purple {
        --accent: #8b5cf6;
        --soft: #f3edff;
    }

    .stat-card-blue {
        --accent: #0ea5e9;
        --soft: #e9f7ff;
    }

    .stat-card-red {
        --accent: #f43f5e;
        --soft: #ffeaf0;
    }

    .stat-card-teal {
        --accent: #14b8a6;
        --soft: #e8faf7;
    }

    .stat-card-green {
        --accent: #10b981;
        --soft: #e8faf2;
    }

    .stat-top {
        position: relative;
        z-index: 2;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .stat-icon {
        width: 48px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 14px;
        background: var(--soft);
        color: var(--accent);
        font-size: 1.25rem;
    }

    .stat-arrow {
        width: 31px;
        height: 31px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 9px;
        background: #f8fafc;
        color: #94a3b8;
        font-size: .75rem;
        transition: .2s ease;
    }

    .stat-card:hover .stat-arrow {
        background: var(--accent);
        color: white;
        transform: translate(2px,-2px);
    }

    .stat-label {
        position: relative;
        z-index: 2;
        margin-top: 17px;
        color: #64748b;
        font-size: .68rem;
        font-weight: 850;
        text-transform: uppercase;
        letter-spacing: .8px;
    }

    .stat-value {
        position: relative;
        z-index: 2;
        margin-top: 4px;
        color: #111827;
        font-size: 1.55rem;
        line-height: 1.2;
        font-weight: 850;
        letter-spacing: -.7px;
    }

    .stat-footer {
        position: relative;
        z-index: 2;
        margin-top: 7px;
        color: var(--accent);
        font-size: .72rem;
        font-weight: 750;
    }

    /* =========================================================
               REVENUE
               ========================================================= */

    .revenue-card {
        position: relative;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        padding: 20px 23px;
        margin-bottom: 25px;
        border: 1px solid #ccefe0;
        border-radius: 19px;
        background: linear-gradient(110deg, #ecfdf5, #ffffff 65%);
        box-shadow: 0 7px 20px rgba(15,23,42,.04);
    }

    .revenue-left {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .revenue-icon {
        width: 49px;
        height: 49px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 14px;
        background: #d1fae5;
        color: #059669;
        font-size: 1.25rem;
    }

    .revenue-label {
        color: #64748b;
        font-size: .68rem;
        font-weight: 850;
        text-transform: uppercase;
        letter-spacing: .8px;
    }

    .revenue-value {
        margin-top: 3px;
        color: #047857;
        font-size: 1.35rem;
        font-weight: 850;
    }

    .revenue-link {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 10px 16px;
        border-radius: 11px;
        background: #059669;
        color: white;
        text-decoration: none;
        font-size: .74rem;
        font-weight: 800;
        transition: .2s ease;
    }

        .revenue-link:hover {
            background: #047857;
            color: white;
            transform: translateY(-2px);
        }

    /* =========================================================
               CONTENT
               ========================================================= */

    .content-grid {
        display: grid;
        grid-template-columns: 1.45fr 1fr;
        gap: 20px;
        margin-bottom: 28px;
    }

    .panel {
        overflow: hidden;
        border: 1px solid #e5e9f0;
        border-radius: 19px;
        background: #ffffff;
        box-shadow: 0 6px 18px rgba(15,23,42,.045);
    }

    .panel-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        padding: 17px 20px;
        border-bottom: 1px solid #edf0f5;
    }

    .panel-title {
        display: flex;
        align-items: center;
        gap: 10px;
        color: #172033;
        font-size: .91rem;
        font-weight: 850;
    }

    .panel-title-icon {
        width: 35px;
        height: 35px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        background: #eef2ff;
        color: #4f46e5;
    }

    .panel-link {
        color: #4f46e5;
        text-decoration: none;
        font-size: .72rem;
        font-weight: 800;
    }

        .panel-link:hover {
            text-decoration: underline;
        }

    /* =========================================================
               TABLE
               ========================================================= */

    .table-wrapper {
        width: 100%;
        overflow-x: auto;
    }

    .modern-table {
        width: 100%;
        min-width: 560px;
        margin: 0;
        border-collapse: collapse;
    }

        .modern-table thead th {
            padding: 12px 18px;
            border-bottom: 1px solid #edf0f5;
            background: #fafbfc;
            color: #64748b;
            font-size: .65rem;
            font-weight: 850;
            text-transform: uppercase;
            letter-spacing: .6px;
            white-space: nowrap;
        }

        .modern-table tbody td {
            padding: 13px 18px;
            border-bottom: 1px solid #f0f2f5;
            color: #475569;
            font-size: .76rem;
            vertical-align: middle;
        }

        .modern-table tbody tr {
            transition: background .18s ease;
        }

            .modern-table tbody tr:hover {
                background: #f8faff;
            }

            .modern-table tbody tr:last-child td {
                border-bottom: 0;
            }

    .booking-number {
        color: #1e293b;
        font-weight: 850;
    }

    .complaint-text {
        max-width: 210px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .amount {
        color: #0f172a;
        font-weight: 850;
    }

    /* =========================================================
               STATUS
               ========================================================= */

    .status-badge,
    .payment-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        white-space: nowrap;
        border-radius: 30px;
        font-size: .61rem;
        font-weight: 850;
    }

    .status-badge {
        padding: 5px 10px;
    }

        .status-badge::before {
            content: "";
            width: 5px;
            height: 5px;
            border-radius: 50%;
            background: currentColor;
        }

    .status-completed {
        background: #dcfce7;
        color: #15803d;
    }

    .status-pending {
        background: #fef3c7;
        color: #a16207;
    }

    .status-progress {
        background: #dbeafe;
        color: #1d4ed8;
    }

    .status-cancelled {
        background: #fee2e2;
        color: #dc2626;
    }

    .status-default {
        background: #f1f5f9;
        color: #64748b;
    }

    .payment-badge {
        padding: 5px 9px;
        border-radius: 7px;
    }

    .payment-cash {
        background: #dcfce7;
        color: #15803d;
    }

    .payment-upi {
        background: #cffafe;
        color: #0e7490;
    }

    .payment-card {
        background: #dbeafe;
        color: #1d4ed8;
    }

    .payment-net {
        background: #e2e8f0;
        color: #475569;
    }

    .payment-default {
        background: #f1f5f9;
        color: #64748b;
    }

    /* =========================================================
               EMPTY STATE
               ========================================================= */

    .empty-state {
        min-height: 180px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-direction: column;
        padding: 35px 20px;
        color: #94a3b8;
    }

    .empty-state-icon {
        width: 52px;
        height: 52px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 10px;
        border-radius: 15px;
        background: #f8fafc;
        color: #cbd5e1;
        font-size: 1.4rem;
    }

    .empty-state p {
        margin: 0;
        font-size: .77rem;
    }

    /* =========================================================
               QUICK ACTIONS
               ========================================================= */

    .quick-section {
        margin-top: 3px;
    }

    .section-heading {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        margin-bottom: 14px;
    }

        .section-heading h3 {
            margin: 0;
            color: #172033;
            font-size: .95rem;
            font-weight: 850;
        }

        .section-heading span {
            color: #94a3b8;
            font-size: .7rem;
        }

    .quick-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0,1fr));
        gap: 16px;
    }

    .quick-action {
        position: relative;
        overflow: hidden;
        min-height: 120px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding: 18px;
        border-radius: 18px;
        color: white;
        text-decoration: none;
        box-shadow: 0 10px 25px rgba(15,23,42,.10);
        transition: transform .25s ease, box-shadow .25s ease;
    }

        .quick-action:hover,
        .quick-action:focus-visible {
            transform: translateY(-5px);
            color: white;
            box-shadow: 0 20px 35px rgba(15,23,42,.16);
        }

        .quick-action::after {
            content: "";
            position: absolute;
            width: 120px;
            height: 120px;
            right: -35px;
            bottom: -55px;
            border-radius: 50%;
            background: rgba(255,255,255,.12);
        }

    .quick-icon {
        position: relative;
        z-index: 2;
        width: 39px;
        height: 39px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        background: rgba(255,255,255,.17);
        font-size: 1.05rem;
    }

    .quick-content {
        position: relative;
        z-index: 2;
    }

    .quick-title {
        font-size: .83rem;
        font-weight: 850;
    }

    .quick-subtitle {
        margin-top: 3px;
        font-size: .64rem;
        opacity: .8;
    }

    .quick-purple {
        background: linear-gradient(135deg, #6366f1, #4338ca);
    }

    .quick-orange {
        background: linear-gradient(135deg, #f59e0b, #ea580c);
    }

    .quick-blue {
        background: linear-gradient(135deg, #8b5cf6, #6d28d9);
    }

    .quick-red {
        background: linear-gradient(135deg, #f43f5e, #be123c);
    }

    /* =========================================================
               ANIMATION
               ========================================================= */

    .dashboard-wrapper > * {
        animation: dashboardFade .45s ease both;
    }

    .stats-grid .stat-card:nth-child(1) {
        animation: dashboardFade .35s ease .03s both;
    }

    .stats-grid .stat-card:nth-child(2) {
        animation: dashboardFade .35s ease .06s both;
    }

    .stats-grid .stat-card:nth-child(3) {
        animation: dashboardFade .35s ease .09s both;
    }

    .stats-grid .stat-card:nth-child(4) {
        animation: dashboardFade .35s ease .12s both;
    }

    @@keyframes dashboardFade {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* =========================================================
               RESPONSIVE
               ========================================================= */

    @@media (max-width: 1300px) {

        .stats-grid {
            grid-template-columns: repeat(3, minmax(0,1fr));
        }

        .quick-grid {
            grid-template-columns: repeat(2, minmax(0,1fr));
        }

        .content-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 900px) {

        .service-dashboard {
            padding: 20px;
        }

        .stats-grid {
            grid-template-columns: repeat(2, minmax(0,1fr));
        }

        .hero {
            padding: 27px;
        }

            .hero h2 {
                font-size: 1.65rem;
            }
    }

    @@media (max-width: 650px) {

        .service-dashboard {
            padding: 14px;
        }

        .dashboard-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .date-card {
            width: 100%;
            justify-content: center;
        }

        .header-title h1 {
            font-size: 1.35rem;
        }

        .header-title p {
            font-size: .78rem;
        }

        .header-logo {
            width: 48px;
            height: 48px;
            font-size: 20px;
        }

        .hero {
            min-height: auto;
            padding: 24px;
            border-radius: 20px;
        }

            .hero h2 {
                font-size: 1.35rem;
            }

            .hero p {
                font-size: .79rem;
            }

        .stats-grid {
            grid-template-columns: 1fr;
            gap: 13px;
        }

        .stat-card {
            min-height: 145px;
        }

        .revenue-card {
            align-items: flex-start;
            flex-direction: column;
        }

        .revenue-link {
            width: 100%;
            justify-content: center;
        }

        .quick-grid {
            grid-template-columns: 1fr;
        }

        .section-heading {
            align-items: flex-start;
            flex-direction: column;
        }

        .panel-header {
            padding: 15px;
        }
    }

    @@media (max-width: 400px) {

        .header-left {
            align-items: flex-start;
        }

        .hero {
            padding: 20px;
        }

            .hero h2 {
                font-size: 1.2rem;
            }

        .stat-value {
            font-size: 1.4rem;
        }

        .revenue-value {
            font-size: 1.15rem;
        }
    }

    @@media (prefers-reduced-motion: reduce) {

        .service-dashboard *,
        .service-dashboard *::before,
        .service-dashboard *::after {
            animation-duration: .001ms !important;
            transition-duration: .001ms !important;
        }
    }

</style>


<div class="service-dashboard">

    <div class="dashboard-wrapper">

        <!-- =====================================================
             HEADER
        ====================================================== -->

        <div class="dashboard-header">

            <div class="header-left">

                <div class="header-logo" aria-hidden="true">
                    <i class="bi bi-speedometer2"></i>
                </div>

                <div class="header-title">

                    <h1>
                        Service Center Dashboard
                    </h1>

                    <p>
                        Monitor your complete vehicle service operations.
                    </p>

                </div>

            </div>

            <div class="date-card">

                <i class="bi bi-calendar3" aria-hidden="true"></i>

                @DateTime.Now.ToString("dddd, dd MMM yyyy")

            </div>

        </div>


        <!-- =====================================================
             HERO
        ====================================================== -->

        <section class="hero">

            <div class="hero-content">

                <div class="hero-badge">

                    <i class="bi bi-stars" aria-hidden="true"></i>

                    ADMIN OVERVIEW

                </div>

                <h2>
                    Welcome back, @(User.Identity?.Name ?? "Admin") 👋
                </h2>

                <p>
                    Here's your service center overview for today.
                    Manage customers, vehicles, bookings, job cards,
                    invoices and payments from one powerful dashboard.
                </p>

            </div>

        </section>


        <!-- =====================================================
             STATISTICS
        ====================================================== -->

        <div class="stats-grid">

            <!-- Customers -->

            <a asp-controller="Customer"
               asp-action="Index"
               class="stat-card stat-card-indigo">

                <div class="stat-top">

                    <div class="stat-icon" aria-hidden="true">
                        <i class="bi bi-people"></i>
                    </div>

                    <div class="stat-arrow" aria-hidden="true">
                        <i class="bi bi-arrow-up-right"></i>
                    </div>

                </div>

                <div class="stat-label">
                    Customers
                </div>

                <div class="stat-value">
                    @Model.Customers
                </div>

                <div class="stat-footer">
                    View customers
                    <i class="bi bi-arrow-right" aria-hidden="true"></i>
                </div>

            </a>


            <!-- Vehicles -->

            <a asp-controller="Vehicle"
               asp-action="Index"
               class="stat-card stat-card-orange">

                <div class="stat-top">

                    <div class="stat-icon" aria-hidden="true">
                        <i class="bi bi-car-front"></i>
                    </div>

                    <div class="stat-arrow" aria-hidden="true">
                        <i class="bi bi-arrow-up-right"></i>
                    </div>

                </div>

                <div class="stat-label">
                    Vehicles
                </div>

                <div class="stat-value">
                    @Model.Vehicles
                </div>

                <div class="stat-footer">
                    View vehicles
                    <i class="bi bi-arrow-right" aria-hidden="true"></i>
                </div>

            </a>


            <!-- Mechanics -->

            <a asp-controller="Mechanic"
               asp-action="Index"
               class="stat-card stat-card-cyan">

                <div class="stat-top">

                    <div class="stat-icon" aria-hidden="true">
                        <i class="bi bi-person-workspace"></i>
                    </div>

                    <div class="stat-arrow" aria-hidden="true">
                        <i class="bi bi-arrow-up-right"></i>
                    </div>

                </div>

                <div class="stat-label">
                    Mechanics
                </div>

                <div class="stat-value">
                    @Model.Mechanics
                </div>

                <div class="stat-footer">
                    View mechanics
                    <i class="bi bi-arrow-right" aria-hidden="true"></i>
                </div>

            </a>


            <!-- Bookings -->

            <a asp-controller="ServiceBooking"
               asp-action="Index"
               class="stat-card stat-card-purple">

                <div class="stat-top">

                    <div class="stat-icon" aria-hidden="true">
                        <i class="bi bi-calendar-check"></i>
                    </div>

                    <div class="stat-arrow" aria-hidden="true">
                        <i class="bi bi-arrow-up-right"></i>
                    </div>

                </div>

                <div class="stat-label">
                    Service Bookings
                </div>

                <div class="stat-value">
                    @Model.Bookings
                </div>

                <div class="stat-footer">
                    Manage bookings
                    <i class="bi bi-arrow-right" aria-hidden="true"></i>
                </div>

            </a>


            <!-- Job Cards -->

            <a asp-controller="JobCard"
               asp-action="Index"
               class="stat-card stat-card-blue">

                <div class="stat-top">

                    <div class="stat-icon" aria-hidden="true">
                        <i class="bi bi-file-earmark-text"></i>
                    </div>

                    <div class="stat-arrow" aria-hidden="true">
                        <i class="bi bi-arrow-up-right"></i>
                    </div>

                </div>

                <div class="stat-label">
                    Job Cards
                </div>

                <div class="stat-value">
                    @Model.JobCards
                </div>

                <div class="stat-footer">
                    View job cards
                    <i class="bi bi-arrow-right" aria-hidden="true"></i>
                </div>

            </a>


            <!-- Invoices -->

            <a asp-controller="Invoice"
               asp-action="Index"
               class="stat-card stat-card-red">

                <div class="stat-top">

                    <div class="stat-icon" aria-hidden="true">
                        <i class="bi bi-receipt"></i>
                    </div>

                    <div class="stat-arrow" aria-hidden="true">
                        <i class="bi bi-arrow-up-right"></i>
                    </div>

                </div>

                <div class="stat-label">
                    Invoices
                </div>

                <div class="stat-value">
                    @Model.Invoices
                </div>

                <div class="stat-footer">
                    Manage invoices
                    <i class="bi bi-arrow-right" aria-hidden="true"></i>
                </div>

            </a>


            <!-- Payments -->

            <a asp-controller="Payment"
               asp-action="Index"
               class="stat-card stat-card-teal">

                <div class="stat-top">

                    <div class="stat-icon" aria-hidden="true">
                        <i class="bi bi-cash-stack"></i>
                    </div>

                    <div class="stat-arrow" aria-hidden="true">
                        <i class="bi bi-arrow-up-right"></i>
                    </div>

                </div>

                <div class="stat-label">
                    Payments
                </div>

                <div class="stat-value">
                    @Model.Payments
                </div>

                <div class="stat-footer">
                    View payments
                    <i class="bi bi-arrow-right" aria-hidden="true"></i>
                </div>

            </a>


            <!-- Revenue -->

            <a asp-controller="Report"
               asp-action="Revenue"
               class="stat-card stat-card-green">

                <div class="stat-top">

                    <div class="stat-icon" aria-hidden="true">
                        <i class="bi bi-graph-up-arrow"></i>
                    </div>

                    <div class="stat-arrow" aria-hidden="true">
                        <i class="bi bi-arrow-up-right"></i>
                    </div>

                </div>

                <div class="stat-label">
                    Total Revenue
                </div>

                <div class="stat-value">
                    ₹@Model.Revenue.ToString("N0")
                </div>

                <div class="stat-footer">
                    View revenue report
                    <i class="bi bi-arrow-right" aria-hidden="true"></i>
                </div>

            </a>

        </div>


        <!-- =====================================================
             REVENUE SUMMARY
        ====================================================== -->

        <div class="revenue-card">

            <div class="revenue-left">

                <div class="revenue-icon" aria-hidden="true">
                    <i class="bi bi-currency-rupee"></i>
                </div>

                <div>

                    <div class="revenue-label">
                        Total Business Revenue
                    </div>

                    <div class="revenue-value">
                        ₹@Model.Revenue.ToString("N0")
                    </div>

                </div>

            </div>

            <a asp-controller="Report"
               asp-action="Revenue"
               class="revenue-link">

                Detailed Report

                <i class="bi bi-arrow-right" aria-hidden="true"></i>

            </a>

        </div>


        <!-- =====================================================
             RECENT ACTIVITY
        ====================================================== -->

        <div class="content-grid">


            <!-- RECENT BOOKINGS -->

            <div class="panel">

                <div class="panel-header">

                    <div class="panel-title">

                        <div class="panel-title-icon" aria-hidden="true">

                            <i class="bi bi-calendar-check"></i>

                        </div>

                        Recent Service Bookings

                    </div>

                    <a asp-controller="ServiceBooking"
                       asp-action="Index"
                       class="panel-link">

                        View all

                        <i class="bi bi-arrow-right" aria-hidden="true"></i>

                    </a>

                </div>


                @if (Model.RecentBookings == null || !Model.RecentBookings.Any())
                {
                    <div class="empty-state">

                        <div class="empty-state-icon" aria-hidden="true">

                            <i class="bi bi-calendar-x"></i>

                        </div>

                        <p>
                            No service bookings available yet.
                        </p>

                    </div>
                }
                else
                {
                    <div class="table-wrapper">

                        <table class="modern-table">

                            <thead>

                                <tr>

                                    <th>
                                        Booking
                                    </th>

                                    <th>
                                        Date
                                    </th>

                                    <th>
                                        Complaint
                                    </th>

                                    <th>
                                        Status
                                    </th>

                                </tr>

                            </thead>

                            <tbody>

                                @foreach (var item in Model.RecentBookings)
                                {
                                    <tr>

                                        <td>

                                            <span class="booking-number">
                                                @item.BookingNumber
                                            </span>

                                        </td>

                                        <td>

                                            @item.BookingDate.ToString("dd MMM yyyy")

                                        </td>

                                        <td>

                                            <div class="complaint-text" title="@item.Complaint">

                                                @(string.IsNullOrWhiteSpace(item.Complaint)
                                                    ? "General Service"
                                                    : item.Complaint)

                                            </div>

                                        </td>

                                        <td>

                                            <span class="status-badge @BookingBadge(item.Status.ToString())">

                                                @item.Status

                                            </span>

                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>
                }

            </div>


            <!-- RECENT PAYMENTS -->

            <div class="panel">

                <div class="panel-header">

                    <div class="panel-title">

                        <div class="panel-title-icon"
                             style="background:#ecfdf5;color:#059669;"
                             aria-hidden="true">

                            <i class="bi bi-cash-stack"></i>

                        </div>

                        Recent Payments

                    </div>

                    <a asp-controller="Payment"
                       asp-action="Index"
                       class="panel-link"
                       style="color:#059669;">

                        View all

                        <i class="bi bi-arrow-right" aria-hidden="true"></i>

                    </a>

                </div>


                @if (Model.RecentPayments == null || !Model.RecentPayments.Any())
                {
                    <div class="empty-state">

                        <div class="empty-state-icon" aria-hidden="true">

                            <i class="bi bi-wallet2"></i>

                        </div>

                        <p>
                            No payments recorded yet.
                        </p>

                    </div>
                }
                else
                {
                    <div class="table-wrapper">

                        <table class="modern-table">

                            <thead>

                                <tr>

                                    <th>
                                        Invoice
                                    </th>

                                    <th>
                                        Amount
                                    </th>

                                    <th>
                                        Payment Mode
                                    </th>

                                </tr>

                            </thead>

                            <tbody>

                                @foreach (var item in Model.RecentPayments)
                                {
                                    <tr>

                                        <td>

                                            <span class="booking-number">
                                                #@item.InvoiceId
                                            </span>

                                        </td>

                                        <td>

                                            <span class="amount">
                                                ₹@item.AmountPaid.ToString("N2")
                                            </span>

                                        </td>

                                        <td>

                                            <span class="payment-badge @PaymentBadge(item.PaymentMode.ToString())">

                                                @item.PaymentMode

                                            </span>

                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>
                }

            </div>

        </div>


        <!-- =====================================================
             QUICK ACTIONS
        ====================================================== -->

        <section class="quick-section">

            <div class="section-heading">

                <h3>

                    <i class="bi bi-lightning-charge-fill text-warning me-1" aria-hidden="true"></i>

                    Quick Actions

                </h3>

                <span>
                    Frequently used operations
                </span>

            </div>


            <div class="quick-grid">


                <!-- Add Customer -->

                <a asp-controller="Customer"
                   asp-action="Create"
                   class="quick-action quick-purple">

                    <div class="quick-icon" aria-hidden="true">

                        <i class="bi bi-person-plus"></i>

                    </div>

                    <div class="quick-content">

                        <div class="quick-title">
                            Add Customer
                        </div>

                        <div class="quick-subtitle">
                            Register a new customer
                        </div>

                    </div>

                </a>


                <!-- Add Vehicle -->

                <a asp-controller="Vehicle"
                   asp-action="Create"
                   class="quick-action quick-orange">

                    <div class="quick-icon" aria-hidden="true">

                        <i class="bi bi-car-front"></i>

                    </div>

                    <div class="quick-content">

                        <div class="quick-title">
                            Add Vehicle
                        </div>

                        <div class="quick-subtitle">
                            Register customer vehicle
                        </div>

                    </div>

                </a>


                <!-- New Booking -->

                <a asp-controller="ServiceBooking"
                   asp-action="Create"
                   class="quick-action quick-blue">

                    <div class="quick-icon" aria-hidden="true">

                        <i class="bi bi-calendar-plus"></i>

                    </div>

                    <div class="quick-content">

                        <div class="quick-title">
                            New Booking
                        </div>

                        <div class="quick-subtitle">
                            Schedule vehicle service
                        </div>

                    </div>

                </a>


                <!-- Generate Invoice -->

                <a asp-controller="Invoice"
                   asp-action="Create"
                   class="quick-action quick-red">

                    <div class="quick-icon" aria-hidden="true">

                        <i class="bi bi-receipt"></i>

                    </div>

                    <div class="quick-content">

                        <div class="quick-title">
                            Generate Invoices
                        </div>

                        <div class="quick-subtitle">
                            Create service invoice
                        </div>

                    </div>

                </a>

            </div>

        </section>

    </div>

</div>
